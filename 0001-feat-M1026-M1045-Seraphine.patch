+# ============================================================
+# 核心类: MetaComplianceScorer
+# ============================================================
+
+class MetaComplianceScorer:
+    """
+    版本适应度评分器 — 评估玩家出装/英雄选择与当前版本Meta的契合度
+
+    遵循Seraphine connector.py的架构模式:
+    - needLcu装饰器 → ensure_initialized() 前置检查
+    - retry装饰器 → _with_retry() 指数退避
+    - PastRequest → _request_log 请求历史
+    - HTTP session分离 → _connector 独立连接层
+    """
+
+    def __init__(self):
+        self._state = MetaComplianceScorerState.UNINITIALIZED
+        self._connector = _LcuConnectorAdapter()
+        self._cache = AnalysisCache(max_size=512, ttl_seconds=300)
+        self._stats_helper = StatisticalHelper()
+        self._init_lock = threading.Lock()
+        self._request_log: List[Dict] = []
+        self._error_counts: Dict[str, int] = defaultdict(int)
+        self._initialized = False
+        self._module_id = "M1042"
+        self._created_at = time.time()
+        logger.info(f"M1042 MetaComplianceScorer instantiated")
+
+    async def ensure_initialized(self) -> bool:
+        """初始化检查 — 对应Seraphine的needLcu装饰器"""
+        if self._initialized:
+            return True
+        try:
+            self._state = MetaComplianceScorerState.INITIALIZING
+            connected = await self._connector.ensure_connected()
+            if not connected:
+                self._state = MetaComplianceScorerState.ERROR
+                return False
+            self._initialized = True
+            self._state = MetaComplianceScorerState.READY
+            logger.info(f"M1042 initialized successfully")
+            return True
+        except Exception as e:
+            self._state = MetaComplianceScorerState.ERROR
+            logger.error(f"M1042 initialization failed: {e}")
+            return False
+
+    async def _with_retry(self, coro_factory: Callable, max_retries: int = 3) -> Optional[Any]:
+        """重试包装器 — 对应Seraphine的retry装饰器"""
+        last_err = None
+        for attempt in range(max_retries):
+            try:
+                return await coro_factory()
+            except Exception as e:
+                last_err = e
+                backoff = 0.3 * (2 ** attempt)
+                logger.warning(f"Retry {attempt+1}/{max_retries}: {e}")
+                await asyncio.sleep(backoff)
+        logger.error(f"All retries exhausted: {last_err}")
+        self._error_counts["retry_exhausted"] += 1
+        return None
+
+    async def score_meta_compliance(self, puuid: str, recent_n: int = 10) -> Dict[str, Any]:
+        """
+        评估Meta适应度:英雄选择/出装/符文的综合评分
+
+        Returns:
+            Dict[str, Any]: 分析结果字典,包含status/data/metadata字段
+        """
+        if not await self.ensure_initialized():
+            return {"status": "error", "reason": "not_initialized"}
+
+        self._state = MetaComplianceScorerState.PROCESSING
+        start_time = time.time()
+
+        cache_key = f"score_meta_compliance::{puuid}"
+        cached = self._cache.get(cache_key)
+        if cached is not None:
+            logger.debug(f"Cache hit for {cache_key}")
+            self._state = MetaComplianceScorerState.READY
+            return cached
+
+        try:
+            logger.info(f"M1042.score_meta_compliance starting")
+
+            # ---- 域逻辑: score_meta_compliance ----
+            raw_data = await self._connector.request("GET", "/meta_compliance_scorer/score_meta_compliance")
+            if raw_data is None:
+                return {"status": "error", "reason": "lcu_request_failed"}
+
+            # 评分/评级逻辑
+            metrics = raw_data.get("data", {})
+            scores = {}
+            for metric, val in metrics.items():
+                if isinstance(val, (int, float)):
+                    normalized = min(max(float(val) / 100.0, 0.0), 1.0)
+                    scores[metric] = round(normalized * 100, 1)
+            total_score = self._stats_helper.safe_mean(list(scores.values())) if scores else 50.0
+            grade = "S" if total_score >= 90 else "A" if total_score >= 75 else "B" if total_score >= 60 else "C" if total_score >= 45 else "D"
+            result = {
+                "status": "ok",
+                "data": {"scores": scores, "total_score": round(total_score, 1), "grade": grade},
+            }
+
+            elapsed = time.time() - start_time
+            result["metadata"] = {
+                "module": "M1042",
+                "method": "score_meta_compliance",
+                "elapsed_ms": round(elapsed * 1000, 2),
+                "timestamp": time.time(),
+                "cache_stats": self._cache.stats,
+            }
+
+            self._cache.put(cache_key, result)
+            self._state = MetaComplianceScorerState.READY
+            logger.info(f"M1042.score_meta_compliance completed in {elapsed:.3f}s")
+            return result
+
+        except Exception as e:
+            self._state = MetaComplianceScorerState.ERROR
+            self._error_counts["score_meta_compliance"] += 1
+            logger.error(f"M1042.score_meta_compliance failed: {e}")
+            return {"status": "error", "reason": str(e)}
