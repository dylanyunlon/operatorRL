+    async def ensure_initialized(self) -> bool:
+        """初始化检查 — 对应Seraphine的needLcu装饰器"""
+        if self._initialized:
+            return True
+        try:
+            self._state = ChampionMasteryAnalyzerState.INITIALIZING
+            connected = await self._connector.ensure_connected()
+            if not connected:
+                self._state = ChampionMasteryAnalyzerState.ERROR
+                return False
+            self._initialized = True
+            self._state = ChampionMasteryAnalyzerState.READY
+            logger.info(f"M1028 initialized successfully")
