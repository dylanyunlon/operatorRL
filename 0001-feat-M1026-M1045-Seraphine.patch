+        logger.info(f"M1042 shutting down...")
+        self._cache.clear()
+        self._state = MetaComplianceScorerState.SHUTDOWN
+        self._initialized = False
+
+    def __repr__(self) -> str:
+        return f"MetaComplianceScorer(state={self._state.value}, uptime={time.time()-self._created_at:.0f}s)"
+
