+        return (time.time() - self.timestamp) > ttl
+
+    def merge(self, other: "HeatmapGrid") -> "HeatmapGrid":
+        merged_data = {**self.data, **other.data}
+        return HeatmapGrid(data=merged_data, timestamp=max(self.timestamp, other.timestamp))
