+        start_time = time.time()
+
+        cache_key = f"predict_premade_strategy::{duo_puuids}"
+        cached = self._cache.get(cache_key)
+        if cached is not None:
+            logger.debug(f"Cache hit for {cache_key}")
+            self._state = DuoPartnerDetectorState.READY
+            return cached
+
