+@dataclass
+class LPCurve:
+    """LP变化曲线,支持移动平均/趋势检测"""
+    data: Dict[str, Any] = field(default_factory=dict)
+    timestamp: float = field(default_factory=time.time)
+    version: str = "1.0.0"
+    source_module: str = "M1029"
+
+    def to_dict(self) -> Dict[str, Any]:
+        return asdict(self)
+
+    def is_stale(self, ttl: float = 300.0) -> bool:
+        return (time.time() - self.timestamp) > ttl
+
+    def merge(self, other: "LPCurve") -> "LPCurve":
+        merged_data = {**self.data, **other.data}
+        return LPCurve(data=merged_data, timestamp=max(self.timestamp, other.timestamp))
+
+    @classmethod
+    def from_dict(cls, raw: Dict[str, Any]) -> "LPCurve":
+        return cls(
+            data=raw.get("data", {}),
+            timestamp=raw.get("timestamp", time.time()),
+            version=raw.get("version", "1.0.0"),
+            source_module=raw.get("source_module", "M1029"),
+        )
+
+    def __repr__(self) -> str:
+        keys = list(self.data.keys())[:5]
