+    @classmethod
+    def from_dict(cls, raw: Dict[str, Any]) -> "HeatmapGrid":
+        return cls(
+            data=raw.get("data", {}),
+            timestamp=raw.get("timestamp", time.time()),
+            version=raw.get("version", "1.0.0"),
+            source_module=raw.get("source_module", "M1037"),
+        )
