+
+
+# ============================================================
+# 配置与常量 — 时间线解析:事件提取/时间戳归一化/关键节点识别
+# ============================================================
+
+EVENT_TYPES_KILL = "CHAMPION_KILL"
+EVENT_TYPES_BUILDING = "BUILDING_KILL"
+EVENT_TYPES_MONSTER = "ELITE_MONSTER_KILL"
+EVENT_TYPES_WARD = "WARD_PLACED"
