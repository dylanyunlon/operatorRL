+"""Multi-Agent Coordinator — Team coordination for 5v5. Ref: self_play_scheduler.py, evolution_orchestrator.py"""
+from __future__ import annotations
+import logging, time
+from collections import defaultdict
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "agentlightning.trainer.multi_agent_coordinator.v1"
+
+class MultiAgentCoordinator:
+    def __init__(self) -> None:
+        self._agents: Dict[str, Dict[str, Any]] = {}; self._messages: Dict[str, List[Dict[str, Any]]] = defaultdict(list)
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+    @property
+    def agent_count(self) -> int: return len(self._agents)
+    def register_agent(self, agent_id: str, role: str = "UNKNOWN", **cfg: Any) -> None:
+        self._agents[agent_id] = {"role": role, "config": cfg, "registered_at": time.time()}; self._messages[agent_id] = []
+        self._fire({"event": "agent_registered", "agent_id": agent_id, "role": role})
+    def remove_agent(self, agent_id: str) -> None: self._agents.pop(agent_id, None); self._messages.pop(agent_id, None)
+    def get_role(self, agent_id: str) -> str: return self._agents.get(agent_id, {}).get("role", "UNKNOWN")
+    def list_roles(self) -> List[str]: return [a["role"] for a in self._agents.values()]
+    def broadcast(self, message: Dict[str, Any]) -> List[str]:
+        r = []
+        for aid in self._agents: self._messages[aid].append({"from": "_broadcast", "payload": message, "timestamp": time.time()}); r.append(aid)
+        return r
+    def send_message(self, from_agent: str, to_agent: str, message: Dict[str, Any]) -> None:
+        self._messages[to_agent].append({"from": from_agent, "payload": message, "timestamp": time.time()})
+    def get_messages(self, agent_id: str) -> List[Dict[str, Any]]:
+        msgs = list(self._messages.get(agent_id, [])); self._messages[agent_id] = []; return msgs
+    def select_joint_action(self, proposals: Dict[str, Dict[str, Any]]) -> Dict[str, str]:
+        return {aid: p.get("action", "wait") for aid, p in proposals.items()}
+    def distribute_reward(self, team_reward: float, contributions: Optional[Dict[str, float]] = None) -> Dict[str, float]:
+        if contributions is None: n = max(len(self._agents), 1); return {aid: team_reward/n for aid in self._agents}
+        tc = sum(contributions.values()) or 1.0; return {aid: team_reward*(contributions.get(aid,0.0)/tc) for aid in self._agents}
+    def get_team_state(self) -> Dict[str, Any]: return {"agents": [{"id": a, "role": i["role"]} for a, i in self._agents.items()], "agent_count": len(self._agents)}
+    def _fire(self, payload: Dict[str, Any]) -> None:
+        if self.evolution_callback:
+            try: self.evolution_callback({"source": _EVOLUTION_KEY, "timestamp": time.time(), **payload})
+            except Exception as e: logger.warning("cb: %s", e)
