+"""Decision Tree Fallback — Rule-based when NN confidence low. Ref: dota2bot hero_axe.lua, decision_engine.py"""
+from __future__ import annotations
+import logging, time
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "agentlightning.inference.decision_tree_fallback.v1"
+
+class DecisionTreeFallback:
+    def __init__(self, confidence_threshold: float = 0.5) -> None:
+        self.confidence_threshold = confidence_threshold; self.rules: List[Dict[str, Any]] = []; self._fallback_log: List[Dict[str, Any]] = []
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+    def add_rule(self, name: str, condition, action: str, priority: int = 0) -> None:
+        self.rules.append({"name": name, "condition": condition, "action": action, "priority": priority}); self.rules.sort(key=lambda r: -r["priority"])
+    def remove_rule(self, name: str) -> None: self.rules = [r for r in self.rules if r["name"] != name]
+    def maybe_fallback(self, state: Dict[str, Any], nn_confidence: float) -> Dict[str, Any]:
+        if nn_confidence >= self.confidence_threshold: return {"triggered": False, "action": None, "rule": None}
+        for rule in self.rules:
+            try:
+                if rule["condition"](state):
+                    entry = {"state": dict(state), "nn_confidence": nn_confidence, "rule": rule["name"], "action": rule["action"], "timestamp": time.time()}
+                    self._fallback_log.append(entry)
+                    self._fire({"event": "fallback_triggered", "rule": rule["name"], "confidence": nn_confidence})
+                    return {"triggered": True, "action": rule["action"], "rule": rule["name"]}
+            except Exception as e: logger.warning("Rule '%s' error: %s", rule["name"], e)
+        return {"triggered": False, "action": None, "rule": None}
+    def get_fallback_log(self): return list(self._fallback_log)
+    def get_blind_spots(self):
+        if not self._fallback_log: return []
+        rc: Dict[str, int] = {}; rs: Dict[str, List] = {}
+        for e in self._fallback_log:
+            r = e.get("rule", "unknown"); rc[r] = rc.get(r,0)+1; rs.setdefault(r, []).append(e["state"])
+        return [{"rule": r, "trigger_count": c, "sample_states": rs[r][:5]} for r, c in rc.items() if c >= 1]
+    def _fire(self, payload):
+        if self.evolution_callback:
+            try: self.evolution_callback({"source": _EVOLUTION_KEY, "timestamp": time.time(), **payload})
+            except: pass
