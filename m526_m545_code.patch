+"""Model Ensemble — Vote/weighted_avg fusion. Ref: Akagi mjai_bot, adapter/base.py"""
+from __future__ import annotations
+import logging, time
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "agentlightning.inference.model_ensemble.v1"
+
+class ModelEnsemble:
+    def __init__(self, fusion: str = "weighted_avg") -> None:
+        self.fusion = fusion; self._models: Dict[str, Dict[str, Any]] = {}; self._performance: Dict[str, List[float]] = {}; self._last_contributions: Dict[str, List[float]] = {}
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+    @property
+    def model_count(self) -> int: return len(self._models)
+    def add_model(self, mid: str, predict_fn, weight: float = 1.0) -> None: self._models[mid] = {"predict_fn": predict_fn, "weight": weight}; self._performance[mid] = []
+    def remove_model(self, mid: str) -> None: self._models.pop(mid, None); self._performance.pop(mid, None)
+    def list_models(self) -> List[str]: return list(self._models.keys())
+    def get_weight(self, mid: str) -> float: return self._models.get(mid, {}).get("weight", 0.0)
+    def predict(self, state: Any) -> List[float]:
+        if not self._models: raise ValueError("No models in ensemble")
+        outputs = {}
+        for mid, info in self._models.items():
+            try: outputs[mid] = info["predict_fn"](state)
+            except: pass
+        if not outputs: raise ValueError("All models failed")
+        if self.fusion == "vote": result = self._vote(outputs)
+        else: result = self._wavg(outputs)
+        self._last_contributions = dict(outputs); self._fire({"event": "ensemble_predict", "models_used": len(outputs)}); return result
+    def _vote(self, outputs):
+        dim = len(next(iter(outputs.values()))); avg = [0.0]*dim
+        for o in outputs.values():
+            for i in range(min(dim,len(o))): avg[i] += o[i]
+        return [v/len(outputs) for v in avg]
+    def _wavg(self, outputs):
+        dim = len(next(iter(outputs.values()))); r = [0.0]*dim; tw = 0.0
+        for mid, o in outputs.items():
+            w = self._models[mid]["weight"]; tw += w
+            for i in range(min(dim,len(o))): r[i] += o[i]*w
+        return [v/tw for v in r] if tw > 0 else r
+    def record_performance(self, mid: str, score: float) -> None:
+        if mid in self._performance: self._performance[mid].append(score)
+    def update_weights_from_performance(self) -> None:
+        for mid in self._models:
+            sc = self._performance.get(mid, [])
+            if sc: self._models[mid]["weight"] = max(sum(sc[-10:])/len(sc[-10:]), 0.01)
+    def get_contributions(self): return dict(self._last_contributions)
+    def _fire(self, payload):
+        if self.evolution_callback:
+            try: self.evolution_callback({"source": _EVOLUTION_KEY, "timestamp": time.time(), **payload})
+            except: pass
