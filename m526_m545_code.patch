+"""Action Sampler — greedy/temperature/topk/beam. Ref: dota2bot Consider*Action, decision_engine.py"""
+from __future__ import annotations
+import logging, math, random, time
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "agentlightning.inference.action_sampler.v1"
+def _softmax(logits: List[float], temp: float = 1.0) -> List[float]:
+    if temp <= 0: temp = 1e-8
+    sc = [x/temp for x in logits]; mx = max(sc); exps = [math.exp(s-mx) for s in sc]; t = sum(exps) or 1.0; return [e/t for e in exps]
+
+class ActionSampler:
+    def __init__(self, mode: str = "greedy", temperature: float = 1.0, top_k: int = 5, beam_width: int = 3) -> None:
+        self.mode = mode; self.temperature = temperature; self.top_k = top_k; self.beam_width = beam_width
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+    def sample(self, logits: List[float]) -> int:
+        if not logits: raise ValueError("Cannot sample from empty logits")
+        if self.mode == "greedy": a = max(range(len(logits)), key=lambda i: logits[i])
+        elif self.mode == "temperature": a = self._temp(logits)
+        elif self.mode == "topk": a = self._topk(logits)
+        else: a = max(range(len(logits)), key=lambda i: logits[i])
+        self._fire({"event": "action_sampled", "mode": self.mode, "action": a}); return a
+    def _temp(self, logits: List[float]) -> int:
+        probs = _softmax(logits, self.temperature); r = random.random(); c = 0.0
+        for i, p in enumerate(probs):
+            c += p
+            if c >= r: return i
+        return len(probs)-1
+    def _topk(self, logits: List[float]) -> int:
+        indexed = sorted(enumerate(logits), key=lambda x: -x[1]); top = indexed[:self.top_k]
+        tl = [x[1] for x in top]; ti = [x[0] for x in top]; probs = _softmax(tl, self.temperature); r = random.random(); c = 0.0
+        for i, p in enumerate(probs):
+            c += p
+            if c >= r: return ti[i]
+        return ti[-1]
+    def beam_search(self, logits_seq: List[List[float]]) -> List[int]:
+        if not logits_seq: return []
+        beams = [(0.0, [])]
+        for logits in logits_seq:
+            cands = []; probs = _softmax(logits, self.temperature)
+            for sc, seq in beams:
+                for i, p in enumerate(probs): cands.append((sc+math.log(p+1e-10), seq+[i]))
+            cands.sort(key=lambda x: -x[0]); beams = cands[:self.beam_width]
+        return beams[0][1] if beams else []
+    def set_mode(self, mode: str, **kw: Any) -> None:
+        self.mode = mode
+        if "temperature" in kw: self.temperature = kw["temperature"]
+        if "top_k" in kw: self.top_k = kw["top_k"]
+    def get_probabilities(self, logits: List[float], temperature: float = 1.0) -> List[float]: return _softmax(logits, temperature)
+    def _fire(self, payload: Dict[str, Any]) -> None:
+        if self.evolution_callback:
+            try: self.evolution_callback({"source": _EVOLUTION_KEY, "timestamp": time.time(), **payload})
+            except Exception as e: logger.warning("cb: %s", e)
