+"""Distributed Training Coordinator — Parameter server + fault detection. Ref: DI-star ctools/worker/, client_server.py"""
+from __future__ import annotations
+import logging, time
+from collections import defaultdict
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "agentos.governance.distributed_training_coordinator.v1"
+
+class DistributedTrainingCoordinator:
+    def __init__(self, heartbeat_timeout: float = 30.0) -> None:
+        self.heartbeat_timeout = heartbeat_timeout; self._workers: Dict[str, Dict[str, Any]] = {}
+        self._pending_gradients: List[Dict[str, Any]] = []; self._current_params: Dict[str, List[float]] = {}
+        self._tasks: Dict[str, List[str]] = defaultdict(list); self.evolution_callback: Optional[Callable[[Dict], None]] = None
+    @property
+    def worker_count(self) -> int: return len(self._workers)
+    @property
+    def pending_gradient_count(self) -> int: return len(self._pending_gradients)
+    def register_worker(self, worker_id: str, capacity: float = 1.0) -> None:
+        self._workers[worker_id] = {"capacity": capacity, "last_heartbeat": time.time(), "params": None, "status": "active"}
+        self._fire({"event": "worker_registered", "worker_id": worker_id})
+    def remove_worker(self, wid: str) -> None: self._workers.pop(wid, None); self._tasks.pop(wid, None)
+    def heartbeat(self, wid: str) -> None:
+        if wid in self._workers: self._workers[wid]["last_heartbeat"] = time.time()
+    def submit_gradients(self, wid: str, gradients: Dict[str, List[float]]) -> None:
+        self._pending_gradients.append({"worker_id": wid, "gradients": gradients, "timestamp": time.time()})
+    def aggregate_gradients(self) -> Dict[str, List[float]]:
+        if not self._pending_gradients: return {}
+        all_keys = set(); [all_keys.update(pg["gradients"].keys()) for pg in self._pending_gradients]
+        agg = {}
+        for key in all_keys:
+            vecs = [pg["gradients"][key] for pg in self._pending_gradients if key in pg["gradients"]]
+            if not vecs: continue
+            dim = max(len(v) for v in vecs); avg = [0.0]*dim
+            for v in vecs:
+                for i in range(min(len(v), dim)): avg[i] += v[i]
+            agg[key] = [x/len(vecs) for x in avg]
+        self._pending_gradients.clear(); return agg
+    def broadcast_params(self, params: Dict[str, List[float]]) -> None:
+        self._current_params = {k: list(v) for k, v in params.items()}
+        for wid in self._workers: self._workers[wid]["params"] = {k: list(v) for k, v in params.items()}
+    def get_worker_params(self, wid: str): return self._workers[wid].get("params") if wid in self._workers else None
+    def detect_failed_workers(self, current_time: Optional[float] = None) -> List[str]:
+        now = current_time if current_time is not None else time.time()
+        return [wid for wid, info in self._workers.items() if now - info["last_heartbeat"] > self.heartbeat_timeout]
+    def assign_task(self, wid: str, task_id: str) -> None: self._tasks[wid].append(task_id)
+    def reassign_task(self, task_id: str, from_worker: str, to_worker: str) -> None:
+        if from_worker in self._tasks: self._tasks[from_worker] = [t for t in self._tasks[from_worker] if t != task_id]
+        self._tasks[to_worker].append(task_id)
+    def get_tasks(self, wid: str) -> List[str]: return list(self._tasks.get(wid, []))
+    def get_cluster_status(self) -> Dict[str, Any]:
+        return {"total_workers": len(self._workers), "total_capacity": sum(w["capacity"] for w in self._workers.values()), "pending_gradients": len(self._pending_gradients)}
+    def _fire(self, payload):
+        if self.evolution_callback:
+            try: self.evolution_callback({"source": _EVOLUTION_KEY, "timestamp": time.time(), **payload})
+            except: pass
