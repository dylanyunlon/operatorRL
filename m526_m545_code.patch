@@ -0,0 +1,51 @@
+"""Policy Gradient Trainer — PPO/REINFORCE + GAE. Ref: multi_game_ppo.py, lol_trainer.py"""
+from __future__ import annotations
+import logging, time
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "agentlightning.trainer.policy_gradient_trainer.v1"
+
+class PolicyGradientTrainer:
+    def __init__(self, mode: str = "ppo", lr: float = 3e-4, gamma: float = 0.99, gae_lambda: float = 0.95, clip_eps: float = 0.2) -> None:
+        self.mode = mode; self.lr = lr; self.gamma = gamma; self.gae_lambda = gae_lambda; self.clip_eps = clip_eps
+        self.global_step: int = 0; self._total_loss: float = 0.0; self._metrics_buffer: List[Dict[str, Any]] = []
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+    def train_step(self, batch: Dict[str, Any]) -> Dict[str, Any]:
+        if not batch or "rewards" not in batch: raise ValueError("Batch must contain 'rewards'")
+        rewards = batch["rewards"]; lp = batch.get("log_probs", [-1.0]*len(rewards)); vals = batch.get("values", [0.0]*len(rewards))
+        dones = batch.get("dones", [False]*len(rewards)); adv = self.compute_gae(rewards, vals + [0.0], dones)
+        rets = [a + v for a, v in zip(adv, vals)]
+        if self.mode == "ppo":
+            ratios = [1.0 + 0.01*l for l in lp]; loss = self._compute_ppo_loss(ratios, adv)
+        elif self.mode == "reinforce": loss = self._compute_reinforce_loss(lp, rets)
+        else: loss = sum(abs(r) for r in rewards) / max(len(rewards), 1)
+        self.global_step += 1; self._total_loss += loss
+        metrics = {"loss": loss, "step": self.global_step, "mode": self.mode, "batch_size": len(rewards), "avg_reward": sum(rewards)/max(len(rewards),1), "avg_advantage": sum(adv)/max(len(adv),1)}
+        self._metrics_buffer.append(metrics); self._fire({"event": "train_step", **metrics}); return metrics
+    def compute_gae(self, rewards: List[float], values: List[float], dones: Optional[List[bool]] = None) -> List[float]:
+        n = len(rewards); dones = dones or [False]*n; adv = [0.0]*n; last = 0.0
+        for t in reversed(range(n)):
+            nv = values[t+1] if t+1 < len(values) else 0.0; mask = 0.0 if (t < len(dones) and dones[t]) else 1.0
+            delta = rewards[t] + self.gamma * nv * mask - values[t]; last = delta + self.gamma * self.gae_lambda * mask * last; adv[t] = last
+        return adv
+    def _compute_ppo_loss(self, ratios: List[float], advantages: List[float]) -> float:
+        if not ratios: return 0.0
+        t = 0.0
+        for r, a in zip(ratios, advantages):
+            cl = max(min(r, 1.0+self.clip_eps), 1.0-self.clip_eps); t += -min(r*a, cl*a)
+        return t / len(ratios)
+    def _compute_reinforce_loss(self, log_probs: List[float], returns: List[float]) -> float:
+        if not log_probs: return 0.0
+        return sum(-lp*r for lp, r in zip(log_probs, returns)) / len(log_probs)
+    def set_mode(self, mode: str) -> None: self.mode = mode
+    def save_checkpoint(self) -> Dict[str, Any]:
+        return {"global_step": self.global_step, "mode": self.mode, "lr": self.lr, "gamma": self.gamma, "gae_lambda": self.gae_lambda, "clip_eps": self.clip_eps, "total_loss": self._total_loss}
+    def load_checkpoint(self, ckpt: Dict[str, Any]) -> None:
+        self.global_step = ckpt.get("global_step", 0); self.mode = ckpt.get("mode", self.mode); self.lr = ckpt.get("lr", self.lr)
+        self.gamma = ckpt.get("gamma", self.gamma); self.gae_lambda = ckpt.get("gae_lambda", self.gae_lambda)
+        self.clip_eps = ckpt.get("clip_eps", self.clip_eps); self._total_loss = ckpt.get("total_loss", 0.0)
+    def get_metrics(self) -> Dict[str, Any]: return {"global_step": self.global_step, "mode": self.mode, "avg_loss": self._total_loss / max(self.global_step, 1)}
+    def _fire(self, payload: Dict[str, Any]) -> None:
+        if self.evolution_callback:
+            try: self.evolution_callback({"source": _EVOLUTION_KEY, "timestamp": time.time(), **payload})
+            except Exception as e: logger.warning("cb err: %s", e)
