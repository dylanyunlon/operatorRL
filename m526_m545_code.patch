@@ -0,0 +1,93 @@
+"""
+RL Reward Designer — Dynamic multi-dimensional reward shaping.
+Location: agentlightning/trainer/rl_reward_designer.py
+Reference: DI-star/rl_learner.py ReinforcementLoss, integrations/lol/reward_shaper.py
+"""
+from __future__ import annotations
+import logging, math, time
+from collections import defaultdict
+from typing import Any, Callable, Dict, List, Optional, Tuple
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "agentlightning.trainer.rl_reward_designer.v1"
+
+def _clamp(v: float, lo: float, hi: float) -> float:
+    return max(lo, min(hi, v))
+
+def _normalize(v: float, lo: float, hi: float) -> float:
+    if hi <= lo: return 0.0
+    return _clamp((v - lo) / (hi - lo), 0.0, 1.0)
+
+def _softmax_weights(scores: Dict[str, float]) -> Dict[str, float]:
+    if not scores: return {}
+    mx = max(scores.values())
+    exps = {k: math.exp(v - mx) for k, v in scores.items()}
+    t = sum(exps.values()) or 1.0
+    return {k: v / t for k, v in exps.items()}
+
+class RlRewardDesigner:
+    """Dynamic multi-dimensional reward designer with weakness-driven auto-adjustment."""
+    def __init__(self) -> None:
+        self.dimensions: Dict[str, Dict[str, Any]] = {}
+        self._game_index: Dict[str, List[str]] = defaultdict(list)
+        self._reward_history: List[Dict[str, Any]] = []
+        self._weight_history: List[Dict[str, float]] = []
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+
+    def register_dimension(self, name: str, weight: float = 1.0, bounds: Tuple[float, float] = (0.0, 1.0), game: str = "_global") -> None:
+        key = f"{game}::{name}" if game != "_global" else name
+        self.dimensions[key] = {"name": name, "weight": weight, "bounds": bounds, "game": game}
+        self._game_index[game].append(key)
+
+    def compute_reward(self, raw_values: Dict[str, float], game: str = "_global") -> float:
+        total_w, weighted_sum = 0.0, 0.0
+        for key, dim in self.dimensions.items():
+            dn = dim["name"]
+            if dn not in raw_values: continue
+            if dim["game"] not in ("_global", game): continue
+            lo, hi = dim["bounds"]
+            normed = _normalize(raw_values[dn], lo, hi)
+            w = dim["weight"]
+            weighted_sum += normed * w
+            total_w += w
+        reward = _clamp(weighted_sum / total_w if total_w > 0 else 0.0, 0.0, 1.0)
+        self._reward_history.append({"reward": reward, "raw": dict(raw_values), "game": game, "timestamp": time.time()})
+        self._fire_evolution({"event": "reward_computed", "reward": reward, "game": game})
+        return reward
+
+    def adjust_weights(self, performance: Dict[str, float], adjustment_rate: float = 0.3) -> None:
+        if not performance: return
+        inv_scores: Dict[str, float] = {}
+        for key, dim in self.dimensions.items():
+            if dim["name"] in performance:
+                inv_scores[key] = 1.0 / _clamp(performance[dim["name"]], 0.01, 1.0)
+        if not inv_scores: return
+        target_dist = _softmax_weights(inv_scores)
+        total_current = sum(self.dimensions[k]["weight"] for k in inv_scores) or 1.0
+        for key in inv_scores:
+            cur_w = self.dimensions[key]["weight"]
+            tgt_w = target_dist[key] * total_current * len(inv_scores)
+            self.dimensions[key]["weight"] = max(cur_w * (1 - adjustment_rate) + tgt_w * adjustment_rate, 0.01)
+        self._weight_history.append(self.get_weight_snapshot())
+        self._fire_evolution({"event": "weights_adjusted", "new_weights": self.get_weight_snapshot()})
+
+    def list_games(self) -> List[str]:
+        return [g for g in self._game_index if g != "_global"]
+
+    def get_weight_snapshot(self) -> Dict[str, float]:
+        return {(d["name"] if d["game"] == "_global" else f"{d['game']}::{d['name']}"): d["weight"] for k, d in self.dimensions.items()}
+
+    def global_weight_sum(self) -> float:
+        return sum(d["weight"] for d in self.dimensions.values())
+
+    def save_checkpoint(self) -> Dict[str, Any]:
+        return {"dimensions": {k: dict(v) for k, v in self.dimensions.items()}, "game_index": {k: list(v) for k, v in self._game_index.items()}}
+
+    def load_checkpoint(self, ckpt: Dict[str, Any]) -> None:
+        self.dimensions = {k: dict(v) for k, v in ckpt.get("dimensions", {}).items()}
+        self._game_index = defaultdict(list)
+        for k, v in ckpt.get("game_index", {}).items(): self._game_index[k] = list(v)
+
+    def _fire_evolution(self, payload: Dict[str, Any]) -> None:
+        if self.evolution_callback:
+            try: self.evolution_callback({"source": _EVOLUTION_KEY, "timestamp": time.time(), **payload})
+            except Exception as exc: logger.warning("Evolution callback error: %s", exc)
