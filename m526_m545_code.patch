+"""Meta-Learning Optimizer — MAML/Reptile. Ref: DI-star rl_learner.py optimizer, lol_trainer.py"""
+from __future__ import annotations
+import logging, math, time
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "agentlightning.trainer.meta_learning_optimizer.v1"
+
+class MetaLearningOptimizer:
+    def __init__(self, mode: str = "maml", inner_steps: int = 5, inner_lr: float = 0.01, meta_lr: float = 0.001) -> None:
+        self.mode = mode; self.inner_steps = inner_steps; self.inner_lr = inner_lr; self.meta_lr = meta_lr
+        self._meta_params: Dict[str, List[float]] = {}; self.tasks: Dict[str, List[Dict[str, Any]]] = {}
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+    def set_meta_params(self, params: Dict[str, List[float]]) -> None: self._meta_params = {k: list(v) for k, v in params.items()}
+    def get_meta_params(self) -> Dict[str, List[float]]: return {k: list(v) for k, v in self._meta_params.items()}
+    def register_task(self, name: str, data: List[Dict[str, Any]]) -> None: self.tasks[name] = data
+    def inner_adapt(self, task_name: str) -> Dict[str, List[float]]:
+        if task_name not in self.tasks: return dict(self._meta_params)
+        data = self.tasks[task_name]; adapted = {k: list(v) for k, v in self._meta_params.items()}
+        for _ in range(self.inner_steps):
+            for sample in data:
+                s = sample.get("s", sample.get("state", [0.0])); r = sample.get("r", sample.get("reward", 0.0))
+                if not isinstance(s, list): s = [s]
+                for key in adapted:
+                    for i in range(len(adapted[key])):
+                        si = s[i % len(s)] if s else 0.0; adapted[key][i] -= self.inner_lr * (-r * si * 0.1)
+        return adapted
+    def meta_update(self, task_names: List[str]) -> Dict[str, Any]:
+        if not task_names or not self._meta_params: return {"meta_loss": 0.0}
+        if self.mode == "maml": return self._maml(task_names)
+        elif self.mode == "reptile": return self._reptile(task_names)
+        return {"meta_loss": 0.0}
+    def _maml(self, tasks: List[str]) -> Dict[str, Any]:
+        mg = {k: [0.0]*len(v) for k, v in self._meta_params.items()}; tl = 0.0
+        for t in tasks:
+            ad = self.inner_adapt(t)
+            for k in self._meta_params:
+                for i in range(len(self._meta_params[k])): d = ad[k][i]-self._meta_params[k][i]; mg[k][i] += d; tl += d**2
+        n = max(len(tasks),1)
+        for k in self._meta_params:
+            for i in range(len(self._meta_params[k])): self._meta_params[k][i] += self.meta_lr * mg[k][i] / n
+        m = {"meta_loss": tl/n, "tasks": len(tasks)}; self._fire({"event": "meta_update", **m}); return m
+    def _reptile(self, tasks: List[str]) -> Dict[str, Any]:
+        tl = 0.0
+        for t in tasks:
+            ad = self.inner_adapt(t)
+            for k in self._meta_params:
+                for i in range(len(self._meta_params[k])): d = ad[k][i]-self._meta_params[k][i]; self._meta_params[k][i] += self.meta_lr*d; tl += d**2
+        n = max(len(tasks),1); m = {"meta_loss": tl/n, "tasks": len(tasks)}; self._fire({"event": "meta_update", **m}); return m
+    def adaptation_distance(self, task_name: str) -> float:
+        ad = self.inner_adapt(task_name); d = 0.0
+        for k in self._meta_params:
+            for i in range(len(self._meta_params[k])): d += (ad[k][i]-self._meta_params[k][i])**2
+        return math.sqrt(d)
+    def save_checkpoint(self) -> Dict[str, Any]: return {"mode": self.mode, "inner_steps": self.inner_steps, "inner_lr": self.inner_lr, "meta_lr": self.meta_lr, "meta_params": {k: list(v) for k, v in self._meta_params.items()}}
+    def load_checkpoint(self, ckpt: Dict[str, Any]) -> None:
+        self.mode = ckpt.get("mode",self.mode); self.inner_steps = ckpt.get("inner_steps",self.inner_steps); self.inner_lr = ckpt.get("inner_lr",self.inner_lr); self.meta_lr = ckpt.get("meta_lr",self.meta_lr)
+        self._meta_params = {k: list(v) for k, v in ckpt.get("meta_params",{}).items()}
+    def _fire(self, payload: Dict[str, Any]) -> None:
+        if self.evolution_callback:
+            try: self.evolution_callback({"source": _EVOLUTION_KEY, "timestamp": time.time(), **payload})
+            except Exception as e: logger.warning("cb: %s", e)
