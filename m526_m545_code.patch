+"""Imitation Learning Pipeline — BC + DAgger. Ref: DI-star replay_decoder.py, distar_adapter.py"""
+from __future__ import annotations
+import logging, random, time
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "agentlightning.trainer.imitation_learning_pipeline.v1"
+
+class ImitationLearningPipeline:
+    def __init__(self, mode: str = "bc", lr: float = 1e-3, initial_mix_ratio: float = 1.0, decay_rate: float = 0.05) -> None:
+        self.mode = mode; self.lr = lr; self.initial_mix_ratio = initial_mix_ratio; self.current_mix_ratio = initial_mix_ratio; self.decay_rate = decay_rate
+        self.global_step: int = 0; self._total_loss: float = 0.0; self._expert_trajectories: List[List[Dict[str, Any]]] = []
+        self._weights: List[float] = []; self._initialized: bool = False; self.evolution_callback: Optional[Callable[[Dict], None]] = None
+    @property
+    def expert_count(self) -> int: return len(self._expert_trajectories)
+    def add_expert_trajectory(self, traj: List[Dict[str, Any]]) -> None: self._expert_trajectories.append(traj)
+    def extract_features(self, raw: Dict[str, Any]) -> Dict[str, Any]: return {"state": raw.get("state", []), "action": raw.get("action", 0)}
+    def train_step(self) -> Dict[str, Any]:
+        if not self._expert_trajectories: raise ValueError("No expert trajectories")
+        pairs = [self.extract_features(s) for t in self._expert_trajectories for s in t]
+        if not pairs: return {"loss": 0.0, "step": self.global_step}
+        batch = random.sample(pairs, min(32, len(pairs))); loss = 0.0
+        for p in batch:
+            s, a = p["state"], p["action"]
+            if not self._initialized and s:
+                d = len(s) if isinstance(s, list) else 1; self._weights = [0.01]*d; self._initialized = True
+            pred = sum(w*x for w, x in zip(self._weights, s)) if self._initialized and isinstance(s, list) else 0.0
+            loss += (pred - float(a))**2
+        loss /= max(len(batch), 1)
+        if self._initialized:
+            for p in batch:
+                s, a = p["state"], p["action"]
+                if isinstance(s, list):
+                    pred = sum(w*x for w, x in zip(self._weights, s)); err = pred - float(a)
+                    for j in range(len(self._weights)):
+                        if j < len(s): self._weights[j] -= self.lr * 2 * err * s[j] / len(batch)
+        if self.mode == "dagger": self.current_mix_ratio = max(0.0, self.current_mix_ratio - self.decay_rate)
+        self.global_step += 1; self._total_loss += loss
+        metrics = {"loss": loss, "step": self.global_step, "mode": self.mode, "mix_ratio": self.current_mix_ratio}
+        self._fire({"event": "train_step", **metrics}); return metrics
+    def save_checkpoint(self) -> Dict[str, Any]:
+        return {"global_step": self.global_step, "mode": self.mode, "lr": self.lr, "mix_ratio": self.current_mix_ratio, "weights": list(self._weights), "total_loss": self._total_loss}
+    def load_checkpoint(self, ckpt: Dict[str, Any]) -> None:
+        self.global_step = ckpt.get("global_step",0); self.mode = ckpt.get("mode",self.mode); self._weights = list(ckpt.get("weights",[])); self._total_loss = ckpt.get("total_loss",0.0); self._initialized = bool(self._weights)
+    def get_metrics(self) -> Dict[str, Any]: return {"global_step": self.global_step, "mode": self.mode, "avg_loss": self._total_loss/max(self.global_step,1)}
+    def _fire(self, payload: Dict[str, Any]) -> None:
+        if self.evolution_callback:
+            try: self.evolution_callback({"source": _EVOLUTION_KEY, "timestamp": time.time(), **payload})
+            except Exception as e: logger.warning("cb: %s", e)
