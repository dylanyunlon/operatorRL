+"""Self-Play Arena — Tournament with Elo. Ref: self_play_scheduler.py"""
+from __future__ import annotations
+import logging, time
+from typing import Any, Callable, Dict, List, Optional, Tuple
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "agentlightning.trainer.self_play_arena.v1"
+_K = 32.0
+
+class SelfPlayArena:
+    def __init__(self, mode: str = "round_robin") -> None:
+        self.mode = mode; self._policies: Dict[str, float] = {}; self.match_history: List[Dict[str, Any]] = []; self._trajectories: List[Dict[str, Any]] = []
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+    @property
+    def pool_size(self) -> int: return len(self._policies)
+    def add_policy(self, pid: str, elo: float = 1000.0) -> None: self._policies[pid] = elo
+    def get_elo(self, pid: str) -> float: return self._policies.get(pid, 0.0)
+    def get_rankings(self) -> List[Tuple[str, float]]: return sorted(self._policies.items(), key=lambda x: -x[1])
+    def schedule_round(self) -> List[Dict[str, str]]:
+        ids = list(self._policies.keys())
+        if len(ids) < 2: return []
+        if self.mode == "round_robin": return [{"player_a": ids[i], "player_b": ids[j]} for i in range(len(ids)) for j in range(i+1, len(ids))]
+        elif self.mode == "elimination":
+            si = [p for p, _ in self.get_rankings()]; return [{"player_a": si[i], "player_b": si[i+1]} for i in range(0, len(si)-1, 2)]
+        return []
+    def record_result(self, player_a: str, player_b: str, winner: str, trajectory: Optional[List[Dict[str, Any]]] = None) -> None:
+        ea_r, eb_r = self._policies.get(player_a,1000), self._policies.get(player_b,1000)
+        ea = 1.0/(1.0+10**((eb_r-ea_r)/400.0)); sa = 1.0 if winner == player_a else 0.0
+        self._policies[player_a] = ea_r + _K*(sa-ea); self._policies[player_b] = eb_r + _K*((1-sa)-(1-ea))
+        rec = {"player_a": player_a, "player_b": player_b, "winner": winner, "elo_a_after": self._policies[player_a], "elo_b_after": self._policies[player_b], "timestamp": time.time()}
+        self.match_history.append(rec)
+        if trajectory: self._trajectories.append({"match": rec, "trajectory": trajectory})
+        self._fire({"event": "result_recorded", **rec})
+    def get_trajectories(self) -> List[Dict[str, Any]]: return list(self._trajectories)
+    def _fire(self, payload: Dict[str, Any]) -> None:
+        if self.evolution_callback:
+            try: self.evolution_callback({"source": _EVOLUTION_KEY, "timestamp": time.time(), **payload})
+            except Exception as e: logger.warning("cb: %s", e)
