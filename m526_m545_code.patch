+"""Experience Replay Manager — PER + HER. Ref: experience_store.py, DI-star data_helper.py"""
+from __future__ import annotations
+import logging, random, time
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "agentlightning.trainer.experience_replay_manager.v1"
+
+class ExperienceReplayManager:
+    def __init__(self, capacity: int = 10000, alpha: float = 0.6, beta: float = 0.4) -> None:
+        self.capacity = capacity; self.alpha = alpha; self.beta = beta
+        self._buffer: List[Dict[str, Any]] = []; self._priorities: List[float] = []
+        self._max_priority: float = 1.0; self.evolution_callback: Optional[Callable[[Dict], None]] = None
+    def __len__(self) -> int: return len(self._buffer)
+    def add(self, state: Any, action: Any, reward: float, next_state: Any, done: bool, td_error: float = 1.0, **extra: Any) -> None:
+        entry = {"state": state, "action": action, "reward": reward, "next_state": next_state, "done": done, "td_error": abs(td_error), **extra}
+        priority = (abs(td_error) + 1e-6) ** self.alpha
+        if len(self._buffer) >= self.capacity: self._buffer.pop(0); self._priorities.pop(0)
+        self._buffer.append(entry); self._priorities.append(priority)
+        self._max_priority = max(self._max_priority, priority)
+        self._fire({"event": "experience_added", "size": len(self._buffer)})
+    def prioritized_sample(self, batch_size: int) -> List[Dict[str, Any]]:
+        if not self._buffer: return []
+        n = min(batch_size, len(self._buffer)); total_p = sum(self._priorities)
+        if total_p <= 0: return random.sample(self._buffer, n)
+        probs = [p / total_p for p in self._priorities]; indices = []
+        for _ in range(n):
+            r = random.random(); cumsum = 0.0
+            for i, p in enumerate(probs):
+                cumsum += p
+                if cumsum >= r: indices.append(i); break
+            else: indices.append(len(probs) - 1)
+        return [self._buffer[i] for i in indices]
+    def uniform_sample(self, batch_size: int) -> List[Dict[str, Any]]:
+        n = min(batch_size, len(self._buffer)); return random.sample(self._buffer, n) if n else []
+    def update_priority(self, index: int, new_td_error: float) -> None:
+        if 0 <= index < len(self._buffer):
+            self._buffer[index]["td_error"] = abs(new_td_error)
+            self._priorities[index] = (abs(new_td_error) + 1e-6) ** self.alpha
+            self._max_priority = max(self._max_priority, self._priorities[index])
+    def get_priority(self, index: int) -> float: return self._priorities[index] if 0 <= index < len(self._priorities) else 0.0
+    def her_relabel(self, trajectory: List[Dict[str, Any]], achieved_goal: str, success_reward: float = 1.0) -> List[Dict[str, Any]]:
+        relabeled = []
+        for i, step in enumerate(trajectory):
+            ns = dict(step); ns["goal"] = achieved_goal
+            if i == len(trajectory) - 1: ns["reward"] = success_reward
+            relabeled.append(ns)
+        return relabeled
+    def get_statistics(self) -> Dict[str, Any]:
+        if not self._buffer: return {"size": 0, "mean_td_error": 0.0, "max_td_error": 0.0}
+        td = [e["td_error"] for e in self._buffer]
+        return {"size": len(self._buffer), "mean_td_error": sum(td)/len(td), "max_td_error": max(td), "min_td_error": min(td)}
+    def _fire(self, payload: Dict[str, Any]) -> None:
+        if self.evolution_callback:
+            try: self.evolution_callback({"source": _EVOLUTION_KEY, "timestamp": time.time(), **payload})
+            except Exception as exc: logger.warning("cb err: %s", exc)
