@@ -0,0 +1,49 @@
+"""Value Network Trainer — TD(lambda) value approximation. Ref: DI-star rl_learner.py"""
+from __future__ import annotations
+import logging, time
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "agentlightning.trainer.value_network_trainer.v1"
+
+class ValueNetworkTrainer:
+    def __init__(self, lr: float = 1e-3, gamma: float = 0.99, td_lambda: float = 0.95, hidden_dim: int = 64) -> None:
+        self.lr = lr; self.gamma = gamma; self.td_lambda = td_lambda; self.hidden_dim = hidden_dim
+        self.global_step: int = 0; self._total_loss: float = 0.0
+        self._weights: List[float] = []; self._bias: float = 0.0; self._initialized: bool = False
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+    def _ensure_init(self, dim: int) -> None:
+        if not self._initialized or len(self._weights) != dim: self._weights = [0.01]*dim; self._bias = 0.0; self._initialized = True
+    def predict(self, states: List[List[float]]) -> List[float]:
+        if not states: return []
+        self._ensure_init(len(states[0]))
+        return [sum(w*x for w, x in zip(self._weights, s)) + self._bias for s in states]
+    def train_step(self, batch: Dict[str, Any]) -> Dict[str, Any]:
+        if not batch or "states" not in batch or "td_targets" not in batch: raise ValueError("Batch must contain 'states' and 'td_targets'")
+        states, targets = batch["states"], batch["td_targets"]
+        if not states: return {"value_loss": 0.0, "step": self.global_step}
+        dim = len(states[0]); self._ensure_init(dim); preds = self.predict(states)
+        loss = sum((p-t)**2 for p, t in zip(preds, targets)) / len(states)
+        for i in range(len(states)):
+            err = preds[i] - targets[i]
+            for j in range(dim): self._weights[j] -= self.lr * 2.0 * err * states[i][j] / len(states)
+            self._bias -= self.lr * 2.0 * err / len(states)
+        self.global_step += 1; self._total_loss += loss
+        metrics = {"value_loss": loss, "step": self.global_step, "batch_size": len(states)}
+        self._fire({"event": "train_step", **metrics}); return metrics
+    def compute_td_lambda_targets(self, rewards: List[float], values: List[float]) -> List[float]:
+        n = len(rewards); targets = [0.0]*n; last = 0.0
+        for t in reversed(range(n)):
+            nv = values[t+1] if t+1 < len(values) else 0.0
+            td_t = rewards[t] + self.gamma * nv; last = td_t * (1-self.td_lambda) + (rewards[t] + self.gamma * last) * self.td_lambda; targets[t] = last
+        return targets
+    def get_prediction_errors(self, states: List[List[float]], targets: List[float]) -> List[float]:
+        preds = self.predict(states); return [abs(p-t) for p, t in zip(preds, targets)]
+    def save_checkpoint(self) -> Dict[str, Any]:
+        return {"global_step": self.global_step, "lr": self.lr, "gamma": self.gamma, "td_lambda": self.td_lambda, "weights": list(self._weights), "bias": self._bias, "total_loss": self._total_loss}
+    def load_checkpoint(self, ckpt: Dict[str, Any]) -> None:
+        self.global_step = ckpt.get("global_step",0); self.lr = ckpt.get("lr",self.lr); self._weights = list(ckpt.get("weights",[])); self._bias = ckpt.get("bias",0.0)
+        self._total_loss = ckpt.get("total_loss",0.0); self._initialized = bool(self._weights)
+    def _fire(self, payload: Dict[str, Any]) -> None:
+        if self.evolution_callback:
+            try: self.evolution_callback({"source": _EVOLUTION_KEY, "timestamp": time.time(), **payload})
+            except Exception as e: logger.warning("cb: %s", e)
