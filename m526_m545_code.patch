+"""Training Checkpoint Manager — Auto-save + A/B compare. Ref: model_versioner.py"""
+from __future__ import annotations
+import logging, time
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "agentlightning.trainer.training_checkpoint_manager.v1"
+
+class TrainingCheckpointManager:
+    def __init__(self, auto_save_interval: int = 0) -> None:
+        self.auto_save_interval = auto_save_interval; self._store: Dict[str, List[Dict[str, Any]]] = {}
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+    def checkpoint_count(self) -> int: return sum(len(v) for v in self._store.values())
+    def save(self, run_id: str, step: int, data: Dict[str, Any]) -> None:
+        if run_id not in self._store: self._store[run_id] = []
+        self._store[run_id].append({"step": step, "data": data, "saved_at": time.time()})
+        self._fire({"event": "checkpoint_saved", "run_id": run_id, "step": step})
+    def load(self, run_id: str, step: int) -> Dict[str, Any]:
+        if run_id not in self._store: raise KeyError(f"Run '{run_id}' not found")
+        for e in self._store[run_id]:
+            if e["step"] == step: return e["data"]
+        raise KeyError(f"Step {step} not found for run '{run_id}'")
+    def load_latest(self, run_id: str) -> Dict[str, Any]:
+        if run_id not in self._store or not self._store[run_id]: raise KeyError(f"Run '{run_id}' not found or empty")
+        return self._store[run_id][-1]["data"]
+    def list_checkpoints(self, run_id: str) -> List[int]: return [e["step"] for e in self._store.get(run_id, [])]
+    def delete(self, run_id: str, step: int) -> None:
+        if run_id in self._store: self._store[run_id] = [e for e in self._store[run_id] if e["step"] != step]
+    def maybe_save(self, run_id: str, step: int, data: Dict[str, Any]) -> bool:
+        if self.auto_save_interval <= 0: return False
+        if step % self.auto_save_interval == 0: self.save(run_id, step, data); return True
+        return False
+    def ab_compare(self, run_id: str, step_a: int, step_b: int, eval_fn) -> Dict[str, Any]:
+        da, db = self.load(run_id, step_a), self.load(run_id, step_b); sa, sb = eval_fn(da), eval_fn(db)
+        return {"step_a": step_a, "score_a": sa, "step_b": step_b, "score_b": sb, "winner_step": step_a if sa >= sb else step_b}
+    def _fire(self, payload: Dict[str, Any]) -> None:
+        if self.evolution_callback:
+            try: self.evolution_callback({"source": _EVOLUTION_KEY, "timestamp": time.time(), **payload})
+            except Exception as e: logger.warning("cb: %s", e)
