+"""Evolution Fitness Landscape — Multi-dim landscape + plateau detection. Ref: fitness_aggregator.py"""
+from __future__ import annotations
+import logging, math, time
+from collections import defaultdict
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "agentos.governance.evolution_fitness_landscape.v1"
+
+class EvolutionFitnessLandscape:
+    def __init__(self, plateau_window: int = 5, plateau_threshold: float = 0.02) -> None:
+        self.plateau_window = plateau_window; self.plateau_threshold = plateau_threshold
+        self._dimensions: Dict[str, float] = {}; self._history: Dict[str, List[float]] = defaultdict(list)
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+    @property
+    def dimension_count(self) -> int: return len(self._dimensions)
+    def register_dimension(self, name: str, weight: float = 1.0) -> None: self._dimensions[name] = weight
+    def report(self, dimension: str, fitness: float) -> None:
+        clamped = max(0.0, min(1.0, fitness)); self._history[dimension].append(clamped)
+        self._fire({"event": "fitness_reported", "dimension": dimension, "fitness": clamped})
+    def get_history(self, dimension: str) -> List[float]: return list(self._history.get(dimension, []))
+    def build_landscape(self) -> Dict[str, Dict[str, Any]]:
+        return {d: {"latest": self._history.get(d, [0.0])[-1] if self._history.get(d) else 0.0, "weight": self._dimensions[d], "history_len": len(self._history.get(d, []))} for d in self._dimensions}
+    def global_fitness(self) -> float:
+        tw, ws = 0.0, 0.0
+        for d, w in self._dimensions.items():
+            h = self._history.get(d, [])
+            if h: ws += h[-1]*w; tw += w
+        return ws/tw if tw > 0 else 0.0
+    def detect_plateaus(self) -> List[str]:
+        r = []
+        for d in self._dimensions:
+            h = self._history.get(d, [])
+            if len(h) < self.plateau_window: continue
+            win = h[-self.plateau_window:]
+            if max(win) - min(win) < self.plateau_threshold: r.append(d)
+        return r
+    def recommend_evolution_direction(self) -> Dict[str, Any]:
+        if not self._dimensions: return {"dimension": None, "reason": "no dimensions"}
+        worst, wf = None, 2.0
+        for d in self._dimensions:
+            h = self._history.get(d, []); latest = h[-1] if h else 0.0
+            if latest < wf: wf = latest; worst = d
+        return {"dimension": worst, "current_fitness": wf, "reason": "lowest fitness"}
+    def plan_evolution_path(self, target: Dict[str, float]) -> List[Dict[str, Any]]:
+        gaps = []
+        for d, tv in target.items():
+            h = self._history.get(d, []); cur = h[-1] if h else 0.0; gap = tv - cur
+            if gap > 0: gaps.append({"dimension": d, "current": cur, "target": tv, "gap": gap})
+        gaps.sort(key=lambda g: -g["gap"]); return gaps
+    def _fire(self, payload):
+        if self.evolution_callback:
+            try: self.evolution_callback({"source": _EVOLUTION_KEY, "timestamp": time.time(), **payload})
+            except: pass
