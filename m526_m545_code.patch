+"""Training Dashboard — Unified metrics + anomaly detection + trends. Ref: fitness_aggregator.py, evolution_metrics_exporter.py"""
+from __future__ import annotations
+import logging, math, time
+from collections import defaultdict
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "agentos.governance.training_dashboard.v1"
+
+class TrainingDashboard:
+    def __init__(self) -> None: self._metrics: Dict[str, List[Dict[str, Any]]] = defaultdict(list); self.evolution_callback: Optional[Callable[[Dict], None]] = None
+    @property
+    def metric_count(self) -> int: return len(self._metrics)
+    def record(self, name: str, value: float, step: int = 0, timestamp: Optional[float] = None) -> None:
+        ts = timestamp if timestamp is not None else time.time(); self._metrics[name].append({"value": value, "step": step, "timestamp": ts})
+        self._fire({"event": "metric_recorded", "name": name, "value": value, "step": step})
+    def get_history(self, name: str) -> List[Dict[str, Any]]: return list(self._metrics.get(name, []))
+    def query(self, name: str, from_time: Optional[float] = None, to_time: Optional[float] = None) -> List[Dict[str, Any]]:
+        return [e for e in self._metrics.get(name, []) if (from_time is None or e["timestamp"] >= from_time) and (to_time is None or e["timestamp"] <= to_time)]
+    def get_trend(self, name: str) -> str:
+        h = self._metrics.get(name, [])
+        if len(h) < 3: return "insufficient_data"
+        r = [e["value"] for e in h[-5:]]
+        if all(r[i] <= r[i+1] for i in range(len(r)-1)): return "improving"
+        if all(r[i] >= r[i+1] for i in range(len(r)-1)): return "declining"
+        return "stable"
+    def detect_anomalies(self, name: str, z_threshold: float = 3.0) -> List[Dict[str, Any]]:
+        h = self._metrics.get(name, [])
+        if len(h) < 5: return []
+        vals = [e["value"] for e in h]; mean = sum(vals)/len(vals); var = sum((v-mean)**2 for v in vals)/len(vals); std = math.sqrt(var) if var > 0 else 1.0
+        return [{**e, "z_score": abs(e["value"]-mean)/std} for e in h if abs(e["value"]-mean)/std > z_threshold]
+    def generate_report(self, fmt: str = "text") -> Any:
+        data = {}
+        for name, h in self._metrics.items():
+            if not h: continue
+            vals = [e["value"] for e in h]; data[name] = {"count": len(vals), "latest": vals[-1], "mean": sum(vals)/len(vals), "min": min(vals), "max": max(vals), "trend": self.get_trend(name)}
+        if fmt == "json": return data
+        lines = ["=== Training Dashboard Report ==="] + [f"{n}: latest={i['latest']:.4f} mean={i['mean']:.4f} trend={i['trend']} ({i['count']} records)" for n, i in data.items()]
+        return "\n".join(lines)
+    def _fire(self, payload):
+        if self.evolution_callback:
+            try: self.evolution_callback({"source": _EVOLUTION_KEY, "timestamp": time.time(), **payload})
+            except: pass
