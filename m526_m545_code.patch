@@ -0,0 +1,60 @@
+"""Hyperparameter Tuner — Grid/random/bayesian + early stop. Ref: DI-star rl_learner.py cfg, lol_trainer.py"""
+from __future__ import annotations
+import itertools, logging, random, time
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "agentos.governance.hyperparameter_tuner.v1"
+
+class HyperparameterTuner:
+    def __init__(self, strategy: str = "grid", max_trials: int = 20, early_stop_patience: int = 5) -> None:
+        self.strategy = strategy; self.max_trials = max_trials; self.early_stop_patience = early_stop_patience
+        self.search_space: Dict[str, Dict[str, Any]] = {}; self.trial_history: List[Dict[str, Any]] = []
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+    def define_param(self, name: str, values=None, low=None, high=None) -> None: self.search_space[name] = {"values": values, "low": low, "high": high}
+    def generate_configs(self) -> List[Dict[str, Any]]:
+        if self.strategy == "grid": return self._grid()
+        elif self.strategy == "random": return self._rand()
+        elif self.strategy == "bayesian": return [self.suggest_next() for _ in range(self.max_trials)]
+        return []
+    def _grid(self):
+        names = list(self.search_space.keys()); vl = []
+        for n in names:
+            sp = self.search_space[n]
+            if sp["values"]: vl.append(sp["values"])
+            elif sp["low"] is not None and sp["high"] is not None:
+                lo, hi = sp["low"], sp["high"]; vl.append([lo+(hi-lo)*i/4 for i in range(5)])
+            else: vl.append([None])
+        return [dict(zip(names, combo)) for combo in itertools.product(*vl)]
+    def _rand(self):
+        configs = []
+        for _ in range(self.max_trials):
+            c = {}
+            for n, sp in self.search_space.items():
+                if sp["values"]: c[n] = random.choice(sp["values"])
+                elif sp["low"] is not None: c[n] = random.uniform(sp["low"], sp["high"])
+            configs.append(c)
+        return configs
+    def suggest_next(self):
+        c = {}; best = self.get_best_config()
+        for n, sp in self.search_space.items():
+            if sp["low"] is not None:
+                lo, hi = sp["low"], sp["high"]
+                if best and n in best.get("config", {}):
+                    center = best["config"][n]; val = max(lo, min(hi, center + random.gauss(0, (hi-lo)*0.2)))
+                else: val = random.uniform(lo, hi)
+                c[n] = val
+            elif sp["values"]: c[n] = random.choice(sp["values"])
+        return c
+    def record_trial(self, config, score: float, steps: int = 0) -> None:
+        self.trial_history.append({"config": dict(config), "score": score, "steps": steps, "timestamp": time.time()})
+        self._fire({"event": "trial_recorded", "score": score})
+    def get_best_config(self): return max(self.trial_history, key=lambda t: t["score"]) if self.trial_history else None
+    def apply_best(self): best = self.get_best_config(); return dict(best["config"]) if best else {}
+    def should_early_stop(self, config) -> bool:
+        r = self.trial_history[-self.early_stop_patience:]
+        if len(r) < self.early_stop_patience: return False
+        return max(t["score"] for t in r) - min(t["score"] for t in r) < 0.01
+    def _fire(self, payload):
+        if self.evolution_callback:
+            try: self.evolution_callback({"source": _EVOLUTION_KEY, "timestamp": time.time(), **payload})
+            except: pass
