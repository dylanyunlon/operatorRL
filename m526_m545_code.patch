+"""Curriculum Learning Engine — Difficulty progression with retreat. Ref: curriculum_manager.py"""
+from __future__ import annotations
+import logging, time
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "agentlightning.trainer.curriculum_learning_engine.v1"
+
+class CurriculumLearningEngine:
+    def __init__(self, retreat_window: int = 3, retreat_threshold: float = 0.3) -> None:
+        self.current_level: int = 0; self.retreat_window = retreat_window; self.retreat_threshold = retreat_threshold
+        self._levels: List[Dict[str, Any]] = []; self._performance_history: List[Dict[str, Any]] = []; self._consecutive_low: int = 0
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+    @property
+    def level_count(self) -> int: return len(self._levels)
+    def register_level(self, index: int, name: str, threshold: float, **cfg: Any) -> None:
+        entry = {"index": index, "name": name, "threshold": threshold}; entry.update(cfg)
+        while len(self._levels) <= index: self._levels.append({})
+        self._levels[index] = entry
+    def evaluate_and_advance(self, performance: float) -> None:
+        self._performance_history.append({"performance": performance, "level": self.current_level, "timestamp": time.time()})
+        if performance < self.retreat_threshold: self._consecutive_low += 1
+        else: self._consecutive_low = 0
+        if self._consecutive_low >= self.retreat_window and self.current_level > 0:
+            self.current_level -= 1; self._consecutive_low = 0
+            self._fire({"event": "level_retreated", "current_level": self.current_level}); return
+        if self.current_level < len(self._levels):
+            thr = self._levels[self.current_level].get("threshold", 1.0)
+            if performance >= thr and self.current_level < len(self._levels) - 1:
+                self.current_level += 1; self._consecutive_low = 0
+                self._fire({"event": "level_advanced", "current_level": self.current_level})
+    def get_current_config(self) -> Dict[str, Any]:
+        if not self._levels or self.current_level >= len(self._levels): return {}
+        return dict(self._levels[self.current_level])
+    def generate_progress_report(self) -> Dict[str, Any]:
+        return {"current_level": self.current_level, "total_levels": len(self._levels), "history": list(self._performance_history[-20:]), "consecutive_low": self._consecutive_low}
+    def _fire(self, payload: Dict[str, Any]) -> None:
+        if self.evolution_callback:
+            try: self.evolution_callback({"source": _EVOLUTION_KEY, "timestamp": time.time(), **payload})
+            except Exception as e: logger.warning("cb: %s", e)
