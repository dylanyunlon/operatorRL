+"""State Encoder Network — numeric/categorical/sequence. Ref: DI-star model.py, state_encoder.py"""
+from __future__ import annotations
+import logging, time
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "agentlightning.inference.state_encoder_network.v1"
+
+class StateEncoderNetwork:
+    def __init__(self, output_dim: int = 64) -> None:
+        self.output_dim = output_dim; self.features: Dict[str, Dict[str, Any]] = {}
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+    def register_feature(self, name: str, ftype: str = "numeric", input_dim: int = 1, num_categories: int = 10, seq_dim: int = 4) -> None:
+        if ftype == "numeric":
+            w = [[0.01*((i*7+j*13)%17-8)/8.0 for j in range(self.output_dim)] for i in range(input_dim)]
+            self.features[name] = {"ftype": ftype, "input_dim": input_dim, "weights": w}
+        elif ftype == "categorical":
+            t = [[0.01*((i*11+j*3)%19-9)/9.0 for j in range(self.output_dim)] for i in range(num_categories)]
+            self.features[name] = {"ftype": ftype, "num_categories": num_categories, "table": t}
+        elif ftype == "sequence":
+            w = [[0.01*((i*5+j*7)%13-6)/6.0 for j in range(self.output_dim)] for i in range(seq_dim)]
+            self.features[name] = {"ftype": ftype, "seq_dim": seq_dim, "weights": w}
+    def encode(self, state: Dict[str, Any]) -> List[float]:
+        if not self.features: raise ValueError("No features registered")
+        if not state: raise ValueError("Empty state")
+        emb = [0.0]*self.output_dim; count = 0
+        for name, value in state.items():
+            if name not in self.features: continue
+            f = self.features[name]; ft = f["ftype"]
+            if ft == "numeric": sub = self._enc_num(value, f["weights"])
+            elif ft == "categorical": sub = self._enc_cat(value, f["table"])
+            elif ft == "sequence": sub = self._enc_seq(value, f["weights"])
+            else: continue
+            for i in range(self.output_dim): emb[i] += sub[i]
+            count += 1
+        if count > 0: emb = [v/count for v in emb]
+        self._fire({"event": "state_encoded", "features_used": count}); return emb
+    def _enc_num(self, values, weights):
+        if not isinstance(values, list): values = [values]
+        r = [0.0]*self.output_dim
+        for i, v in enumerate(values):
+            if i < len(weights):
+                for j in range(self.output_dim): r[j] += float(v)*weights[i][j]
+        return r
+    def _enc_cat(self, value, table): return list(table[int(value) % len(table)])
+    def _enc_seq(self, values, weights):
+        if not isinstance(values, list) or not values: return [0.0]*self.output_dim
+        sl = len(values); dim = len(values[0]) if isinstance(values[0], list) else 1; avg = [0.0]*dim
+        for step in values:
+            if isinstance(step, list):
+                for k in range(min(dim, len(step))): avg[k] += step[k]
+            else: avg[0] += float(step)
+        avg = [v/sl for v in avg]; r = [0.0]*self.output_dim
+        for i in range(min(dim, len(weights))):
+            for j in range(self.output_dim): r[j] += avg[i]*weights[i][j]
+        return r
+    def detect_feature_type(self, value: Any) -> str:
+        if isinstance(value, int): return "categorical"
+        if isinstance(value, list):
+            if value and isinstance(value[0], list): return "sequence"
+            return "numeric"
+        return "numeric"
+    def save_checkpoint(self) -> Dict[str, Any]: return {"output_dim": self.output_dim, "features": dict(self.features)}
+    def load_checkpoint(self, ckpt: Dict[str, Any]) -> None: self.output_dim = ckpt.get("output_dim", self.output_dim); self.features = dict(ckpt.get("features", {}))
+    def _fire(self, payload: Dict[str, Any]) -> None:
+        if self.evolution_callback:
+            try: self.evolution_callback({"source": _EVOLUTION_KEY, "timestamp": time.time(), **payload})
+            except Exception as e: logger.warning("cb: %s", e)
