+"""Model Registry — Publish/query/load/lineage. Ref: model_versioner.py, registry.py"""
+from __future__ import annotations
+import logging, time
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "agentos.governance.model_registry.v1"
+
+class ModelRegistry:
+    def __init__(self) -> None: self._models: Dict[str, Dict[str, Any]] = {}; self.evolution_callback: Optional[Callable[[Dict], None]] = None
+    @property
+    def model_count(self) -> int: return len(self._models)
+    def publish(self, name: str, game: str, stage: str, elo: float, weights: Dict[str, Any], parent: Optional[str] = None) -> None:
+        self._models[name] = {"name": name, "game": game, "stage": stage, "elo": elo, "weights": weights, "parent": parent, "published_at": time.time()}
+        self._fire({"event": "model_published", "name": name, "game": game, "stage": stage})
+    def query(self, game=None, stage=None, min_elo=None, max_elo=None) -> List[Dict[str, Any]]:
+        r = []
+        for i in self._models.values():
+            if game and i["game"] != game: continue
+            if stage and i["stage"] != stage: continue
+            if min_elo and i["elo"] < min_elo: continue
+            if max_elo and i["elo"] > max_elo: continue
+            r.append(dict(i))
+        return r
+    def load(self, name: str) -> Dict[str, Any]:
+        if name not in self._models: raise KeyError(f"Model '{name}' not found")
+        return self._models[name]["weights"]
+    def get_info(self, name: str) -> Dict[str, Any]:
+        if name not in self._models: raise KeyError(f"Model '{name}' not found")
+        return dict(self._models[name])
+    def set_status(self, name: str, stage: str) -> None:
+        if name not in self._models: raise KeyError(f"Model '{name}' not found")
+        self._models[name]["stage"] = stage
+    def get_lineage(self, name: str) -> List[str]:
+        chain, current, visited = [], name, set()
+        while current and current not in visited:
+            visited.add(current); chain.append(current)
+            current = self._models[current].get("parent") if current in self._models else None
+        chain.reverse(); return chain
+    def _fire(self, payload):
+        if self.evolution_callback:
+            try: self.evolution_callback({"source": _EVOLUTION_KEY, "timestamp": time.time(), **payload})
+            except: pass
