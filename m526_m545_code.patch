+"""Attention Mechanism — Multi-head + explain. Ref: DI-star Transformer, state_encoder.py"""
+from __future__ import annotations
+import logging, math, time
+from typing import Any, Callable, Dict, List, Optional, Tuple
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "agentlightning.inference.attention_mechanism.v1"
+def _sv(scores):
+    if not scores: return []
+    mx = max(scores); exps = [math.exp(s-mx) for s in scores]; t = sum(exps) or 1.0; return [e/t for e in exps]
+
+class AttentionMechanism:
+    def __init__(self, embed_dim: int = 64, num_heads: int = 4) -> None:
+        self.embed_dim = embed_dim; self.num_heads = num_heads; self._last_weights = None
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+    def forward(self, queries, keys, values) -> Tuple[List[List[float]], List[List[float]]]:
+        if not queries or not keys or not values: raise ValueError("Empty input")
+        qd = len(queries[0])
+        if qd % self.num_heads != 0: raise ValueError(f"embed_dim {qd} not divisible by num_heads {self.num_heads}")
+        hd = qd // self.num_heads; scale = math.sqrt(hd) or 1.0; nq, nk = len(queries), len(keys)
+        ao = [[0.0]*qd for _ in range(nq)]; aw = [[0.0]*nk for _ in range(nq)]
+        for h in range(self.num_heads):
+            lo = h*hd
+            for qi in range(nq):
+                scores = [sum(queries[qi][lo+d]*keys[ki][lo+d] for d in range(hd))/scale for ki in range(nk)]
+                wts = _sv(scores)
+                for ki in range(nk):
+                    aw[qi][ki] += wts[ki]/self.num_heads
+                    for d in range(hd): ao[qi][lo+d] += wts[ki]*values[ki][lo+d]
+        self._last_weights = aw; self._fire({"event": "attention_computed", "num_queries": nq}); return ao, aw
+    def get_attention_map(self): return self._last_weights
+    def explain(self, element_names=None) -> str:
+        if self._last_weights is None: return "No attention computed yet"
+        if element_names is None: element_names = [f"element_{i}" for i in range(len(self._last_weights[0]))]
+        lines = []
+        for qi, w in enumerate(self._last_weights):
+            ranked = sorted(zip(element_names, w), key=lambda x: -x[1])[:3]
+            lines.append(f"Query {qi}: focus on " + ", ".join(f"{n}({v:.2f})" for n, v in ranked))
+        return "; ".join(lines)
+    def save_checkpoint(self): return {"embed_dim": self.embed_dim, "num_heads": self.num_heads}
+    def load_checkpoint(self, ckpt): self.embed_dim = ckpt.get("embed_dim", self.embed_dim); self.num_heads = ckpt.get("num_heads", self.num_heads)
+    def _fire(self, payload):
+        if self.evolution_callback:
+            try: self.evolution_callback({"source": _EVOLUTION_KEY, "timestamp": time.time(), **payload})
+            except: pass
