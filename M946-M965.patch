+
+def create_voice_strategy_narrator(config_path=None, **overrides):
+    """Factory function to create a configured VoiceStrategyNarrator instance."""
+    if config_path and pathlib.Path(config_path).exists():
+        config = ModuleConfig.from_json(pathlib.Path(config_path))
+    else:
+        config = ModuleConfig(**overrides)
+    return VoiceStrategyNarrator(config=config)
