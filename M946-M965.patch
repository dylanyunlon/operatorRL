+async def _self_test() -> None:
+    """Run module self-test."""
+    logger.info(f"[{MOD_ID}] Running self-test...")
+    instance = create_live_game_state_projector()
+    assert instance._state.phase == ModulePhase.UNINITIALIZED
+    await instance.start()
