+"""
+Matchup Advisor — Strategic advice based on matchup winrate data.
+
+Classifies matchups as favorable/even/unfavorable, provides confidence
+levels, and generates actionable tips.
+
+Location: integrations/lol_agent_pkg/matchup_advisor.py
+
+Reference (拿来主义):
+  - integrations/lol/src/lol_agent/lol_strategy_advisor.py: advisory pattern
+  - integrations/lol-history/src/lol_history/matchup_database.py: matchup data
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "lol_agent.matchup_advisor.v1"
+
+_FAVORABLE_THRESHOLD = 0.55
+_UNFAVORABLE_THRESHOLD = 0.45
+_HIGH_SAMPLE = 15
+_LOW_SAMPLE = 5
+
+_TIPS: dict[str, list[str]] = {
+    "favorable": [
+        "Play aggressively in lane — history shows you have the advantage",
+        "Look for early trades to establish dominance",
+        "Consider roaming after building a lead",
+    ],
+    "even": [
+        "Focus on CS and avoid unnecessary trades",
+        "Wait for jungler assistance before committing",
+        "Track enemy cooldowns before engaging",
+    ],
+    "unfavorable": [
+        "Play safely and focus on farming under tower",
+        "Request jungle ganks to recover from matchup disadvantage",
+        "Consider early defensive itemization",
+        "Avoid extended trades — look for short burst opportunities",
+    ],
+}
+
+
+class MatchupAdvisor:
+    """Advise on champion matchups based on historical winrate data."""
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[dict], None]] = None
+
+    def advise(
+        self,
+        my_champ: str,
+        enemy_champ: str,
+        winrate: float,
+        sample_size: int,
+    ) -> dict[str, Any]:
+        """Generate matchup advice."""
+        if winrate >= _FAVORABLE_THRESHOLD:
+            verdict = "favorable"
+        elif winrate <= _UNFAVORABLE_THRESHOLD:
+            verdict = "unfavorable"
+        else:
+            verdict = "even"
+
+        if sample_size >= _HIGH_SAMPLE:
+            confidence = "high"
+        elif sample_size >= _LOW_SAMPLE:
+            confidence = "medium"
+        else:
+            confidence = "low"
+
+        tips = self.generate_tips(verdict)
+        summary = (
+            f"{my_champ} vs {enemy_champ}: {verdict} matchup "
+            f"({winrate:.0%} WR over {sample_size} games, {confidence} confidence)"
+        )
+
+        result = {
+            "my_champ": my_champ,
+            "enemy_champ": enemy_champ,
+            "verdict": verdict,
+            "winrate": winrate,
+            "sample_size": sample_size,
+            "confidence": confidence,
+            "tips": tips,
+            "summary": summary,
+        }
+        self._fire_evolution("advice_given", {
+            "matchup": f"{my_champ}_vs_{enemy_champ}", "verdict": verdict,
+        })
+        return result
+
+    def generate_tips(self, verdict: str) -> list[str]:
+        return list(_TIPS.get(verdict, _TIPS["even"]))
+
+    def batch_advise(self, matchups: list[dict[str, Any]]) -> list[dict[str, Any]]:
+        """Advise on multiple matchups at once."""
+        return [
+            self.advise(
+                m["my_champ"], m["enemy_champ"],
+                m["winrate"], m["sample_size"],
+            )
+            for m in matchups
+        ]
+
+    def _fire_evolution(self, event_type: str, payload: dict) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({
+                "source": _EVOLUTION_KEY,
+                "type": event_type,
+                "timestamp": time.time(),
+                "payload": payload,
+            })
