@@ -0,0 +1,100 @@
+"""
+Queue Filter Engine — Queue-specific match filtering.
+
+Filters match history by queue type (ranked, ARAM, etc.), with support
+for queue mappings, remake exclusion, and time-range filtering.
+
+Location: integrations/lol_history_pkg/queue_filter_engine.py
+
+Reference (拿来主义):
+  - Seraphine/app/lol/tools.py: queueFilterList, queueIds filtering logic
+  - Seraphine/app/lol/tools.py: parseGames(games, targetId)
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "lol_history.queue_filter_engine.v1"
+
+# Standard queue names (Seraphine拿来主义)
+_QUEUE_NAMES: dict[int, str] = {
+    0: "Custom",
+    420: "Ranked Solo",
+    440: "Ranked Flex",
+    450: "ARAM",
+    900: "URF",
+    1300: "Nexus Blitz",
+    1700: "Arena",
+    1900: "URF",
+}
+
+
+class QueueFilterEngine:
+    """Filter match history by queue type.
+
+    Supports queue ID mapping (e.g. ranked → [420, 440]),
+    remake exclusion, and time-range filtering.
+    """
+
+    def __init__(self) -> None:
+        self._queue_mappings: dict[int, list[int]] = {}
+        self.evolution_callback: Optional[Callable[[dict], None]] = None
+
+    def set_queue_mapping(self, target_queue: int, accepted_queues: list[int]) -> None:
+        """Set which queue IDs are accepted when filtering for target_queue."""
+        self._queue_mappings[target_queue] = accepted_queues
+
+    def filter_games(
+        self,
+        games: list[dict[str, Any]],
+        target_queue: Optional[int] = None,
+        exclude_remakes: bool = False,
+    ) -> list[dict[str, Any]]:
+        """Filter games by queue type and optionally exclude remakes."""
+        result = []
+        for g in games:
+            queue_id = g.get("queueId", -1)
+
+            # Queue filter
+            if target_queue is not None:
+                accepted = self._queue_mappings.get(target_queue, [target_queue])
+                if queue_id not in accepted:
+                    continue
+
+            # Remake filter
+            if exclude_remakes and g.get("remake", False):
+                continue
+
+            result.append(g)
+
+        self._fire_evolution("games_filtered", {
+            "input_count": len(games), "output_count": len(result),
+        })
+        return result
+
+    def filter_by_time(
+        self, games: list[dict[str, Any]], max_age_days: int = 365
+    ) -> list[dict[str, Any]]:
+        """Filter games by age (gameCreation timestamp in milliseconds)."""
+        cutoff = (time.time() - max_age_days * 24 * 60 * 60) * 1000
+        return [g for g in games if g.get("gameCreation", 0) > cutoff]
+
+    def get_queue_name(self, queue_id: int) -> str:
+        return _QUEUE_NAMES.get(queue_id, "Unknown")
+
+    def get_supported_queues(self) -> list[int]:
+        return list(_QUEUE_NAMES.keys())
+
+    def _fire_evolution(self, event_type: str, payload: dict) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({
+                "source": _EVOLUTION_KEY,
+                "type": event_type,
+                "timestamp": time.time(),
+                "payload": payload,
+            })
diff --git a/integrations/lol_history_pkg/rank_snapshot_cache.py b/integrations/lol_history_pkg/rank_snapshot_cache.py
new file mode 100644
index 00000000..bb267aa9
--- /dev/null
+++ b/integrations/lol_history_pkg/rank_snapshot_cache.py
@@ -0,0 +1,100 @@
+"""
+Rank Snapshot Cache — Cache ranked info snapshots.
+
+Caches parsed ranked statistics with TTL expiry.
+Supports both LCU and SGP response formats.
+
+Location: integrations/lol_history_pkg/rank_snapshot_cache.py
+
+Reference (拿来主义):
+  - Seraphine/app/lol/connector.py: getRankedStatsByPuuid
+  - Seraphine/app/lol/tools.py: parseRankInfo, parseRankInfoFromSGP
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "lol_history.rank_snapshot_cache.v1"
+
+
+class RankSnapshotCache:
+    """Cache ranked statistics with TTL expiry.
+
+    Parses both LCU and SGP response formats into a unified schema.
+    """
+
+    def __init__(self, ttl: float = 300.0) -> None:
+        self.ttl = ttl
+        self._cache: dict[str, tuple[float, dict[str, Any]]] = {}
+        self.evolution_callback: Optional[Callable[[dict], None]] = None
+
+    def store(self, puuid: str, rank_data: dict[str, Any]) -> None:
+        rank_data = dict(rank_data)  # shallow copy
+        rank_data["cached_at"] = time.time()
+        self._cache[puuid] = (time.time(), rank_data)
+        self._fire_evolution("rank_stored", {"puuid": puuid})
+
+    def get(self, puuid: str) -> Optional[dict[str, Any]]:
+        entry = self._cache.get(puuid)
+        if entry is None:
+            return None
+        ts, data = entry
+        if time.time() - ts > self.ttl:
+            del self._cache[puuid]
+            return None
+        return data
+
+    def parse_lcu_response(self, response: dict[str, Any]) -> dict[str, Any]:
+        """Parse LCU /lol-ranked/v1/ranked-stats response (Seraphine parseRankInfo)."""
+        queue_map = response.get("queueMap", {})
+        solo = queue_map.get("RANKED_SOLO_5x5", {})
+        tier = solo.get("tier", "")
+        if not tier:
+            tier = "UNRANKED"
+        division = solo.get("division", "")
+        if division == "NA":
+            division = ""
+        return {
+            "tier": tier,
+            "division": division,
+            "wins": solo.get("wins", 0),
+            "losses": solo.get("losses", 0),
+            "lp": solo.get("leaguePoints", 0),
+        }
+
+    def parse_sgp_response(self, response: dict[str, Any]) -> dict[str, Any]:
+        """Parse SGP ranked stats response (Seraphine parseRankInfoFromSGP)."""
+        queues = response.get("queues", [])
+        for q in queues:
+            if q.get("queueType") == "RANKED_SOLO_5x5":
+                tier = q.get("tier", "")
+                if not tier:
+                    tier = "UNRANKED"
+                return {
+                    "tier": tier,
+                    "division": q.get("rank", ""),
+                    "wins": q.get("wins", 0),
+                    "losses": q.get("losses", 0),
+                    "lp": q.get("leaguePoints", 0),
+                }
+        return {"tier": "UNRANKED", "division": "", "wins": 0, "losses": 0, "lp": 0}
+
+    def size(self) -> int:
+        return len(self._cache)
+
+    def clear_all(self) -> None:
+        self._cache.clear()
+
+    def _fire_evolution(self, event_type: str, payload: dict) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({
+                "source": _EVOLUTION_KEY,
+                "type": event_type,
+                "timestamp": time.time(),
+                "payload": payload,
+            })
