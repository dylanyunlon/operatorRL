index 00000000..69ad07dc
--- /dev/null
+++ b/integrations/lol_history_pkg/game_detail_enricher.py
@@ -0,0 +1,114 @@
+"""
+Game Detail Enricher — Enrich match data with items, runes, position.
+
+Extracts structured data from raw match participant objects:
+items, KDA, CS, position detection, damage.
+
+Location: integrations/lol_history_pkg/game_detail_enricher.py
+
+Reference (拿来主义):
+  - Seraphine/app/lol/tools.py: parseGameData — item extraction, KDA, position detection
+  - Seraphine/app/lol/tools.py: lane/role → position mapping
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "lol_history.game_detail_enricher.v1"
+
+# Seraphine position mapping (拿来主义 from tools.py)
+_LANE_ROLE_TO_POSITION = {
+    ("TOP", "SOLO"): "TOP",
+    ("TOP", "NONE"): "TOP",
+    ("JUNGLE", "NONE"): "JUNGLE",
+    ("MIDDLE", "SOLO"): "MID",
+    ("MIDDLE", "NONE"): "MID",
+    ("BOTTOM", "CARRY"): "BOT",
+    ("BOTTOM", "DUO_CARRY"): "BOT",
+    ("BOTTOM", "SUPPORT"): "SUPPORT",
+    ("BOTTOM", "DUO_SUPPORT"): "SUPPORT",
+}
+
+_RANKED_QUEUES = {420, 440}
+
+
+class GameDetailEnricher:
+    """Enrich raw match participant data with structured fields.
+
+    Provides item extraction, KDA computation, CS calculation,
+    position detection, and damage extraction.
+    """
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[dict], None]] = None
+
+    def enrich_items(self, participant: dict[str, Any]) -> dict[str, Any]:
+        stats = participant.get("stats", participant)
+        items = [stats.get(f"item{i}", 0) for i in range(7)]
+        return {"items": items}
+
+    def compute_kda(self, stats: dict[str, Any]) -> float:
+        kills = stats.get("kills", 0)
+        deaths = max(stats.get("deaths", 0), 1)  # avoid /0 (Seraphine pattern)
+        assists = stats.get("assists", 0)
+        result = (kills + assists) / deaths
+        self._fire_evolution("kda_computed", {"kda": result})
+        return result
+
+    def compute_cs(self, stats: dict[str, Any]) -> int:
+        return stats.get("totalMinionsKilled", 0) + stats.get("neutralMinionsKilled", 0)
+
+    def detect_position(
+        self, timeline: dict[str, Any], queue_id: int
+    ) -> Optional[str]:
+        """Detect position from lane/role (Seraphine pattern).
+
+        Only returns position for ranked queues (420, 440).
+        """
+        if queue_id not in _RANKED_QUEUES:
+            return None
+        lane = timeline.get("lane", "")
+        role = timeline.get("role", "")
+        return _LANE_ROLE_TO_POSITION.get((lane, role))
+
+    def extract_damage(self, stats: dict[str, Any]) -> int:
+        return stats.get("totalDamageDealtToChampions", 0)
+
+    def enrich_participant(
+        self, raw: dict[str, Any], queue_id: int = 420
+    ) -> dict[str, Any]:
+        """Full enrichment of a raw participant dict."""
+        stats = raw.get("stats", raw)
+        timeline = raw.get("timeline", {})
+
+        items_data = self.enrich_items(raw)
+        kda = self.compute_kda(stats)
+        cs = self.compute_cs(stats)
+        position = self.detect_position(timeline, queue_id)
+        damage = self.extract_damage(stats)
+
+        return {
+            "championId": raw.get("championId", 0),
+            "items": items_data["items"],
+            "kda": kda,
+            "cs": cs,
+            "position": position,
+            "damage": damage,
+            "gold": stats.get("goldEarned", 0),
+            "level": stats.get("champLevel", 1),
+            "win": stats.get("win", False),
+        }
+
+    def _fire_evolution(self, event_type: str, payload: dict) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({
+                "source": _EVOLUTION_KEY,
+                "type": event_type,
+                "timestamp": time.time(),
+                "payload": payload,
+            })
