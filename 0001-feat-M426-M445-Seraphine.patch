@@ -0,0 +1,92 @@
+"""
+Champion Pool Analyzer — Analyze opponent champion pools.
+
+Determines an opponent's most-played champions, one-trick status,
+likely pick prediction, and position distribution.
+
+Location: integrations/lol_agent_pkg/champion_pool_analyzer.py
+
+Reference (拿来主义):
+  - Seraphine/app/lol/tools.py: getRecentChampions(games)
+  - Seraphine/app/lol/tools.py: champion aggregation + queueId==0 exclusion
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "lol_agent.champion_pool_analyzer.v1"
+_ONE_TRICK_THRESHOLD = 0.7  # 70% of games on one champion
+
+
+class ChampionPoolAnalyzer:
+    """Analyze an opponent's champion pool from match history."""
+
+    def __init__(self, max_champions: int = 10) -> None:
+        self.max_champions = max_champions
+        self.evolution_callback: Optional[Callable[[dict], None]] = None
+
+    def analyze(self, games: list[dict[str, Any]]) -> list[dict[str, Any]]:
+        """Analyze champion pool from game list (Seraphine getRecentChampions pattern).
+
+        Excludes custom games (queueId == 0).
+        """
+        champions: dict[int, dict[str, Any]] = {}
+        for g in games:
+            if g.get("queueId", 0) == 0:
+                continue  # Skip custom games (Seraphine pattern)
+            cid = g.get("championId", 0)
+            if cid not in champions:
+                champions[cid] = {"championId": cid, "total": 0, "wins": 0, "losses": 0}
+            champions[cid]["total"] += 1
+            if g.get("win", False):
+                champions[cid]["wins"] += 1
+            else:
+                champions[cid]["losses"] += 1
+
+        result = list(champions.values())
+        for entry in result:
+            entry["winrate"] = entry["wins"] / max(entry["total"], 1)
+        result.sort(key=lambda x: x["total"], reverse=True)
+
+        self._fire_evolution("pool_analyzed", {"champion_count": len(result)})
+        return result[:self.max_champions]
+
+    def is_one_trick(self, games: list[dict[str, Any]]) -> bool:
+        """Detect if player is a one-trick pony."""
+        pool = self.analyze(games)
+        if not pool:
+            return False
+        total_games = sum(c["total"] for c in pool)
+        if total_games == 0:
+            return False
+        return pool[0]["total"] / total_games >= _ONE_TRICK_THRESHOLD
+
+    def predict_likely_pick(self, games: list[dict[str, Any]]) -> int:
+        """Predict most likely champion pick based on history."""
+        pool = self.analyze(games)
+        if not pool:
+            return 0
+        return pool[0]["championId"]
+
+    def position_distribution(self, games: list[dict[str, Any]]) -> dict[str, int]:
+        """Count games per position."""
+        dist: dict[str, int] = {}
+        for g in games:
+            pos = g.get("position")
+            if pos:
+                dist[pos] = dist.get(pos, 0) + 1
+        return dist
+
+    def _fire_evolution(self, event_type: str, payload: dict) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({
+                "source": _EVOLUTION_KEY,
+                "type": event_type,
+                "timestamp": time.time(),
+                "payload": payload,
+            })
