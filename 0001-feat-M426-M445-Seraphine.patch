+"""
+SGP API Adapter — SGP API compatibility adapter.
+
+Provides URL building and response parsing for SGP (Server Gateway Proxy)
+endpoints, which are an alternative to LCU for Chinese servers.
+
+Location: integrations/lol_history_pkg/sgp_api_adapter.py
+
+Reference (拿来主义):
+  - Seraphine/app/lol/connector.py: getSummonerByPuuidViaSGP, getSummonerGamesByPuuidViaSGP
+  - Seraphine/app/lol/tools.py: parseGamesDataFromSGP, getNameTagLineFromGame
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Optional, Tuple
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "lol_history.sgp_api_adapter.v1"
+
+
+class SgpApiAdapter:
+    """SGP API compatibility adapter.
+
+    Mirrors Seraphine's SGP endpoint patterns for servers where
+    standard LCU endpoints are unavailable or limited.
+    """
+
+    def __init__(self, base_url: str = "https://127.0.0.1:2999") -> None:
+        self.base_url = base_url.rstrip("/")
+        self._available: bool = False
+        self.evolution_callback: Optional[Callable[[dict], None]] = None
+
+    def build_summoner_url(self, puuid: str) -> str:
+        return f"{self.base_url}/lol-summoner/v1/summoners-by-puuid-sgp/{puuid}"
+
+    def build_match_history_url(self, puuid: str, beg: int = 0, end: int = 14) -> str:
+        return (
+            f"{self.base_url}/lol-match-history/v1/products/lol/"
+            f"{puuid}/matches-sgp?begIndex={beg}&endIndex={end}"
+        )
+
+    def build_ranked_url(self, puuid: str) -> str:
+        return f"{self.base_url}/lol-ranked/v1/ranked-stats-sgp/{puuid}"
+
+    def parse_games(self, response: dict[str, Any]) -> list[dict[str, Any]]:
+        """Parse SGP games response (games contain nested 'json' key)."""
+        raw_games = response.get("games", [])
+        result = []
+        for g in raw_games:
+            json_data = g.get("json", g)
+            result.append(json_data)
+        self._fire_evolution("sgp_games_parsed", {"count": len(result)})
+        return result
+
+    def extract_participant(
+        self, raw_game: dict[str, Any], puuid: str
+    ) -> Optional[dict[str, Any]]:
+        """Extract participant data for a specific puuid from SGP game."""
+        json_data = raw_game.get("json", raw_game)
+        participants = json_data.get("participants", [])
+        for p in participants:
+            if p.get("puuid") == puuid:
+                return p
+        return None
+
+    def extract_name_tagline(
+        self, game: dict[str, Any], puuid: str
+    ) -> Tuple[Optional[str], Optional[str]]:
+        """Extract riotIdGameName and riotIdTagline (Seraphine getNameTagLineFromGame)."""
+        json_data = game.get("json", game)
+        participants = json_data.get("participants", [])
+        for p in participants:
+            if p.get("puuid") == puuid:
+                return p.get("riotIdGameName"), p.get("riotIdTagline")
+        return None, None
+
+    def is_available(self) -> bool:
+        return self._available
+
+    def set_available(self, available: bool) -> None:
+        self._available = available
+
+    def _fire_evolution(self, event_type: str, payload: dict) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({
+                "source": _EVOLUTION_KEY,
+                "type": event_type,
+                "timestamp": time.time(),
+                "payload": payload,
+            })
