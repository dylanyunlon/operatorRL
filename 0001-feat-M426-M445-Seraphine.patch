@@ -0,0 +1,93 @@
+"""
+Performance Trend Tracker — Hot/cold streak + tilt detection.
+
+Analyzes recent match performance to detect trends: hot streaks,
+cold streaks, tilt, and improvement patterns.
+
+Location: integrations/lol_agent_pkg/performance_trend_tracker.py
+
+Reference (拿来主义):
+  - integrations/lol/src/lol_agent/post_game_analyzer.py: get_trend pattern
+  - Seraphine/app/lol/tools.py: parseGames KDA aggregation
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "lol_agent.performance_trend_tracker.v1"
+
+_HOT_WINRATE_THRESHOLD = 0.7
+_COLD_WINRATE_THRESHOLD = 0.3
+_TILT_DEATH_THRESHOLD = 8.0  # avg deaths per game
+_TILT_KDA_THRESHOLD = 1.0
+
+
+class PerformanceTrendTracker:
+    """Track performance trends across recent games."""
+
+    def __init__(self, window_size: int = 5) -> None:
+        self.window_size = window_size
+        self.evolution_callback: Optional[Callable[[dict], None]] = None
+
+    def analyze(self, games: list[dict[str, Any]]) -> dict[str, Any]:
+        """Analyze performance trend from recent games (most-recent first)."""
+        if not games:
+            return {
+                "is_hot": False, "is_cold": False, "possible_tilt": False,
+                "improving": False, "recent_kda": 0.0, "confidence": 0.0,
+            }
+
+        window = games[:self.window_size]
+        n = len(window)
+
+        wins = sum(1 for g in window if g.get("win", False))
+        winrate = wins / n
+
+        total_k = sum(g.get("kills", 0) for g in window)
+        total_d = sum(g.get("deaths", 0) for g in window)
+        total_a = sum(g.get("assists", 0) for g in window)
+        avg_deaths = total_d / n
+        recent_kda = (total_k + total_a) / max(total_d, 1)
+
+        is_hot = winrate >= _HOT_WINRATE_THRESHOLD and recent_kda >= 3.0
+        is_cold = winrate <= _COLD_WINRATE_THRESHOLD and recent_kda < 2.0
+        possible_tilt = avg_deaths >= _TILT_DEATH_THRESHOLD and recent_kda < _TILT_KDA_THRESHOLD
+
+        # Improvement: compare first half vs second half KDA
+        improving = False
+        if n >= 4:
+            mid = n // 2
+            recent_half = window[:mid]
+            older_half = window[mid:]
+            rk = sum(g.get("kills", 0) + g.get("assists", 0) for g in recent_half)
+            rd = max(sum(g.get("deaths", 0) for g in recent_half), 1)
+            ok = sum(g.get("kills", 0) + g.get("assists", 0) for g in older_half)
+            od = max(sum(g.get("deaths", 0) for g in older_half), 1)
+            improving = (rk / rd) > (ok / od) * 1.2  # 20% improvement threshold
+
+        confidence = min(n / self.window_size, 1.0)
+
+        result = {
+            "is_hot": is_hot,
+            "is_cold": is_cold,
+            "possible_tilt": possible_tilt,
+            "improving": improving,
+            "recent_kda": recent_kda,
+            "confidence": confidence,
+        }
+        self._fire_evolution("trend_analyzed", {"winrate": winrate, "kda": recent_kda})
+        return result
+
+    def _fire_evolution(self, event_type: str, payload: dict) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({
+                "source": _EVOLUTION_KEY,
+                "type": event_type,
+                "timestamp": time.time(),
+                "payload": payload,
+            })
