@@ -0,0 +1,113 @@
+"""
+Pregame Intel Aggregator — Combine history + live data for pregame intelligence.
+
+Builds comprehensive pregame reports per opponent, computes threat levels,
+and aggregates team-level intelligence.
+
+Location: integrations/lol_agent_pkg/pregame_intel_aggregator.py
+
+Reference (拿来主义):
+  - Seraphine/app/lol/tools.py: parseSummonerGameInfo → full summoner report
+  - integrations/lol/src/lol_agent/pregame_scout_engine.py: threat scoring
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "lol_agent.pregame_intel_aggregator.v1"
+
+_TIER_SCORES: dict[str, float] = {
+    "IRON": 0.1, "BRONZE": 0.2, "SILVER": 0.3, "GOLD": 0.4,
+    "PLATINUM": 0.5, "EMERALD": 0.55, "DIAMOND": 0.65,
+    "MASTER": 0.8, "GRANDMASTER": 0.9, "CHALLENGER": 1.0,
+    "UNRANKED": 0.3,
+}
+
+
+class PregameIntelAggregator:
+    """Aggregate pregame intelligence per opponent and per team."""
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[dict], None]] = None
+
+    def tier_to_score(self, tier: str) -> float:
+        return _TIER_SCORES.get(tier.upper(), 0.3)
+
+    def build_report(
+        self,
+        opponent: dict[str, Any],
+        history: list[dict[str, Any]],
+        rank: Optional[dict[str, Any]],
+    ) -> dict[str, Any]:
+        """Build a pregame intel report for one opponent."""
+        # History summary
+        total = len(history)
+        wins = sum(1 for g in history if g.get("win", False))
+        total_k = sum(g.get("kills", 0) for g in history)
+        total_d = sum(g.get("deaths", 0) for g in history)
+        total_a = sum(g.get("assists", 0) for g in history)
+        avg_kda = (total_k + total_a) / max(total_d, 1)
+        winrate = wins / max(total, 1)
+
+        report = {
+            "summoner_name": opponent.get("summonerName", ""),
+            "puuid": opponent.get("puuid", ""),
+            "rank": rank or {"tier": "UNRANKED", "division": ""},
+            "history_summary": {
+                "total_games": total,
+                "wins": wins,
+                "losses": total - wins,
+                "winrate": winrate,
+                "avg_kda": avg_kda,
+            },
+        }
+
+        self._fire_evolution("report_built", {
+            "summoner": report["summoner_name"],
+        })
+        return report
+
+    def compute_threat_level(self, report: dict[str, Any]) -> float:
+        """Compute threat level [0.0, 1.0] from a pregame report."""
+        rank = report.get("rank", {})
+        tier = rank.get("tier", "UNRANKED")
+        summary = report.get("history_summary", {})
+        winrate = summary.get("winrate", 0.5)
+        avg_kda = summary.get("avg_kda", 2.0)
+
+        tier_score = self.tier_to_score(tier)
+        wr_component = min(winrate, 1.0)
+        kda_component = min(avg_kda / 10.0, 1.0)
+
+        raw = 0.40 * tier_score + 0.35 * wr_component + 0.25 * kda_component
+        return max(0.0, min(1.0, raw))
+
+    def aggregate_team(self, reports: list[dict[str, Any]]) -> dict[str, Any]:
+        """Aggregate team-level threat stats."""
+        if not reports:
+            return {"avg_threat": 0.0, "highest_threat": None}
+        threats = [r.get("threat_level", 0.0) for r in reports]
+        return {
+            "avg_threat": sum(threats) / len(threats),
+            "highest_threat": max(reports, key=lambda r: r.get("threat_level", 0.0))
+                if reports else None,
+        }
+
+    def get_highest_threat(self, reports: list[dict[str, Any]]) -> dict[str, Any]:
+        if not reports:
+            return {}
+        return max(reports, key=lambda r: r.get("threat_level", 0.0))
+
+    def _fire_evolution(self, event_type: str, payload: dict) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({
+                "source": _EVOLUTION_KEY,
+                "type": event_type,
+                "timestamp": time.time(),
+                "payload": payload,
+            })
