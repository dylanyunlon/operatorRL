+"""
+Teammate Tracker — Recent teammate co-op statistics.
+
+Tracks how often you play with the same teammates and your winrate together.
+
+Location: integrations/lol_history_pkg/teammate_tracker.py
+
+Reference (拿来主义):
+  - Seraphine/app/lol/tools.py: getRecentTeammates(games, puuid)
+  - Seraphine/app/lol/tools.py: getTeammates(game, puuid)
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "lol_history.teammate_tracker.v1"
+
+
+class TeammateTracker:
+    """Track recent teammate co-op statistics.
+
+    Records games played with each teammate, wins, losses.
+    Mirrors Seraphine getRecentTeammates pattern.
+    """
+
+    def __init__(self, max_tracked: int = 100) -> None:
+        self.max_tracked = max_tracked
+        # {player_puuid: {teammate_puuid: {name, total, wins, losses}}}
+        self._data: dict[str, dict[str, dict[str, Any]]] = {}
+        self.evolution_callback: Optional[Callable[[dict], None]] = None
+
+    def record_game(
+        self, player_puuid: str, teammate_puuid: str, teammate_name: str, won: bool
+    ) -> None:
+        # Prevent self-tracking (Seraphine skips self in getTeammates)
+        if player_puuid == teammate_puuid:
+            return
+
+        if player_puuid not in self._data:
+            self._data[player_puuid] = {}
+
+        teammates = self._data[player_puuid]
+        if teammate_puuid not in teammates:
+            teammates[teammate_puuid] = {
+                "name": teammate_name, "total": 0, "wins": 0, "losses": 0,
+            }
+
+        entry = teammates[teammate_puuid]
+        entry["name"] = teammate_name  # update latest name
+        entry["total"] += 1
+        if won:
+            entry["wins"] += 1
+        else:
+            entry["losses"] += 1
+
+        self._fire_evolution("teammate_recorded", {
+            "player": player_puuid, "teammate": teammate_puuid,
+        })
+
+    def get_teammate_stats(self, player_puuid: str, teammate_puuid: str) -> dict[str, Any]:
+        teammates = self._data.get(player_puuid, {})
+        return teammates.get(teammate_puuid, {
+            "name": "", "total": 0, "wins": 0, "losses": 0,
+        })
+
+    def get_frequent_teammates(
+        self, player_puuid: str, top_n: int = 5
+    ) -> list[dict[str, Any]]:
+        teammates = self._data.get(player_puuid, {})
+        entries = [
+            {"puuid": k, **v} for k, v in teammates.items()
+        ]
+        entries.sort(key=lambda x: x["total"], reverse=True)
+        return entries[:top_n]
+
+    def get_winrate_with(self, player_puuid: str, teammate_puuid: str) -> float:
+        stats = self.get_teammate_stats(player_puuid, teammate_puuid)
+        if stats["total"] == 0:
+            return 0.0
+        return stats["wins"] / stats["total"]
+
+    def tracked_count(self, player_puuid: str) -> int:
+        return len(self._data.get(player_puuid, {}))
+
+    def clear(self, player_puuid: str) -> None:
+        self._data.pop(player_puuid, None)
+
+    def _fire_evolution(self, event_type: str, payload: dict) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({
+                "source": _EVOLUTION_KEY,
+                "type": event_type,
+                "timestamp": time.time(),
+                "payload": payload,
+            })
