+"""
+History Packet Correlator — Correlate network packets with historical context.
+
+Enriches captured network packets with historical player data,
+adding threat annotations and context for real-time decision making.
+
+Location: extensions_fiddler/history_packet_correlator.py
+
+Reference (拿来主义):
+  - extensions/fiddler-bridge/src/fiddler_packet_parser.py: packet parsing
+  - extensions/fiddler-bridge/src/fiddler_bridge/opponent_timing_tracker.py: player correlation
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "fiddler.history_packet_correlator.v1"
+
+_PLAYER_EVENT_TYPES = {"player_action", "player_state", "player_combat", "champion_action"}
+
+
+class HistoryPacketCorrelator:
+    """Correlate network packets with historical player data.
+
+    Enriches player-related packets with historical context
+    (KDA, winrate, tier) and assigns threat annotations.
+    """
+
+    def __init__(self) -> None:
+        self._correlation_count: int = 0
+        self.evolution_callback: Optional[Callable[[dict], None]] = None
+
+    def correlate(
+        self,
+        packet: dict[str, Any],
+        history: dict[str, dict[str, Any]],
+    ) -> dict[str, Any]:
+        """Correlate a single packet with historical data.
+
+        Args:
+            packet: Network packet dict with 'type' and optionally 'puuid'.
+            history: Dict mapping puuid → historical stats.
+
+        Returns:
+            Enriched packet with 'historical_context' and 'threat_annotation'.
+        """
+        self._correlation_count += 1
+        enriched = dict(packet)
+        enriched["correlation_timestamp"] = time.time()
+
+        puuid = packet.get("puuid")
+        ptype = packet.get("type", "")
+
+        if ptype not in _PLAYER_EVENT_TYPES or puuid is None:
+            enriched["historical_context"] = None
+            enriched["threat_annotation"] = None
+            self._fire_evolution("correlated", {"has_context": False})
+            return enriched
+
+        ctx = history.get(puuid)
+        if ctx is None:
+            enriched["historical_context"] = None
+            enriched["threat_annotation"] = None
+        else:
+            enriched["historical_context"] = ctx
+            enriched["threat_annotation"] = self._compute_threat(ctx)
+
+        self._fire_evolution("correlated", {
+            "puuid": puuid, "has_context": ctx is not None,
+        })
+        return enriched
+
+    def _compute_threat(self, ctx: dict[str, Any]) -> str:
+        """Compute threat level annotation from historical context."""
+        kda = ctx.get("avg_kda", 2.0)
+        winrate = ctx.get("winrate", 0.5)
+        tier = ctx.get("tier", "UNRANKED")
+
+        tier_weight = {
+            "IRON": 0.1, "BRONZE": 0.2, "SILVER": 0.3, "GOLD": 0.4,
+            "PLATINUM": 0.5, "EMERALD": 0.55, "DIAMOND": 0.65,
+            "MASTER": 0.8, "GRANDMASTER": 0.9, "CHALLENGER": 1.0,
+        }.get(tier.upper(), 0.3)
+
+        score = 0.4 * tier_weight + 0.3 * min(winrate, 1.0) + 0.3 * min(kda / 10.0, 1.0)
+
+        if score >= 0.6:
+            return "high"
+        elif score >= 0.35:
+            return "medium"
+        else:
+            return "low"
+
+    def batch_correlate(
+        self,
+        packets: list[dict[str, Any]],
+        history: dict[str, dict[str, Any]],
+    ) -> list[dict[str, Any]]:
+        return [self.correlate(p, history) for p in packets]
+
+    def filter_relevant(self, packets: list[dict[str, Any]]) -> list[dict[str, Any]]:
+        """Filter packets to only player-related events."""
+        return [p for p in packets if p.get("type", "") in _PLAYER_EVENT_TYPES]
+
+    def correlation_count(self) -> int:
+        return self._correlation_count
+
+    def _fire_evolution(self, event_type: str, payload: dict) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({
+                "source": _EVOLUTION_KEY,
+                "type": event_type,
+                "timestamp": time.time(),
+                "payload": payload,
+            })
