+"""
+Champ Select Analyzer — Analyze champion select and provide advice.
+
+Analyzes team composition, detects missing roles, suggests bans/picks,
+and evaluates team synergy.
+
+Location: integrations/lol_agent_pkg/champ_select_analyzer.py
+
+Reference (拿来主义):
+  - Seraphine/app/lol/tools.py: autoPick, autoBan, showOpggBuild
+  - Seraphine/app/lol/tools.py: sortedSummonersByGameRole
+  - integrations/lol/src/lol_agent/team_comp_evaluator.py: comp scoring
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "lol_agent.champ_select_analyzer.v1"
+
+_ALL_ROLES = {"TOP", "JUNGLE", "MID", "BOT", "SUPPORT"}
+
+
+class ChampSelectAnalyzer:
+    """Analyze champion select session and provide strategic advice."""
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[dict], None]] = None
+
+    def analyze_team(self, team: list[dict[str, Any]]) -> dict[str, Any]:
+        """Analyze team composition."""
+        if not team:
+            return {"composition_type": "unknown", "champion_count": 0}
+
+        positions = [p.get("position", "") for p in team if p.get("position")]
+        champion_count = len(team)
+
+        # Simple comp classification
+        if champion_count >= 5:
+            comp_type = "full"
+        elif champion_count >= 3:
+            comp_type = "partial"
+        else:
+            comp_type = "incomplete"
+
+        self._fire_evolution("team_analyzed", {"champion_count": champion_count})
+        return {
+            "composition_type": comp_type,
+            "champion_count": champion_count,
+            "positions": positions,
+        }
+
+    def detect_missing_roles(self, team: list[dict[str, Any]]) -> list[str]:
+        """Detect which roles are not yet filled."""
+        filled = set()
+        for p in team:
+            pos = p.get("position", "")
+            if pos:
+                filled.add(pos.upper())
+        return sorted(_ALL_ROLES - filled)
+
+    def suggest_bans(
+        self, opponent_pool: list[dict[str, Any]], max_bans: int = 5
+    ) -> list[int]:
+        """Suggest bans based on opponent champion pool.
+
+        Ban the champion with highest (total * winrate) product.
+        """
+        scored = [
+            (c["championId"], c.get("total", 0) * c.get("winrate", 0.5))
+            for c in opponent_pool
+        ]
+        scored.sort(key=lambda x: x[1], reverse=True)
+        return [cid for cid, _ in scored[:max_bans]]
+
+    def suggest_pick(self, matchup_data: dict[str, dict[str, Any]]) -> str:
+        """Suggest best pick based on matchup winrate data."""
+        if not matchup_data:
+            return ""
+        best = max(matchup_data, key=lambda c: matchup_data[c].get("winrate", 0.5))
+        return best
+
+    def synergy_score(self, team: list[dict[str, Any]]) -> float:
+        """Compute team synergy score [0.0, 1.0].
+
+        Simple heuristic: diversity of champions indicates better comp.
+        """
+        if not team:
+            return 0.0
+        unique = len({p.get("championId", 0) for p in team})
+        return min(unique / 5.0, 1.0)
+
+    def detect_weaknesses(self, enemy: list[dict[str, Any]]) -> list[str]:
+        """Detect potential weaknesses in enemy team comp."""
+        weaknesses = []
+        if len(enemy) < 5:
+            weaknesses.append("incomplete_team")
+        champ_ids = {e.get("championId", 0) for e in enemy}
+        if len(champ_ids) < len(enemy):
+            weaknesses.append("duplicate_champions")
+        return weaknesses
+
+    def detect_phase(self, session: dict[str, Any]) -> str:
+        """Detect current champ select phase."""
+        timer = session.get("timer", {})
+        phase = timer.get("phase", "unknown")
+        if phase in ("BAN_PICK", "BAN", "PICK", "FINALIZATION"):
+            return phase
+        return "unknown"
+
+    def _fire_evolution(self, event_type: str, payload: dict) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({
+                "source": _EVOLUTION_KEY,
+                "type": event_type,
+                "timestamp": time.time(),
+                "payload": payload,
+            })
