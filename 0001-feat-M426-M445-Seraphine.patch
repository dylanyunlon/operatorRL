+"""
+LCU Event Listener — LCU WebSocket event listener.
+
+Provides event subscription, dispatch, and URI-based filtering for
+LCU WebSocket events (champ select, gameflow, summoner profile changes).
+
+Location: integrations/lol_agent_pkg/lcu_event_listener.py
+
+Reference (拿来主义):
+  - Seraphine/app/lol/connector.py: LcuWebSocket.subscribe(event, uri, type)
+  - Seraphine/app/lol/connector.py: LcuWebSocket.matchUri(data)
+  - Seraphine/app/lol/listener.py: LolProcessExistenceListener pattern
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "lol_agent.lcu_event_listener.v1"
+
+
+class LcuEventListener:
+    """LCU WebSocket event listener.
+
+    Manages event subscriptions with optional URI filtering,
+    dispatches events to registered callbacks.
+    """
+
+    def __init__(self, port: int = 0, token: str = "") -> None:
+        self.port = port
+        self.token = token
+        self._connected: bool = False
+        # {event_name: [(callback, uri_filter)]}
+        self._subscriptions: dict[str, list[tuple[Callable, Optional[str]]]] = {}
+        self.evolution_callback: Optional[Callable[[dict], None]] = None
+
+    def subscribe(
+        self,
+        event: str,
+        callback: Callable[[dict], Any],
+        uri_filter: Optional[str] = None,
+    ) -> None:
+        """Subscribe to an LCU event with optional URI filter.
+
+        Mirrors Seraphine LcuWebSocket.subscribe(event, uri, type).
+        """
+        if event not in self._subscriptions:
+            self._subscriptions[event] = []
+        self._subscriptions[event].append((callback, uri_filter))
+
+    def unsubscribe(self, event: str, callback: Callable) -> None:
+        """Remove a specific callback from an event."""
+        if event in self._subscriptions:
+            self._subscriptions[event] = [
+                (cb, f) for cb, f in self._subscriptions[event] if cb is not callback
+            ]
+            if not self._subscriptions[event]:
+                del self._subscriptions[event]
+
+    def dispatch(self, event: str, data: dict[str, Any]) -> None:
+        """Dispatch an event to all matching subscribers.
+
+        Mirrors Seraphine LcuWebSocket.matchUri logic.
+        """
+        subscribers = self._subscriptions.get(event, [])
+        for callback, uri_filter in subscribers:
+            if uri_filter is not None:
+                data_uri = data.get("uri", "")
+                if data_uri != uri_filter:
+                    continue
+            callback(data)
+
+        self._fire_evolution("event_dispatched", {
+            "event": event, "subscriber_count": len(subscribers),
+        })
+
+    def build_ws_url(self) -> str:
+        """Build WebSocket URL for LCU connection."""
+        return f"wss://127.0.0.1:{self.port}"
+
+    def subscription_count(self) -> int:
+        return sum(len(subs) for subs in self._subscriptions.values())
+
+    def is_connected(self) -> bool:
+        return self._connected
+
+    def set_connected(self, connected: bool) -> None:
+        self._connected = connected
+
+    def clear_subscriptions(self) -> None:
+        self._subscriptions.clear()
+
+    def _fire_evolution(self, event_type: str, payload: dict) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({
+                "source": _EVOLUTION_KEY,
+                "type": event_type,
+                "timestamp": time.time(),
+                "payload": payload,
+            })
