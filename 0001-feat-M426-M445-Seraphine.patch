+"""
+Match Fetcher Paginator — Paginated match history retrieval.
+
+Mirrors Seraphine connector.py pattern: getSummonerGamesByPuuid with begIndex/endIndex.
+
+Location: integrations/lol_history_pkg/match_fetcher_paginator.py
+
+Reference (拿来主义):
+  - Seraphine/app/lol/connector.py: getSummonerGamesByPuuid(puuid, begIndex, endIndex)
+  - Seraphine/app/lol/tools.py: parseSummonerGameInfo pagination loop
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "lol_history.match_fetcher_paginator.v1"
+
+
+class MatchFetcherPaginator:
+    """Paginated match history fetcher.
+
+    Builds LCU-compatible URLs with begIndex/endIndex and parses
+    the 'games' array from the response.
+    """
+
+    def __init__(
+        self,
+        base_url: str = "https://127.0.0.1:2999",
+        max_pages: int = 5,
+        default_page_size: int = 15,
+    ) -> None:
+        self.base_url = base_url.rstrip("/")
+        self.max_pages = max_pages
+        self.default_page_size = default_page_size
+        self.evolution_callback: Optional[Callable[[dict], None]] = None
+
+    def build_page_url(self, puuid: str, page: int = 0, page_size: int = 15) -> str:
+        beg = page * page_size
+        end = beg + page_size
+        return (
+            f"{self.base_url}/lol-match-history/v1/products/lol/"
+            f"{puuid}/matches?begIndex={beg}&endIndex={end}"
+        )
+
+    def parse_page_response(self, response: dict[str, Any]) -> list[dict[str, Any]]:
+        games = response.get("games", [])
+        self._fire_evolution("page_parsed", {"count": len(games)})
+        return games
+
+    def has_more_pages(self, current_count: int, page_size: int) -> bool:
+        return current_count >= page_size
+
+    def collect_pages(self, pages: list[list[dict[str, Any]]]) -> list[dict[str, Any]]:
+        result: list[dict[str, Any]] = []
+        for page in pages:
+            result.extend(page)
+        return result
+
+    def _fire_evolution(self, event_type: str, payload: dict) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({
+                "source": _EVOLUTION_KEY,
+                "type": event_type,
+                "timestamp": time.time(),
+                "payload": payload,
+            })
diff --git a/integrations/lol_history_pkg/opponent_fate_detector.py b/integrations/lol_history_pkg/opponent_fate_detector.py
new file mode 100644
index 00000000..09b88dab
--- /dev/null
+++ b/integrations/lol_history_pkg/opponent_fate_detector.py
@@ -0,0 +1,134 @@
+"""
+Opponent Fate Detector — Detect repeat opponents.
+
+Identifies opponents you've faced before, tracks win/loss history,
+and detects "nemesis" / "favorite" patterns.
+
+Location: integrations/lol_history_pkg/opponent_fate_detector.py
+
+Reference (拿来主义):
+  - Seraphine/app/lol/tools.py: fateFlag ("ally"/"enemy") detection
+  - Seraphine/app/lol/tools.py: getTeammates → enemies list
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "lol_history.opponent_fate_detector.v1"
+
+
+class OpponentFateDetector:
+    """Detect repeat opponents and track encounter history.
+
+    Mirrors Seraphine fateFlag pattern for identifying previously
+    encountered opponents in current game.
+    """
+
+    def __init__(self) -> None:
+        # {player_puuid: {opponent_puuid: {name, encounters, wins_against, losses_against, last_seen}}}
+        self._encounters: dict[str, dict[str, dict[str, Any]]] = {}
+        self.evolution_callback: Optional[Callable[[dict], None]] = None
+
+    def record_encounter(
+        self, my_puuid: str, opponent_puuid: str, opponent_name: str, won: bool
+    ) -> None:
+        if my_puuid not in self._encounters:
+            self._encounters[my_puuid] = {}
+
+        opponents = self._encounters[my_puuid]
+        if opponent_puuid not in opponents:
+            opponents[opponent_puuid] = {
+                "name": opponent_name,
+                "encounters": 0,
+                "wins_against": 0,
+                "losses_against": 0,
+                "last_seen": 0.0,
+            }
+
+        entry = opponents[opponent_puuid]
+        entry["name"] = opponent_name
+        entry["encounters"] += 1
+        entry["last_seen"] = time.time()
+        if won:
+            entry["wins_against"] += 1
+        else:
+            entry["losses_against"] += 1
+
+        self._fire_evolution("encounter_recorded", {
+            "my_puuid": my_puuid, "opponent": opponent_puuid,
+        })
+
+    def detect_fate(self, my_puuid: str, opponent_puuid: str) -> dict[str, Any]:
+        opponents = self._encounters.get(my_puuid, {})
+        entry = opponents.get(opponent_puuid)
+        if entry is None:
+            return {"met_before": False, "encounters": 0, "wins_against": 0,
+                    "losses_against": 0, "last_seen": 0.0}
+        return {
+            "met_before": True,
+            "encounters": entry["encounters"],
+            "wins_against": entry["wins_against"],
+            "losses_against": entry["losses_against"],
+            "last_seen": entry["last_seen"],
+        }
+
+    def get_winrate_against(self, my_puuid: str, opponent_puuid: str) -> float:
+        fate = self.detect_fate(my_puuid, opponent_puuid)
+        if fate["encounters"] == 0:
+            return 0.5
+        return fate["wins_against"] / fate["encounters"]
+
+    def get_nemesis(self, my_puuid: str) -> dict[str, Any]:
+        """Opponent with worst winrate (most losses against)."""
+        opponents = self._encounters.get(my_puuid, {})
+        if not opponents:
+            return {"puuid": "", "name": "", "winrate": 0.5}
+        worst_puuid = min(
+            opponents,
+            key=lambda k: opponents[k]["wins_against"] / max(opponents[k]["encounters"], 1),
+        )
+        entry = opponents[worst_puuid]
+        return {
+            "puuid": worst_puuid,
+            "name": entry["name"],
+            "winrate": entry["wins_against"] / max(entry["encounters"], 1),
+        }
+
+    def get_favorite_opponent(self, my_puuid: str) -> dict[str, Any]:
+        """Opponent with best winrate."""
+        opponents = self._encounters.get(my_puuid, {})
+        if not opponents:
+            return {"puuid": "", "name": "", "winrate": 0.5}
+        best_puuid = max(
+            opponents,
+            key=lambda k: opponents[k]["wins_against"] / max(opponents[k]["encounters"], 1),
+        )
+        entry = opponents[best_puuid]
+        return {
+            "puuid": best_puuid,
+            "name": entry["name"],
+            "winrate": entry["wins_against"] / max(entry["encounters"], 1),
+        }
+
+    def scan_opponents(
+        self, my_puuid: str, opponents: list[dict[str, Any]]
+    ) -> list[dict[str, Any]]:
+        """Scan a list of current-game opponents for fate flags."""
+        return [self.detect_fate(my_puuid, o.get("puuid", "")) for o in opponents]
+
+    def clear(self, my_puuid: str) -> None:
+        self._encounters.pop(my_puuid, None)
+
+    def _fire_evolution(self, event_type: str, payload: dict) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({
+                "source": _EVOLUTION_KEY,
+                "type": event_type,
+                "timestamp": time.time(),
+                "payload": payload,
+            })
