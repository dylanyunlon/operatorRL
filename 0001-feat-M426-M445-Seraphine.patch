+History Evolution Bridge — Bridge history data into evolution training.
+
+Converts match history data into training events with reward signals
+for the operatorRL evolution pipeline.
+
+Location: integrations/lol_agent_pkg/history_evolution_bridge.py
+
+Reference (拿来主义):
+  - integrations/lol-history/src/lol_history/history_evolution_bridge.py: event format
+  - integrations/lol/src/lol_agent/lol_evolution_loop.py: reward computation
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "lol_agent.history_evolution_bridge.v1"
+
+
+class HistoryEvolutionBridge:
+    """Convert match history into evolution training events."""
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[dict], None]] = None
+
+    def compute_reward(self, won: bool, kda: float = 2.0) -> float:
+        """Compute reward signal from match outcome and KDA.
+
+        Win: +0.5 to +1.0 based on KDA.
+        Loss: -0.5 to 0.0 based on KDA.
+        """
+        kda_bonus = min(kda / 20.0, 0.5)  # max +0.5 from KDA
+        if won:
+            return 0.5 + kda_bonus
+        else:
+            return -0.5 + kda_bonus
+
+    def extract_features(self, match: dict[str, Any]) -> dict[str, Any]:
+        """Extract state features from a match dict."""
+        kills = match.get("kills", 0)
+        deaths = max(match.get("deaths", 0), 1)
+        assists = match.get("assists", 0)
+        cs = match.get("cs", 0)
+        gold = match.get("gold", 0)
+        level = match.get("level", 1)
+
+        return {
+            "kda": (kills + assists) / deaths,
+            "cs": cs,
+            "gold": gold,
+            "level": level,
+            "gold_efficiency": gold / max(level * 1000, 1),
+            "championId": match.get("championId", 0),
+        }
+
+    def to_training_event(self, match: dict[str, Any]) -> dict[str, Any]:
+        """Convert a single match to a training event."""
+        game_id = match.get("gameId", 0)
+        won = match.get("win", False)
+        kills = match.get("kills", 0)
+        deaths = max(match.get("deaths", 0), 1)
+        assists = match.get("assists", 0)
+        kda = (kills + assists) / deaths if match else 0.0
+
+        reward = self.compute_reward(won, kda) if match else 0.0
+
+        event = {
+            "type": "match_outcome",
+            "game_id": game_id,
+            "reward": reward,
+            "won": won,
+            "kda": kda,
+            "timestamp": time.time(),
+        }
+        self._fire_evolution("training_event_created", {"game_id": game_id})
+        return event
+
+    def batch_convert(self, matches: list[dict[str, Any]]) -> list[dict[str, Any]]:
+        """Convert multiple matches to training events."""
+        return [self.to_training_event(m) for m in matches]
+
+    def _fire_evolution(self, event_type: str, payload: dict) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({
+                "source": _EVOLUTION_KEY,
+                "type": event_type,
+                "timestamp": time.time(),
+                "payload": payload,
+            })
