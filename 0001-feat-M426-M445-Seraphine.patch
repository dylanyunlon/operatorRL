+"""
+History Data Governor — Govern historical data access.
+
+Provides authorization, rate limiting, audit logging, and module
+registration for accessing historical match data.
+
+Location: agentos_governance/history_data_governor.py
+
+Reference (拿来主义):
+  - agentos/governance/policy_enforcer.py: authorization pattern
+  - agentos/governance/telemetry_collector.py: audit logging
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "agentos.governance.history_data_governor.v1"
+
+# Default allowed modules and their data scopes
+_DEFAULT_MODULES: dict[str, list[str]] = {
+    "lol_agent": ["match_history", "ranked_stats", "summoner_data", "game_detail"],
+    "dota2_agent": ["match_history", "ranked_stats"],
+    "mahjong_agent": ["match_history"],
+    "fiddler_bridge": ["match_history", "game_detail"],
+    "evolution_bridge": ["match_history", "training_events"],
+}
+
+
+class HistoryDataGovernor:
+    """Govern access to historical match data.
+
+    Provides module authorization, rate limiting, audit logging,
+    and data retention policy enforcement.
+    """
+
+    def __init__(
+        self,
+        max_requests_per_minute: int = 60,
+        retention_days: int = 90,
+    ) -> None:
+        self.max_requests_per_minute = max_requests_per_minute
+        self.retention_days = retention_days
+        self._modules: dict[str, list[str]] = dict(_DEFAULT_MODULES)
+        self._rate_counters: dict[str, list[float]] = {}
+        self._audit_log: list[dict[str, Any]] = []
+        self.evolution_callback: Optional[Callable[[dict], None]] = None
+
+    def authorize(self, requester: str, data_scope: str) -> bool:
+        """Check if a module is authorized to access a data scope."""
+        allowed_scopes = self._modules.get(requester, [])
+        authorized = data_scope in allowed_scopes
+
+        self._audit_log.append({
+            "requester": requester,
+            "data_scope": data_scope,
+            "authorized": authorized,
+            "timestamp": time.time(),
+        })
+
+        self._fire_evolution("access_check", {
+            "requester": requester, "authorized": authorized,
+        })
+        return authorized
+
+    def check_rate_limit(self, requester: str) -> bool:
+        """Check if requester is within rate limit."""
+        now = time.time()
+        if requester not in self._rate_counters:
+            self._rate_counters[requester] = []
+
+        # Prune old entries (older than 60 seconds)
+        self._rate_counters[requester] = [
+            t for t in self._rate_counters[requester] if now - t < 60.0
+        ]
+
+        if len(self._rate_counters[requester]) >= self.max_requests_per_minute:
+            return False
+
+        self._rate_counters[requester].append(now)
+        return True
+
+    def reset_rate_limit(self, requester: str) -> None:
+        self._rate_counters.pop(requester, None)
+
+    def register_module(self, module_name: str, scopes: list[str]) -> None:
+        self._modules[module_name] = scopes
+
+    def revoke_module(self, module_name: str) -> None:
+        self._modules.pop(module_name, None)
+
+    def list_modules(self) -> list[str]:
+        return list(self._modules.keys())
+
+    def get_audit_log(self) -> list[dict[str, Any]]:
+        return list(self._audit_log)
+
+    def _fire_evolution(self, event_type: str, payload: dict) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({
+                "source": _EVOLUTION_KEY,
+                "type": event_type,
+                "timestamp": time.time(),
+                "payload": payload,
+            })
