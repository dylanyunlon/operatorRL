new file mode 100644
index 00000000..6540b124
--- /dev/null
+++ b/integrations/lol_history_pkg/history_aggregator.py
@@ -0,0 +1,117 @@
+"""
+History Aggregator — Aggregate statistics across match history.
+
+Computes aggregate stats: total games, wins, losses, winrate, KDA,
+per-champion breakdown, streaks, and most-played champions.
+
+Location: integrations/lol_history_pkg/history_aggregator.py
+
+Reference (拿来主义):
+  - Seraphine/app/lol/tools.py: parseGames → K/D/A/wins/losses accumulation
+  - Seraphine/app/lol/tools.py: getRecentChampions → per-champion stats
+  - Seraphine/app/lol/tools.py: parseSummonerData → games aggregation
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "lol_history.history_aggregator.v1"
+
+
+class HistoryAggregator:
+    """Aggregate statistics across a list of match records.
+
+    Mirrors Seraphine's parseSummonerData and parseGames aggregation patterns.
+    """
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[dict], None]] = None
+
+    def aggregate(self, games: list[dict[str, Any]]) -> dict[str, Any]:
+        """Aggregate basic stats from a list of game dicts.
+
+        Each game dict should have: win, kills, deaths, assists.
+        """
+        total = len(games)
+        wins = sum(1 for g in games if g.get("win", False))
+        losses = total - wins
+        total_kills = sum(g.get("kills", 0) for g in games)
+        total_deaths = sum(g.get("deaths", 0) for g in games)
+        total_assists = sum(g.get("assists", 0) for g in games)
+
+        # KDA: (K+A)/max(D,1)
+        avg_kda = (total_kills + total_assists) / max(total_deaths, 1)
+        winrate = wins / max(total, 1)
+
+        result = {
+            "total_games": total,
+            "wins": wins,
+            "losses": losses,
+            "winrate": winrate,
+            "total_kills": total_kills,
+            "total_deaths": total_deaths,
+            "total_assists": total_assists,
+            "avg_kda": avg_kda,
+        }
+        self._fire_evolution("aggregated", {"total_games": total})
+        return result
+
+    def aggregate_by_champion(
+        self, games: list[dict[str, Any]]
+    ) -> dict[int, dict[str, Any]]:
+        """Aggregate stats per champion (Seraphine getRecentChampions pattern)."""
+        by_champ: dict[int, dict[str, Any]] = {}
+        for g in games:
+            cid = g.get("championId", 0)
+            if cid not in by_champ:
+                by_champ[cid] = {"total": 0, "wins": 0, "losses": 0}
+            by_champ[cid]["total"] += 1
+            if g.get("win", False):
+                by_champ[cid]["wins"] += 1
+            else:
+                by_champ[cid]["losses"] += 1
+        return by_champ
+
+    def get_most_played(
+        self, games: list[dict[str, Any]], top_n: int = 10
+    ) -> list[dict[str, Any]]:
+        """Get most played champions sorted by total games."""
+        by_champ = self.aggregate_by_champion(games)
+        entries = [
+            {"championId": k, **v} for k, v in by_champ.items()
+        ]
+        entries.sort(key=lambda x: x["total"], reverse=True)
+        return entries[:top_n]
+
+    def detect_streak(self, games: list[dict[str, Any]]) -> dict[str, Any]:
+        """Detect current win/loss streak from most recent games.
+
+        Games should be ordered most-recent first.
+        """
+        if not games:
+            return {"type": "none", "length": 0}
+
+        first_result = games[0].get("win", False)
+        streak_type = "win" if first_result else "loss"
+        length = 0
+        for g in games:
+            if g.get("win", False) == first_result:
+                length += 1
+            else:
+                break
+
+        return {"type": streak_type, "length": length}
+
+    def _fire_evolution(self, event_type: str, payload: dict) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({
+                "source": _EVOLUTION_KEY,
+                "type": event_type,
+                "timestamp": time.time(),
+                "payload": payload,
+            })
