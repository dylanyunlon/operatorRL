@@ -0,0 +1,88 @@
+"""
+Champion Matchup Matrix — Champion vs champion winrate stats.
+
+Tracks win/loss records for every champion pair encountered in match history.
+
+Location: integrations/lol_history_pkg/champion_matchup_matrix.py
+
+Reference (拿来主义):
+  - Seraphine/app/lol/tools.py: getRecentChampions champion tracking pattern
+  - integrations/lol-history/src/lol_history/matchup_database.py: matchup storage
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "lol_history.champion_matchup_matrix.v1"
+
+
+class ChampionMatchupMatrix:
+    """Track champion-vs-champion win/loss statistics.
+
+    Records matchup outcomes and computes winrates, best/worst matchups.
+    """
+
+    def __init__(self) -> None:
+        self._matrix: dict[tuple[str, str], dict[str, int]] = {}
+        self.evolution_callback: Optional[Callable[[dict], None]] = None
+
+    def record_matchup(self, my_champ: str, enemy_champ: str, won: bool) -> None:
+        key = (my_champ, enemy_champ)
+        if key not in self._matrix:
+            self._matrix[key] = {"wins": 0, "losses": 0, "total": 0}
+        self._matrix[key]["total"] += 1
+        if won:
+            self._matrix[key]["wins"] += 1
+        else:
+            self._matrix[key]["losses"] += 1
+        self._fire_evolution("matchup_recorded", {
+            "my_champ": my_champ, "enemy_champ": enemy_champ, "won": won,
+        })
+
+    def get_matchup(self, my_champ: str, enemy_champ: str) -> dict[str, int]:
+        key = (my_champ, enemy_champ)
+        return self._matrix.get(key, {"wins": 0, "losses": 0, "total": 0})
+
+    def get_winrate(self, my_champ: str, enemy_champ: str) -> float:
+        stats = self.get_matchup(my_champ, enemy_champ)
+        if stats["total"] == 0:
+            return 0.5  # unknown → assume even
+        return stats["wins"] / stats["total"]
+
+    def get_best_matchups(self, my_champ: str, top_n: int = 5) -> list[dict[str, Any]]:
+        relevant = [
+            {"opponent": k[1], "winrate": v["wins"] / max(v["total"], 1), "total": v["total"]}
+            for k, v in self._matrix.items()
+            if k[0] == my_champ and v["total"] > 0
+        ]
+        relevant.sort(key=lambda x: x["winrate"], reverse=True)
+        return relevant[:top_n]
+
+    def get_worst_matchups(self, my_champ: str, top_n: int = 5) -> list[dict[str, Any]]:
+        relevant = [
+            {"opponent": k[1], "winrate": v["wins"] / max(v["total"], 1), "total": v["total"]}
+            for k, v in self._matrix.items()
+            if k[0] == my_champ and v["total"] > 0
+        ]
+        relevant.sort(key=lambda x: x["winrate"])
+        return relevant[:top_n]
+
+    def total_matchups(self) -> int:
+        return len(self._matrix)
+
+    def export_dict(self) -> dict[tuple[str, str], dict[str, int]]:
+        return dict(self._matrix)
+
+    def _fire_evolution(self, event_type: str, payload: dict) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({
+                "source": _EVOLUTION_KEY,
+                "type": event_type,
+                "timestamp": time.time(),
+                "payload": payload,
+            })
