+"""
+Summoner Resolver — PUUID resolution + caching.
+
+Mirrors Seraphine connector.py patterns: getSummonerByName, getSummonerByPuuid.
+Provides URL building, response parsing, and TTL-based caching.
+
+Location: integrations/lol_history_pkg/summoner_resolver.py
+
+Reference (拿来主义):
+  - Seraphine/app/lol/connector.py: getSummonerByName, getSummonerByPuuid
+  - integrations/lol-history/src/lol_history/seraphine_bridge.py: URL patterns
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "lol_history.summoner_resolver.v1"
+
+
+class SummonerResolver:
+    """Resolve summoner name ↔ PUUID with TTL caching.
+
+    Mirrors Seraphine connector.py LCU endpoints for summoner lookup.
+
+    Attributes:
+        base_url: LCU base URL.
+        cache_ttl: Cache entry time-to-live in seconds.
+        evolution_callback: Optional callback for evolution events.
+    """
+
+    def __init__(
+        self,
+        base_url: str = "https://127.0.0.1:2999",
+        cache_ttl: float = 300.0,
+        max_cache_size: int = 256,
+    ) -> None:
+        self.base_url = base_url.rstrip("/")
+        self.cache_ttl = cache_ttl
+        self._max_cache_size = max_cache_size
+        self._cache: dict[str, tuple[float, dict[str, Any]]] = {}
+        self.evolution_callback: Optional[Callable[[dict], None]] = None
+
+    # ── URL builders (Seraphine拿来主义) ──
+
+    def build_resolve_url(self, summoner_name: str) -> str:
+        return f"{self.base_url}/lol-summoner/v1/summoners?name={summoner_name}"
+
+    def build_puuid_url(self, puuid: str) -> str:
+        return f"{self.base_url}/lol-summoner/v1/summoners-by-puuid/{puuid}"
+
+    # ── Resolution (offline stubs — real impl uses HTTP) ──
+
+    def resolve_by_name(self, name: str) -> dict[str, Any]:
+        if not name:
+            result = {"puuid": "", "name": ""}
+        else:
+            cached = self.cache_get(f"name:{name}")
+            if cached is not None:
+                result = cached
+            else:
+                result = {"puuid": f"resolved-{name}", "name": name}
+                self.cache_put(f"name:{name}", result)
+        self._fire_evolution("resolve_by_name", {"name": name})
+        return result
+
+    def resolve_by_puuid(self, puuid: str) -> dict[str, Any]:
+        cached = self.cache_get(puuid)
+        if cached is not None:
+            return cached
+        result = {"puuid": puuid, "name": f"Player-{puuid[:8]}", "gameName": f"Player-{puuid[:8]}"}
+        self.cache_put(puuid, result)
+        return result
+
+    # ── Cache ──
+
+    def cache_put(self, key: str, value: dict[str, Any]) -> None:
+        if len(self._cache) >= self._max_cache_size:
+            oldest_key = min(self._cache, key=lambda k: self._cache[k][0])
+            del self._cache[oldest_key]
+        self._cache[key] = (time.time(), value)
+
+    def cache_get(self, key: str) -> Optional[dict[str, Any]]:
+        entry = self._cache.get(key)
+        if entry is None:
+            return None
+        ts, value = entry
+        if time.time() - ts > self.cache_ttl:
+            del self._cache[key]
+            return None
+        return value
+
+    def cache_size(self) -> int:
+        return len(self._cache)
+
+    # ── Evolution ──
+
+    def _fire_evolution(self, event_type: str, payload: dict) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({
+                "source": _EVOLUTION_KEY,
+                "type": event_type,
+                "timestamp": time.time(),
+                "payload": payload,
+            })
