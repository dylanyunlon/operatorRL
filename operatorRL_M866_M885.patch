+"""
+M879: LCU 数据摄入器 - 从 LCU API 拉取数据到管道
+"""
+import asyncio
+import logging
+from typing import AsyncGenerator
+
+logger = logging.getLogger("operatorRL.pipeline.ingestion")
+
+
+class LCUIngestor:
+    """从 LCU API 拉取数据并推入管道"""
+
+    def __init__(self, connector):
+        self._connector = connector
+
+    async def ingest_match_history(self, puuid: str,
+                                    count: int = 20) -> AsyncGenerator:
+        """逐条产出对局记录"""
+        games = await self._connector.get_match_history(puuid, 0, count - 1)
+        for game in games:
+            game_id = game.get("gameId")
+            if game_id:
+                try:
+                    detail = await self._connector.get_game_detail(game_id)
+                    yield detail
+                except Exception as e:
+                    logger.warning(f"Failed to get detail for {game_id}: {e}")
+                    yield game
