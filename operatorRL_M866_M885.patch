+"""
+M885: LCU Connector 单元测试
+"""
+import asyncio
+import pytest
+
+
+class TestLCUConnector:
+    """测试 LCU 连接器"""
+
+    def test_circuit_breaker_opens(self):
+        from modules.lcu_connector.connector import CircuitBreaker
+        cb = CircuitBreaker(failure_threshold=3)
+        assert cb.can_proceed()
+        cb.record_failure()
+        cb.record_failure()
+        cb.record_failure()
+        assert cb.state == "OPEN"
+        assert not cb.can_proceed()
+
+    def test_circuit_breaker_recovery(self):
+        from modules.lcu_connector.connector import CircuitBreaker
+        cb = CircuitBreaker(failure_threshold=1, recovery_timeout=0.01)
+        cb.record_failure()
+        assert cb.state == "OPEN"
+        import time
+        time.sleep(0.02)
+        assert cb.can_proceed()
+        assert cb.state == "HALF_OPEN"
+
+    def test_past_request_serialization(self):
+        from modules.lcu_connector.connector import PastRequest
+        req = PastRequest(
+            func_name="get_match_history",
+            params={"puuid": "abc"},
+            duration_ms=15.5,
+        )
+        d = req.to_dict()
