+"""
+M881: 对局结果预测器 - 基于历史数据预测胜负
+============================================
+
+"观察模型如何反映游戏在任何时刻的状态, 以及预测游戏结果"
+"""
+import statistics
+import logging
+from typing import List, Dict
+
+logger = logging.getLogger("operatorRL.models.prediction")
+
+
+class GameOutcomePredictor:
+    """
+    对局结果预测器
+
+    基于双方 10 人的历史数据预测胜负概率。
+    随着 EvolutionLoop 的迭代, 模型权重自动优化。
+    """
+
+    def __init__(self, weights: Dict[str, float] = None):
+        self._weights = weights or {
+            "kda_weight": 0.25,
+            "winrate_weight": 0.25,
+            "champion_pool_weight": 0.20,
+            "playstyle_weight": 0.15,
+            "form_weight": 0.15,
+        }
+
+    def predict(self, team_a_profiles: list,
+                team_b_profiles: list) -> dict:
+        """
+        预测对局结果
+
+        Returns:
+            {
+                "team_a_win_prob": float,
+                "team_b_win_prob": float,
+                "confidence": float,
+                "key_factors": [...],
+            }
+        """
+        a_score = self._team_score(team_a_profiles)
+        b_score = self._team_score(team_b_profiles)
+
+        total = a_score + b_score
+        if total == 0:
+            return {
+                "team_a_win_prob": 0.5,
+                "team_b_win_prob": 0.5,
+                "confidence": 0.0,
+                "key_factors": [],
+            }
+
+        a_prob = a_score / total
+        b_prob = b_score / total
+        confidence = abs(a_prob - 0.5) * 2  # 偏离50%越多越有信心
+
+        return {
+            "team_a_win_prob": round(a_prob, 3),
+            "team_b_win_prob": round(b_prob, 3),
+            "confidence": round(confidence, 3),
+            "key_factors": self._identify_key_factors(
+                team_a_profiles, team_b_profiles
+            ),
+        }
+
+    def _team_score(self, profiles: list) -> float:
+        if not profiles:
+            return 5.0
+
+        score = 0
+        w = self._weights
+
+        for p in profiles:
+            player_score = (
+                p.avg_kda * w.get("kda_weight", 0.25)
+                + p.win_rate * 10 * w.get("winrate_weight", 0.25)
+                + p.threat_level * w.get("playstyle_weight", 0.15)
+                + (1.0 if p.recent_form == "hot" else
+                   -0.5 if p.recent_form == "cold" else 0)
+                * w.get("form_weight", 0.15)
+            )
+            score += player_score
+
+        return score / len(profiles)
+
+    def _identify_key_factors(self, team_a: list, team_b: list) -> list:
+        factors = []
+
+        # 最大威胁差
+        a_max = max((p.threat_level for p in team_a), default=5)
+        b_max = max((p.threat_level for p in team_b), default=5)
+        if abs(a_max - b_max) > 3:
+            factors.append(
+                f"Significant threat gap: "
+                f"A={a_max:.1f} vs B={b_max:.1f}"
+            )
+
+        # 胜率差
+        a_wr = statistics.mean([p.win_rate for p in team_a]) if team_a else 0.5
+        b_wr = statistics.mean([p.win_rate for p in team_b]) if team_b else 0.5
+        if abs(a_wr - b_wr) > 0.1:
+            factors.append(
+                f"Winrate difference: "
+                f"A={a_wr:.0%} vs B={b_wr:.0%}"
+            )
+
+        return factors
+
+    def update_weights(self, new_weights: Dict[str, float]):
+        self._weights = new_weights
