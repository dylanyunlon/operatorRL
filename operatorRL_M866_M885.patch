+"""
+M869: Proxifier 进程规则管理器
+"""
+import logging
+from typing import Dict, List
+
+logger = logging.getLogger("operatorRL.proxifier.rules")
+
+
+class ProcessRuleManager:
+    """动态管理 Proxifier 进程规则"""
+
+    def __init__(self):
+        self._rules: Dict[str, dict] = {}
+
+    def add_proxy_rule(self, name: str, processes: List[str],
+                       proxy_id: str = "100"):
+        self._rules[name] = {
+            "processes": processes,
+            "action": "proxy",
+            "proxy_id": proxy_id,
+            "enabled": True,
+        }
+
+    def add_direct_rule(self, name: str, processes: List[str]):
+        self._rules[name] = {
+            "processes": processes,
+            "action": "direct",
+            "enabled": True,
+        }
+
+    def disable_rule(self, name: str):
+        if name in self._rules:
+            self._rules[name]["enabled"] = False
+
+    def get_active_rules(self) -> Dict[str, dict]:
+        return {
+            name: rule for name, rule in self._rules.items()
+            if rule["enabled"]
+        }
