+"""
+M876: 自演化反馈循环 - operatorRL 的核心 agentic 特性
+====================================================
+
+operatorRL 的 agentic 理念: 自部署、自环境反馈、自演化。
+
+Evolution Loop 实现:
+    1. 对局前: 预测 (基于历史数据)
+    2. 对局中: 实时反馈 (基于 Fiddler 捕获的实时数据)
+    3. 对局后: 评估预测准确度
+    4. 迭代: 调整预测模型权重
+
+每场对局都是一次训练迭代。
+"""
+
+import time
+import json
+import logging
+from typing import Dict, List, Optional
+from dataclasses import dataclass, field
+
+logger = logging.getLogger("operatorRL.evolution")
+
+
+@dataclass
+class PredictionRecord:
+    """预测记录 - 用于对局后评估"""
+    game_id: int
+    timestamp: float
+    predictions: Dict[str, any] = field(default_factory=dict)
+    actual_results: Dict[str, any] = field(default_factory=dict)
+    accuracy_scores: Dict[str, float] = field(default_factory=dict)
+    model_weights: Dict[str, float] = field(default_factory=dict)
+
+
+class EvolutionLoop:
+    """
+    自演化反馈循环
+
+    核心循环:
+        predict() -> observe() -> evaluate() -> evolve()
+    """
+
+    def __init__(self, storage_path: str = "./evolution_data"):
+        self._storage_path = storage_path
+        self._records: List[PredictionRecord] = []
+        self._model_weights: Dict[str, float] = {
+            "kda_weight": 0.25,
+            "winrate_weight": 0.25,
+            "champion_pool_weight": 0.20,
+            "playstyle_weight": 0.15,
+            "form_weight": 0.15,
+        }
+        self._iteration = 0
+
+    def record_prediction(self, game_id: int,
+                           predictions: dict) -> PredictionRecord:
+        """
+        记录对局前的预测
+
+        predictions 示例:
+        {
+            "predicted_winner": "team_a",
+            "threat_levels": {"player1": 7.5, "player2": 3.2, ...},
+            "lane_advantages": {"top": "ally", "mid": "enemy", ...},
+        }
+        """
+        record = PredictionRecord(
+            game_id=game_id,
+            timestamp=time.time(),
+            predictions=predictions,
+            model_weights=dict(self._model_weights),
+        )
+        self._records.append(record)
+        return record
+
+    def record_actual_result(self, game_id: int,
+                              actual: dict):
+        """记录对局实际结果"""
+        for record in reversed(self._records):
+            if record.game_id == game_id:
+                record.actual_results = actual
+                record.accuracy_scores = self._evaluate(record)
+                return record
+        return None
+
+    def _evaluate(self, record: PredictionRecord) -> Dict[str, float]:
+        """评估预测准确度"""
+        scores = {}
+        pred = record.predictions
+        actual = record.actual_results
+
+        # 胜负预测
+        if "predicted_winner" in pred and "actual_winner" in actual:
+            scores["winner_prediction"] = (
+                1.0 if pred["predicted_winner"] == actual["actual_winner"]
+                else 0.0
+            )
+
+        # 威胁等级准确度
+        if "threat_levels" in pred and "actual_performance" in actual:
+            threat_errors = []
+            for player_id, predicted_threat in pred["threat_levels"].items():
+                actual_perf = actual["actual_performance"].get(player_id, 5.0)
+                error = abs(predicted_threat - actual_perf) / 10.0
+                threat_errors.append(1.0 - error)
+            if threat_errors:
+                scores["threat_accuracy"] = sum(threat_errors) / len(threat_errors)
+
+        return scores
+
+    def evolve(self):
+        """
+        基于最近的评估结果调整模型权重
+
+        简单的在线学习: 表现好的维度增加权重, 表现差的减少。
+        生产版本会使用更复杂的优化算法 (如贝叶斯优化)。
+        """
+        recent = [r for r in self._records if r.accuracy_scores][-20:]
+
+        if len(recent) < 5:
+            logger.info("Not enough data for evolution (need 5+)")
+            return
+
+        self._iteration += 1
+        avg_accuracy = {}
+        for record in recent:
+            for metric, score in record.accuracy_scores.items():
+                if metric not in avg_accuracy:
+                    avg_accuracy[metric] = []
+                avg_accuracy[metric].append(score)
+
+        overall = sum(
+            sum(v) / len(v) for v in avg_accuracy.values()
+        ) / max(len(avg_accuracy), 1)
+
+        logger.info(
+            f"Evolution iteration {self._iteration}: "
+            f"overall accuracy = {overall:.2%}"
+        )
+
+        # 简单权重调整 (学习率 0.01)
+        lr = 0.01
+        if "winner_prediction" in avg_accuracy:
+            wp_acc = sum(avg_accuracy["winner_prediction"]) / len(
+                avg_accuracy["winner_prediction"]
+            )
+            if wp_acc < 0.5:
+                # 胜负预测不准, 增加 winrate 权重
+                self._model_weights["winrate_weight"] += lr
+                self._model_weights["playstyle_weight"] -= lr
+
+        # 归一化权重
+        total = sum(self._model_weights.values())
+        self._model_weights = {
+            k: v / total for k, v in self._model_weights.items()
+        }
+
+    def get_current_weights(self) -> Dict[str, float]:
+        return dict(self._model_weights)
+
+    def get_evolution_stats(self) -> dict:
+        """获取演化统计"""
+        evaluated = [r for r in self._records if r.accuracy_scores]
+        return {
+            "total_games": len(self._records),
+            "evaluated_games": len(evaluated),
+            "iteration": self._iteration,
+            "current_weights": self._model_weights,
+            "avg_accuracy": self._compute_avg_accuracy(evaluated),
+        }
+
+    @staticmethod
+    def _compute_avg_accuracy(records: list) -> Dict[str, float]:
+        acc = {}
+        for r in records:
+            for metric, score in r.accuracy_scores.items():
+                if metric not in acc:
+                    acc[metric] = []
+                acc[metric].append(score)
+        return {k: sum(v) / len(v) for k, v in acc.items()} if acc else {}
