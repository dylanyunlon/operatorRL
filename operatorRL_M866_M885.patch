+"""
+M870: 批量对局收集器 - 同时收集多个玩家的历史数据
+"""
+import asyncio
+import logging
+from typing import List, Dict
+
+logger = logging.getLogger("operatorRL.history_battle.batch")
+
+
+class BatchCollector:
+    """
+    批量收集器 - 选人阶段同时获取 10 人历史数据
+
+    Seraphine 在选人阶段串行获取队友数据。
+    operatorRL 并行获取所有 10 人 (5 队友 + 5 对手) 的历史数据。
+    """
+
+    def __init__(self, match_collector):
+        self._collector = match_collector
+
+    async def collect_all_players(self, puuids: List[str],
+                                   count: int = 10,
+                                   ranked_only: bool = True) -> Dict[str, list]:
+        """
+        并行收集多个玩家的对局历史
+
+        Args:
+            puuids: 玩家 PUUID 列表
+            count: 每个玩家需要的对局数量
+            ranked_only: 只获取排位赛
+
+        Returns:
+            {puuid: [MatchRecord, ...]}
+        """
+        tasks = []
+        for puuid in puuids:
+            task = asyncio.create_task(
+                self._collector.collect_player_history(
+                    puuid, count, ranked_only
+                )
+            )
+            tasks.append((puuid, task))
+
+        results = {}
+        for puuid, task in tasks:
+            try:
+                records = await task
+                results[puuid] = records
+                logger.info(
+                    f"Collected {len(records)} games for {puuid[:8]}..."
+                )
+            except Exception as e:
+                logger.error(
+                    f"Failed to collect for {puuid[:8]}...: {e}"
+                )
+                results[puuid] = []
+
+        return results
+
+    async def collect_champ_select_players(self, champ_select_session: dict,
+                                            count: int = 10) -> Dict[str, list]:
+        """
+        从选人阶段会话中提取所有玩家并批量收集
+
+        Seraphine 只获取队友。operatorRL 获取全部10人 (包括对手, 通过 SGP)。
+        """
+        puuids = []
+
+        # 我方队伍
+        my_team = champ_select_session.get("myTeam", [])
+        for player in my_team:
+            puuid = player.get("puuid")
+            if puuid:
+                puuids.append(puuid)
+
+        # 对方队伍 (如果可见)
+        their_team = champ_select_session.get("theirTeam", [])
+        for player in their_team:
+            puuid = player.get("puuid")
+            if puuid:
+                puuids.append(puuid)
+
+        return await self.collect_all_players(puuids, count)
