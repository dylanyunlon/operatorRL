+"""
+M885: Battle Analyzer 单元测试
+"""
+import pytest
+from dataclasses import dataclass
+
+
+@dataclass
+class MockMatch:
+    game_id: int = 1
+    champion_id: int = 1
+    champion_name: str = "Jinx"
+    role: str = "ADC"
+    win: bool = True
+    kills: int = 8
+    deaths: int = 3
+    assists: int = 10
+    cs: int = 200
+    gold_earned: int = 14000
+    damage_dealt: int = 25000
+    damage_taken: int = 15000
+    vision_score: int = 25
+    game_duration: int = 1800
+    game_mode: str = "CLASSIC"
+    queue_type: str = "RANKED_SOLO_5x5"
+    timestamp: int = 1700000000
+
+    @property
+    def kda(self):
+        return (self.kills + self.assists) / max(self.deaths, 1)
+
+    @property
+    def cs_per_min(self):
+        return self.cs / max(self.game_duration / 60, 1)
+
+    @property
+    def gold_per_min(self):
+        return self.gold_earned / max(self.game_duration / 60, 1)
+
+    @property
+    def damage_per_min(self):
+        return self.damage_dealt / max(self.game_duration / 60, 1)
+
+
+class TestBattleAnalyzer:
+
+    def test_analyze_player_basic(self):
+        from modules.history_battle.analyzer.battle_analyzer import BattleAnalyzer
+        analyzer = BattleAnalyzer()
+        matches = [MockMatch() for _ in range(10)]
+        profile = analyzer.analyze_player("test-puuid", matches)
+        assert profile.avg_kda == 6.0
+        assert profile.win_rate == 1.0
+        assert profile.threat_level > 5.0
+        assert "Jinx" in profile.champion_pool
+
+    def test_analyze_empty(self):
+        from modules.history_battle.analyzer.battle_analyzer import BattleAnalyzer
+        analyzer = BattleAnalyzer()
+        profile = analyzer.analyze_player("empty", [])
+        assert profile.threat_level == 0.0
