+"""
+M868: Fiddler MCP Bridge - Fiddler Everywhere MCP Server 集成
+============================================================
+
+参考: https://www.telerik.com/fiddler/fiddler-everywhere/documentation/mcp-server/fiddler-mcp-server
+
+Fiddler MCP Server 提供的工具:
+    get_status          - 应用状态检查
+    is_user_logged_in   - 登录状态
+    start_capture_with_browser   - 启动浏览器捕获
+    start_capture_with_terminal  - 启动终端捕获
+    get_sessions        - 获取捕获的会话列表
+    get_sessions_count  - 会话计数
+    get_session_details - 会话详情 (请求/响应头/体)
+    apply_filters       - 应用过滤条件
+    clear_sessions      - 清除会话
+    create_rule         - 创建流量规则
+    clear_rules         - 清除规则
+    add_reverse_proxy_port    - 添加反向代理端口
+    remove_reverse_proxy_port - 移除反向代理端口
+    enable_reverse_proxy      - 启用反向代理
+    disable_reverse_proxy     - 禁用反向代理
+
+设计理念:
+    Fiddler 通过反向代理捕获 LoL 客户端的 HTTPS 流量,
+    MCP Server 暴露 HTTP 接口让 operatorRL 的 AI 模型可以直接分析协议数据。
+    这比视觉方案精度高 (零幻觉), 延迟低 (<5ms vs ~70ms+推理时间)。
+"""
+
+import asyncio
+import json
+import logging
+from typing import Optional, Dict, Any, List
+
+import aiohttp
+
+logger = logging.getLogger("operatorRL.fiddler_mcp")
+
+
+class FiddlerMCPBridge:
+    """
+    Fiddler Everywhere MCP Server 桥接器
+
+    通过 MCP 协议与 Fiddler 通信, 获取/分析 HTTPS 流量。
+    默认连接 http://localhost:8868/mcp
+    """
+
+    DEFAULT_PORT = 8868
+    DEFAULT_URL = "http://localhost:{port}/mcp"
+
+    def __init__(self, api_key: str, port: int = DEFAULT_PORT):
+        self._api_key = api_key
+        self._port = port
+        self._base_url = self.DEFAULT_URL.format(port=port)
+        self._session: Optional[aiohttp.ClientSession] = None
+
+    async def connect(self) -> bool:
+        """建立与 Fiddler MCP Server 的连接"""
+        self._session = aiohttp.ClientSession(
+            headers={
+                "Authorization": f"ApiKey {self._api_key}",
+                "Content-Type": "application/json",
+            }
+        )
+        try:
+            status = await self.get_status()
+            logger.info(f"Fiddler MCP connected: {status}")
+            return True
+        except Exception as e:
+            logger.error(f"Fiddler MCP connection failed: {e}")
+            return False
+
+    async def disconnect(self):
+        if self._session:
+            await self._session.close()
+            self._session = None
+
+    async def _call_tool(self, tool_name: str,
+                         arguments: Optional[dict] = None) -> dict:
+        """调用 MCP 工具"""
+        if not self._session:
+            raise ConnectionError("Fiddler MCP not connected")
+
+        payload = {
+            "jsonrpc": "2.0",
+            "method": "tools/call",
+            "params": {
+                "name": tool_name,
+                "arguments": arguments or {},
+            },
+            "id": 1,
+        }
+
+        async with self._session.post(self._base_url,
+                                       json=payload) as resp:
+            result = await resp.json()
+            if "error" in result:
+                raise RuntimeError(
+                    f"Fiddler MCP error: {result['error']}"
+                )
+            return result.get("result", {})
+
+    # ========== 状态检查 ==========
+
+    async def get_status(self) -> dict:
+        """获取 Fiddler 应用状态"""
+        return await self._call_tool("get_status")
+
+    async def is_user_logged_in(self) -> bool:
+        """检查用户是否已登录"""
+        result = await self._call_tool("is_user_logged_in")
+        return result.get("loggedIn", False)
+
+    # ========== 流量捕获 ==========
+
+    async def start_browser_capture(self) -> dict:
+        """启动浏览器捕获模式"""
+        return await self._call_tool("start_capture_with_browser")
+
+    async def start_terminal_capture(self) -> dict:
+        """启动终端捕获模式"""
+        return await self._call_tool("start_capture_with_terminal")
+
+    # ========== 会话管理 (核心功能) ==========
+
+    async def get_sessions(self, filters: Optional[dict] = None) -> List[dict]:
+        """
+        获取捕获的 HTTP/HTTPS 会话列表
+
+        这是获取 LoL 客户端网络通信的核心方法。
+        配合 Proxifier 将游戏流量路由到 Fiddler, 即可捕获所有协议数据。
+        """
+        if filters:
+            await self.apply_filters(filters)
+        result = await self._call_tool("get_sessions")
+        return result.get("sessions", [])
+
+    async def get_sessions_count(self) -> int:
+        """获取当前捕获的会话数量"""
+        result = await self._call_tool("get_sessions_count")
+        return result.get("count", 0)
+
+    async def get_session_details(self, session_id: int) -> dict:
+        """
+        获取特定会话的完整详情
+
+        返回:
+            request/response headers, body, HTTP method, URL,
+            status code, protocol, timing, TLS info, IP addresses
+        """
+        return await self._call_tool(
+            "get_session_details",
+            {"sessionId": session_id}
+        )
+
+    async def apply_filters(self, filters: dict) -> dict:
+        """
+        应用过滤条件
+
+        Args:
+            filters: 过滤条件 (URL pattern, status code, HTTP method 等)
+
+        示例:
+            await bridge.apply_filters({
+                "url": "*/lol-match-history/*",
+                "method": "GET"
+            })
+        """
+        return await self._call_tool("apply_filters", filters)
+
+    async def clear_sessions(self) -> dict:
+        """清除所有捕获的会话"""
+        return await self._call_tool("clear_sessions")
+
+    # ========== 流量规则 ==========
+
+    async def create_rule(self, match_conditions: dict,
+                          actions: dict) -> dict:
+        """
+        创建流量操纵规则
+
+        可用于:
+        - 拦截并修改请求/响应
+        - URL 重定向
+        - 注入自定义内容
+        - 模拟延迟
+        """
+        return await self._call_tool("create_rule", {
+            "matchConditions": match_conditions,
+            "actions": actions,
+        })
+
+    async def clear_rules(self) -> dict:
+        """清除所有 MCP 创建的规则"""
+        return await self._call_tool("clear_rules")
+
+    # ========== 反向代理 (关键 - LoL 流量捕获) ==========
+
+    async def add_reverse_proxy(self, local_port: int,
+                                remote_host: str,
+                                remote_port: int) -> dict:
+        """
+        添加反向代理端口映射
+
+        对于 LoL:
+        - 配合 Proxifier 将 LeagueClientUx.exe 流量路由到本地端口
+        - Fiddler 通过反向代理转发到实际 LCU 端口
+
+        Args:
+            local_port: 本地监听端口 (Proxifier 将流量发到这里)
+            remote_host: 远程主机 (通常是 127.0.0.1)
+            remote_port: 远程端口 (LCU 实际端口)
+        """
+        return await self._call_tool("add_reverse_proxy_port", {
+            "localPort": local_port,
+            "remoteHost": remote_host,
+            "remotePort": remote_port,
+        })
+
+    async def remove_reverse_proxy(self, local_port: int) -> dict:
+        """移除反向代理端口"""
+        return await self._call_tool("remove_reverse_proxy_port", {
+            "localPort": local_port,
+        })
+
+    async def enable_reverse_proxy(self) -> dict:
+        """启用反向代理"""
+        return await self._call_tool("enable_reverse_proxy")
+
+    async def disable_reverse_proxy(self) -> dict:
+        """禁用反向代理"""
+        return await self._call_tool("disable_reverse_proxy")
+
+    # ========== LoL 专用便捷方法 ==========
+
+    async def get_lol_api_sessions(self) -> List[dict]:
+        """获取所有 LoL LCU API 相关的捕获会话"""
+        await self.apply_filters({
+            "url": "*riot*|*lol*|*league*",
+        })
+        return await self.get_sessions()
+
+    async def get_match_history_traffic(self) -> List[dict]:
+        """获取对局历史相关的流量"""
+        await self.apply_filters({
+            "url": "*match-history*|*lol-match*",
+        })
+        sessions = await self.get_sessions()
+
+        detailed = []
+        for s in sessions:
+            sid = s.get("id")
+            if sid:
+                detail = await self.get_session_details(sid)
+                detailed.append(detail)
+        return detailed
+
+    async def setup_lol_proxy(self, lcu_port: int,
+                              proxy_port: int = 9000) -> bool:
+        """
+        一键配置 LoL 流量捕获
+
+        1. 添加反向代理 (proxy_port -> 127.0.0.1:lcu_port)
+        2. 启用反向代理
+        3. 设置过滤条件
+
+        配合 Proxifier:
+            - 规则: LeagueClientUx.exe -> 127.0.0.1:proxy_port (HTTPS)
+        """
+        try:
+            await self.add_reverse_proxy(
+                proxy_port, "127.0.0.1", lcu_port
+            )
+            await self.enable_reverse_proxy()
+            logger.info(
+                f"LoL proxy setup: :{proxy_port} -> :{ lcu_port}"
+            )
+            return True
+        except Exception as e:
+            logger.error(f"LoL proxy setup failed: {e}")
+            return False
+
+    async def __aenter__(self):
+        await self.connect()
+        return self
+
+    async def __aexit__(self, *args):
+        await self.disconnect()
