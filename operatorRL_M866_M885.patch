+"""
+M880: 数据标准化器 - 将多源数据统一为标准格式
+"""
+import logging
+from typing import Dict, Any, Optional
+
+logger = logging.getLogger("operatorRL.pipeline.transform")
+
+
+class DataNormalizer:
+    """统一多源数据格式"""
+
+    def normalize_lcu_game(self, raw: dict) -> dict:
+        """标准化 LCU API 返回的对局数据"""
+        participants = raw.get("participants", [])
+        return {
+            "game_id": raw.get("gameId"),
+            "mode": raw.get("gameMode"),
+            "duration": raw.get("gameDuration"),
+            "timestamp": raw.get("gameCreation"),
+            "participants": [
+                self._normalize_participant(p) for p in participants
+            ],
+        }
+
+    def normalize_fiddler_session(self, raw: dict) -> dict:
+        """标准化 Fiddler 捕获的会话数据"""
+        return {
+            "url": raw.get("url"),
+            "method": raw.get("method"),
+            "status": raw.get("statusCode"),
+            "duration_ms": raw.get("duration"),
+            "has_response": bool(raw.get("responseBody")),
+        }
+
+    def _normalize_participant(self, p: dict) -> dict:
+        stats = p.get("stats", {})
+        return {
+            "champion_id": p.get("championId"),
+            "team_id": p.get("teamId"),
+            "kills": stats.get("kills", 0),
+            "deaths": stats.get("deaths", 0),
+            "assists": stats.get("assists", 0),
+            "gold": stats.get("goldEarned", 0),
+            "cs": (stats.get("totalMinionsKilled", 0)
+                   + stats.get("neutralMinionsKilled", 0)),
+            "damage": stats.get("totalDamageDealtToChampions", 0),
+            "vision": stats.get("visionScore", 0),
+            "win": stats.get("win", False),
+        }
