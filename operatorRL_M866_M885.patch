+"""
+M877: 建议语音队列 - 管理语音输出的优先级队列
+"""
+import asyncio
+import time
+import logging
+from typing import Optional
+
+logger = logging.getLogger("operatorRL.voice.queue")
+
+
+class AdviceQueue:
+    """优先级语音队列"""
+
+    def __init__(self, min_interval: float = 5.0):
+        self._queue: asyncio.PriorityQueue = asyncio.PriorityQueue()
+        self._min_interval = min_interval
+        self._last_speak_time = 0.0
+
+    async def enqueue(self, priority: int, text: str):
+        """入队 (priority 越小越优先)"""
+        await self._queue.put((-priority, time.time(), text))
+
+    async def dequeue(self) -> Optional[str]:
+        """出队 (尊重最小间隔)"""
+        try:
+            priority, ts, text = await asyncio.wait_for(
+                self._queue.get(), timeout=1.0
+            )
+        except asyncio.TimeoutError:
+            return None
+
+        # 最小间隔控制
+        elapsed = time.time() - self._last_speak_time
+        if elapsed < self._min_interval:
+            await asyncio.sleep(self._min_interval - elapsed)
+
+        self._last_speak_time = time.time()
+        return text
+
+    @property
+    def pending_count(self) -> int:
+        return self._queue.qsize()
