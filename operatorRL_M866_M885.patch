+"""
+M866: LCU 异常定义 (参考 Seraphine exceptions.py)
+"""
+
+
+class LCUError(Exception):
+    """LCU API 基础异常"""
+    pass
+
+
+class SummonerNotFound(LCUError):
+    """召唤师未找到"""
+    pass
+
+
+class SummonerGamesNotFound(LCUError):
+    """对局历史未找到"""
+    pass
+
+
+class SummonerRankInfoNotFound(LCUError):
+    """排位信息未找到"""
+    pass
+
+
+class LCUConnectionError(LCUError):
+    """连接错误"""
+    pass
+
+
+class SGPTokenError(LCUError):
+    """SGP 令牌获取失败"""
+    pass
+
+
+class CircuitBreakerOpen(LCUError):
+    """熔断器开启"""
+    pass
