+"""
+M870: Data Dragon 静态数据获取
+"""
+import logging
+from typing import Dict, Optional
+
+logger = logging.getLogger("operatorRL.adapters.data_dragon")
+
+
+class DataDragonClient:
+    """Riot Data Dragon 静态资源客户端"""
+
+    BASE_URL = "https://ddragon.leagueoflegends.com"
+
+    def __init__(self, version: str = "14.1.1", locale: str = "zh_CN"):
+        self._version = version
+        self._locale = locale
+        self._champion_cache: Dict[int, str] = {}
+
+    @property
+    def champions_url(self) -> str:
+        return (
+            f"{self.BASE_URL}/cdn/{self._version}/data/"
+            f"{self._locale}/champion.json"
+        )
+
+    @property
+    def items_url(self) -> str:
+        return (
+            f"{self.BASE_URL}/cdn/{self._version}/data/"
+            f"{self._locale}/item.json"
+        )
+
+    def get_champion_icon_url(self, champion_name: str) -> str:
+        return (
+            f"{self.BASE_URL}/cdn/{self._version}/img/"
+            f"champion/{champion_name}.png"
+        )
