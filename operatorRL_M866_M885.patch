+"""
+M873: 对局模式引擎 - 对手行为模式识别与预测
+=============================================
+
+从历史对局数据中提取对手的行为模式, 用于:
+    1. 预测对手选人 (基于英雄池和当前阵容)
+    2. 预测对手出装路线
+    3. 预测对手打法风格 (是否倾向于反野、抢龙、分推)
+    4. 预测对局走势 (基于双方历史数据的模式匹配)
+"""
+
+import logging
+from typing import List, Dict, Optional, Tuple
+from collections import defaultdict, Counter
+import statistics
+
+logger = logging.getLogger("operatorRL.history_battle.pattern")
+
+
+class MatchPatternEngine:
+    """
+    对局模式匹配引擎
+
+    核心思路: 历史数据 -> 行为模式 -> 预测
+    这是 operatorRL 的 agentic 特性之一:
+    系统根据环境反馈 (历史数据) 自我演化预测模型。
+    """
+
+    def __init__(self):
+        self._pattern_cache: Dict[str, dict] = {}
+
+    def extract_champion_patterns(self, matches: list) -> dict:
+        """
+        提取英雄选择模式
+
+        Returns:
+            {
+                "most_played": [...],
+                "win_rate_by_champ": {...},
+                "role_preference": {...},
+                "counter_picks": {...},
+            }
+        """
+        champ_stats = defaultdict(lambda: {"games": 0, "wins": 0})
+        role_champ = defaultdict(list)
+
+        for m in matches:
+            key = m.champion_name
+            champ_stats[key]["games"] += 1
+            if m.win:
+                champ_stats[key]["wins"] += 1
+            role_champ[m.role].append(key)
+
+        most_played = sorted(
+            champ_stats.items(),
+            key=lambda x: x[1]["games"],
+            reverse=True,
+        )
+
+        win_rate_by_champ = {
+            champ: stats["wins"] / max(stats["games"], 1)
+            for champ, stats in champ_stats.items()
+        }
+
+        role_preference = {}
+        for role, champs in role_champ.items():
+            counter = Counter(champs)
+            role_preference[role] = counter.most_common(3)
+
+        return {
+            "most_played": [(c, s) for c, s in most_played[:10]],
+            "win_rate_by_champ": win_rate_by_champ,
+            "role_preference": role_preference,
+        }
+
+    def predict_champion_pick(self, matches: list,
+                               available_champions: Optional[List[str]] = None,
+                               team_comp: Optional[List[str]] = None) -> List[Tuple[str, float]]:
+        """
+        预测对手可能的英雄选择
+
+        Args:
+            matches: 对手的历史对局
+            available_champions: 可选英雄 (未被 ban/pick)
+            team_comp: 当前队伍阵容
+
+        Returns:
+            [(champion_name, probability), ...]
+        """
+        patterns = self.extract_champion_patterns(matches)
+
+        predictions = []
+        for champ, stats in patterns["most_played"]:
+            freq = stats["games"] / len(matches) if matches else 0
+            wr = patterns["win_rate_by_champ"].get(champ, 0.5)
+
+            # 权重: 使用频率 * 0.6 + 胜率 * 0.4
+            score = freq * 0.6 + wr * 0.4
+
+            # 过滤不可用英雄
+            if available_champions and champ not in available_champions:
+                continue
+
+            predictions.append((champ, score))
+
+        predictions.sort(key=lambda x: x[1], reverse=True)
+        return predictions[:5]
+
+    def detect_playstyle_pattern(self, matches: list) -> dict:
+        """
+        检测打法模式
+
+        Returns:
+            {
+                "aggression_level": float,      # 0-10
+                "farm_focus": float,             # 0-10
+                "team_fight_tendency": float,    # 0-10
+                "split_push_tendency": float,    # 0-10
+                "objective_focus": float,        # 0-10
+                "early_game_strength": float,    # 0-10
+            }
+        """
+        if not matches:
+            return {k: 5.0 for k in [
+                "aggression_level", "farm_focus",
+                "team_fight_tendency", "split_push_tendency",
+                "objective_focus", "early_game_strength",
+            ]}
+
+        avg_kills = statistics.mean([m.kills for m in matches])
+        avg_deaths = statistics.mean([m.deaths for m in matches])
+        avg_assists = statistics.mean([m.assists for m in matches])
+        avg_cs = statistics.mean([m.cs_per_min for m in matches])
+        avg_damage = statistics.mean([m.damage_per_min for m in matches])
+
+        # 参团率估算
+        kill_participation = (avg_kills + avg_assists) / max(
+            avg_kills + avg_assists + avg_deaths, 1
+        )
+
+        return {
+            "aggression_level": min(10, (avg_kills + avg_deaths) * 0.8),
+            "farm_focus": min(10, avg_cs * 1.1),
+            "team_fight_tendency": min(10, kill_participation * 12),
+            "split_push_tendency": min(10, avg_cs * 0.8 - kill_participation * 3),
+            "objective_focus": min(10, avg_assists * 0.8 + 2),
+            "early_game_strength": min(10, avg_kills * 0.7 + avg_cs * 0.3),
+        }
+
+    def find_similar_matchups(self, player_matches: list,
+                                opponent_matches: list,
+                                top_n: int = 5) -> list:
+        """
+        查找历史上相似的对局组合
+
+        通过分析双方历史, 找到最相似的对局场景。
+        """
+        player_champs = Counter(m.champion_name for m in player_matches)
+        opponent_champs = Counter(m.champion_name for m in opponent_matches)
+
+        matchups = []
+        for p_champ in player_champs:
+            for o_champ in opponent_champs:
+                # 找双方都玩过的对位场景
+                p_games = [
+                    m for m in player_matches if m.champion_name == p_champ
+                ]
+                o_games = [
+                    m for m in opponent_matches if m.champion_name == o_champ
+                ]
+                if p_games and o_games:
+                    matchups.append({
+                        "player_champ": p_champ,
+                        "opponent_champ": o_champ,
+                        "player_wr": sum(1 for m in p_games if m.win) / len(p_games),
+                        "opponent_wr": sum(1 for m in o_games if m.win) / len(o_games),
+                        "sample_size": min(len(p_games), len(o_games)),
+                    })
+
+        matchups.sort(key=lambda x: x["sample_size"], reverse=True)
+        return matchups[:top_n]
