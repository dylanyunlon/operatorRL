+"""
+M875: 建议格式化器 - 将建议格式化为语音友好的文本
+"""
+import logging
+
+logger = logging.getLogger("operatorRL.tactical.formatter")
+
+
+class AdviceFormatter:
+    """将 TacticalAdvice 格式化为适合 TTS 朗读的文本"""
+
+    PHASE_PREFIX = {
+        "champ_select": "选人阶段提示",
+        "laning": "对线提示",
+        "mid_game": "中期提示",
+        "late_game": "后期提示",
+    }
+
+    def format_for_tts(self, advice) -> str:
+        """格式化为 TTS 文本"""
+        prefix = self.PHASE_PREFIX.get(advice.phase, "提示")
+        return f"{prefix}: {advice.message}"
+
+    def format_for_overlay(self, advice) -> dict:
+        """格式化为 overlay 显示"""
+        return {
+            "text": advice.message,
+            "priority": advice.priority,
+            "phase": advice.phase,
+            "color": self._priority_color(advice.priority),
+        }
+
+    @staticmethod
+    def _priority_color(priority: int) -> str:
+        colors = {5: "#FF0000", 4: "#FF6600", 3: "#FFCC00",
+                  2: "#00CC00", 1: "#0099FF"}
+        return colors.get(priority, "#FFFFFF")
