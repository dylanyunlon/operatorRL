@@ -0,0 +1,453 @@
+"""
+M866: LCU Connector - operatorRL 的英雄联盟客户端 API 连接器
+========================================================
+
+设计来源: Seraphine/app/lol/connector.py (1411行)
+核心改进:
+    1. 去除 PyQt5 依赖, 改为纯 asyncio 事件驱动
+    2. 双通道设计保留 (LCU API + SGP 协议), 增加 Fiddler MCP 第三通道
+    3. retry 装饰器增加指数退避和熔断器模式
+    4. 请求历史队列增加持久化, 支持跨会话分析
+
+Seraphine 原始 API 端点 (已验证):
+    /lol-match-history/v1/products/lol/{puuid}/matches
+    /lol-match-history/v1/games/{gameId}
+    /lol-ranked/v1/ranked-stats/{puuid}
+    /match-history-query/v1/products/lol/player/{puuid}/SUMMARY  (SGP)
+    /gsm/v1/ledge/spectator/region/{region}/puuid/{puuid}  (SGP)
+    /lol-champ-select/v1/session
+"""
+
+import asyncio
+import time
+import ssl
+import base64
+import logging
+import functools
+from collections import deque
+from typing import Optional, Dict, Any, List
+from dataclasses import dataclass, field
+
+import aiohttp
+
+logger = logging.getLogger("operatorRL.lcu_connector")
+
+
+@dataclass
+class PastRequest:
+    """请求历史记录 - 改进自 Seraphine 的 PastRequest"""
+    func_name: str
+    params: Dict[str, Any]
+    response: Optional[Any] = None
+    timestamp: float = field(default_factory=time.time)
+    duration_ms: float = 0.0
+    retry_count: int = 0
+    error: Optional[str] = None
+
+    def to_dict(self) -> dict:
+        return {
+            "func": self.func_name,
+            "params": self.params,
+            "ts": self.timestamp,
+            "dur_ms": self.duration_ms,
+            "retries": self.retry_count,
+            "error": self.error,
+        }
+
+
+class CircuitBreaker:
+    """熔断器 - Seraphine 缺少此关键生产级组件"""
+
+    def __init__(self, failure_threshold: int = 5,
+                 recovery_timeout: float = 30.0):
+        self.failure_threshold = failure_threshold
+        self.recovery_timeout = recovery_timeout
+        self.failure_count = 0
+        self.last_failure_time = 0.0
+        self.state = "CLOSED"  # CLOSED / OPEN / HALF_OPEN
+
+    def record_failure(self):
+        self.failure_count += 1
+        self.last_failure_time = time.time()
+        if self.failure_count >= self.failure_threshold:
+            self.state = "OPEN"
+            logger.warning(
+                f"CircuitBreaker OPEN after {self.failure_count} failures"
+            )
+
+    def record_success(self):
+        self.failure_count = 0
+        self.state = "CLOSED"
+
+    def can_proceed(self) -> bool:
+        if self.state == "CLOSED":
+            return True
+        if self.state == "OPEN":
+            elapsed = time.time() - self.last_failure_time
+            if elapsed >= self.recovery_timeout:
+                self.state = "HALF_OPEN"
+                return True
+            return False
+        # HALF_OPEN: 允许一次试探
+        return True
+
+
+def retry(count: int = 5, backoff_base: float = 0.5,
+          backoff_max: float = 10.0):
+    """
+    增强版 retry 装饰器 - 改进自 Seraphine 的 retry 装饰器
+    增加: 指数退避, 最大退避时间, 与熔断器集成
+    """
+    def decorator(func):
+        @functools.wraps(func)
+        async def wrapper(self, *args, **kwargs):
+            last_error = None
+            for attempt in range(count):
+                if hasattr(self, '_breaker') and not self._breaker.can_proceed():
+                    raise ConnectionError(
+                        "CircuitBreaker OPEN - LCU API unavailable"
+                    )
+                try:
+                    start_t = time.time()
+                    result = await func(self, *args, **kwargs)
+                    duration = (time.time() - start_t) * 1000
+
+                    if hasattr(self, '_breaker'):
+                        self._breaker.record_success()
+
+                    # 记录请求历史
+                    if hasattr(self, '_request_history'):
+                        req = PastRequest(
+                            func_name=func.__name__,
+                            params={"args": str(args), "kwargs": str(kwargs)},
+                            duration_ms=duration,
+                            retry_count=attempt,
+                        )
+                        self._request_history.append(req)
+
+                    return result
+
+                except Exception as e:
+                    last_error = e
+                    if hasattr(self, '_breaker'):
+                        self._breaker.record_failure()
+
+                    wait_time = min(
+                        backoff_base * (2 ** attempt), backoff_max
+                    )
+                    logger.debug(
+                        f"{func.__name__} attempt {attempt+1}/{count} "
+                        f"failed: {e}, retry in {wait_time:.1f}s"
+                    )
+                    await asyncio.sleep(wait_time)
+
+            raise last_error
+
+        return wrapper
+    return decorator
+
+
+def need_lcu(func):
+    """确保 LCU 会话可用 - 改进自 Seraphine 的 needLcu 装饰器"""
+    @functools.wraps(func)
+    async def wrapper(self, *args, **kwargs):
+        if self._lcu_session is None:
+            raise ConnectionError(
+                "LCU session not established. "
+                "Call connect() first or wait for client startup."
+            )
+        return await func(self, *args, **kwargs)
+    return wrapper
+
+
+class LCUConnector:
+    """
+    operatorRL 的 LCU 连接器
+
+    架构对比 Seraphine:
+    - Seraphine: connector.py 是单例全局对象, 耦合 PyQt QObject
+    - operatorRL: 无GUI依赖, 纯异步, 支持多实例(多客户端)
+
+    三通道数据获取:
+    1. LCU API (本地 HTTPS, wss://127.0.0.1:{port})
+    2. SGP (Server Gateway Protocol, 腾讯/Riot 服务器网关)
+    3. Fiddler MCP (通过 Fiddler Everywhere 的 MCP Server 获取流量分析)
+    """
+
+    def __init__(self, max_history: int = 1000):
+        self._lcu_session: Optional[aiohttp.ClientSession] = None
+        self._sgp_session: Optional[aiohttp.ClientSession] = None
+        self._port: int = 0
+        self._auth_token: str = ""
+        self._server: str = ""
+        self._sgp_url: str = ""
+        self._sgp_token: str = ""
+        self._in_tencent: bool = False
+        self._breaker = CircuitBreaker()
+        self._request_history: deque = deque(maxlen=max_history)
+
+    async def connect(self, port: int, auth_token: str,
+                      server: str = "HN10") -> bool:
+        """
+        建立与 LCU 的连接
+
+        Seraphine 通过 getPortTokenServerByPid 从进程参数获取端口和令牌。
+        operatorRL 支持外部注入(更灵活, 适配 Proxifier 场景)。
+
+        Args:
+            port: LCU API 端口 (通常从 LeagueClientUx 进程参数获取)
+            auth_token: Base64 编码的 riot:token
+            server: 服务器标识 (如 HN10, NA1)
+        """
+        self._port = port
+        self._auth_token = auth_token
+        self._server = server
+
+        auth_str = base64.b64encode(
+            f"riot:{auth_token}".encode()
+        ).decode()
+
+        ssl_ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
+        ssl_ctx.check_hostname = False
+        ssl_ctx.verify_mode = ssl.CERT_NONE
+
+        connector = aiohttp.TCPConnector(ssl=ssl_ctx)
+        self._lcu_session = aiohttp.ClientSession(
+            connector=connector,
+            base_url=f"https://127.0.0.1:{port}",
+            headers={"Authorization": f"Basic {auth_str}"},
+        )
+
+        # 验证连接
+        try:
+            summoner = await self.get_current_summoner()
+            logger.info(
+                f"Connected to LCU, summoner: "
+                f"{summoner.get('displayName', 'Unknown')}"
+            )
+            return True
+        except Exception as e:
+            logger.error(f"LCU connection verification failed: {e}")
+            await self.disconnect()
+            return False
+
+    async def disconnect(self):
+        if self._lcu_session:
+            await self._lcu_session.close()
+            self._lcu_session = None
+        if self._sgp_session:
+            await self._sgp_session.close()
+            self._sgp_session = None
+
+    # ========== LCU API 通道 ==========
+
+    @need_lcu
+    async def _get(self, path: str,
+                   params: Optional[dict] = None) -> aiohttp.ClientResponse:
+        return await self._lcu_session.get(path, params=params, ssl=False)
+
+    @need_lcu
+    async def _post(self, path: str,
+                    data: Optional[dict] = None) -> aiohttp.ClientResponse:
+        headers = {"Content-Type": "application/json"}
+        return await self._lcu_session.post(
+            path, json=data, headers=headers, ssl=False
+        )
+
+    @need_lcu
+    async def _put(self, path: str,
+                   data: Optional[dict] = None) -> aiohttp.ClientResponse:
+        return await self._lcu_session.put(path, json=data, ssl=False)
+
+    # ========== SGP 通道 ==========
+
+    async def _sgp_get(self, path: str,
+                       params: Optional[dict] = None) -> aiohttp.ClientResponse:
+        """
+        SGP 通道 - Seraphine 的 __sgp__get 增强版
+        SGP 用于获取跨服数据和更详细的历史记录
+        """
+        if not self._sgp_session:
+            raise ConnectionError("SGP session not established")
+        return await self._sgp_session.get(path, params=params)
+
+    async def init_sgp(self):
+        """初始化 SGP 通道 - 从 LCU 获取 SGP 令牌"""
+        res = await self._get("/entitlements/v1/token")
+        data = await res.json()
+        if "accessToken" not in data:
+            raise ValueError("Failed to obtain SGP token")
+
+        self._sgp_token = data["accessToken"]
+        # SGP URL 根据服务器确定
+        self._sgp_url = self._resolve_sgp_url(self._server)
+
+        self._sgp_session = aiohttp.ClientSession(
+            base_url=self._sgp_url,
+            headers={
+                "Authorization": f"Bearer {self._sgp_token}",
+            },
+        )
+
+    def _resolve_sgp_url(self, server: str) -> str:
+        """解析 SGP 网关 URL"""
+        sgp_map = {
+            "NA1": "https://na1.sgp.pvp.net",
+            "EUW1": "https://euw1.sgp.pvp.net",
+            "KR": "https://kr.sgp.pvp.net",
+            # 腾讯服务器
+            "HN1": "https://hn1-sgp.lol.qq.com:21019",
+            "HN10": "https://hn10-sgp.lol.qq.com:21019",
+        }
+        return sgp_map.get(server, f"https://{server.lower()}.sgp.pvp.net")
+
+    # ========== 召唤师信息 ==========
+
+    @retry()
+    async def get_current_summoner(self) -> dict:
+        """获取当前登录的召唤师信息"""
+        res = await self._get("/lol-summoner/v1/current-summoner")
+        return await res.json()
+
+    @retry()
+    async def get_summoner_by_puuid(self, puuid: str) -> dict:
+        """通过 PUUID 获取召唤师信息"""
+        res = await self._get(f"/lol-summoner/v1/summoners-by-puuid/{puuid}")
+        return await res.json()
+
+    @retry()
+    async def get_summoner_by_name(self, name: str) -> dict:
+        """通过名称获取召唤师信息"""
+        res = await self._get(
+            f"/lol-summoner/v1/summoners?name={name}"
+        )
+        return await res.json()
+
+    # ========== 对局历史 (核心 M866 功能) ==========
+
+    @retry()
+    async def get_match_history(self, puuid: str,
+                                 beg_index: int = 0,
+                                 end_index: int = 19) -> List[dict]:
+        """
+        获取对局历史 - 对应 Seraphine 的 getSummonerGamesByPuuid
+
+        Args:
+            puuid: 玩家唯一标识
+            beg_index: 起始索引
+            end_index: 结束索引
+
+        Returns:
+            对局列表 (包含 gameId, champion, result 等)
+        """
+        params = {"begIndex": beg_index, "endIndex": end_index}
+        res = await self._get(
+            f"/lol-match-history/v1/products/lol/{puuid}/matches",
+            params,
+        )
+        data = await res.json()
+
+        if "games" not in data:
+            raise ValueError(
+                f"No match history found for puuid={puuid[:8]}..."
+            )
+
+        return data["games"]
+
+    @retry()
+    async def get_game_detail(self, game_id: int) -> dict:
+        """
+        获取对局详情 - 对应 Seraphine 的 getGameDetailByGameId
+
+        返回: 完整对局数据 (参与者、KDA、伤害、经济等)
+        """
+        res = await self._get(f"/lol-match-history/v1/games/{game_id}")
+        return await res.json()
+
+    @retry()
+    async def get_ranked_stats(self, puuid: str) -> dict:
+        """获取排位统计 - 对应 Seraphine 的 getRankedStatsByPuuid"""
+        res = await self._get(f"/lol-ranked/v1/ranked-stats/{puuid}")
+        data = await res.json()
+        if "errorCode" in data:
+            raise ValueError(f"Ranked stats not found for {puuid[:8]}...")
+        return data
+
+    # ========== SGP 通道对局历史 (跨服/更完整) ==========
+
+    async def get_match_history_via_sgp(self, puuid: str,
+                                         start_index: int = 0,
+                                         count: int = 20) -> dict:
+        """
+        通过 SGP 获取对局历史 - 对应 Seraphine 的 getSummonerGamesByPuuidViaSGP
+        SGP 端点提供更完整的历史数据, 不受 LCU 本地缓存限制
+        """
+        url = f"/match-history-query/v1/products/lol/player/{puuid}/SUMMARY"
+        params = {"startIndex": start_index, "count": count}
+        res = await self._sgp_get(url, params)
+        return await res.json()
+
+    async def get_gaming_info_via_sgp(self, puuid: str) -> dict:
+        """
+        通过 SGP 获取玩家当前游戏信息 (观战数据)
+        对应 Seraphine 的 getSummonerGamingInfoByPuuidViaSgp
+        """
+        server = self._server.lower()
+        url = f"/gsm/v1/ledge/spectator/region/{server}/puuid/{puuid}"
+        res = await self._sgp_get(url)
+        return await res.json()
+
+    async def get_ranked_stats_via_sgp(self, puuid: str) -> dict:
+        """通过 SGP 获取排位统计"""
+        url = f"/leagues-ledge/v2/rankedStats/puuid/{puuid}"
+        res = await self._sgp_get(url)
+        data = await res.json()
+        if "errorCode" in data:
+            raise ValueError(f"SGP ranked stats not found for {puuid[:8]}...")
+        return data
+
+    # ========== 对局中实时数据 ==========
+
+    @retry(count=3)
+    async def get_champ_select_session(self) -> dict:
+        """获取选人阶段会话"""
+        res = await self._get("/lol-champ-select/v1/session")
+        return await res.json()
+
+    @retry(count=3)
+    async def get_gameflow_session(self) -> dict:
+        """获取当前游戏流程状态"""
+        res = await self._get("/lol-gameflow/v1/session")
+        return await res.json()
+
+    @retry(count=3)
+    async def get_game_status(self) -> str:
+        """获取游戏状态 (None/Lobby/ChampSelect/InProgress/...)"""
+        res = await self._get("/lol-gameflow/v1/gameflow-phase")
+        return await res.json()
+
+    @retry(count=3)
+    async def get_map_side(self) -> dict:
+        """获取地图阵营信息"""
+        res = await self._get("/lol-champ-select/v1/pin-drop-notification")
+        return await res.json()
+
+    # ========== 工具方法 ==========
+
+    def get_request_history(self) -> List[dict]:
+        """获取请求历史 (用于分析和调试)"""
+        return [req.to_dict() for req in self._request_history]
+
+    @property
+    def is_connected(self) -> bool:
+        return self._lcu_session is not None
+
+    @property
+    def server(self) -> str:
+        return self._server
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, exc_type, exc_val, exc_tb):
+        await self.disconnect()
