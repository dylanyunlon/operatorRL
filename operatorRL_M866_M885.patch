+"""
+M866: LCU Session Manager - 进程发现与会话管理
+=============================================
+
+Seraphine 通过 LolProcessExistenceListener (QThread) 轮询进程列表。
+operatorRL 改为 asyncio 任务, 支持多客户端同时监控。
+
+关键改进:
+    1. 使用 psutil 替代 subprocess + tasklist 管道
+    2. 自动从进程命令行参数提取 port/token
+    3. 支持 Proxifier 环境下的端口重映射
+"""
+
+import asyncio
+import re
+import logging
+from typing import Optional, Tuple, List, Callable
+
+logger = logging.getLogger("operatorRL.lcu_connector.session")
+
+try:
+    import psutil
+    HAS_PSUTIL = True
+except ImportError:
+    HAS_PSUTIL = False
+
+
+class SessionManager:
+    """
+    LCU 客户端进程发现与会话生命周期管理
+
+    Seraphine 对比:
+    - Seraphine: listener.py 用 QThread 循环, 依赖 signalBus 发送信号
+    - operatorRL: 纯 asyncio, 回调式事件通知, 支持多客户端
+    """
+
+    PROCESS_NAME = "LeagueClientUx.exe"
+    POLL_INTERVAL = 1.5  # 秒, 与 Seraphine 一致
+
+    def __init__(self):
+        self._active_pids: dict = {}  # pid -> (port, token, server)
+        self._on_client_start: Optional[Callable] = None
+        self._on_client_stop: Optional[Callable] = None
+        self._on_client_change: Optional[Callable] = None
+        self._running = False
+        self._task: Optional[asyncio.Task] = None
+
+    def on_client_start(self, callback: Callable):
+        """注册客户端启动回调"""
+        self._on_client_start = callback
+
+    def on_client_stop(self, callback: Callable):
+        """注册客户端停止回调"""
+        self._on_client_stop = callback
+
+    def on_client_change(self, callback: Callable):
+        """注册客户端切换回调"""
+        self._on_client_change = callback
+
+    async def start_monitoring(self):
+        """开始监控 LoL 客户端进程"""
+        self._running = True
+        self._task = asyncio.create_task(self._monitor_loop())
+        logger.info("LCU process monitoring started")
+
+    async def stop_monitoring(self):
+        self._running = False
+        if self._task:
+            self._task.cancel()
+            try:
+                await self._task
+            except asyncio.CancelledError:
+                pass
+        logger.info("LCU process monitoring stopped")
+
+    async def _monitor_loop(self):
+        while self._running:
+            try:
+                current_pids = self._discover_lcu_processes()
+                await self._reconcile(current_pids)
+            except Exception as e:
+                logger.error(f"Monitor loop error: {e}")
+            await asyncio.sleep(self.POLL_INTERVAL)
+
+    def _discover_lcu_processes(self) -> dict:
+        """
+        发现所有运行中的 LeagueClientUx 进程
+
+        Seraphine 用 subprocess 调用 tasklist 解析文本输出。
+        operatorRL 用 psutil 直接遍历进程, 更可靠跨平台。
+        """
+        result = {}
+
+        if not HAS_PSUTIL:
+            logger.warning("psutil not available, using fallback")
+            return self._discover_via_subprocess()
+
+        for proc in psutil.process_iter(["pid", "name", "cmdline"]):
+            try:
+                if proc.info["name"] == self.PROCESS_NAME:
+                    cmdline = " ".join(proc.info["cmdline"] or [])
+                    port, token, server = self._parse_cmdline(cmdline)
+                    if port and token:
+                        result[proc.info["pid"]] = (port, token, server)
+            except (psutil.NoSuchProcess, psutil.AccessDenied):
+                continue
+
+        return result
+
+    def _discover_via_subprocess(self) -> dict:
+        """后备方案: 通过 WMIC 发现进程 (Windows only)"""
+        import subprocess
+        result = {}
+        try:
+            output = subprocess.check_output(
+                'wmic process where name="LeagueClientUx.exe" '
+                'get ProcessId,CommandLine /format:csv',
+                shell=True, text=True, timeout=5
+            )
+            for line in output.strip().split("\n"):
+                if "LeagueClientUx" in line:
+                    port, token, server = self._parse_cmdline(line)
+                    # 从 CSV 提取 PID
+                    parts = line.strip().split(",")
+                    if parts:
+                        try:
+                            pid = int(parts[-1])
+                            result[pid] = (port, token, server)
+                        except ValueError:
+                            pass
+        except Exception as e:
+            logger.error(f"WMIC discovery failed: {e}")
+        return result
+
+    @staticmethod
+    def _parse_cmdline(cmdline: str) -> Tuple[Optional[int],
+                                               Optional[str],
+                                               Optional[str]]:
+        """
+        从 LeagueClientUx 命令行参数解析连接信息
+
+        Seraphine 的 getPortTokenServerByPid 做同样的事。
+        关键参数: --app-port=, --remoting-auth-token=, --rso_platform_id=
+        """
+        port = None
+        token = None
+        server = None
+
+        port_match = re.search(r"--app-port=(\d+)", cmdline)
+        if port_match:
+            port = int(port_match.group(1))
+
+        token_match = re.search(r"--remoting-auth-token=([\w-]+)", cmdline)
+        if token_match:
+            token = token_match.group(1)
+
+        server_match = re.search(r"--rso_platform_id=(\w+)", cmdline)
+        if server_match:
+            server = server_match.group(1)
+
+        return port, token, server
+
+    async def _reconcile(self, current_pids: dict):
+        """协调已知进程与当前进程状态"""
+        old_pids = set(self._active_pids.keys())
+        new_pids = set(current_pids.keys())
+
+        # 新启动的客户端
+        for pid in new_pids - old_pids:
+            port, token, server = current_pids[pid]
+            self._active_pids[pid] = (port, token, server)
+            logger.info(f"LoL client started: pid={pid}, port={port}")
+            if self._on_client_start:
+                await self._safe_callback(
+                    self._on_client_start, pid, port, token, server
+                )
+
+        # 已关闭的客户端
+        for pid in old_pids - new_pids:
+            info = self._active_pids.pop(pid)
+            logger.info(f"LoL client stopped: pid={pid}")
+            if self._on_client_stop:
+                await self._safe_callback(self._on_client_stop, pid)
+
+        # 客户端切换 (多开场景)
+        if (old_pids and new_pids and
+                old_pids != new_pids and
+                self._on_client_change):
+            active_pid = next(iter(new_pids))
+            port, token, server = current_pids[active_pid]
+            await self._safe_callback(
+                self._on_client_change, active_pid, port, token, server
+            )
+
+    @staticmethod
+    async def _safe_callback(callback, *args):
+        try:
+            if asyncio.iscoroutinefunction(callback):
+                await callback(*args)
+            else:
+                callback(*args)
+        except Exception as e:
+            logger.error(f"Callback error: {e}")
+
+    def get_active_clients(self) -> dict:
+        """返回所有活跃客户端 {pid: (port, token, server)}"""
+        return dict(self._active_pids)
