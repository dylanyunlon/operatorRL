+"""
+M883: Riot API 速率限制器
+"""
+import time
+import asyncio
+from collections import deque
+
+
+class RateLimiter:
+    """Riot API 速率限制"""
+
+    def __init__(self, requests_per_second: int = 20,
+                 requests_per_two_minutes: int = 100):
+        self._rps = requests_per_second
+        self._rpm = requests_per_two_minutes
+        self._second_window: deque = deque()
+        self._minute_window: deque = deque()
+
+    async def acquire(self):
+        now = time.time()
+
+        # 清理过期记录
+        while self._second_window and now - self._second_window[0] > 1:
+            self._second_window.popleft()
+        while self._minute_window and now - self._minute_window[0] > 120:
+            self._minute_window.popleft()
+
+        # 等待
+        while (len(self._second_window) >= self._rps or
+               len(self._minute_window) >= self._rpm):
+            await asyncio.sleep(0.05)
+            now = time.time()
+            while self._second_window and now - self._second_window[0] > 1:
+                self._second_window.popleft()
+            while self._minute_window and now - self._minute_window[0] > 120:
+                self._minute_window.popleft()
+
+        self._second_window.append(now)
+        self._minute_window.append(now)
