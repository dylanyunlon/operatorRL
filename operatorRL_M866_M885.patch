+"""
+M885: Match Pattern Engine 单元测试
+"""
+import pytest
+
+
+class TestMatchPatternEngine:
+
+    def test_extract_patterns(self):
+        from dataclasses import dataclass
+        from modules.history_battle.pattern.match_pattern_engine import MatchPatternEngine
+
+        @dataclass
+        class M:
+            champion_name: str
+            role: str
+            win: bool
+            kills: int = 5
+            deaths: int = 3
+            assists: int = 7
+            cs_per_min: float = 7.0
+            damage_per_min: float = 500.0
+
+        engine = MatchPatternEngine()
+        matches = [
+            M("Jinx", "ADC", True),
+            M("Jinx", "ADC", True),
+            M("Ezreal", "ADC", False),
+            M("Kai\'Sa", "ADC", True),
+        ]
+        patterns = engine.extract_champion_patterns(matches)
+        assert patterns["most_played"][0][0] == "Jinx"
