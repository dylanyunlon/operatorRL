@@ -0,0 +1,174 @@
+"""
+M867: LCU WebSocket 事件流 - 实时游戏状态监听
+=============================================
+
+Seraphine 使用 QThread + aiohttp WebSocket 订阅 LCU 事件。
+operatorRL 改为纯 asyncio WebSocket 客户端, 支持事件过滤和回放。
+
+关键事件:
+    /lol-gameflow/v1/gameflow-phase  -> 游戏流程阶段变化
+    /lol-champ-select/v1/session     -> 选人阶段变化
+    /lol-matchmaking/v1/search       -> 匹配状态
+    /lol-end-of-game/v1/eog-stats-block -> 对局结束统计
+"""
+
+import asyncio
+import json
+import ssl
+import logging
+from typing import Optional, Callable, Dict, List, Any
+from collections import defaultdict
+from dataclasses import dataclass, field
+
+import aiohttp
+
+logger = logging.getLogger("operatorRL.lcu_connector.ws")
+
+
+@dataclass
+class LCUEvent:
+    """LCU WebSocket 事件"""
+    uri: str
+    event_type: str  # Create / Update / Delete
+    data: Any
+    timestamp: float = 0.0
+
+    def __repr__(self):
+        return f"LCUEvent({self.event_type} {self.uri})"
+
+
+class LCUWebSocket:
+    """
+    LCU WebSocket 事件流
+
+    Seraphine 缺少完整的 WebSocket 实现,
+    operatorRL 提供完整的事件订阅/过滤/回放能力。
+    """
+
+    def __init__(self, port: int, auth_token: str):
+        self._port = port
+        self._auth_token = auth_token
+        self._ws: Optional[aiohttp.ClientWebSocketResponse] = None
+        self._session: Optional[aiohttp.ClientSession] = None
+        self._handlers: Dict[str, List[Callable]] = defaultdict(list)
+        self._running = False
+        self._event_buffer: List[LCUEvent] = []
+        self._max_buffer = 5000
+
+    def subscribe(self, uri_pattern: str, handler: Callable):
+        """
+        订阅特定 URI 模式的事件
+
+        示例:
+            ws.subscribe("/lol-gameflow/", on_gameflow_change)
+            ws.subscribe("/lol-champ-select/", on_champ_select)
+        """
+        self._handlers[uri_pattern].append(handler)
+
+    async def connect(self):
+        """建立 WebSocket 连接"""
+        import base64
+        auth = base64.b64encode(
+            f"riot:{self._auth_token}".encode()
+        ).decode()
+
+        ssl_ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
+        ssl_ctx.check_hostname = False
+        ssl_ctx.verify_mode = ssl.CERT_NONE
+
+        self._session = aiohttp.ClientSession()
+        url = f"wss://127.0.0.1:{self._port}/"
+
+        self._ws = await self._session.ws_connect(
+            url,
+            ssl=ssl_ctx,
+            headers={"Authorization": f"Basic {auth}"},
+        )
+
+        # 订阅所有 JSON API 事件
+        await self._ws.send_str(
+            json.dumps([5, "OnJsonApiEvent"])
+        )
+
+        self._running = True
+        logger.info(f"WebSocket connected to port {self._port}")
+
+    async def listen(self):
+        """主事件循环"""
+        if not self._ws:
+            raise ConnectionError("WebSocket not connected")
+
+        while self._running:
+            try:
+                msg = await self._ws.receive(timeout=30)
+
+                if msg.type == aiohttp.WSMsgType.TEXT:
+                    await self._process_message(msg.data)
+                elif msg.type in (aiohttp.WSMsgType.CLOSED,
+                                  aiohttp.WSMsgType.ERROR):
+                    logger.warning(f"WebSocket closed/error: {msg.type}")
+                    break
+
+            except asyncio.TimeoutError:
+                continue
+            except Exception as e:
+                logger.error(f"WebSocket listen error: {e}")
+                await asyncio.sleep(1)
+
+    async def _process_message(self, raw: str):
+        """解析并分发 WebSocket 消息"""
+        try:
+            data = json.loads(raw)
+
+            # LCU WebSocket 格式: [opcode, event_name, payload]
+            if not isinstance(data, list) or len(data) < 3:
+                return
+
+            payload = data[2]
+            uri = payload.get("uri", "")
+            event_type = payload.get("eventType", "")
+            event_data = payload.get("data")
+
+            event = LCUEvent(
+                uri=uri,
+                event_type=event_type,
+                data=event_data,
+                timestamp=asyncio.get_event_loop().time(),
+            )
+
+            # 缓存事件
+            if len(self._event_buffer) >= self._max_buffer:
+                self._event_buffer.pop(0)
+            self._event_buffer.append(event)
+
+            # 分发到匹配的处理器
+            for pattern, handlers in self._handlers.items():
+                if pattern in uri:
+                    for handler in handlers:
+                        try:
+                            if asyncio.iscoroutinefunction(handler):
+                                await handler(event)
+                            else:
+                                handler(event)
+                        except Exception as e:
+                            logger.error(
+                                f"Event handler error for {uri}: {e}"
+                            )
+
+        except json.JSONDecodeError:
+            pass
+
+    async def disconnect(self):
+        self._running = False
+        if self._ws:
+            await self._ws.close()
+        if self._session:
+            await self._session.close()
+
+    def get_event_buffer(self) -> List[LCUEvent]:
+        """获取事件缓冲区 (用于回放/分析)"""
+        return list(self._event_buffer)
+
+    def get_events_by_uri(self, uri_pattern: str) -> List[LCUEvent]:
+        """按 URI 过滤事件"""
+        return [e for e in self._event_buffer if uri_pattern in e.uri]
