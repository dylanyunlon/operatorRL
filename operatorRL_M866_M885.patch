index 0000000..afaf534
--- /dev/null
+++ b/modules/history_battle/collector/match_collector.py
@@ -0,0 +1,213 @@
+"""
+M870: 对局历史收集器 - 从多通道获取历史战斗数据
+================================================
+
+遵循 Seraphine connector.py 的 getSummonerGamesByPuuid 模式,
+增加多通道 fallback (LCU -> SGP -> Fiddler 缓存)。
+
+对于当前对战而言, 历史战斗信息的价值:
+    1. 对手英雄池分析 -> 预测选人
+    2. 对手段位/胜率 -> 评估威胁等级
+    3. 对手常用路线 -> 预判 gank 路线
+    4. 队友历史表现 -> 资源倾斜策略
+"""
+
+import asyncio
+import logging
+from typing import List, Dict, Any, Optional
+from dataclasses import dataclass
+
+logger = logging.getLogger("operatorRL.history_battle.collector")
+
+
+@dataclass
+class MatchRecord:
+    """标准化的对局记录"""
+    game_id: int
+    champion_id: int
+    champion_name: str
+    role: str              # TOP/JUNGLE/MID/ADC/SUPPORT
+    win: bool
+    kills: int
+    deaths: int
+    assists: int
+    cs: int                # Creep Score (补刀)
+    gold_earned: int
+    damage_dealt: int
+    damage_taken: int
+    vision_score: int
+    game_duration: int     # 秒
+    game_mode: str         # CLASSIC/ARAM/...
+    queue_type: str        # RANKED_SOLO/RANKED_FLEX/NORMAL/...
+    timestamp: int         # 对局时间戳
+
+    @property
+    def kda(self) -> float:
+        return (self.kills + self.assists) / max(self.deaths, 1)
+
+    @property
+    def cs_per_min(self) -> float:
+        return self.cs / max(self.game_duration / 60, 1)
+
+    @property
+    def gold_per_min(self) -> float:
+        return self.gold_earned / max(self.game_duration / 60, 1)
+
+    @property
+    def damage_per_min(self) -> float:
+        return self.damage_dealt / max(self.game_duration / 60, 1)
+
+
+class MatchCollector:
+    """
+    对局历史收集器
+
+    多通道 fallback 策略:
+    1. LCU API (最快, 但数据量有限, 通常最近20场)
+    2. SGP 协议 (跨服, 更完整, 但需要额外认证)
+    3. Fiddler 缓存 (从捕获的流量中恢复, 无需额外请求)
+    """
+
+    def __init__(self, lcu_connector, fiddler_bridge=None):
+        self._lcu = lcu_connector
+        self._fiddler = fiddler_bridge
+        self._cache: Dict[str, List[MatchRecord]] = {}
+
+    async def collect_player_history(self, puuid: str,
+                                      count: int = 20,
+                                      ranked_only: bool = False) -> List[MatchRecord]:
+        """
+        收集玩家历史对局
+
+        Args:
+            puuid: 玩家唯一标识
+            count: 需要的对局数量
+            ranked_only: 是否只获取排位赛
+
+        Returns:
+            标准化的 MatchRecord 列表
+        """
+        # 检查缓存
+        cache_key = f"{puuid}:{count}:{ranked_only}"
+        if cache_key in self._cache:
+            return self._cache[cache_key]
+
+        records = []
+
+        # 通道1: LCU API
+        try:
+            raw_games = await self._lcu.get_match_history(
+                puuid, 0, count - 1
+            )
+            records = self._normalize_games(raw_games)
+            logger.info(
+                f"LCU channel: {len(records)} games for {puuid[:8]}..."
+            )
+        except Exception as e:
+            logger.warning(f"LCU channel failed: {e}")
+
+        # 通道2: SGP (如果 LCU 数据不足)
+        if len(records) < count:
+            try:
+                sgp_data = await self._lcu.get_match_history_via_sgp(
+                    puuid, len(records), count
+                )
+                sgp_games = sgp_data.get("games", [])
+                sgp_records = self._normalize_games(sgp_games)
+                # 去重合并
+                existing_ids = {r.game_id for r in records}
+                for r in sgp_records:
+                    if r.game_id not in existing_ids:
+                        records.append(r)
+                logger.info(
+                    f"SGP channel: +{len(sgp_records)} games"
+                )
+            except Exception as e:
+                logger.warning(f"SGP channel failed: {e}")
+
+        # 通道3: Fiddler 缓存 (从捕获的流量恢复)
+        if len(records) < count and self._fiddler:
+            try:
+                from ..fiddler_mcp.traffic_analyzer import TrafficAnalyzer
+                analyzer = TrafficAnalyzer()
+                traffic = await self._fiddler.get_match_history_traffic()
+                fiddler_games = analyzer.extract_match_histories()
+                fiddler_records = self._normalize_games(fiddler_games)
+                existing_ids = {r.game_id for r in records}
+                for r in fiddler_records:
+                    if r.game_id not in existing_ids:
+                        records.append(r)
+                logger.info(
+                    f"Fiddler cache: +{len(fiddler_records)} games"
+                )
+            except Exception as e:
+                logger.warning(f"Fiddler cache failed: {e}")
+
+        # 过滤
+        if ranked_only:
+            records = [
+                r for r in records
+                if "RANKED" in r.queue_type.upper()
+            ]
+
+        # 按时间排序 (最近的在前)
+        records.sort(key=lambda r: r.timestamp, reverse=True)
+        records = records[:count]
+
+        # 缓存
+        self._cache[cache_key] = records
+        return records
+
+    def _normalize_games(self, raw_games: list) -> List[MatchRecord]:
+        """将原始 API 数据标准化为 MatchRecord"""
+        records = []
+        for game in raw_games:
+            try:
+                participants = game.get("participants", [{}])
+                p = participants[0] if participants else {}
+                stats = p.get("stats", {})
+
+                record = MatchRecord(
+                    game_id=game.get("gameId", 0),
+                    champion_id=p.get("championId", 0),
+                    champion_name=str(p.get("championId", "Unknown")),
+                    role=self._detect_role(p),
+                    win=stats.get("win", False),
+                    kills=stats.get("kills", 0),
+                    deaths=stats.get("deaths", 0),
+                    assists=stats.get("assists", 0),
+                    cs=stats.get("totalMinionsKilled", 0)
+                       + stats.get("neutralMinionsKilled", 0),
+                    gold_earned=stats.get("goldEarned", 0),
+                    damage_dealt=stats.get("totalDamageDealtToChampions", 0),
+                    damage_taken=stats.get("totalDamageTaken", 0),
+                    vision_score=stats.get("visionScore", 0),
+                    game_duration=game.get("gameDuration", 0),
+                    game_mode=game.get("gameMode", "CLASSIC"),
+                    queue_type=game.get("queueType", "UNKNOWN"),
+                    timestamp=game.get("gameCreation", 0),
+                )
+                records.append(record)
+            except Exception as e:
+                logger.debug(f"Failed to normalize game: {e}")
+
+        return records
+
+    @staticmethod
+    def _detect_role(participant: dict) -> str:
+        """检测玩家角色"""
+        timeline = participant.get("timeline", {})
+        role = timeline.get("role", "")
+        lane = timeline.get("lane", "")
+
+        role_map = {
+            ("SOLO", "TOP"): "TOP",
+            ("NONE", "JUNGLE"): "JUNGLE",
+            ("SOLO", "MIDDLE"): "MID",
+            ("DUO_CARRY", "BOTTOM"): "ADC",
+            ("DUO_SUPPORT", "BOTTOM"): "SUPPORT",
+        }
+        return role_map.get((role, lane), lane or "UNKNOWN")
+
+    def clear_cache(self):
+        self._cache.clear()
