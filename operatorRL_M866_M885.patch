+# M870-M875: History Battle Module
+
+def __getattr__(name):
+    _map = {
+        "MatchCollector": ".collector.match_collector",
+        "BatchCollector": ".collector.batch_collector",
+        "BattleAnalyzer": ".analyzer.battle_analyzer",
+        "KDAAnalyzer": ".analyzer.kda_analyzer",
+        "MatchPatternEngine": ".pattern.match_pattern_engine",
+    }
+    if name in _map:
+        import importlib
+        mod = importlib.import_module(_map[name], __name__)
+        return getattr(mod, name)
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+
+__all__ = [
+    "MatchCollector", "BatchCollector",
+    "BattleAnalyzer", "KDAAnalyzer",
+    "MatchPatternEngine",
+]
