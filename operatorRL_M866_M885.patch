+"""
+M875: 战术反馈引擎 - 基于历史数据生成实时战术建议
+================================================
+
+将 BattleAnalyzer 的分析结果转化为可执行的战术建议,
+并通过 TTS (Text-to-Speech) 输出语音指导。
+
+这是 30 分钟持续对局指导的核心组件:
+    选人阶段: 对手英雄池分析 + ban/pick 建议
+    对线阶段: 对手弱点利用建议
+    中期: 地图节奏建议 (基于对手的打法模式)
+    后期: 团战/分推决策建议
+"""
+
+import logging
+import time
+from typing import List, Dict, Optional
+from dataclasses import dataclass, field
+
+logger = logging.getLogger("operatorRL.tactical")
+
+
+@dataclass
+class TacticalAdvice:
+    """战术建议"""
+    phase: str           # champ_select / laning / mid_game / late_game
+    priority: int        # 1-5, 5最高
+    message: str         # 人类可读的建议
+    reasoning: str       # 推理依据
+    confidence: float    # 0-1 置信度
+    timestamp: float = field(default_factory=time.time)
+    spoken: bool = False # 是否已语音输出
+
+
+class TacticalFeedbackEngine:
+    """
+    战术反馈引擎
+
+    输入: PlayerProfile + MatchPatternEngine 分析结果
+    输出: TacticalAdvice 队列 -> 语音系统
+    """
+
+    def __init__(self):
+        self._advice_queue: List[TacticalAdvice] = []
+        self._spoken_history: List[TacticalAdvice] = []
+
+    def generate_champ_select_advice(
+        self,
+        allies: list,      # List[PlayerProfile]
+        enemies: list,      # List[PlayerProfile]
+        pattern_data: dict,
+    ) -> List[TacticalAdvice]:
+        """生成选人阶段建议"""
+        advices = []
+
+        # 识别最大威胁
+        if enemies:
+            top_threat = max(enemies, key=lambda p: p.threat_level)
+            if top_threat.threat_level >= 7:
+                advices.append(TacticalAdvice(
+                    phase="champ_select",
+                    priority=5,
+                    message=f"注意! {top_threat.main_role}位对手威胁等级 "
+                            f"{top_threat.threat_level:.1f}/10, "
+                            f"擅长 {', '.join(top_threat.champion_pool[:3])}",
+                    reasoning=f"基于最近 {len(top_threat.champion_pool)} 场数据分析",
+                    confidence=0.8,
+                ))
+
+            # 对手手冷提示
+            cold_enemies = [e for e in enemies if e.recent_form == "cold"]
+            if cold_enemies:
+                names = [e.main_role for e in cold_enemies]
+                advices.append(TacticalAdvice(
+                    phase="champ_select",
+                    priority=3,
+                    message=f"对手 {', '.join(names)} 位近期状态不佳, "
+                            f"可重点针对",
+                    reasoning="近5场胜率低于30%",
+                    confidence=0.7,
+                ))
+
+        # 队友分析
+        if allies:
+            weak_ally = min(allies, key=lambda p: p.threat_level)
+            if weak_ally.threat_level < 4:
+                advices.append(TacticalAdvice(
+                    phase="champ_select",
+                    priority=4,
+                    message=f"队友 {weak_ally.main_role} 位实力较弱 "
+                            f"(评分 {weak_ally.threat_level:.1f}), "
+                            f"建议选择自主carry能力强的英雄",
+                    reasoning=f"胜率 {weak_ally.win_rate:.0%}, "
+                              f"KDA {weak_ally.avg_kda:.1f}",
+                    confidence=0.65,
+                ))
+
+        self._advice_queue.extend(advices)
+        return advices
+
+    def generate_laning_advice(
+        self,
+        my_profile: dict,
+        lane_opponent: dict,
+        matchup_data: Optional[dict] = None,
+    ) -> List[TacticalAdvice]:
+        """生成对线阶段建议"""
+        advices = []
+
+        opponent = lane_opponent
+        if hasattr(opponent, 'weaknesses'):
+            for weakness in opponent.weaknesses:
+                if weakness == "low_vision_control":
+                    advices.append(TacticalAdvice(
+                        phase="laning",
+                        priority=4,
+                        message="对手视野控制差, 打野可频繁 gank 该路",
+                        reasoning="历史视野分低于 15",
+                        confidence=0.75,
+                    ))
+                elif weakness == "poor_farming":
+                    advices.append(TacticalAdvice(
+                        phase="laning",
+                        priority=3,
+                        message="对手补刀效率低, 可通过压线建立经济优势",
+                        reasoning=f"场均每分钟补刀仅 {opponent.avg_cs_per_min:.1f}",
+                        confidence=0.7,
+                    ))
+                elif weakness == "high_death_rate":
+                    advices.append(TacticalAdvice(
+                        phase="laning",
+                        priority=4,
+                        message="对手容易被击杀, 积极寻找机会",
+                        reasoning="场均死亡超过 6 次",
+                        confidence=0.7,
+                    ))
+
+        self._advice_queue.extend(advices)
+        return advices
+
+    def get_next_advice(self) -> Optional[TacticalAdvice]:
+        """获取下一条未播报的最高优先级建议"""
+        unspoken = [a for a in self._advice_queue if not a.spoken]
+        if not unspoken:
+            return None
+        unspoken.sort(key=lambda a: a.priority, reverse=True)
+        advice = unspoken[0]
+        advice.spoken = True
+        self._spoken_history.append(advice)
+        return advice
+
+    def get_all_pending(self) -> List[TacticalAdvice]:
+        return [a for a in self._advice_queue if not a.spoken]
