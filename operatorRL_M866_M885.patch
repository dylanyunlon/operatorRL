+"""
+M871: 战斗分析器 - 从历史数据生成战术建议
+==========================================
+
+基于收集到的历史 KDA/伤害/经济数据, 生成:
+    1. 威胁等级评估 (每个对手的整体实力)
+    2. 英雄池分析 (擅长/不擅长的英雄)
+    3. 游戏风格画像 (激进/保守/团战型/分推型)
+    4. 弱点识别 (death热区、视野盲区)
+"""
+
+import logging
+import statistics
+from typing import List, Dict, Any, Optional
+from dataclasses import dataclass
+
+logger = logging.getLogger("operatorRL.history_battle.analyzer")
+
+
+@dataclass
+class PlayerProfile:
+    """玩家画像"""
+    puuid: str
+    display_name: str = ""
+    threat_level: float = 0.0       # 0-10 威胁等级
+    main_role: str = ""              # 主要位置
+    champion_pool: List[str] = None  # 英雄池
+    play_style: str = ""             # 游戏风格
+    avg_kda: float = 0.0
+    avg_cs_per_min: float = 0.0
+    avg_damage_per_min: float = 0.0
+    avg_vision_score: float = 0.0
+    win_rate: float = 0.0
+    recent_form: str = ""            # 近期状态 (hot/cold/normal)
+    weaknesses: List[str] = None     # 弱点列表
+    strengths: List[str] = None      # 强项列表
+
+    def __post_init__(self):
+        if self.champion_pool is None:
+            self.champion_pool = []
+        if self.weaknesses is None:
+            self.weaknesses = []
+        if self.strengths is None:
+            self.strengths = []
+
+
+class BattleAnalyzer:
+    """
+    战斗分析引擎
+
+    输入: MatchRecord 列表
+    输出: PlayerProfile (包含威胁等级、游戏风格、弱点识别)
+
+    这些信息将传递给 AI 模型, 生成实时语音战术建议。
+    """
+
+    # 各指标的段位基准值 (取自 Seraphine 数据 + op.gg 统计)
+    BENCHMARKS = {
+        "kda": {"iron": 1.5, "silver": 2.0, "gold": 2.5,
+                "plat": 3.0, "diamond": 3.5, "master": 4.0},
+        "cs_per_min": {"iron": 4.0, "silver": 5.5, "gold": 6.5,
+                       "plat": 7.5, "diamond": 8.5, "master": 9.5},
+        "vision_score_per_min": {"iron": 0.3, "silver": 0.5,
+                                  "gold": 0.7, "plat": 0.9,
+                                  "diamond": 1.1, "master": 1.3},
+    }
+
+    def analyze_player(self, puuid: str,
+                       matches: list,
+                       ranked_stats: Optional[dict] = None) -> PlayerProfile:
+        """
+        分析单个玩家
+
+        Args:
+            puuid: 玩家标识
+            matches: MatchRecord 列表
+            ranked_stats: 排位统计 (可选, 来自 LCU/SGP)
+        """
+        if not matches:
+            return PlayerProfile(puuid=puuid)
+
+        profile = PlayerProfile(puuid=puuid)
+
+        # 基础统计
+        profile.avg_kda = statistics.mean([m.kda for m in matches])
+        profile.avg_cs_per_min = statistics.mean([m.cs_per_min for m in matches])
+        profile.avg_damage_per_min = statistics.mean([m.damage_per_min for m in matches])
+        profile.avg_vision_score = statistics.mean([m.vision_score for m in matches])
+
+        wins = sum(1 for m in matches if m.win)
+        profile.win_rate = wins / len(matches)
+
+        # 英雄池
+        champ_counts = {}
+        for m in matches:
+            champ_counts[m.champion_name] = champ_counts.get(m.champion_name, 0) + 1
+        profile.champion_pool = sorted(
+            champ_counts, key=champ_counts.get, reverse=True
+        )[:5]
+
+        # 主要位置
+        role_counts = {}
+        for m in matches:
+            role_counts[m.role] = role_counts.get(m.role, 0) + 1
+        profile.main_role = max(role_counts, key=role_counts.get) if role_counts else "UNKNOWN"
+
+        # 游戏风格判断
+        profile.play_style = self._detect_play_style(matches)
+
+        # 威胁等级 (0-10)
+        profile.threat_level = self._calculate_threat(profile, matches)
+
+        # 近期状态
+        profile.recent_form = self._detect_form(matches[:5])
+
+        # 弱点与强项
+        profile.weaknesses = self._identify_weaknesses(profile, matches)
+        profile.strengths = self._identify_strengths(profile, matches)
+
+        return profile
+
+    def _detect_play_style(self, matches: list) -> str:
+        """检测游戏风格"""
+        avg_kills = statistics.mean([m.kills for m in matches])
+        avg_deaths = statistics.mean([m.deaths for m in matches])
+        avg_assists = statistics.mean([m.assists for m in matches])
+        avg_damage = statistics.mean([m.damage_per_min for m in matches])
+
+        if avg_kills > 7 and avg_deaths > 5:
+            return "aggressive_volatile"  # 激进但不稳定
+        elif avg_kills > 5 and avg_deaths < 3:
+            return "aggressive_stable"    # 激进且稳定 (最危险)
+        elif avg_assists > avg_kills * 2:
+            return "team_oriented"        # 团队型
+        elif avg_damage < 300 and avg_deaths < 3:
+            return "passive_safe"         # 保守安全
+        else:
+            return "balanced"             # 均衡型
+
+    def _calculate_threat(self, profile: PlayerProfile,
+                          matches: list) -> float:
+        """计算威胁等级 (0-10)"""
+        score = 5.0  # 基准
+
+        # KDA 影响
+        if profile.avg_kda > 4.0:
+            score += 2.0
+        elif profile.avg_kda > 3.0:
+            score += 1.0
+        elif profile.avg_kda < 1.5:
+            score -= 2.0
+
+        # 胜率影响
+        if profile.win_rate > 0.6:
+            score += 1.5
+        elif profile.win_rate < 0.4:
+            score -= 1.5
+
+        # CS 效率 (反映基本功)
+        if profile.avg_cs_per_min > 8.0:
+            score += 1.0
+        elif profile.avg_cs_per_min < 5.0:
+            score -= 1.0
+
+        # 视野分影响 (反映意识)
+        if profile.avg_vision_score > 30:
+            score += 0.5
+
+        return max(0.0, min(10.0, score))
+
+    def _detect_form(self, recent: list) -> str:
+        """检测近期状态"""
+        if len(recent) < 3:
+            return "unknown"
+        recent_wins = sum(1 for m in recent if m.win)
+        rate = recent_wins / len(recent)
+        if rate >= 0.7:
+            return "hot"       # 手热
+        elif rate <= 0.3:
+            return "cold"      # 手冷
+        return "normal"
+
+    def _identify_weaknesses(self, profile: PlayerProfile,
+                              matches: list) -> List[str]:
+        """识别弱点"""
+        weaknesses = []
+
+        if profile.avg_vision_score < 15:
+            weaknesses.append("low_vision_control")
+        if statistics.mean([m.deaths for m in matches]) > 6:
+            weaknesses.append("high_death_rate")
+        if profile.avg_cs_per_min < 5.5 and profile.main_role in ("TOP", "MID", "ADC"):
+            weaknesses.append("poor_farming")
+
+        # 后期表现
+        long_games = [m for m in matches if m.game_duration > 1800]
+        if long_games:
+            late_wr = sum(1 for m in long_games if m.win) / len(long_games)
+            if late_wr < 0.35:
+                weaknesses.append("weak_late_game")
+
+        return weaknesses
+
+    def _identify_strengths(self, profile: PlayerProfile,
+                             matches: list) -> List[str]:
+        """识别强项"""
+        strengths = []
+
+        if profile.avg_kda > 3.5:
+            strengths.append("high_kda_consistency")
+        if profile.play_style == "aggressive_stable":
+            strengths.append("controlled_aggression")
+        if profile.avg_vision_score > 35:
+            strengths.append("excellent_vision")
+
+        # 早期表现
+        early_kills = statistics.mean([m.kills for m in matches])
+        if early_kills > 6:
+            strengths.append("strong_laning")
+
+        return strengths
+
+    def compare_teams(self, team_a: List[PlayerProfile],
+                      team_b: List[PlayerProfile]) -> dict:
+        """
+        团队对比分析
+
+        Returns:
+            team_comparison: 包含各维度对比和预测胜率
+        """
+        a_threat = sum(p.threat_level for p in team_a) / max(len(team_a), 1)
+        b_threat = sum(p.threat_level for p in team_b) / max(len(team_b), 1)
+
+        a_wr = statistics.mean([p.win_rate for p in team_a]) if team_a else 0.5
+        b_wr = statistics.mean([p.win_rate for p in team_b]) if team_b else 0.5
+
+        return {
+            "team_a_avg_threat": round(a_threat, 1),
+            "team_b_avg_threat": round(b_threat, 1),
+            "team_a_avg_winrate": round(a_wr, 3),
+            "team_b_avg_winrate": round(b_wr, 3),
+            "predicted_advantage": "team_a" if a_threat > b_threat else "team_b",
+            "confidence": abs(a_threat - b_threat) / 10,
+        }
