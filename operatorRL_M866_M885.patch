+"""
+M883: 玩家数据缓存
+"""
+import time
+from typing import Dict, Optional
+
+
+class PlayerCache:
+    """玩家画像缓存"""
+
+    def __init__(self, ttl: int = 600):
+        self._cache: Dict[str, dict] = {}
+        self._ttl = ttl
+
+    def get_profile(self, puuid: str) -> Optional[dict]:
+        entry = self._cache.get(puuid)
+        if entry and time.time() - entry["ts"] < self._ttl:
+            return entry["profile"]
+        return None
+
+    def set_profile(self, puuid: str, profile: dict):
+        self._cache[puuid] = {"profile": profile, "ts": time.time()}
+
+    def clear(self):
+        self._cache.clear()
