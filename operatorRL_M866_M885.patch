+"""
+M876: 权重持久化 - 保存和加载模型权重
+"""
+import json
+import os
+import logging
+from typing import Dict
+
+logger = logging.getLogger("operatorRL.evolution.storage")
+
+
+class WeightStorage:
+    """模型权重持久化存储"""
+
+    def __init__(self, path: str = "./evolution_data/weights.json"):
+        self._path = path
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+
+    def save(self, weights: Dict[str, float], iteration: int):
+        data = {"weights": weights, "iteration": iteration}
+        with open(self._path, "w") as f:
+            json.dump(data, f, indent=2)
+        logger.info(f"Weights saved (iteration {iteration})")
+
+    def load(self) -> tuple:
+        if not os.path.exists(self._path):
+            return {}, 0
+        with open(self._path) as f:
+            data = json.load(f)
+        return data.get("weights", {}), data.get("iteration", 0)
