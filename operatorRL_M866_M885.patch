+"""
+M866: LCU Authentication - 认证与令牌管理
+"""
+import base64
+import logging
+from typing import Optional
+
+logger = logging.getLogger("operatorRL.lcu_connector.auth")
+
+
+class LCUAuth:
+    """LCU 认证管理器"""
+
+    def __init__(self):
+        self._port: Optional[int] = None
+        self._token: Optional[str] = None
+        self._basic_auth: Optional[str] = None
+
+    def set_credentials(self, port: int, token: str):
+        self._port = port
+        self._token = token
+        self._basic_auth = base64.b64encode(
+            f"riot:{token}".encode()
+        ).decode()
+
+    @property
+    def authorization_header(self) -> str:
+        if not self._basic_auth:
+            raise ValueError("Credentials not set")
+        return f"Basic {self._basic_auth}"
+
+    @property
+    def base_url(self) -> str:
+        if not self._port:
+            raise ValueError("Port not set")
+        return f"https://127.0.0.1:{self._port}"
+
+    @property
+    def websocket_url(self) -> str:
+        if not self._port:
+            raise ValueError("Port not set")
+        return f"wss://127.0.0.1:{self._port}"
+
+    @property
+    def is_valid(self) -> bool:
+        return self._port is not None and self._token is not None
