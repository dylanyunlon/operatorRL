+"""
+M868: 协议解码器 - 解码 Fiddler 捕获的二进制/加密数据
+"""
+import json
+import base64
+import logging
+from typing import Optional
+
+logger = logging.getLogger("operatorRL.fiddler_mcp.decoder")
+
+
+class ProtocolDecoder:
+    """解码 Fiddler 捕获的 HTTP 响应体"""
+
+    @staticmethod
+    def decode_response_body(raw: str, content_type: str = "") -> Optional[dict]:
+        """尝试解码响应体"""
+        if not raw:
+            return None
+
+        # JSON
+        if "json" in content_type or raw.strip().startswith("{"):
+            try:
+                return json.loads(raw)
+            except json.JSONDecodeError:
+                pass
+
+        # Base64 编码的 JSON
+        try:
+            decoded = base64.b64decode(raw).decode("utf-8")
+            return json.loads(decoded)
+        except Exception:
+            pass
+
+        return None
+
+    @staticmethod
+    def extract_puuid_from_url(url: str) -> Optional[str]:
+        """从 URL 中提取 PUUID"""
+        import re
+        match = re.search(
+            r"/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})",
+            url,
+        )
+        return match.group(1) if match else None
