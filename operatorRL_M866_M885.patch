+"""
+M868: Fiddler 流量分析器 - 从捕获的 HTTPS 流量中提取 LoL 数据
+=============================================================
+
+通过 FiddlerMCPBridge 获取的原始 HTTP 会话, 解析出:
+    1. LCU API 调用链 (对局历史、排位数据、选人阶段)
+    2. SGP 协议数据 (跨服历史、观战信息)
+    3. Riot 客户端认证流量 (token 刷新、heartbeat)
+"""
+
+import json
+import re
+import logging
+from typing import List, Dict, Any, Optional, Tuple
+from dataclasses import dataclass, field
+from collections import defaultdict
+
+logger = logging.getLogger("operatorRL.fiddler_mcp.analyzer")
+
+
+@dataclass
+class ParsedSession:
+    """解析后的网络会话"""
+    session_id: int
+    method: str
+    url: str
+    status_code: int
+    request_headers: Dict[str, str] = field(default_factory=dict)
+    response_headers: Dict[str, str] = field(default_factory=dict)
+    request_body: Optional[str] = None
+    response_body: Optional[str] = None
+    duration_ms: float = 0.0
+    category: str = "unknown"  # lcu_api / sgp / riot_auth / game_data / other
+
+
+class TrafficAnalyzer:
+    """
+    LoL 网络流量分析器
+
+    将 Fiddler 捕获的原始 HTTP 会话分类并提取有价值的游戏数据。
+    这是网络捕获方案 vs 视觉方案的核心优势所在:
+    结构化的 JSON 数据, 零幻觉, 延迟 <5ms。
+    """
+
+    LCU_PATTERNS = {
+        "match_history": r"/lol-match-history/v1/products/lol/",
+        "game_detail": r"/lol-match-history/v1/games/",
+        "ranked_stats": r"/lol-ranked/v1/ranked-stats/",
+        "champ_select": r"/lol-champ-select/v1/session",
+        "gameflow": r"/lol-gameflow/v1/",
+        "summoner": r"/lol-summoner/v1/",
+        "lobby": r"/lol-lobby/v2/lobby",
+        "perks": r"/lol-perks/v1/",
+    }
+
+    SGP_PATTERNS = {
+        "sgp_match_history": r"/match-history-query/v1/",
+        "sgp_spectator": r"/gsm/v1/ledge/spectator/",
+        "sgp_ranked": r"/leagues-ledge/v2/",
+        "sgp_summoner": r"/summoner-ledge/v1/",
+    }
+
+    def __init__(self):
+        self._sessions: List[ParsedSession] = []
+        self._categories: Dict[str, List[ParsedSession]] = defaultdict(list)
+
+    def parse_raw_sessions(self, raw_sessions: List[dict]) -> List[ParsedSession]:
+        """解析 Fiddler MCP 返回的原始会话数据"""
+        parsed = []
+        for raw in raw_sessions:
+            session = ParsedSession(
+                session_id=raw.get("id", 0),
+                method=raw.get("method", "GET"),
+                url=raw.get("url", ""),
+                status_code=raw.get("statusCode", 0),
+                request_headers=raw.get("requestHeaders", {}),
+                response_headers=raw.get("responseHeaders", {}),
+                request_body=raw.get("requestBody"),
+                response_body=raw.get("responseBody"),
+                duration_ms=raw.get("duration", 0),
+            )
+            session.category = self._categorize(session.url)
+            parsed.append(session)
+            self._sessions.append(session)
+            self._categories[session.category].append(session)
+
+        return parsed
+
+    def _categorize(self, url: str) -> str:
+        """将 URL 分类"""
+        for cat, pattern in self.LCU_PATTERNS.items():
+            if re.search(pattern, url):
+                return f"lcu_{cat}"
+        for cat, pattern in self.SGP_PATTERNS.items():
+            if re.search(pattern, url):
+                return cat
+        if "entitlements" in url or "rso-auth" in url:
+            return "riot_auth"
+        return "other"
+
+    def extract_match_histories(self) -> List[dict]:
+        """提取所有对局历史数据"""
+        results = []
+        for session in self._categories.get("lcu_match_history", []):
+            if session.response_body and session.status_code == 200:
+                try:
+                    data = json.loads(session.response_body)
+                    if "games" in data:
+                        results.extend(data["games"])
+                except json.JSONDecodeError:
+                    pass
+        return results
+
+    def extract_game_details(self) -> List[dict]:
+        """提取所有对局详情数据"""
+        results = []
+        for session in self._categories.get("lcu_game_detail", []):
+            if session.response_body and session.status_code == 200:
+                try:
+                    results.append(json.loads(session.response_body))
+                except json.JSONDecodeError:
+                    pass
+        return results
+
+    def extract_champ_select_data(self) -> List[dict]:
+        """提取选人阶段数据"""
+        results = []
+        for session in self._categories.get("lcu_champ_select", []):
+            if session.response_body and session.status_code == 200:
+                try:
+                    results.append(json.loads(session.response_body))
+                except json.JSONDecodeError:
+                    pass
+        return results
+
+    def get_api_call_timeline(self) -> List[Tuple[float, str, str, int]]:
+        """生成 API 调用时间线 (用于分析通信模式)"""
+        timeline = []
+        for s in sorted(self._sessions, key=lambda x: x.session_id):
+            timeline.append((
+                s.duration_ms,
+                s.method,
+                s.url[:80],
+                s.status_code,
+            ))
+        return timeline
+
+    def get_statistics(self) -> dict:
+        """获取流量统计"""
+        return {
+            "total_sessions": len(self._sessions),
+            "by_category": {
+                cat: len(sessions)
+                for cat, sessions in self._categories.items()
+            },
+            "avg_duration_ms": (
+                sum(s.duration_ms for s in self._sessions)
+                / max(len(self._sessions), 1)
+            ),
+            "error_count": sum(
+                1 for s in self._sessions if s.status_code >= 400
+            ),
+        }
