+"""
+M874: 启动实时监控脚本
+"""
+import asyncio
+import sys
+sys.path.insert(0, ".")
+
+
+async def main():
+    from modules.lcu_connector.session_manager import SessionManager
+    from modules.lcu_connector.connector import LCUConnector
+
+    print("Starting LoL client monitor...")
+    sm = SessionManager()
+
+    async def on_start(pid, port, token, server):
+        print(f"Client found: pid={pid} port={port} server={server}")
+        connector = LCUConnector()
+        ok = await connector.connect(port, token, server)
+        if ok:
+            summoner = await connector.get_current_summoner()
+            print(f"Logged in as: {summoner.get('displayName')}")
+            await connector.disconnect()
+
+    sm.on_client_start(on_start)
+    await sm.start_monitoring()
+
+    try:
+        while True:
+            await asyncio.sleep(1)
+    except KeyboardInterrupt:
+        await sm.stop_monitoring()
+
+
+if __name__ == "__main__":
+    asyncio.run(main())
