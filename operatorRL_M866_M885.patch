+
+
+class FiddlerIngestor:
+    """从 Fiddler MCP 拉取捕获的流量"""
+
+    def __init__(self, bridge):
+        self._bridge = bridge
+
+    async def ingest_lol_traffic(self) -> AsyncGenerator:
+        """产出 LoL 相关的网络会话"""
+        sessions = await self._bridge.get_lol_api_sessions()
+        for session in sessions:
+            sid = session.get("id")
+            if sid:
+                try:
+                    detail = await self._bridge.get_session_details(sid)
+                    yield detail
+                except Exception as e:
+                    logger.warning(f"Failed to get session {sid}: {e}")
