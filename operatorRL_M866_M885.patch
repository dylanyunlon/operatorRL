+"""
+M869: Proxifier 配置生成器
+=========================
+
+生成 Proxifier 配置, 将 LoL 客户端流量路由到 Fiddler。
+
+Proxifier 配置要点:
+    1. LeagueClientUx.exe -> Fiddler 代理端口 (默认 8888)
+    2. LeagueClient.exe -> Fiddler 代理端口
+    3. 排除 Game 进程本身 (避免影响游戏延迟)
+    4. DNS 解析走代理 (捕获完整 URL)
+
+用户场景:
+    用户作为逆向工程师, 倾向原生网络捕获而非视觉方案。
+    Proxifier + Fiddler 是标准的协议逆向工具链。
+"""
+
+import xml.etree.ElementTree as ET
+import logging
+from typing import List, Optional
+
+logger = logging.getLogger("operatorRL.proxifier")
+
+
+class ProxifierConfigGenerator:
+    """生成 Proxifier 的 .ppx 配置文件"""
+
+    LOL_PROCESSES = [
+        "LeagueClientUx.exe",
+        "LeagueClient.exe",
+        "LeagueClientUxRender.exe",
+        "RiotClientServices.exe",
+        "RiotClientUx.exe",
+    ]
+
+    # 不代理的进程 (游戏进程直连, 避免增加延迟)
+    EXCLUDED_PROCESSES = [
+        "League of Legends.exe",
+    ]
+
+    def __init__(self, fiddler_host: str = "127.0.0.1",
+                 fiddler_port: int = 8888):
+        self.fiddler_host = fiddler_host
+        self.fiddler_port = fiddler_port
+
+    def generate_ppx(self, output_path: str,
+                     extra_processes: Optional[List[str]] = None) -> str:
+        """
+        生成 Proxifier 配置文件 (.ppx)
+
+        Args:
+            output_path: 输出路径
+            extra_processes: 额外需要代理的进程
+
+        Returns:
+            生成的配置文件路径
+        """
+        root = ET.Element("ProxifierProfile")
+        root.set("version", "101")
+        root.set("platform", "Windows")
+
+        # 代理服务器定义
+        proxy_list = ET.SubElement(root, "ProxyList")
+        proxy = ET.SubElement(proxy_list, "Proxy")
+        proxy.set("id", "100")
+        proxy.set("type", "HTTPS")
+        ET.SubElement(proxy, "Address").text = self.fiddler_host
+        ET.SubElement(proxy, "Port").text = str(self.fiddler_port)
+        ET.SubElement(proxy, "Options").text = "48"
+
+        # 规则列表
+        rule_list = ET.SubElement(root, "RuleList")
+
+        # 规则1: LoL 客户端进程走 Fiddler
+        processes = self.LOL_PROCESSES + (extra_processes or [])
+        rule_lol = ET.SubElement(rule_list, "Rule")
+        rule_lol.set("enabled", "true")
+        ET.SubElement(rule_lol, "Name").text = "LoL Client via Fiddler"
+        ET.SubElement(rule_lol, "Applications").text = ";".join(processes)
+        ET.SubElement(rule_lol, "Action").text = "Proxy"
+        ET.SubElement(rule_lol, "ProxyId").text = "100"
+
+        # 规则2: 游戏进程排除
+        rule_exclude = ET.SubElement(rule_list, "Rule")
+        rule_exclude.set("enabled", "true")
+        ET.SubElement(rule_exclude, "Name").text = "Game Direct (No Proxy)"
+        ET.SubElement(rule_exclude, "Applications").text = ";".join(
+            self.EXCLUDED_PROCESSES
+        )
+        ET.SubElement(rule_exclude, "Action").text = "Direct"
+
+        # 规则3: 默认直连
+        rule_default = ET.SubElement(rule_list, "Rule")
+        rule_default.set("enabled", "true")
+        ET.SubElement(rule_default, "Name").text = "Default"
+        ET.SubElement(rule_default, "Action").text = "Direct"
+
+        # DNS 设置 - 通过代理解析
+        dns = ET.SubElement(root, "DNSSettings")
+        ET.SubElement(dns, "Mode").text = "2"  # Resolve via Proxy
+
+        tree = ET.ElementTree(root)
+        ET.indent(tree, space="  ")
+        tree.write(output_path, encoding="utf-8", xml_declaration=True)
+
+        logger.info(f"Proxifier config generated: {output_path}")
+        return output_path
+
+    def generate_proxifier_rules_text(self) -> str:
+        """生成人类可读的 Proxifier 规则说明"""
+        rules = []
+        rules.append("=== Proxifier Configuration for LoL Traffic Capture ===")
+        rules.append(f"\nProxy Server: {self.fiddler_host}:{self.fiddler_port} (HTTPS)")
+        rules.append("\nRules:")
+        rules.append(f"  1. [Proxy] {', '.join(self.LOL_PROCESSES)}")
+        rules.append(f"  2. [Direct] {', '.join(self.EXCLUDED_PROCESSES)}")
+        rules.append("  3. [Direct] Default (all other traffic)")
+        rules.append("\nDNS: Resolve through proxy")
+        rules.append("\nNote: Game process (League of Legends.exe) is excluded")
+        rules.append("       to avoid adding latency to gameplay.")
+        return "\n".join(rules)
