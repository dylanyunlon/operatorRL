+# M866: LCU Connector Module
+# 查看 Seraphine-LastVersion 上现有 LCU Connector 的实现方式,
+# 理解其 connector.py 的 retry 装饰器和 __get/__sgp__get 双通道设计模式,
+# 特别是 API 调用层与 GUI 展示层如何分离。
+# 遵循该模式实现 operatorRL 的 LCU 连接器, 去除 PyQt 依赖, 改为纯异步事件驱动。
+
+def __getattr__(name):
+    if name == "LCUConnector":
+        from .connector import LCUConnector
+        return LCUConnector
+    if name == "SessionManager":
+        from .session_manager import SessionManager
+        return SessionManager
+    if name == "LCUAuth":
+        from .auth import LCUAuth
+        return LCUAuth
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+
+__all__ = ["LCUConnector", "SessionManager", "LCUAuth"]
+__version__ = "0.1.0"
