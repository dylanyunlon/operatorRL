@@ -0,0 +1,95 @@
+"""
+M877: TTS 语音引擎 - 将战术建议转为语音输出
+============================================
+
+30 分钟持续对局指导的语音输出组件。
+支持多种 TTS 后端: 系统自带 / Edge TTS / 本地 VITS。
+"""
+
+import asyncio
+import logging
+from typing import Optional
+
+logger = logging.getLogger("operatorRL.voice")
+
+
+class TTSEngine:
+    """
+    文本转语音引擎
+
+    优先使用 Edge TTS (免费、高质量), 降级到系统 TTS。
+    """
+
+    def __init__(self, backend: str = "edge",
+                 voice: str = "zh-CN-XiaoxiaoNeural",
+                 rate: str = "+10%"):
+        self._backend = backend
+        self._voice = voice
+        self._rate = rate
+        self._queue: asyncio.Queue = asyncio.Queue()
+        self._running = False
+
+    async def speak(self, text: str, priority: int = 3):
+        """将文本加入语音队列"""
+        await self._queue.put((priority, text))
+
+    async def start(self):
+        """启动语音输出循环"""
+        self._running = True
+        while self._running:
+            try:
+                priority, text = await asyncio.wait_for(
+                    self._queue.get(), timeout=1.0
+                )
+                await self._synthesize(text)
+            except asyncio.TimeoutError:
+                continue
+
+    async def stop(self):
+        self._running = False
+
+    async def _synthesize(self, text: str):
+        """执行 TTS 合成"""
+        if self._backend == "edge":
+            await self._edge_tts(text)
+        else:
+            await self._system_tts(text)
+
+    async def _edge_tts(self, text: str):
+        """使用 Edge TTS"""
+        try:
+            import edge_tts
+            communicate = edge_tts.Communicate(
+                text, self._voice, rate=self._rate
+            )
+            tmp_file = "/tmp/operatorrl_tts.mp3"
+            await communicate.save(tmp_file)
+            # 播放
+            proc = await asyncio.create_subprocess_exec(
+                "ffplay", "-nodisp", "-autoexit", tmp_file,
+                stdout=asyncio.subprocess.DEVNULL,
+                stderr=asyncio.subprocess.DEVNULL,
+            )
+            await proc.wait()
+        except ImportError:
+            logger.warning("edge_tts not available, falling back")
+            await self._system_tts(text)
+        except Exception as e:
+            logger.error(f"Edge TTS error: {e}")
+
+    async def _system_tts(self, text: str):
+        """系统 TTS 后备方案"""
+        import platform
+        if platform.system() == "Windows":
+            import subprocess
+            ps_cmd = (
+                f'''Add-Type -AssemblyName System.Speech; '''
+                f'''$s = New-Object System.Speech.Synthesis.SpeechSynthesizer; '''
+                f'''$s.Speak("{text}")'''
+            )
+            subprocess.run(
+                ["powershell", "-Command", ps_cmd],
+                capture_output=True, timeout=30,
+            )
+        else:
+            logger.warning("System TTS not available on this platform")
