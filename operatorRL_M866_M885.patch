+"""
+M868: Fiddler 会话过滤器 - 智能过滤 LoL 相关流量
+"""
+import re
+from typing import List, Dict
+
+
+class SessionFilter:
+    """智能过滤 Fiddler 捕获的会话"""
+
+    LOL_URL_PATTERNS = [
+        r"127\.0\.0\.1:\d+/lol-",
+        r"127\.0\.0\.1:\d+/riotclient",
+        r"sgp\.pvp\.net",
+        r"sgp\.lol\.qq\.com",
+        r"lol\.qq\.com",
+        r"ddragon\.leagueoflegends\.com",
+    ]
+
+    def is_lol_session(self, url: str) -> bool:
+        return any(re.search(p, url) for p in self.LOL_URL_PATTERNS)
+
+    def filter_sessions(self, sessions: List[dict]) -> List[dict]:
+        return [s for s in sessions if self.is_lol_session(s.get("url", ""))]
+
+    def categorize(self, url: str) -> str:
+        if "/lol-match-history/" in url:
+            return "match_history"
+        elif "/lol-champ-select/" in url:
+            return "champ_select"
+        elif "/lol-gameflow/" in url:
+            return "gameflow"
+        elif "/lol-summoner/" in url:
+            return "summoner"
+        elif "/lol-ranked/" in url:
+            return "ranked"
+        elif "sgp" in url:
+            return "sgp"
+        else:
+            return "other"
