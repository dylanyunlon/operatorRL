+"""
+M882: 操作评估器 - 评估玩家行为是否符合战术建议
+================================================
+
+"给出判断, 以及我做出的不符合指导的操作之后的反馈"
+"""
+import logging
+from typing import List, Dict, Optional
+
+logger = logging.getLogger("operatorRL.models.feedback")
+
+
+class ActionEvaluator:
+    """
+    操作评估器
+
+    对比战术建议和玩家实际行为, 给出反馈。
+    实际数据来源: Fiddler 捕获的实时 API 调用 + LCU WebSocket 事件。
+    """
+
+    def __init__(self):
+        self._advice_history: List[dict] = []
+        self._action_history: List[dict] = []
+
+    def record_advice(self, advice: dict):
+        self._advice_history.append(advice)
+
+    def record_action(self, action: dict):
+        self._action_history.append(action)
+
+    def evaluate_compliance(self) -> dict:
+        """评估玩家是否遵循建议"""
+        if not self._advice_history:
+            return {"compliance_rate": 1.0, "feedback": []}
+
+        followed = 0
+        feedback = []
+
+        for advice in self._advice_history:
+            # 简化评估: 检查是否有对应的行动
+            phase = advice.get("phase", "")
+            if self._find_matching_action(advice):
+                followed += 1
+            else:
+                feedback.append({
+                    "missed_advice": advice.get("message", ""),
+                    "phase": phase,
+                })
+
+        rate = followed / len(self._advice_history)
+        return {
+            "compliance_rate": round(rate, 2),
+            "total_advices": len(self._advice_history),
+            "followed": followed,
+            "feedback": feedback,
+        }
+
+    def _find_matching_action(self, advice: dict) -> bool:
+        """查找与建议匹配的行动 (简化实现)"""
+        # 生产版本会使用更复杂的行为匹配逻辑
+        phase = advice.get("phase", "")
+        return any(
+            a.get("phase") == phase for a in self._action_history
+        )
