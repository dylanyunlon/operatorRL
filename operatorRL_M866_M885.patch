+"""
+M884: 健康检查
+"""
+import time
+import logging
+
+logger = logging.getLogger("operatorRL.monitoring.health")
+
+
+class HealthChecker:
+    """系统健康检查"""
+
+    def __init__(self):
+        self._components: dict = {}
+
+    def register(self, name: str, check_func):
+        self._components[name] = check_func
+
+    async def check_all(self) -> dict:
+        results = {}
+        for name, check in self._components.items():
+            try:
+                import asyncio
+                if asyncio.iscoroutinefunction(check):
+                    ok = await check()
+                else:
+                    ok = check()
+                results[name] = {"status": "ok" if ok else "fail"}
+            except Exception as e:
+                results[name] = {"status": "error", "message": str(e)}
+        return results
