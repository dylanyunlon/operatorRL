+"""
+M877: 音频播放器 - 跨平台音频播放
+"""
+import asyncio
+import platform
+import logging
+from typing import Optional
+
+logger = logging.getLogger("operatorRL.voice.player")
+
+
+class AudioPlayer:
+    """跨平台音频播放"""
+
+    @staticmethod
+    async def play_file(filepath: str) -> bool:
+        """播放音频文件"""
+        system = platform.system()
+        try:
+            if system == "Windows":
+                proc = await asyncio.create_subprocess_exec(
+                    "powershell", "-Command",
+                    f'(New-Object Media.SoundPlayer "{filepath}").PlaySync()',
+                    stdout=asyncio.subprocess.DEVNULL,
+                    stderr=asyncio.subprocess.DEVNULL,
+                )
+            else:
+                proc = await asyncio.create_subprocess_exec(
+                    "ffplay", "-nodisp", "-autoexit", filepath,
+                    stdout=asyncio.subprocess.DEVNULL,
+                    stderr=asyncio.subprocess.DEVNULL,
+                )
+            await proc.wait()
+            return proc.returncode == 0
+        except Exception as e:
+            logger.error(f"Audio playback error: {e}")
+            return False
diff --git a/modules/voice_output/tts_engine.py b/modules/voice_output/tts_engine.py
