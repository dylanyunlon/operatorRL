+    def test_gradient_clipping(self):
+        p = self._make()
+        p.set_params({"w1": 0.5})
+        p.add_feedback("w1", 10.0, 0.5)  # huge gradient
+        p.run_finetune_step()
+        params = p.get_params()
+        # Should be clipped to max_gradient * lr
+        assert abs(params["params"]["w1"] - 0.5) <= 0.1 * 0.5 + 0.001
+
+    def test_no_feedback(self):
+        p = self._make()
+        r = p.run_finetune_step()
+        assert r["updates"] == 0
