@@ -0,0 +1,166 @@
+"""
+LiveHistoryTelemetryExporter — Exports fused live+historical telemetry for training.
+
+Architecture (拿来主义):
+  e2e_inference_telemetry_exporter.py（M664）— telemetry export pattern
+  historical_training_exporter.py — training data export
+  realtime_dashboard_data_source.py（M703）— SSE/poll data source
+
+Location: integrations/lol-history/src/lol_history/live_history_telemetry_exporter.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Exports decision+context pairs for offline training pipeline consumption.
+    - Configurable export format (JSON lines, CSV, protobuf-like dict) for flexibility.
+  System:
+    - Ring buffer prevents memory blowup during long game sessions.
+    - Batch export with configurable flush interval balances latency vs throughput.
+"""
+from __future__ import annotations
+import logging, time, json
+from collections import deque
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.live_history_telemetry_exporter.v1"
+
+def _safe_div(a, b, d=0.0): return a / b if b else d
+
+_EXPORT_FORMATS = ["jsonl", "dict_list", "csv_rows"]
+
+class LiveHistoryTelemetryExporter:
+    """Exports fused live+historical telemetry data for training pipelines.
+
+    Public API: record_event, flush_batch, get_pending_count, set_export_format,
+                export_session, get_stats
+    """
+    def __init__(self, buffer_size: int = 10000,
+                 batch_size: int = 100,
+                 export_format: str = "jsonl") -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._buffer: deque = deque(maxlen=buffer_size)
+        self._batch_size = batch_size
+        self._export_format = export_format
+        self._exported_count = 0
+        self._record_count = 0
+        self._session_id: str = f"session_{int(time.time())}"
+        self._flush_history: List[Dict[str, Any]] = []
+        self._export_sinks: List[Callable] = []
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def record_event(self, event_type: str, live_context: Dict[str, Any],
+                     historical_context: Dict[str, Any],
+                     decision: Dict[str, Any] = None,
+                     outcome: Dict[str, Any] = None) -> Dict[str, Any]:
+        """Record a telemetry event combining live and historical data."""
+        self._op_count += 1
+        self._record_count += 1
+        entry = {
+            "session_id": self._session_id,
+            "event_type": event_type,
+            "timestamp": time.time(),
+            "sequence_num": self._record_count,
+            "live_context": live_context,
+            "historical_context": historical_context,
+            "decision": decision or {},
+            "outcome": outcome or {}}
+        self._buffer.append(entry)
+
+        # Auto-flush if batch size reached
+        if len(self._buffer) >= self._batch_size:
+            self._auto_flush()
+
+        return {"status": "ok", "sequence": self._record_count,
+                "pending": len(self._buffer)}
+
+    def _auto_flush(self):
+        """Internal auto-flush when batch size is reached."""
+        batch = list(self._buffer)[:self._batch_size]
+        for sink in self._export_sinks:
+            try:
+                sink(batch)
+            except Exception as e:
+                logger.warning("Export sink error: %s", e)
+        # Remove flushed items
+        for _ in range(min(self._batch_size, len(self._buffer))):
+            self._buffer.popleft()
+        self._exported_count += len(batch)
+        self._flush_history.append({"count": len(batch), "timestamp": time.time()})
+
+    def register_sink(self, sink_fn: Callable) -> Dict[str, Any]:
+        """Register an export sink function that receives batches."""
+        self._op_count += 1
+        self._export_sinks.append(sink_fn)
+        return {"status": "ok", "sinks": len(self._export_sinks)}
+
+    def flush_batch(self, max_items: int = 0) -> Dict[str, Any]:
+        """Manually flush pending events."""
+        self._op_count += 1
+        n = max_items if max_items > 0 else len(self._buffer)
+        batch = []
+        for _ in range(min(n, len(self._buffer))):
+            batch.append(self._buffer.popleft())
+
+        for sink in self._export_sinks:
+            try:
+                sink(batch)
+            except Exception as e:
+                logger.warning("Export sink error: %s", e)
+
+        self._exported_count += len(batch)
+        self._flush_history.append({"count": len(batch), "timestamp": time.time()})
+        self._fire("batch_flushed", {"count": len(batch)})
+
+        if self._export_format == "jsonl":
+            exported = [json.dumps(e, default=str) for e in batch]
+        elif self._export_format == "csv_rows":
+            exported = self._to_csv_rows(batch)
+        else:
+            exported = batch
+
+        return {"status": "ok", "flushed": len(batch), "format": self._export_format,
+                "data": exported, "remaining": len(self._buffer)}
+
+    def _to_csv_rows(self, batch: List[Dict]) -> List[str]:
+        """Convert batch to CSV-like rows."""
+        if not batch:
+            return []
+        rows = []
+        for entry in batch:
+            flat = {"session": entry["session_id"], "seq": entry["sequence_num"],
+                    "type": entry["event_type"], "ts": entry["timestamp"]}
+            rows.append(",".join(str(v) for v in flat.values()))
+        return rows
+
+    def set_export_format(self, fmt: str) -> Dict[str, Any]:
+        self._op_count += 1
+        if fmt not in _EXPORT_FORMATS:
+            return {"status": "error", "reason": f"unknown format: {fmt}",
+                    "available": _EXPORT_FORMATS}
+        self._export_format = fmt
+        return {"status": "ok", "format": fmt}
+
+    def get_pending_count(self) -> int:
+        return len(self._buffer)
+
+    def export_session(self) -> Dict[str, Any]:
+        """Export all remaining buffered events and session summary."""
+        self._op_count += 1
+        remaining = list(self._buffer)
+        self._buffer.clear()
+        self._exported_count += len(remaining)
+        return {"status": "ok", "session_id": self._session_id,
+                "total_recorded": self._record_count,
+                "total_exported": self._exported_count,
+                "final_batch": len(remaining),
+                "flush_count": len(self._flush_history)}
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {"session_id": self._session_id, "record_count": self._record_count,
+                "exported_count": self._exported_count, "pending": len(self._buffer),
+                "flush_count": len(self._flush_history),
+                "export_format": self._export_format,
+                "sinks": len(self._export_sinks), "total_ops": self._op_count}
