+"""
+DuoQueueSynergyAnalyzer — Analyzes synergy between detected duo-queue partners.
+
+Architecture (拿来主义):
+  ally_synergy_history_scorer.py（M727）— pairwise synergy scoring
+  teammate_analyzer.py — teammate pattern detection
+  seraphine_lcu_deep_client.py — LCU friend/duo data
+
+Location: integrations/lol-history/src/lol_history/duo_queue_synergy_analyzer.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Duo detection from co-occurrence frequency enables targeted disruption strategies.
+    - Duo synergy reveals which lane pairings to pressure or avoid.
+  System:
+    - Co-occurrence threshold (>= 3 games together recently) prevents false duo detection.
+    - Communication advantage scoring factors in expected coordination boost.
+"""
+from __future__ import annotations
+import logging, time
+from typing import Any, Callable, Dict, List, Optional, Set, Tuple
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.duo_queue_synergy_analyzer.v1"
+
+def _safe_div(a, b, d=0.0): return a / b if b else d
+def _pair_key(a: str, b: str) -> str: return "|".join(sorted([a, b]))
+
+class DuoQueueSynergyAnalyzer:
+    """Detects and analyzes duo-queue partner synergy from match history.
+
+    Public API: ingest_match_participants, detect_duos, get_duo_synergy,
+                get_disruption_advice, get_stats
+    """
+    def __init__(self, duo_threshold: int = 3, recent_window: int = 20) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._match_participants: List[Dict[str, Any]] = {}
+        self._co_occurrence: Dict[str, Dict[str, int]] = {}
+        self._pair_results: Dict[str, Dict[str, Any]] = {}
+        self._duo_threshold = duo_threshold
+        self._recent_window = recent_window
+        self._ingest_count = 0
+        self._detected_duos: Dict[str, Dict[str, Any]] = {}
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def ingest_match_participants(self, match_id: str,
+                                   team_participants: List[Dict[str, Any]],
+                                   won: bool) -> Dict[str, Any]:
+        """Record a match's team participants for co-occurrence analysis.
+
+        Each participant: {puuid: str, champion: str, role: str, ...}
+        """
+        self._op_count += 1
+        self._ingest_count += 1
+        puuids = [p["puuid"] for p in team_participants if "puuid" in p]
+
+        # Update co-occurrence matrix
+        for i in range(len(puuids)):
+            for j in range(i + 1, len(puuids)):
+                pa, pb = puuids[i], puuids[j]
+                pk = _pair_key(pa, pb)
+                if pk not in self._pair_results:
+                    self._pair_results[pk] = {"games": 0, "wins": 0, "roles": []}
+                self._pair_results[pk]["games"] += 1
+                if won:
+                    self._pair_results[pk]["wins"] += 1
+                # Track roles played together
+                role_a = next((p.get("role", "") for p in team_participants if p.get("puuid") == pa), "")
+                role_b = next((p.get("role", "") for p in team_participants if p.get("puuid") == pb), "")
+                if role_a and role_b:
+                    self._pair_results[pk]["roles"].append(f"{role_a}+{role_b}")
+
+                self._co_occurrence.setdefault(pa, {})[pb] = \
+                    self._co_occurrence.get(pa, {}).get(pb, 0) + 1
+                self._co_occurrence.setdefault(pb, {})[pa] = \
+                    self._co_occurrence.get(pb, {}).get(pa, 0) + 1
+
+        return {"status": "ok", "match_id": match_id, "participants": len(puuids)}
+
+    def detect_duos(self, team_puuids: List[str]) -> Dict[str, Any]:
+        """Detect duo-queue pairs from a set of team members."""
+        self._op_count += 1
+        duos = []
+        for i in range(len(team_puuids)):
+            for j in range(i + 1, len(team_puuids)):
+                pa, pb = team_puuids[i], team_puuids[j]
+                co = self._co_occurrence.get(pa, {}).get(pb, 0)
+                if co >= self._duo_threshold:
+                    pk = _pair_key(pa, pb)
+                    pair_data = self._pair_results.get(pk, {})
+                    games = pair_data.get("games", co)
+                    wins = pair_data.get("wins", 0)
+                    wr = _safe_div(wins, games)
+                    duo_info = {
+                        "players": [pa, pb], "co_occurrences": co,
+                        "win_rate": round(wr, 4), "games_together": games,
+                        "confidence": min(1.0, co / 10.0)}
+                    duos.append(duo_info)
+                    self._detected_duos[pk] = duo_info
+
+        self._fire("duos_detected", {"count": len(duos)})
+        return {"status": "ok", "duos": duos, "total_detected": len(duos)}
+
+    def get_duo_synergy(self, puuid_a: str, puuid_b: str) -> Dict[str, Any]:
+        """Get detailed synergy analysis for a duo pair."""
+        self._op_count += 1
+        pk = _pair_key(puuid_a, puuid_b)
+        pair_data = self._pair_results.get(pk)
+        if not pair_data:
+            return {"status": "not_found", "pair": pk}
+
+        games = pair_data["games"]
+        wins = pair_data["wins"]
+        wr = _safe_div(wins, games)
+
+        # Analyze preferred role combinations
+        from collections import Counter
+        role_counter = Counter(pair_data.get("roles", []))
+        preferred_roles = role_counter.most_common(3)
+
+        # Communication advantage estimate: duo teams coordinate better
+        comm_bonus = min(0.15, 0.03 * games)
+
+        synergy_score = round(wr * 0.7 + comm_bonus * 0.3, 4)
+
+        return {"status": "ok", "pair": pk, "games_together": games,
+                "win_rate": round(wr, 4), "synergy_score": synergy_score,
+                "communication_bonus": round(comm_bonus, 4),
+                "preferred_roles": [{"combo": r, "count": c} for r, c in preferred_roles]}
+
+    def get_disruption_advice(self, duo_pair: List[str]) -> Dict[str, Any]:
+        """Generate strategic advice for disrupting a detected duo."""
+        self._op_count += 1
+        if len(duo_pair) != 2:
+            return {"status": "error", "reason": "need_exactly_2_puuids"}
+
+        pk = _pair_key(duo_pair[0], duo_pair[1])
+        pair_data = self._pair_results.get(pk)
+        if not pair_data:
+            return {"status": "ok", "advice": "no_data_generic_advice",
+                    "strategies": ["ward_their_jungle", "invade_early", "split_map_pressure"]}
+
+        role_counter = Counter(pair_data.get("roles", []))
+        top_combo = role_counter.most_common(1)[0][0] if role_counter else ""
+
+        strategies = []
+        if "bot" in top_combo.lower():
+            strategies.extend(["gank_bot_lane_early", "contest_dragon_vision",
+                               "camp_bot_lane_bush"])
+        elif "jungle" in top_combo.lower():
+            strategies.extend(["deep_ward_enemy_jungle", "counter_jungle_paths",
+                               "track_jungle_pathing"])
+        elif "mid" in top_combo.lower():
+            strategies.extend(["ward_mid_river", "ping_mid_roams", "push_mid_priority"])
+        else:
+            strategies.extend(["split_map_pressure", "avoid_5v5_if_synergy_high",
+                               "target_weaker_solo_laners"])
+
+        return {"status": "ok", "pair": pk, "preferred_combo": top_combo,
+                "strategies": strategies,
+                "duo_win_rate": round(_safe_div(pair_data["wins"], pair_data["games"]), 4)}
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {"pairs_tracked": len(self._pair_results),
+                "duos_detected": len(self._detected_duos),
+                "ingest_count": self._ingest_count, "total_ops": self._op_count}
