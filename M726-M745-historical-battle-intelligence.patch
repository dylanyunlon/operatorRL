@@ -0,0 +1,145 @@
+"""
+OpponentTiltDetector — Detects opponent mental state from recent match history patterns.
+
+Architecture (拿来主义):
+  streak_momentum_analyzer.py — streak/momentum pattern detection
+  loss_pattern_classifier.py — loss pattern classification
+  pregame_scout.py — player profile aggregation
+
+Location: integrations/lol-history/src/lol_history/opponent_tilt_detector.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Tilt detection from losing streaks, death spikes, and performance degradation.
+    - Confidence-weighted output prevents acting on low-sample guesses.
+  System:
+    - Recency weighting: recent games matter exponentially more than older ones.
+    - Multiple tilt signals combined via weighted sum, not any single heuristic.
+"""
+from __future__ import annotations
+import logging, time, math
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.opponent_tilt_detector.v1"
+
+def _safe_div(a, b, d=0.0): return a / b if b else d
+def _confidence(n, max_n=15): return min(1.0, math.log1p(n) / math.log1p(max_n)) if n > 0 else 0.0
+
+_TILT_LEVELS = ["composed", "slightly_tilted", "tilted", "heavily_tilted"]
+
+class OpponentTiltDetector:
+    """Detects opponent tilt from historical performance degradation patterns.
+
+    Public API: analyze_tilt, get_tilt_profile, get_stats
+    """
+    def __init__(self, recency_decay: float = 0.85) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._profiles: Dict[str, Dict[str, Any]] = {}
+        self._analyze_count = 0
+        self._recency_decay = recency_decay
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def _recency_weighted_avg(self, values: List[float]) -> float:
+        """Exponential recency weighting: last element is most recent."""
+        if not values:
+            return 0.0
+        weights = [self._recency_decay ** (len(values) - 1 - i) for i in range(len(values))]
+        total_w = sum(weights)
+        return sum(v * w for v, w in zip(values, weights)) / total_w if total_w > 0 else 0.0
+
+    def analyze_tilt(self, puuid: str,
+                     recent_matches: List[Dict[str, Any]]) -> Dict[str, Any]:
+        """Analyze tilt from recent match history (most recent last).
+
+        Each match: {win: bool, kills: int, deaths: int, assists: int, duration_min: float}
+        """
+        self._op_count += 1
+        self._analyze_count += 1
+
+        if len(recent_matches) < 2:
+            result = {"puuid": puuid, "tilt_level": "unknown", "tilt_score": 0.0,
+                      "confidence": 0.0, "signals": {}, "games_analyzed": len(recent_matches)}
+            self._profiles[puuid] = result
+            return {"status": "ok", **result}
+
+        n = len(recent_matches)
+
+        # Signal 1: Losing streak (recent consecutive losses)
+        consecutive_losses = 0
+        for m in reversed(recent_matches):
+            if not m.get("win", False):
+                consecutive_losses += 1
+            else:
+                break
+        streak_signal = min(consecutive_losses / 5.0, 1.0)
+
+        # Signal 2: Death spike (recent deaths vs earlier deaths)
+        deaths_list = [m.get("deaths", 0) for m in recent_matches]
+        if n >= 4:
+            recent_deaths_avg = _safe_div(sum(deaths_list[-n//2:]), max(n//2, 1))
+            earlier_deaths_avg = _safe_div(sum(deaths_list[:n//2]), max(n//2, 1))
+            death_spike = max(0.0, (recent_deaths_avg - earlier_deaths_avg) / max(earlier_deaths_avg, 1.0))
+            death_signal = min(death_spike / 2.0, 1.0)
+        else:
+            death_signal = 0.0
+
+        # Signal 3: Performance degradation (KDA trend)
+        kda_list = [(m.get("kills", 0) + m.get("assists", 0)) / max(m.get("deaths", 0), 1)
+                    for m in recent_matches]
+        if n >= 4:
+            recent_kda = self._recency_weighted_avg(kda_list[-n//2:])
+            earlier_kda = self._recency_weighted_avg(kda_list[:n//2])
+            kda_drop = max(0.0, (earlier_kda - recent_kda) / max(earlier_kda, 0.5))
+            kda_signal = min(kda_drop, 1.0)
+        else:
+            kda_signal = 0.0
+
+        # Signal 4: Win rate collapse
+        wins = [1.0 if m.get("win") else 0.0 for m in recent_matches]
+        recent_wr = self._recency_weighted_avg(wins)
+        wr_signal = max(0.0, 1.0 - recent_wr * 2.0)
+
+        # Composite tilt score
+        tilt_score = (streak_signal * 0.35 + death_signal * 0.25 +
+                      kda_signal * 0.25 + wr_signal * 0.15)
+        tilt_score = round(min(tilt_score, 1.0), 4)
+
+        # Classify
+        if tilt_score >= 0.7:
+            tilt_level = "heavily_tilted"
+        elif tilt_score >= 0.45:
+            tilt_level = "tilted"
+        elif tilt_score >= 0.2:
+            tilt_level = "slightly_tilted"
+        else:
+            tilt_level = "composed"
+
+        conf = round(_confidence(n), 4)
+        signals = {"streak": round(streak_signal, 4), "death_spike": round(death_signal, 4),
+                   "kda_degradation": round(kda_signal, 4), "winrate_collapse": round(wr_signal, 4)}
+
+        result = {"puuid": puuid, "tilt_level": tilt_level, "tilt_score": tilt_score,
+                  "confidence": conf, "signals": signals,
+                  "consecutive_losses": consecutive_losses, "games_analyzed": n}
+        self._profiles[puuid] = result
+        self._fire("tilt_analyzed", {"puuid": puuid, "tilt_level": tilt_level, "score": tilt_score})
+        return {"status": "ok", **result}
+
+    def get_tilt_profile(self, puuid: str) -> Dict[str, Any]:
+        self._op_count += 1
+        p = self._profiles.get(puuid)
+        if not p:
+            return {"status": "not_found", "puuid": puuid}
+        return {"status": "ok", **p}
+
+    def get_stats(self) -> Dict[str, Any]:
+        distribution = {}
+        for p in self._profiles.values():
+            tl = p.get("tilt_level", "unknown")
+            distribution[tl] = distribution.get(tl, 0) + 1
+        return {"profiles_analyzed": len(self._profiles), "analyze_count": self._analyze_count,
+                "tilt_distribution": distribution, "total_ops": self._op_count}
