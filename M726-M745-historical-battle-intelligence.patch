+"""
+LanePhaseHistoryComparator — Compares live lane metrics to historical baselines.
+
+Architecture (拿来主义):
+  game_phase_detector.py（M689）— phase detection lifecycle
+  segmented_winrate_tracker.py — per-segment statistical tracking
+  DI-star/distar/agent/default/agent.py — _get_time_factor temporal gating
+
+Location: integrations/lol-history/src/lol_history/lane_phase_history_comparator.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Compares your CS/min, gold diff, kill participation vs personal historical baselines.
+    - Deviation alerts fire when you're performing significantly above/below your norm.
+  System:
+    - Running mean/variance via Welford's algorithm avoids storing all raw samples.
+    - Comparison normalized by game duration bucket prevents early-game vs late-game skew.
+"""
+from __future__ import annotations
+import logging, time, math
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.lane_phase_history_comparator.v1"
+
+def _safe_div(a, b, d=0.0): return a / b if b else d
+
+class _WelfordAccumulator:
+    """Online mean/variance via Welford's algorithm."""
+    __slots__ = ("count", "mean", "m2")
+    def __init__(self):
+        self.count = 0
+        self.mean = 0.0
+        self.m2 = 0.0
+    def update(self, x: float):
+        self.count += 1
+        delta = x - self.mean
+        self.mean += delta / self.count
+        delta2 = x - self.mean
+        self.m2 += delta * delta2
+    @property
+    def variance(self) -> float:
+        return self.m2 / self.count if self.count > 1 else 0.0
+    @property
+    def std(self) -> float:
+        return math.sqrt(self.variance) if self.variance > 0 else 0.0
+    def z_score(self, x: float) -> float:
+        if self.std < 0.001 or self.count < 3:
+            return 0.0
+        return (x - self.mean) / self.std
+    def to_dict(self) -> Dict[str, Any]:
+        return {"count": self.count, "mean": round(self.mean, 4),
+                "std": round(self.std, 4), "variance": round(self.variance, 6)}
+
+_METRICS = ["cs_per_min", "gold_diff_at_10", "kill_participation",
+            "damage_per_min", "vision_score_per_min"]
+
+class LanePhaseHistoryComparator:
+    """Compares live lane-phase metrics against historical baselines.
+
+    Public API: ingest_historical_game, compare_live, get_baseline,
+                get_deviation_alerts, get_stats
+    """
+    def __init__(self, alert_z_threshold: float = 1.5) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._baselines: Dict[str, Dict[str, _WelfordAccumulator]] = {}
+        self._alert_z = alert_z_threshold
+        self._ingest_count = 0
+        self._compare_count = 0
+        self._alert_history: List[Dict[str, Any]] = []
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def _player_champ_key(self, puuid: str, champion: str) -> str:
+        return f"{puuid}:{champion}"
+
+    def ingest_historical_game(self, puuid: str, champion: str,
+                                metrics: Dict[str, float]) -> Dict[str, Any]:
+        """Record historical lane-phase metrics for baseline building."""
+        self._op_count += 1
+        self._ingest_count += 1
+        pk = self._player_champ_key(puuid, champion)
+        if pk not in self._baselines:
+            self._baselines[pk] = {m: _WelfordAccumulator() for m in _METRICS}
+        accums = self._baselines[pk]
+        updated = []
+        for metric in _METRICS:
+            if metric in metrics:
+                accums[metric].update(metrics[metric])
+                updated.append(metric)
+        return {"status": "ok", "key": pk, "metrics_updated": updated,
+                "total_games": accums[_METRICS[0]].count}
+
+    def compare_live(self, puuid: str, champion: str,
+                     live_metrics: Dict[str, float]) -> Dict[str, Any]:
+        """Compare live metrics against historical baseline, return z-scores and deviations."""
+        self._op_count += 1
+        self._compare_count += 1
+        pk = self._player_champ_key(puuid, champion)
+        accums = self._baselines.get(pk)
+        if not accums:
+            return {"status": "no_baseline", "key": pk}
+
+        comparisons = {}
+        alerts = []
+        for metric in _METRICS:
+            if metric not in live_metrics:
+                continue
+            acc = accums[metric]
+            live_val = live_metrics[metric]
+            z = acc.z_score(live_val)
+            deviation = "normal"
+            if z > self._alert_z:
+                deviation = "above_normal"
+            elif z < -self._alert_z:
+                deviation = "below_normal"
+            comparisons[metric] = {
+                "live": round(live_val, 4), "baseline_mean": round(acc.mean, 4),
+                "baseline_std": round(acc.std, 4), "z_score": round(z, 4),
+                "deviation": deviation, "samples": acc.count}
+            if deviation != "normal":
+                alert = {"metric": metric, "z_score": round(z, 4),
+                         "deviation": deviation, "timestamp": time.time()}
+                alerts.append(alert)
+                self._alert_history.append(alert)
+
+        if alerts:
+            self._fire("deviation_detected", {"puuid": puuid, "champion": champion,
+                                              "alerts": len(alerts)})
+
+        return {"status": "ok", "key": pk, "comparisons": comparisons, "alerts": alerts}
+
+    def get_baseline(self, puuid: str, champion: str) -> Dict[str, Any]:
+        self._op_count += 1
+        pk = self._player_champ_key(puuid, champion)
+        accums = self._baselines.get(pk)
+        if not accums:
+            return {"status": "no_baseline", "key": pk}
+        return {"status": "ok", "key": pk,
+                "baselines": {m: accums[m].to_dict() for m in _METRICS}}
+
+    def get_deviation_alerts(self, n: int = 20) -> List[Dict[str, Any]]:
+        self._op_count += 1
+        return self._alert_history[-n:]
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {"baselines_tracked": len(self._baselines), "ingest_count": self._ingest_count,
+                "compare_count": self._compare_count, "alerts_total": len(self._alert_history),
+                "total_ops": self._op_count}
