+"""
+ChampionMasteryCurveModeler — Models player learning curves per champion.
+
+Architecture (拿来主义):
+  champion_pool_tracker.py — champion usage tracking
+  coaching_effectiveness_tracker.py（M613）— effectiveness over time
+  seraphine_lcu_deep_client.py — LCU mastery data
+
+Location: integrations/lol-history/src/lol_history/champion_mastery_curve_modeler.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Shows whether a player is still improving or has plateaued on a champion.
+    - Mastery phase classification (learning/improving/peak/declining) guides coaching.
+  System:
+    - Sliding window regression avoids full dataset recomputation on each new game.
+    - Log-fit learning curve models diminishing returns naturally.
+"""
+from __future__ import annotations
+import logging, time, math
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.champion_mastery_curve_modeler.v1"
+
+def _safe_div(a, b, d=0.0): return a / b if b else d
+
+def _linear_slope(xs: List[float], ys: List[float]) -> float:
+    """Simple linear regression slope."""
+    n = len(xs)
+    if n < 2:
+        return 0.0
+    x_mean = sum(xs) / n
+    y_mean = sum(ys) / n
+    num = sum((x - x_mean) * (y - y_mean) for x, y in zip(xs, ys))
+    den = sum((x - x_mean) ** 2 for x in xs)
+    return num / den if abs(den) > 1e-9 else 0.0
+
+_PHASES = ["learning", "improving", "peak", "declining", "unknown"]
+
+class ChampionMasteryCurveModeler:
+    """Models player learning curves per champion from historical performance.
+
+    Public API: ingest_game, get_mastery_curve, get_mastery_phase,
+                get_all_curves, get_stats
+    """
+    def __init__(self, window_size: int = 30) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._curves: Dict[str, List[Dict[str, Any]]] = {}
+        self._window_size = window_size
+        self._ingest_count = 0
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def _pk(self, puuid: str, champion: str) -> str:
+        return f"{puuid}:{champion}"
+
+    def ingest_game(self, puuid: str, champion: str, performance_score: float,
+                    won: bool, kda: float = 0.0, cs_per_min: float = 0.0,
+                    game_index: int = -1) -> Dict[str, Any]:
+        """Record a game result on a champion for curve modeling."""
+        self._op_count += 1
+        self._ingest_count += 1
+        pk = self._pk(puuid, champion)
+        entries = self._curves.setdefault(pk, [])
+        idx = game_index if game_index >= 0 else len(entries)
+        entry = {"index": idx, "performance": performance_score, "won": won,
+                 "kda": kda, "cs_per_min": cs_per_min, "timestamp": time.time()}
+        entries.append(entry)
+        return {"status": "ok", "key": pk, "total_games": len(entries)}
+
+    def get_mastery_curve(self, puuid: str, champion: str) -> Dict[str, Any]:
+        """Get the full performance curve for a champion."""
+        self._op_count += 1
+        pk = self._pk(puuid, champion)
+        entries = self._curves.get(pk, [])
+        if not entries:
+            return {"status": "ok", "key": pk, "curve": [], "total_games": 0}
+
+        # Compute rolling averages
+        perfs = [e["performance"] for e in entries]
+        window = min(self._window_size, len(perfs))
+        rolling = []
+        for i in range(len(perfs)):
+            start = max(0, i - window + 1)
+            segment = perfs[start:i + 1]
+            rolling.append(round(sum(segment) / len(segment), 4))
+
+        # Overall trend
+        xs = list(range(len(perfs)))
+        slope = _linear_slope(xs, perfs)
+
+        # Recent trend (last window)
+        recent_perfs = perfs[-window:]
+        recent_xs = list(range(len(recent_perfs)))
+        recent_slope = _linear_slope(recent_xs, recent_perfs)
+
+        return {"status": "ok", "key": pk, "total_games": len(entries),
+                "overall_slope": round(slope, 6), "recent_slope": round(recent_slope, 6),
+                "current_avg": rolling[-1] if rolling else 0.0,
+                "peak_performance": round(max(perfs), 4),
+                "rolling_averages": rolling[-20:]}
+
+    def get_mastery_phase(self, puuid: str, champion: str) -> Dict[str, Any]:
+        """Classify the player's current mastery phase on a champion."""
+        self._op_count += 1
+        pk = self._pk(puuid, champion)
+        entries = self._curves.get(pk, [])
+        if len(entries) < 5:
+            return {"status": "ok", "key": pk, "phase": "unknown",
+                    "reason": "insufficient_data", "games": len(entries)}
+
+        perfs = [e["performance"] for e in entries]
+        n = len(perfs)
+        # Split into halves
+        first_half = perfs[:n // 2]
+        second_half = perfs[n // 2:]
+        first_avg = sum(first_half) / len(first_half)
+        second_avg = sum(second_half) / len(second_half)
+
+        # Recent window
+        window = min(self._window_size, n)
+        recent = perfs[-window:]
+        recent_slope = _linear_slope(list(range(len(recent))), recent)
+        recent_avg = sum(recent) / len(recent)
+        peak = max(perfs)
+
+        # Classification
+        if n < 10 and recent_slope > 0.01:
+            phase = "learning"
+        elif recent_slope > 0.005 and second_avg > first_avg:
+            phase = "improving"
+        elif abs(recent_slope) <= 0.005 and recent_avg >= peak * 0.9:
+            phase = "peak"
+        elif recent_slope < -0.005:
+            phase = "declining"
+        else:
+            phase = "improving" if second_avg > first_avg else "peak"
+
+        self._fire("mastery_phase", {"key": pk, "phase": phase})
+        return {"status": "ok", "key": pk, "phase": phase,
+                "recent_slope": round(recent_slope, 6),
+                "recent_avg": round(recent_avg, 4),
+                "peak_performance": round(peak, 4), "games": n}
+
+    def get_all_curves(self, puuid: str) -> Dict[str, Any]:
+        self._op_count += 1
+        result = {}
+        for pk, entries in self._curves.items():
+            if pk.startswith(f"{puuid}:"):
+                champion = pk.split(":", 1)[1]
+                result[champion] = {"games": len(entries),
+                                    "latest_performance": entries[-1]["performance"] if entries else 0}
+        return {"status": "ok", "puuid": puuid, "champions": result, "count": len(result)}
+
+    def get_stats(self) -> Dict[str, Any]:
+        total_games = sum(len(v) for v in self._curves.values())
+        return {"curves_tracked": len(self._curves), "total_games": total_games,
+                "ingest_count": self._ingest_count, "total_ops": self._op_count}
