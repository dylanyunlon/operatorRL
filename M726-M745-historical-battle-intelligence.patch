+"""
+HistoricalPowerSpikeDetector — Detects champion power spike timing from historical data.
+
+Architecture (拿来主义):
+  game_phase_detector.py（M689）— phase-aware detection
+  timing_window_scheduler.py（M699）— time window management
+  item_build_path_analyzer.py — item completion timing
+
+Location: integrations/lol-history/src/lol_history/historical_power_spike_detector.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Power spike windows (level/item/ability) enable proactive aggression/retreat.
+    - Historical kill-rate-at-minute charts reveal when champions become dangerous.
+  System:
+    - Minute-granularity buckets balance precision with statistical significance.
+    - Champion-specific spike definitions are data-driven, not hardcoded.
+"""
+from __future__ import annotations
+import logging, time
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.historical_power_spike_detector.v1"
+
+def _safe_div(a, b, d=0.0): return a / b if b else d
+
+_SPIKE_TYPES = ["level", "item", "ability", "general"]
+
+class HistoricalPowerSpikeDetector:
+    """Detects power spike windows from historical performance data.
+
+    Public API: ingest_performance_timeline, detect_spikes, get_champion_spikes,
+                get_spike_windows_for_matchup, get_stats
+    """
+    def __init__(self, spike_threshold: float = 1.3) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._timelines: Dict[str, List[List[float]]] = {}
+        self._spike_threshold = spike_threshold
+        self._ingest_count = 0
+        self._detected_spikes: Dict[str, List[Dict[str, Any]]] = {}
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def ingest_performance_timeline(self, champion: str,
+                                     minute_scores: List[float],
+                                     won: bool = False) -> Dict[str, Any]:
+        """Record per-minute performance scores for a champion game.
+
+        minute_scores[i] = performance metric at minute i (e.g., damage output, kill pressure).
+        """
+        self._op_count += 1
+        self._ingest_count += 1
+        self._timelines.setdefault(champion, []).append(minute_scores)
+        return {"status": "ok", "champion": champion,
+                "games_tracked": len(self._timelines[champion]),
+                "minutes": len(minute_scores)}
+
+    def detect_spikes(self, champion: str) -> Dict[str, Any]:
+        """Detect power spike minutes from aggregated timeline data."""
+        self._op_count += 1
+        timelines = self._timelines.get(champion, [])
+        if len(timelines) < 3:
+            return {"status": "ok", "champion": champion, "spikes": [],
+                    "reason": "insufficient_data"}
+
+        # Compute average performance per minute across all games
+        max_min = max(len(t) for t in timelines)
+        avg_per_min: List[float] = []
+        for m in range(max_min):
+            values = [t[m] for t in timelines if m < len(t)]
+            avg_per_min.append(sum(values) / len(values) if values else 0.0)
+
+        if not avg_per_min:
+            return {"status": "ok", "champion": champion, "spikes": []}
+
+        overall_avg = sum(avg_per_min) / len(avg_per_min) if avg_per_min else 1.0
+        if overall_avg < 0.001:
+            overall_avg = 1.0
+
+        # Detect spikes: minutes where performance exceeds threshold * overall average
+        spikes = []
+        for m, score in enumerate(avg_per_min):
+            ratio = score / overall_avg
+            if ratio >= self._spike_threshold:
+                # Check if it's a local peak (higher than neighbors)
+                prev_score = avg_per_min[m - 1] if m > 0 else 0
+                next_score = avg_per_min[m + 1] if m < len(avg_per_min) - 1 else 0
+                is_peak = score >= prev_score and score >= next_score
+                spikes.append({
+                    "minute": m, "avg_score": round(score, 4),
+                    "ratio_to_avg": round(ratio, 4), "is_peak": is_peak,
+                    "samples": sum(1 for t in timelines if m < len(t))})
+
+        self._detected_spikes[champion] = spikes
+        self._fire("spikes_detected", {"champion": champion, "count": len(spikes)})
+        return {"status": "ok", "champion": champion, "spikes": spikes,
+                "overall_avg": round(overall_avg, 4), "games_analyzed": len(timelines)}
+
+    def get_champion_spikes(self, champion: str) -> Dict[str, Any]:
+        """Get cached spike data for a champion."""
+        self._op_count += 1
+        spikes = self._detected_spikes.get(champion, [])
+        return {"status": "ok", "champion": champion, "spikes": spikes}
+
+    def get_spike_windows_for_matchup(self, champion_a: str,
+                                       champion_b: str) -> Dict[str, Any]:
+        """Compare power spike windows between two champions."""
+        self._op_count += 1
+        spikes_a = self._detected_spikes.get(champion_a, [])
+        spikes_b = self._detected_spikes.get(champion_b, [])
+
+        spike_mins_a = {s["minute"] for s in spikes_a if s.get("is_peak")}
+        spike_mins_b = {s["minute"] for s in spikes_b if s.get("is_peak")}
+
+        # Windows where A spikes but B doesn't
+        a_advantage = sorted(spike_mins_a - spike_mins_b)
+        b_advantage = sorted(spike_mins_b - spike_mins_a)
+        both_spike = sorted(spike_mins_a & spike_mins_b)
+
+        return {"status": "ok",
+                "champion_a": champion_a, "champion_b": champion_b,
+                "a_advantage_minutes": a_advantage,
+                "b_advantage_minutes": b_advantage,
+                "contested_minutes": both_spike,
+                "recommendation": "engage_at_a_spikes" if len(a_advantage) > len(b_advantage)
+                    else "play_safe_until_spike" if len(b_advantage) > len(a_advantage)
+                    else "even_spike_timing"}
+
+    def get_stats(self) -> Dict[str, Any]:
+        total_games = sum(len(v) for v in self._timelines.values())
+        return {"champions_tracked": len(self._timelines), "total_games": total_games,
+                "champions_with_spikes": len(self._detected_spikes),
+                "ingest_count": self._ingest_count, "total_ops": self._op_count}
