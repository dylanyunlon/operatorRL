+"""
+HistoricalComebackPatternAnalyzer — Identifies comeback patterns from losing positions.
+
+Architecture (拿来主义):
+  loss_pattern_classifier.py — loss pattern classification
+  game_event_pattern_library.py — event pattern storage
+  win_condition_analyzer.py — win condition analysis
+
+Location: integrations/lol-history/src/lol_history/historical_comeback_pattern_analyzer.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Identifies gold-deficit thresholds from which comebacks historically succeed.
+    - Reveals which game events (baron steals, ace fights) most commonly trigger comebacks.
+  System:
+    - Comeback definition: won game where team was behind by >= threshold at some point.
+    - Trigger event extraction via temporal proximity to deficit-reversal inflection point.
+"""
+from __future__ import annotations
+import logging, time
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.historical_comeback_pattern_analyzer.v1"
+
+def _safe_div(a, b, d=0.0): return a / b if b else d
+
+_COMEBACK_TRIGGERS = ["baron_steal", "ace", "elder_dragon", "split_push_trade",
+                      "pick_kill", "teamfight_win", "objective_trade", "shutdown_bounty"]
+
+class HistoricalComebackPatternAnalyzer:
+    """Analyzes comeback patterns from historical games.
+
+    Public API: ingest_game_timeline, analyze_comeback_rate, get_trigger_distribution,
+                get_comeback_probability, get_stats
+    """
+    def __init__(self, deficit_threshold: float = 3000.0) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._games: List[Dict[str, Any]] = []
+        self._deficit_threshold = deficit_threshold
+        self._ingest_count = 0
+        self._comeback_games: List[Dict[str, Any]] = []
+        self._trigger_counts: Dict[str, int] = {}
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def ingest_game_timeline(self, won: bool,
+                              gold_diffs: List[float],
+                              events: List[Dict[str, Any]] = None,
+                              game_duration_min: float = 0.0) -> Dict[str, Any]:
+        """Ingest a game timeline with per-minute gold diffs and key events.
+
+        gold_diffs[i] = team gold advantage at minute i (negative = behind).
+        events: list of {type: str, minute: int, ...}
+        """
+        self._op_count += 1
+        self._ingest_count += 1
+        events = events or []
+        max_deficit = min(gold_diffs) if gold_diffs else 0.0
+        is_comeback = won and max_deficit <= -self._deficit_threshold
+
+        game_entry = {"won": won, "gold_diffs": gold_diffs, "events": events,
+                      "max_deficit": max_deficit, "is_comeback": is_comeback,
+                      "duration": game_duration_min, "timestamp": time.time()}
+        self._games.append(game_entry)
+
+        if is_comeback:
+            # Find inflection point: minute where deficit starts recovering
+            inflection_min = 0
+            for i in range(1, len(gold_diffs)):
+                if gold_diffs[i] > gold_diffs[i - 1] and gold_diffs[i - 1] < 0:
+                    inflection_min = i
+                    break
+
+            # Find trigger events near inflection
+            triggers = []
+            for e in events:
+                e_min = e.get("minute", 0)
+                if abs(e_min - inflection_min) <= 3:
+                    triggers.append(e.get("type", "unknown"))
+                    self._trigger_counts[e.get("type", "unknown")] = \
+                        self._trigger_counts.get(e.get("type", "unknown"), 0) + 1
+
+            game_entry["inflection_minute"] = inflection_min
+            game_entry["triggers"] = triggers
+            self._comeback_games.append(game_entry)
+            self._fire("comeback_detected", {"deficit": max_deficit, "triggers": triggers})
+
+        return {"status": "ok", "is_comeback": is_comeback,
+                "max_deficit": round(max_deficit, 0),
+                "total_games": len(self._games)}
+
+    def analyze_comeback_rate(self, deficit_range: float = 0.0) -> Dict[str, Any]:
+        """Analyze comeback win rate, optionally at a specific deficit range."""
+        self._op_count += 1
+        if not self._games:
+            return {"status": "ok", "comeback_rate": 0.0, "total_games": 0}
+
+        if deficit_range > 0:
+            eligible = [g for g in self._games if min(g["gold_diffs"]) <= -deficit_range]
+        else:
+            eligible = [g for g in self._games if min(g["gold_diffs"]) <= -self._deficit_threshold]
+
+        if not eligible:
+            return {"status": "ok", "comeback_rate": 0.0, "eligible_games": 0}
+
+        comebacks = sum(1 for g in eligible if g["won"])
+        rate = _safe_div(comebacks, len(eligible))
+        avg_deficit = sum(min(g["gold_diffs"]) for g in eligible) / len(eligible)
+
+        return {"status": "ok", "comeback_rate": round(rate, 4),
+                "comebacks": comebacks, "eligible_games": len(eligible),
+                "avg_max_deficit": round(avg_deficit, 0)}
+
+    def get_trigger_distribution(self) -> Dict[str, Any]:
+        """Get distribution of events that trigger comebacks."""
+        self._op_count += 1
+        total = sum(self._trigger_counts.values())
+        distribution = {k: {"count": v, "pct": round(_safe_div(v, total) * 100, 1)}
+                        for k, v in sorted(self._trigger_counts.items(),
+                                            key=lambda x: x[1], reverse=True)}
+        return {"status": "ok", "triggers": distribution, "total_triggers": total,
+                "total_comebacks": len(self._comeback_games)}
+
+    def get_comeback_probability(self, current_gold_diff: float,
+                                  current_minute: int) -> Dict[str, Any]:
+        """Estimate comeback probability from current game state."""
+        self._op_count += 1
+        if current_gold_diff >= 0:
+            return {"status": "ok", "probability": 0.5, "note": "not_behind"}
+
+        # Find historical games with similar deficit at similar time
+        similar = []
+        for g in self._games:
+            if current_minute < len(g["gold_diffs"]):
+                hist_diff = g["gold_diffs"][current_minute]
+                if abs(hist_diff - current_gold_diff) < 1500:
+                    similar.append(g)
+
+        if len(similar) < 3:
+            # Fallback: use overall comeback rate
+            rate_data = self.analyze_comeback_rate(abs(current_gold_diff))
+            return {"status": "ok", "probability": rate_data.get("comeback_rate", 0.0),
+                    "method": "overall_rate", "similar_games": len(similar)}
+
+        wins = sum(1 for g in similar if g["won"])
+        prob = _safe_div(wins, len(similar))
+        return {"status": "ok", "probability": round(prob, 4),
+                "method": "situation_match", "similar_games": len(similar),
+                "current_deficit": round(current_gold_diff, 0)}
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {"total_games": len(self._games), "comeback_games": len(self._comeback_games),
+                "overall_comeback_rate": round(_safe_div(len(self._comeback_games), len(self._games)), 4),
+                "trigger_types": len(self._trigger_counts),
+                "ingest_count": self._ingest_count, "total_ops": self._op_count}
