+"""
+AllySynergyHistoryScorer — Scores historical synergy between allied players.
+
+Architecture (拿来主义):
+  team_synergy_scorer.py — existing synergy evaluation pattern
+  seraphine_bridge.py — match history access for ally data
+  pregame_scout.py — player profiling aggregation
+
+Location: integrations/lol-history/src/lol_history/ally_synergy_history_scorer.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Duo/trio synergy detection reveals hidden team advantages.
+    - Champion-pair win rates surface which combos the team executes well.
+  System:
+    - Pairwise computation is O(n^2) but n<=5 so trivially bounded.
+    - Shared game detection uses sorted-puuid-pair keys for canonical ordering.
+"""
+from __future__ import annotations
+import logging, time
+from typing import Any, Callable, Dict, List, Optional, Tuple
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.ally_synergy_history_scorer.v1"
+
+def _safe_div(a, b, d=0.0): return a / b if b else d
+def _pair_key(a: str, b: str) -> str: return "|".join(sorted([a, b]))
+
+class AllySynergyHistoryScorer:
+    """Scores historical synergy between allied players from shared match history.
+
+    Public API: ingest_team_histories, get_pair_synergy, get_team_synergy,
+                get_champion_pair_stats, get_stats
+    """
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._pair_data: Dict[str, Dict[str, Any]] = {}
+        self._champion_pairs: Dict[str, Dict[str, Any]] = {}
+        self._ingest_count = 0
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def ingest_team_histories(self, team: Dict[str, List[Dict[str, Any]]]) -> Dict[str, Any]:
+        """Ingest match histories for all team members and compute pairwise synergy.
+
+        Args:
+            team: Dict mapping puuid -> list of match dicts.
+                  Each match must have 'match_id', 'win', optionally 'champion', 'kills', 'deaths', 'assists'.
+        """
+        self._op_count += 1
+        self._ingest_count += 1
+        puuids = list(team.keys())
+        pairs_computed = 0
+
+        # Build match_id -> participant map per player
+        player_matches: Dict[str, Dict[str, Dict]] = {}
+        for puuid, matches in team.items():
+            player_matches[puuid] = {}
+            for m in matches:
+                mid = m.get("match_id", "")
+                if mid:
+                    player_matches[puuid][mid] = m
+
+        # Pairwise analysis
+        for i in range(len(puuids)):
+            for j in range(i + 1, len(puuids)):
+                pa, pb = puuids[i], puuids[j]
+                pk = _pair_key(pa, pb)
+                shared_ids = set(player_matches[pa].keys()) & set(player_matches[pb].keys())
+                if not shared_ids:
+                    continue
+
+                shared_wins = 0
+                shared_total = len(shared_ids)
+                total_combined_kda = 0.0
+                champ_pair_counts: Dict[str, int] = {}
+                champ_pair_wins: Dict[str, int] = {}
+
+                for mid in shared_ids:
+                    ma = player_matches[pa][mid]
+                    mb = player_matches[pb][mid]
+                    won = ma.get("win", False) or mb.get("win", False)
+                    if won:
+                        shared_wins += 1
+                    ka = (ma.get("kills", 0) + ma.get("assists", 0)) / max(ma.get("deaths", 0), 1)
+                    kb = (mb.get("kills", 0) + mb.get("assists", 0)) / max(mb.get("deaths", 0), 1)
+                    total_combined_kda += (ka + kb) / 2.0
+
+                    cp = _pair_key(ma.get("champion", "?"), mb.get("champion", "?"))
+                    champ_pair_counts[cp] = champ_pair_counts.get(cp, 0) + 1
+                    if won:
+                        champ_pair_wins[cp] = champ_pair_wins.get(cp, 0) + 1
+
+                synergy_wr = _safe_div(shared_wins, shared_total)
+                avg_combined_kda = _safe_div(total_combined_kda, shared_total)
+                synergy_score = round(synergy_wr * 0.6 + min(avg_combined_kda / 5.0, 1.0) * 0.4, 4)
+
+                self._pair_data[pk] = {
+                    "players": [pa, pb], "shared_games": shared_total,
+                    "shared_win_rate": round(synergy_wr, 4),
+                    "avg_combined_kda": round(avg_combined_kda, 2),
+                    "synergy_score": synergy_score}
+
+                # Champion pair stats
+                for cp, cnt in champ_pair_counts.items():
+                    cpk = f"{pk}:{cp}"
+                    self._champion_pairs[cpk] = {
+                        "player_pair": pk, "champion_pair": cp,
+                        "games": cnt, "wins": champ_pair_wins.get(cp, 0),
+                        "win_rate": round(_safe_div(champ_pair_wins.get(cp, 0), cnt), 4)}
+
+                pairs_computed += 1
+
+        self._fire("team_synergy_computed", {"pairs": pairs_computed, "players": len(puuids)})
+        return {"status": "ok", "pairs_computed": pairs_computed, "players": len(puuids)}
+
+    def get_pair_synergy(self, puuid_a: str, puuid_b: str) -> Dict[str, Any]:
+        self._op_count += 1
+        pk = _pair_key(puuid_a, puuid_b)
+        data = self._pair_data.get(pk)
+        if not data:
+            return {"status": "not_found", "pair": pk}
+        return {"status": "ok", **data}
+
+    def get_team_synergy(self) -> Dict[str, Any]:
+        """Aggregate synergy score across all pairs."""
+        self._op_count += 1
+        if not self._pair_data:
+            return {"status": "ok", "team_synergy": 0.0, "pairs": 0}
+        scores = [d["synergy_score"] for d in self._pair_data.values()]
+        return {"status": "ok", "team_synergy": round(sum(scores) / len(scores), 4),
+                "pairs": len(scores), "pair_details": dict(self._pair_data)}
+
+    def get_champion_pair_stats(self, min_games: int = 2) -> Dict[str, Any]:
+        self._op_count += 1
+        filtered = {k: v for k, v in self._champion_pairs.items() if v["games"] >= min_games}
+        return {"status": "ok", "champion_pairs": filtered, "count": len(filtered)}
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {"total_pairs": len(self._pair_data), "ingest_count": self._ingest_count,
+                "champion_pairs_tracked": len(self._champion_pairs), "total_ops": self._op_count}
