@@ -0,0 +1,155 @@
+"""
+OpponentWardHabitProfiler — Profiles ward placement habits from historical data.
+
+Architecture (拿来主义):
+  ward_pattern_analyzer.py — existing ward analysis
+  vision_control_reasoner.py（M698）— vision control logic
+  fiddler_lol_decoder.py — ward event decoding from protocol
+
+Location: integrations/lol-history/src/lol_history/opponent_ward_habit_profiler.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Reveals where opponents habitually place wards, enabling counter-vision.
+    - Time-of-game bucketing shows when opponents ward (early roams vs objective setup).
+  System:
+    - Grid-based ward position quantization reduces storage while preserving patterns.
+    - Statistical significance guard prevents acting on 1-2 sample ward spots.
+"""
+from __future__ import annotations
+import logging, time, math
+from collections import Counter
+from typing import Any, Callable, Dict, List, Optional, Tuple
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.opponent_ward_habit_profiler.v1"
+
+def _safe_div(a, b, d=0.0): return a / b if b else d
+def _grid_key(x: float, y: float, grid_size: float = 500.0) -> str:
+    gx = int(x // grid_size)
+    gy = int(y // grid_size)
+    return f"{gx},{gy}"
+
+_WARD_TYPES = ["stealth", "control", "trinket", "farsight"]
+_PHASE_BUCKETS = ["early", "mid", "late"]
+
+def _phase_from_time(seconds: float) -> str:
+    if seconds < 840:
+        return "early"
+    elif seconds < 1500:
+        return "mid"
+    return "late"
+
+class OpponentWardHabitProfiler:
+    """Profiles opponent warding habits from historical match data.
+
+    Public API: ingest_ward_event, get_ward_profile, get_hotspot_map,
+                get_vulnerability_windows, get_stats
+    """
+    def __init__(self, grid_size: float = 500.0, min_samples: int = 3) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._player_wards: Dict[str, List[Dict[str, Any]]] = {}
+        self._grid_size = grid_size
+        self._min_samples = min_samples
+        self._ingest_count = 0
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def ingest_ward_event(self, puuid: str, ward_type: str,
+                           x: float, y: float, game_time_seconds: float,
+                           champion: str = "") -> Dict[str, Any]:
+        """Record a historical ward placement event."""
+        self._op_count += 1
+        self._ingest_count += 1
+        entry = {"ward_type": ward_type, "x": x, "y": y,
+                 "grid": _grid_key(x, y, self._grid_size),
+                 "game_time": game_time_seconds,
+                 "phase": _phase_from_time(game_time_seconds),
+                 "champion": champion, "timestamp": time.time()}
+        self._player_wards.setdefault(puuid, []).append(entry)
+        return {"status": "ok", "puuid": puuid, "grid": entry["grid"],
+                "total_events": len(self._player_wards[puuid])}
+
+    def get_ward_profile(self, puuid: str) -> Dict[str, Any]:
+        """Get overall warding profile for a player."""
+        self._op_count += 1
+        wards = self._player_wards.get(puuid, [])
+        if not wards:
+            return {"status": "ok", "puuid": puuid, "profile": {}, "total": 0}
+
+        type_counts = Counter(w["ward_type"] for w in wards)
+        phase_counts = Counter(w["phase"] for w in wards)
+        avg_time = sum(w["game_time"] for w in wards) / len(wards)
+        wards_per_game_est = len(wards)  # would need game count for true average
+
+        return {"status": "ok", "puuid": puuid, "total_wards": len(wards),
+                "type_distribution": dict(type_counts),
+                "phase_distribution": dict(phase_counts),
+                "avg_placement_time": round(avg_time, 1)}
+
+    def get_hotspot_map(self, puuid: str, phase: str = "",
+                        top_n: int = 10) -> Dict[str, Any]:
+        """Get top ward placement hotspots for a player."""
+        self._op_count += 1
+        wards = self._player_wards.get(puuid, [])
+        if phase:
+            wards = [w for w in wards if w["phase"] == phase]
+        if not wards:
+            return {"status": "ok", "puuid": puuid, "hotspots": []}
+
+        grid_counts = Counter(w["grid"] for w in wards)
+        hotspots = []
+        for grid, count in grid_counts.most_common(top_n):
+            if count < self._min_samples:
+                continue
+            # Average position within grid
+            grid_wards = [w for w in wards if w["grid"] == grid]
+            avg_x = sum(w["x"] for w in grid_wards) / len(grid_wards)
+            avg_y = sum(w["y"] for w in grid_wards) / len(grid_wards)
+            type_dist = Counter(w["ward_type"] for w in grid_wards)
+            hotspots.append({"grid": grid, "count": count,
+                             "avg_x": round(avg_x, 1), "avg_y": round(avg_y, 1),
+                             "primary_type": type_dist.most_common(1)[0][0],
+                             "frequency_pct": round(count / len(wards) * 100, 1)})
+
+        self._fire("hotspots_computed", {"puuid": puuid, "count": len(hotspots)})
+        return {"status": "ok", "puuid": puuid, "hotspots": hotspots,
+                "total_wards_filtered": len(wards)}
+
+    def get_vulnerability_windows(self, puuid: str) -> Dict[str, Any]:
+        """Identify time windows when opponent wards least (vulnerability)."""
+        self._op_count += 1
+        wards = self._player_wards.get(puuid, [])
+        if len(wards) < 5:
+            return {"status": "ok", "puuid": puuid, "windows": [], "reason": "insufficient_data"}
+
+        # Bucket by 2-minute windows
+        bucket_size = 120
+        buckets: Dict[int, int] = {}
+        for w in wards:
+            b = int(w["game_time"] // bucket_size)
+            buckets[b] = buckets.get(b, 0) + 1
+
+        if not buckets:
+            return {"status": "ok", "puuid": puuid, "windows": []}
+
+        avg_per_bucket = sum(buckets.values()) / max(len(buckets), 1)
+        vulnerable = []
+        for b in range(max(buckets.keys()) + 1):
+            count = buckets.get(b, 0)
+            if count < avg_per_bucket * 0.5:
+                start_sec = b * bucket_size
+                vulnerable.append({
+                    "window_start": start_sec, "window_end": start_sec + bucket_size,
+                    "label": f"{start_sec // 60}-{(start_sec + bucket_size) // 60}min",
+                    "ward_count": count, "vs_average": round(count / max(avg_per_bucket, 0.1), 2)})
+
+        return {"status": "ok", "puuid": puuid, "windows": vulnerable,
+                "avg_per_window": round(avg_per_bucket, 2)}
+
+    def get_stats(self) -> Dict[str, Any]:
+        total_events = sum(len(v) for v in self._player_wards.values())
+        return {"players_tracked": len(self._player_wards), "total_events": total_events,
+                "ingest_count": self._ingest_count, "total_ops": self._op_count}
