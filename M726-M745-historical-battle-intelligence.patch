+"""
+HistoricalObjectiveTimingAnalyzer — Analyzes dragon/baron/herald timing from history.
+
+Architecture (拿来主义):
+  timing_window_scheduler.py（M699）— time-sensitive window scheduling
+  game_phase_detector.py（M689）— phase-aware timing
+  game_event_pattern_library.py — event pattern storage
+
+Location: integrations/lol-history/src/lol_history/historical_objective_timing_analyzer.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Reveals opponents' typical dragon/baron timing for counter-preparation.
+    - Win-rate correlation per timing window surfaces which objectives matter most.
+  System:
+    - Timing buckets (0-5min, 5-10min, etc.) enable efficient aggregation.
+    - Per-team-comp keying prevents averaging unrelated compositions.
+"""
+from __future__ import annotations
+import logging, time
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.historical_objective_timing_analyzer.v1"
+
+def _safe_div(a, b, d=0.0): return a / b if b else d
+
+_OBJECTIVES = ["dragon", "baron", "herald", "elder_dragon", "tower_first"]
+_TIME_BUCKETS = [(0, 300), (300, 600), (600, 900), (900, 1200), (1200, 1800), (1800, 9999)]
+
+def _bucket_label(seconds: float) -> str:
+    for lo, hi in _TIME_BUCKETS:
+        if lo <= seconds < hi:
+            return f"{lo//60}-{hi//60}min"
+    return "30+min"
+
+class HistoricalObjectiveTimingAnalyzer:
+    """Analyzes objective timing patterns from historical match data.
+
+    Public API: ingest_objective_event, get_timing_profile, get_opponent_tendencies,
+                predict_next_objective_window, get_stats
+    """
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._events: Dict[str, List[Dict[str, Any]]] = {}
+        self._player_events: Dict[str, List[Dict[str, Any]]] = {}
+        self._ingest_count = 0
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def ingest_objective_event(self, puuid: str, objective: str,
+                                game_time_seconds: float, won_game: bool,
+                                team_initiated: bool = True,
+                                champion: str = "") -> Dict[str, Any]:
+        """Record a historical objective event."""
+        self._op_count += 1
+        self._ingest_count += 1
+        if objective not in _OBJECTIVES:
+            return {"status": "error", "reason": f"unknown objective: {objective}"}
+
+        entry = {"puuid": puuid, "objective": objective,
+                 "time_seconds": game_time_seconds, "bucket": _bucket_label(game_time_seconds),
+                 "won_game": won_game, "team_initiated": team_initiated,
+                 "champion": champion, "timestamp": time.time()}
+        self._events.setdefault(objective, []).append(entry)
+        self._player_events.setdefault(puuid, []).append(entry)
+        return {"status": "ok", "objective": objective, "bucket": entry["bucket"]}
+
+    def get_timing_profile(self, objective: str) -> Dict[str, Any]:
+        """Get aggregate timing distribution for an objective type."""
+        self._op_count += 1
+        events = self._events.get(objective, [])
+        if not events:
+            return {"status": "ok", "objective": objective, "profile": {}, "total": 0}
+        bucket_stats: Dict[str, Dict[str, int]] = {}
+        for e in events:
+            b = e["bucket"]
+            if b not in bucket_stats:
+                bucket_stats[b] = {"total": 0, "wins": 0, "initiated": 0}
+            bucket_stats[b]["total"] += 1
+            if e["won_game"]:
+                bucket_stats[b]["wins"] += 1
+            if e["team_initiated"]:
+                bucket_stats[b]["initiated"] += 1
+        profile = {}
+        for b, s in bucket_stats.items():
+            profile[b] = {"count": s["total"],
+                          "win_rate": round(_safe_div(s["wins"], s["total"]), 4),
+                          "initiation_rate": round(_safe_div(s["initiated"], s["total"]), 4)}
+        return {"status": "ok", "objective": objective, "profile": profile, "total": len(events)}
+
+    def get_opponent_tendencies(self, puuid: str,
+                                 objective: str = "") -> Dict[str, Any]:
+        """Analyze an opponent's objective timing tendencies."""
+        self._op_count += 1
+        events = self._player_events.get(puuid, [])
+        if objective:
+            events = [e for e in events if e["objective"] == objective]
+        if not events:
+            return {"status": "ok", "puuid": puuid, "tendencies": {}, "total": 0}
+
+        by_obj: Dict[str, List[float]] = {}
+        for e in events:
+            by_obj.setdefault(e["objective"], []).append(e["time_seconds"])
+        tendencies = {}
+        for obj, times in by_obj.items():
+            avg_time = sum(times) / len(times)
+            earliest = min(times)
+            latest = max(times)
+            tendencies[obj] = {"avg_time_seconds": round(avg_time, 1),
+                               "earliest": round(earliest, 1), "latest": round(latest, 1),
+                               "preferred_bucket": _bucket_label(avg_time), "samples": len(times)}
+        return {"status": "ok", "puuid": puuid, "tendencies": tendencies, "total": len(events)}
+
+    def predict_next_objective_window(self, puuid: str, objective: str,
+                                       current_game_time: float) -> Dict[str, Any]:
+        """Predict when an opponent is likely to attempt the next objective."""
+        self._op_count += 1
+        events = [e for e in self._player_events.get(puuid, [])
+                  if e["objective"] == objective and e["time_seconds"] > current_game_time]
+        if not events:
+            all_events = [e for e in self._player_events.get(puuid, [])
+                          if e["objective"] == objective]
+            if not all_events:
+                return {"status": "ok", "prediction": "no_data"}
+            times = [e["time_seconds"] for e in all_events]
+            avg = sum(times) / len(times)
+            if avg <= current_game_time:
+                return {"status": "ok", "prediction": "overdue",
+                        "expected_time": round(avg, 1), "current": round(current_game_time, 1)}
+            return {"status": "ok", "prediction": "expected",
+                    "expected_time": round(avg, 1), "window_bucket": _bucket_label(avg)}
+
+        future_times = [e["time_seconds"] for e in events]
+        predicted = sum(future_times) / len(future_times)
+        urgency = "low"
+        diff = predicted - current_game_time
+        if diff < 60:
+            urgency = "imminent"
+        elif diff < 180:
+            urgency = "high"
+        elif diff < 300:
+            urgency = "medium"
+        self._fire("objective_predicted", {"puuid": puuid, "objective": objective, "urgency": urgency})
+        return {"status": "ok", "prediction": "expected",
+                "expected_time": round(predicted, 1), "urgency": urgency,
+                "window_bucket": _bucket_label(predicted), "samples": len(future_times)}
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {"total_events": sum(len(v) for v in self._events.values()),
+                "players_tracked": len(self._player_events),
+                "ingest_count": self._ingest_count, "total_ops": self._op_count,
+                "events_by_objective": {k: len(v) for k, v in self._events.items()}}
