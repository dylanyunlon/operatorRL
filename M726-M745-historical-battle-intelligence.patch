+"""
+HistoricalRoamingPatternDetector — Detects roaming patterns from historical match data.
+
+Architecture (拿来主义):
+  ward_pattern_analyzer.py — spatial pattern detection
+  game_phase_detector.py（M689）— phase-aware analysis
+  opponent_ward_habit_profiler.py（M735）— grid-based spatial bucketing
+
+Location: integrations/lol-history/src/lol_history/historical_roaming_pattern_detector.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Reveals when and where opponents typically roam, enabling counter-roam preparation.
+    - Roam success rate per timing window guides when to follow vs stay in lane.
+  System:
+    - Roam events detected by kill/assist location far from assigned lane.
+    - Minute-bucketed frequency map enables temporal pattern recognition.
+"""
+from __future__ import annotations
+import logging, time
+from collections import Counter
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.historical_roaming_pattern_detector.v1"
+
+def _safe_div(a, b, d=0.0): return a / b if b else d
+
+_LANES = ["top", "mid", "bot", "jungle"]
+_ROAM_TARGETS = ["top", "mid", "bot", "dragon", "baron", "herald"]
+
+class HistoricalRoamingPatternDetector:
+    """Detects roaming patterns from historical match event data.
+
+    Public API: ingest_roam_event, get_roam_profile, get_roam_timing,
+                predict_roam_target, get_stats
+    """
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._player_roams: Dict[str, List[Dict[str, Any]]] = {}
+        self._ingest_count = 0
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def ingest_roam_event(self, puuid: str, origin_lane: str, target_area: str,
+                           game_time_seconds: float, resulted_in_kill: bool,
+                           champion: str = "", role: str = "") -> Dict[str, Any]:
+        """Record a historical roaming event."""
+        self._op_count += 1
+        self._ingest_count += 1
+        minute = int(game_time_seconds // 60)
+        entry = {"origin": origin_lane, "target": target_area,
+                 "time_seconds": game_time_seconds, "minute": minute,
+                 "success": resulted_in_kill, "champion": champion,
+                 "role": role, "timestamp": time.time()}
+        self._player_roams.setdefault(puuid, []).append(entry)
+        return {"status": "ok", "puuid": puuid,
+                "total_roams": len(self._player_roams[puuid])}
+
+    def get_roam_profile(self, puuid: str) -> Dict[str, Any]:
+        """Get comprehensive roaming profile for a player."""
+        self._op_count += 1
+        roams = self._player_roams.get(puuid, [])
+        if not roams:
+            return {"status": "ok", "puuid": puuid, "profile": {}, "total": 0}
+
+        target_counts = Counter(r["target"] for r in roams)
+        origin_counts = Counter(r["origin"] for r in roams)
+        success_count = sum(1 for r in roams if r["success"])
+        success_rate = _safe_div(success_count, len(roams))
+
+        # Per-target success rate
+        target_success: Dict[str, Dict[str, Any]] = {}
+        for target in set(r["target"] for r in roams):
+            target_roams = [r for r in roams if r["target"] == target]
+            target_wins = sum(1 for r in target_roams if r["success"])
+            target_success[target] = {
+                "count": len(target_roams),
+                "success_rate": round(_safe_div(target_wins, len(target_roams)), 4)}
+
+        avg_roam_time = sum(r["time_seconds"] for r in roams) / len(roams)
+
+        return {"status": "ok", "puuid": puuid, "total_roams": len(roams),
+                "overall_success_rate": round(success_rate, 4),
+                "preferred_targets": dict(target_counts.most_common()),
+                "origin_distribution": dict(origin_counts),
+                "target_success": target_success,
+                "avg_roam_time_seconds": round(avg_roam_time, 1)}
+
+    def get_roam_timing(self, puuid: str, bucket_minutes: int = 2) -> Dict[str, Any]:
+        """Get roaming frequency by time bucket."""
+        self._op_count += 1
+        roams = self._player_roams.get(puuid, [])
+        if not roams:
+            return {"status": "ok", "puuid": puuid, "timing": {}}
+
+        buckets: Dict[str, Dict[str, int]] = {}
+        for r in roams:
+            b = (r["minute"] // bucket_minutes) * bucket_minutes
+            label = f"{b}-{b + bucket_minutes}min"
+            if label not in buckets:
+                buckets[label] = {"count": 0, "successes": 0}
+            buckets[label]["count"] += 1
+            if r["success"]:
+                buckets[label]["successes"] += 1
+
+        timing = {}
+        for label, stats in sorted(buckets.items()):
+            timing[label] = {
+                "count": stats["count"],
+                "success_rate": round(_safe_div(stats["successes"], stats["count"]), 4)}
+
+        # Find peak roaming window
+        peak = max(timing.items(), key=lambda x: x[1]["count"]) if timing else (None, {})
+
+        return {"status": "ok", "puuid": puuid, "timing": timing,
+                "peak_window": peak[0], "peak_count": peak[1].get("count", 0)}
+
+    def predict_roam_target(self, puuid: str, current_minute: int,
+                             available_targets: List[str] = None) -> Dict[str, Any]:
+        """Predict most likely roam target at current game time."""
+        self._op_count += 1
+        roams = self._player_roams.get(puuid, [])
+        if not roams:
+            return {"status": "ok", "puuid": puuid, "prediction": "no_data"}
+
+        # Filter to similar timing (within 3 minutes)
+        similar = [r for r in roams if abs(r["minute"] - current_minute) <= 3]
+        if not similar:
+            similar = roams  # fallback to all data
+
+        target_scores: Dict[str, float] = {}
+        for r in similar:
+            t = r["target"]
+            if available_targets and t not in available_targets:
+                continue
+            # Score: count * success_bonus
+            bonus = 1.5 if r["success"] else 1.0
+            target_scores[t] = target_scores.get(t, 0) + bonus
+
+        if not target_scores:
+            return {"status": "ok", "puuid": puuid, "prediction": "no_matching_data"}
+
+        total = sum(target_scores.values())
+        predictions = []
+        for t, score in sorted(target_scores.items(), key=lambda x: x[1], reverse=True):
+            predictions.append({"target": t, "probability": round(_safe_div(score, total), 4),
+                                "score": round(score, 2)})
+
+        self._fire("roam_predicted", {"puuid": puuid, "top_target": predictions[0]["target"]})
+        return {"status": "ok", "puuid": puuid, "predictions": predictions,
+                "current_minute": current_minute, "samples": len(similar)}
+
+    def get_stats(self) -> Dict[str, Any]:
+        total_roams = sum(len(v) for v in self._player_roams.values())
+        return {"players_tracked": len(self._player_roams), "total_roams": total_roams,
+                "ingest_count": self._ingest_count, "total_ops": self._op_count}
