@@ -0,0 +1,170 @@
+"""
+HistoricalDecisionQualityBenchmarker — Benchmarks decision quality against historical baselines.
+
+Architecture (拿来主义):
+  decision_quality_scorer.py（M702）— decision scoring pattern
+  coaching_effectiveness_tracker.py（M613）— effectiveness tracking
+  lane_phase_history_comparator.py（M730）— Welford baseline comparison
+
+Location: integrations/lol-history/src/lol_history/historical_decision_quality_benchmarker.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Benchmarks current game decisions against historical best/average/worst performance.
+    - Identifies decision categories where the player consistently underperforms.
+  System:
+    - Decision categories (farm/fight/objective/roam/retreat) tracked independently.
+    - Percentile ranking against historical distribution surfaces relative performance.
+"""
+from __future__ import annotations
+import logging, time, math
+from collections import deque
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.historical_decision_quality_benchmarker.v1"
+
+def _safe_div(a, b, d=0.0): return a / b if b else d
+
+_DECISION_CATEGORIES = ["farm", "fight", "objective", "roam", "retreat",
+                         "vision", "itemization", "positioning"]
+
+class HistoricalDecisionQualityBenchmarker:
+    """Benchmarks decision quality against historical baselines per category.
+
+    Public API: ingest_historical_score, benchmark_live_decision,
+                get_category_report, get_improvement_areas, get_stats
+    """
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._baselines: Dict[str, Dict[str, List[float]]] = {}
+        self._live_scores: Dict[str, List[Dict[str, Any]]] = {}
+        self._ingest_count = 0
+        self._benchmark_count = 0
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def _pk(self, puuid: str, champion: str) -> str:
+        return f"{puuid}:{champion}"
+
+    def ingest_historical_score(self, puuid: str, champion: str,
+                                 category: str, score: float) -> Dict[str, Any]:
+        """Record a historical decision quality score for baseline building."""
+        self._op_count += 1
+        self._ingest_count += 1
+        pk = self._pk(puuid, champion)
+        cat_scores = self._baselines.setdefault(pk, {}).setdefault(category, [])
+        cat_scores.append(score)
+        return {"status": "ok", "key": pk, "category": category,
+                "total_samples": len(cat_scores)}
+
+    def _percentile(self, values: List[float], target: float) -> float:
+        """Compute percentile rank of target in sorted values."""
+        if not values:
+            return 50.0
+        sorted_v = sorted(values)
+        count_below = sum(1 for v in sorted_v if v < target)
+        count_equal = sum(1 for v in sorted_v if v == target)
+        return round((count_below + 0.5 * count_equal) / len(sorted_v) * 100, 1)
+
+    def benchmark_live_decision(self, puuid: str, champion: str,
+                                 category: str, live_score: float) -> Dict[str, Any]:
+        """Benchmark a live decision score against historical baseline."""
+        self._op_count += 1
+        self._benchmark_count += 1
+        pk = self._pk(puuid, champion)
+        baseline_scores = self._baselines.get(pk, {}).get(category, [])
+
+        if not baseline_scores:
+            return {"status": "ok", "key": pk, "category": category,
+                    "percentile": 50.0, "vs_baseline": "no_data",
+                    "live_score": live_score}
+
+        avg = sum(baseline_scores) / len(baseline_scores)
+        best = max(baseline_scores)
+        worst = min(baseline_scores)
+        std = math.sqrt(sum((s - avg) ** 2 for s in baseline_scores) / len(baseline_scores)) \
+            if len(baseline_scores) > 1 else 0.0
+
+        percentile = self._percentile(baseline_scores, live_score)
+        z_score = (live_score - avg) / std if std > 0.001 else 0.0
+
+        if percentile >= 75:
+            rating = "excellent"
+        elif percentile >= 50:
+            rating = "above_average"
+        elif percentile >= 25:
+            rating = "below_average"
+        else:
+            rating = "poor"
+
+        result = {"live_score": round(live_score, 4), "percentile": percentile,
+                  "rating": rating, "z_score": round(z_score, 2),
+                  "baseline_avg": round(avg, 4), "baseline_best": round(best, 4),
+                  "baseline_worst": round(worst, 4), "samples": len(baseline_scores)}
+
+        # Track live scores
+        self._live_scores.setdefault(pk, []).append(
+            {"category": category, "score": live_score, "percentile": percentile,
+             "rating": rating, "timestamp": time.time()})
+
+        if rating == "poor":
+            self._fire("poor_decision", {"key": pk, "category": category,
+                                         "percentile": percentile})
+
+        return {"status": "ok", "key": pk, "category": category, **result}
+
+    def get_category_report(self, puuid: str, champion: str) -> Dict[str, Any]:
+        """Get per-category performance report against baselines."""
+        self._op_count += 1
+        pk = self._pk(puuid, champion)
+        baselines = self._baselines.get(pk, {})
+        if not baselines:
+            return {"status": "ok", "key": pk, "report": {}, "reason": "no_baselines"}
+
+        report = {}
+        for cat, scores in baselines.items():
+            if not scores:
+                continue
+            avg = sum(scores) / len(scores)
+            std = math.sqrt(sum((s - avg) ** 2 for s in scores) / len(scores)) \
+                if len(scores) > 1 else 0.0
+            report[cat] = {"avg": round(avg, 4), "std": round(std, 4),
+                           "best": round(max(scores), 4), "worst": round(min(scores), 4),
+                           "samples": len(scores)}
+
+        return {"status": "ok", "key": pk, "report": report}
+
+    def get_improvement_areas(self, puuid: str, champion: str,
+                               top_n: int = 3) -> Dict[str, Any]:
+        """Identify decision categories where the player most needs improvement."""
+        self._op_count += 1
+        pk = self._pk(puuid, champion)
+        live_data = self._live_scores.get(pk, [])
+        if not live_data:
+            return {"status": "ok", "key": pk, "areas": [], "reason": "no_live_data"}
+
+        # Average percentile per category from live scores
+        cat_percentiles: Dict[str, List[float]] = {}
+        for entry in live_data:
+            cat_percentiles.setdefault(entry["category"], []).append(entry["percentile"])
+
+        category_avgs = []
+        for cat, percs in cat_percentiles.items():
+            avg_pct = sum(percs) / len(percs)
+            category_avgs.append({"category": cat, "avg_percentile": round(avg_pct, 1),
+                                  "samples": len(percs)})
+
+        category_avgs.sort(key=lambda x: x["avg_percentile"])
+        areas = category_avgs[:top_n]
+
+        return {"status": "ok", "key": pk, "improvement_areas": areas,
+                "total_categories": len(category_avgs)}
+
+    def get_stats(self) -> Dict[str, Any]:
+        total_samples = sum(len(s) for d in self._baselines.values() for s in d.values())
+        return {"baselines_tracked": len(self._baselines), "total_samples": total_samples,
+                "benchmark_count": self._benchmark_count,
+                "ingest_count": self._ingest_count, "total_ops": self._op_count}
