@@ -0,0 +1,162 @@
+"""
+OpponentBanPickTendencyPredictor — Predicts opponent ban/pick patterns from history.
+
+Architecture (拿来主义):
+  ban_pick_realtime_advisor.py（M637）— real-time draft advice
+  champion_pool_tracker.py — champion pool tracking
+  seraphine_lcu_deep_client.py — LCU data access
+
+Location: integrations/lol-history/src/lol_history/opponent_ban_pick_tendency_predictor.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Predicts what opponents will ban/pick based on their historical draft patterns.
+    - Enables proactive banning of their comfort picks or securing contested champions.
+  System:
+    - Markov-style pick probability: P(pick_X | banned_Y, role_Z) from history.
+    - Recency weighting ensures patch-relevant data dominates.
+"""
+from __future__ import annotations
+import logging, time
+from collections import Counter
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.opponent_ban_pick_tendency_predictor.v1"
+
+def _safe_div(a, b, d=0.0): return a / b if b else d
+
+class OpponentBanPickTendencyPredictor:
+    """Predicts opponent ban/pick tendencies from historical draft data.
+
+    Public API: ingest_draft_history, predict_bans, predict_picks,
+                get_comfort_picks, get_stats
+    """
+    def __init__(self, recency_decay: float = 0.9) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._player_drafts: Dict[str, List[Dict[str, Any]]] = {}
+        self._recency_decay = recency_decay
+        self._ingest_count = 0
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def ingest_draft_history(self, puuid: str, champion_picked: str,
+                              role: str = "", bans: List[str] = None,
+                              won: bool = False) -> Dict[str, Any]:
+        """Record a historical draft choice."""
+        self._op_count += 1
+        self._ingest_count += 1
+        entry = {"champion": champion_picked, "role": role,
+                 "bans": bans or [], "won": won, "timestamp": time.time()}
+        self._player_drafts.setdefault(puuid, []).append(entry)
+        return {"status": "ok", "puuid": puuid,
+                "total_drafts": len(self._player_drafts[puuid])}
+
+    def _weighted_counts(self, drafts: List[Dict[str, Any]],
+                          key: str) -> Counter:
+        """Recency-weighted frequency counting."""
+        n = len(drafts)
+        c = Counter()
+        for i, d in enumerate(drafts):
+            weight = self._recency_decay ** (n - 1 - i)
+            val = d.get(key, "")
+            if val:
+                c[val] += weight
+        return c
+
+    def predict_bans(self, puuid: str, top_n: int = 5) -> Dict[str, Any]:
+        """Predict what an opponent is likely to ban."""
+        self._op_count += 1
+        drafts = self._player_drafts.get(puuid, [])
+        if not drafts:
+            return {"status": "ok", "puuid": puuid, "predicted_bans": []}
+
+        # Aggregate bans across all games
+        ban_counter = Counter()
+        n = len(drafts)
+        for i, d in enumerate(drafts):
+            weight = self._recency_decay ** (n - 1 - i)
+            for b in d.get("bans", []):
+                ban_counter[b] += weight
+
+        total_weight = sum(ban_counter.values())
+        predictions = []
+        for champ, w in ban_counter.most_common(top_n):
+            predictions.append({"champion": champ,
+                                "probability": round(_safe_div(w, total_weight), 4),
+                                "weighted_count": round(w, 2)})
+
+        self._fire("bans_predicted", {"puuid": puuid, "count": len(predictions)})
+        return {"status": "ok", "puuid": puuid, "predicted_bans": predictions}
+
+    def predict_picks(self, puuid: str, role: str = "",
+                      already_banned: List[str] = None,
+                      top_n: int = 5) -> Dict[str, Any]:
+        """Predict what an opponent is likely to pick."""
+        self._op_count += 1
+        drafts = self._player_drafts.get(puuid, [])
+        if not drafts:
+            return {"status": "ok", "puuid": puuid, "predicted_picks": []}
+
+        # Filter by role if provided
+        if role:
+            filtered = [d for d in drafts if d.get("role", "") == role]
+            if not filtered:
+                filtered = drafts
+        else:
+            filtered = drafts
+
+        pick_counts = self._weighted_counts(filtered, "champion")
+
+        # Remove banned champions
+        banned_set = set(already_banned or [])
+        for b in banned_set:
+            if b in pick_counts:
+                del pick_counts[b]
+
+        total_weight = sum(pick_counts.values())
+        predictions = []
+        for champ, w in pick_counts.most_common(top_n):
+            # Win rate on this champion
+            champ_games = [d for d in filtered if d["champion"] == champ]
+            wins = sum(1 for d in champ_games if d["won"])
+            wr = _safe_div(wins, len(champ_games))
+            predictions.append({"champion": champ,
+                                "probability": round(_safe_div(w, total_weight), 4),
+                                "win_rate": round(wr, 4), "games": len(champ_games)})
+
+        return {"status": "ok", "puuid": puuid, "role": role,
+                "predicted_picks": predictions}
+
+    def get_comfort_picks(self, puuid: str, min_games: int = 3) -> Dict[str, Any]:
+        """Get player's comfort champions with high play rate and good win rate."""
+        self._op_count += 1
+        drafts = self._player_drafts.get(puuid, [])
+        if not drafts:
+            return {"status": "ok", "puuid": puuid, "comfort_picks": []}
+
+        champ_stats: Dict[str, Dict[str, Any]] = {}
+        for d in drafts:
+            c = d["champion"]
+            if c not in champ_stats:
+                champ_stats[c] = {"games": 0, "wins": 0}
+            champ_stats[c]["games"] += 1
+            if d["won"]:
+                champ_stats[c]["wins"] += 1
+
+        comfort = []
+        for c, stats in champ_stats.items():
+            if stats["games"] >= min_games:
+                wr = _safe_div(stats["wins"], stats["games"])
+                comfort.append({"champion": c, "games": stats["games"],
+                                "win_rate": round(wr, 4)})
+
+        comfort.sort(key=lambda x: (-x["games"], -x["win_rate"]))
+        return {"status": "ok", "puuid": puuid, "comfort_picks": comfort}
+
+    def get_stats(self) -> Dict[str, Any]:
+        total_drafts = sum(len(v) for v in self._player_drafts.values())
+        return {"players_tracked": len(self._player_drafts), "total_drafts": total_drafts,
+                "ingest_count": self._ingest_count, "total_ops": self._op_count}
