@@ -0,0 +1,156 @@
+"""
+OpponentLiveHistoryProfiler — Real-time opponent profiling from Seraphine historical data.
+
+Architecture (拿来主义):
+  pregame_scout.py — scout_player threat_level/KDA/champion_pool pattern
+  seraphine_lcu_deep_client.py（M506+）— LCU data access patterns
+  DI-star/distar/agent/default/agent.py — step-level state update
+
+Location: integrations/lol-history/src/lol_history/opponent_live_history_profiler.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Profiles update incrementally as new match data arrives mid-game.
+    - Staleness detection warns when profiles are based on outdated data.
+    - Per-champion profiling enables matchup-specific threat assessment.
+  System:
+    - Profile cache avoids redundant computation on repeated queries.
+    - Thread-safe counters ensure concurrent live-data feeds don't corrupt state.
+    - Evolution callback fires on profile updates for downstream training.
+"""
+from __future__ import annotations
+import logging, time, math
+from collections import deque
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.opponent_live_history_profiler.v1"
+
+def _safe_div(a, b, d=0.0): return a / b if b else d
+def _kda(k, d, a): return (k + a) / max(d, 1)
+def _confidence(n, max_n=20): return min(1.0, math.log1p(n) / math.log1p(max_n)) if n > 0 else 0.0
+
+_THREAT_THRESHOLDS = {"high": (0.58, 3.0), "medium": (0.45, 1.5), "low": (0.0, 0.0)}
+
+class OpponentLiveHistoryProfiler:
+    """Builds and maintains real-time opponent profiles from historical match data.
+
+    Public API: ingest_match_history, get_profile, get_all_profiles,
+                update_live_observation, get_threat_ranking, get_stats
+    """
+    def __init__(self, stale_seconds: float = 600.0) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._profiles: Dict[str, Dict[str, Any]] = {}
+        self._profile_timestamps: Dict[str, float] = {}
+        self._stale_seconds = stale_seconds
+        self._ingest_count = 0
+        self._live_observations: Dict[str, List[Dict]] = {}
+        self._update_history: deque = deque(maxlen=500)
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def ingest_match_history(self, puuid: str, match_history: List[Dict[str, Any]],
+                             current_champion: str = "") -> Dict[str, Any]:
+        """Ingest a player's match history and build/update their profile."""
+        self._op_count += 1
+        self._ingest_count += 1
+        if not match_history:
+            profile = {"puuid": puuid, "win_rate": 0.0, "kda": 0.0,
+                       "main_champions": [], "threat_level": "unknown",
+                       "games_analyzed": 0, "matchup_profile": {},
+                       "confidence": 0.0, "current_champion": current_champion}
+            self._profiles[puuid] = profile
+            self._profile_timestamps[puuid] = time.time()
+            return {"status": "ok", "profile": profile}
+
+        total = len(match_history)
+        wins = sum(1 for m in match_history if m.get("win"))
+        kills = sum(m.get("kills", 0) for m in match_history)
+        deaths = sum(m.get("deaths", 0) for m in match_history)
+        assists = sum(m.get("assists", 0) for m in match_history)
+        win_rate = _safe_div(wins, total)
+        kda = _kda(kills, deaths, assists)
+
+        # Champion frequency analysis
+        champ_counts: Dict[str, int] = {}
+        champ_wins: Dict[str, int] = {}
+        champ_kda: Dict[str, List[float]] = {}
+        for m in match_history:
+            c = m.get("champion", "Unknown")
+            champ_counts[c] = champ_counts.get(c, 0) + 1
+            if m.get("win"):
+                champ_wins[c] = champ_wins.get(c, 0) + 1
+            k, d, a = m.get("kills", 0), m.get("deaths", 0), m.get("assists", 0)
+            champ_kda.setdefault(c, []).append(_kda(k, d, a))
+
+        sorted_champs = sorted(champ_counts.items(), key=lambda x: x[1], reverse=True)
+        main_champions = [c for c, _ in sorted_champs[:5]]
+
+        # Per-champion matchup profile (for the champion they're currently playing)
+        matchup_profile = {}
+        if current_champion and current_champion in champ_counts:
+            cc = current_champion
+            cc_games = champ_counts[cc]
+            cc_wr = _safe_div(champ_wins.get(cc, 0), cc_games)
+            cc_kda_vals = champ_kda.get(cc, [])
+            cc_avg_kda = _safe_div(sum(cc_kda_vals), len(cc_kda_vals))
+            matchup_profile = {"champion": cc, "games": cc_games,
+                               "win_rate": round(cc_wr, 4), "avg_kda": round(cc_avg_kda, 2),
+                               "confidence": round(_confidence(cc_games), 4)}
+
+        # Threat level
+        threat_level = "low"
+        if win_rate >= _THREAT_THRESHOLDS["high"][0] and kda >= _THREAT_THRESHOLDS["high"][1]:
+            threat_level = "high"
+        elif win_rate >= _THREAT_THRESHOLDS["medium"][0] and kda >= _THREAT_THRESHOLDS["medium"][1]:
+            threat_level = "medium"
+
+        profile = {"puuid": puuid, "win_rate": round(win_rate, 4),
+                   "kda": round(kda, 2), "main_champions": main_champions,
+                   "threat_level": threat_level, "games_analyzed": total,
+                   "matchup_profile": matchup_profile,
+                   "confidence": round(_confidence(total), 4),
+                   "current_champion": current_champion,
+                   "total_kills": kills, "total_deaths": deaths, "total_assists": assists}
+        self._profiles[puuid] = profile
+        self._profile_timestamps[puuid] = time.time()
+        self._update_history.append({"puuid": puuid, "timestamp": time.time(), "games": total})
+        self._fire("profile_updated", {"puuid": puuid, "threat_level": threat_level, "games": total})
+        return {"status": "ok", "profile": profile}
+
+    def get_profile(self, puuid: str) -> Dict[str, Any]:
+        self._op_count += 1
+        p = self._profiles.get(puuid)
+        if not p:
+            return {"status": "not_found", "puuid": puuid}
+        stale = (time.time() - self._profile_timestamps.get(puuid, 0)) > self._stale_seconds
+        return {"status": "ok", "profile": p, "stale": stale}
+
+    def get_all_profiles(self) -> Dict[str, Any]:
+        self._op_count += 1
+        return {"status": "ok", "profiles": dict(self._profiles), "count": len(self._profiles)}
+
+    def update_live_observation(self, puuid: str, observation: Dict[str, Any]) -> Dict[str, Any]:
+        """Append a live in-game observation to augment the historical profile."""
+        self._op_count += 1
+        self._live_observations.setdefault(puuid, []).append(
+            {**observation, "timestamp": time.time()})
+        self._fire("live_observation", {"puuid": puuid})
+        return {"status": "ok", "observations": len(self._live_observations[puuid])}
+
+    def get_threat_ranking(self) -> Dict[str, Any]:
+        """Rank all profiled opponents by composite threat score."""
+        self._op_count += 1
+        scores = {}
+        for puuid, p in self._profiles.items():
+            scores[puuid] = p["win_rate"] * 2.0 + p["kda"] * 0.5 + p["confidence"] * 0.3
+        ranking = sorted(scores.keys(), key=lambda x: scores[x], reverse=True)
+        return {"status": "ok", "ranking": ranking,
+                "scores": {k: round(v, 4) for k, v in scores.items()}}
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {"total_profiles": len(self._profiles), "ingest_count": self._ingest_count,
+                "total_ops": self._op_count,
+                "live_observations": sum(len(v) for v in self._live_observations.values())}
