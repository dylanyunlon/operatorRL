+"""
+HistoricalTeamCompEvaluator — Evaluates team compositions from historical win rate data.
+
+Architecture (拿来主义):
+  team_synergy_scorer.py — synergy evaluation patterns
+  win_condition_analyzer.py — win condition classification
+  champion_winrate_matrix.py — cross-champion statistics
+
+Location: integrations/lol-history/src/lol_history/historical_team_comp_evaluator.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Comp evaluation reveals draft advantages before game starts.
+    - Win condition labeling (teamfight/split/poke/pick) guides strategy selection.
+  System:
+    - Composition hashing via sorted champion tuple enables O(1) lookup.
+    - Partial comp matching (4/5 or 3/5 overlap) prevents cold-start on exact comp.
+"""
+from __future__ import annotations
+import logging, time
+from typing import Any, Callable, Dict, FrozenSet, List, Optional, Tuple
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.historical_team_comp_evaluator.v1"
+
+def _safe_div(a, b, d=0.0): return a / b if b else d
+def _comp_hash(champions: List[str]) -> str: return "|".join(sorted(champions))
+
+_WIN_CONDITIONS = ["teamfight", "split_push", "poke", "pick", "scaling", "early_aggression"]
+
+class HistoricalTeamCompEvaluator:
+    """Evaluates team compositions from historical win rate and archetype data.
+
+    Public API: ingest_comp_result, evaluate_comp, compare_comps,
+                get_win_condition, get_stats
+    """
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._comp_data: Dict[str, Dict[str, Any]] = {}
+        self._archetype_rules: Dict[str, List[str]] = {
+            "teamfight": ["Amumu", "Malphite", "Orianna", "MissFortune", "Kennen", "Leona"],
+            "split_push": ["Fiora", "Tryndamere", "Jax", "Camille", "Shen", "Yorick"],
+            "poke": ["Jayce", "Nidalee", "Xerath", "Ziggs", "Varus", "Lux"],
+            "pick": ["Blitzcrank", "Thresh", "Pyke", "Ahri", "Zoe", "Elise"],
+            "scaling": ["Kayle", "Kassadin", "Vayne", "Jinx", "KogMaw", "Vladimir"],
+            "early_aggression": ["Draven", "Renekton", "LeeSin", "Elise", "Pantheon", "Lucian"],
+        }
+        self._ingest_count = 0
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def ingest_comp_result(self, champions: List[str], won: bool,
+                            game_duration_min: float = 0.0,
+                            avg_kda: float = 0.0) -> Dict[str, Any]:
+        """Record a team composition game result."""
+        self._op_count += 1
+        self._ingest_count += 1
+        ch = _comp_hash(champions)
+        if ch not in self._comp_data:
+            self._comp_data[ch] = {"champions": sorted(champions), "wins": 0, "total": 0,
+                                   "duration_sum": 0.0, "kda_sum": 0.0}
+        self._comp_data[ch]["total"] += 1
+        if won:
+            self._comp_data[ch]["wins"] += 1
+        self._comp_data[ch]["duration_sum"] += game_duration_min
+        self._comp_data[ch]["kda_sum"] += avg_kda
+        return {"status": "ok", "comp": ch, "total": self._comp_data[ch]["total"]}
+
+    def _find_similar_comps(self, champions: List[str], min_overlap: int = 3) -> List[Dict[str, Any]]:
+        """Find comps with >= min_overlap champion matches."""
+        target_set = set(champions)
+        results = []
+        for ch, data in self._comp_data.items():
+            overlap = len(set(data["champions"]) & target_set)
+            if overlap >= min_overlap:
+                results.append({**data, "overlap": overlap,
+                                "win_rate": round(_safe_div(data["wins"], data["total"]), 4)})
+        results.sort(key=lambda x: (-x["overlap"], -x["win_rate"]))
+        return results
+
+    def evaluate_comp(self, champions: List[str]) -> Dict[str, Any]:
+        """Evaluate a team composition based on historical data."""
+        self._op_count += 1
+        ch = _comp_hash(champions)
+        exact = self._comp_data.get(ch)
+
+        if exact and exact["total"] >= 3:
+            wr = _safe_div(exact["wins"], exact["total"])
+            avg_dur = _safe_div(exact["duration_sum"], exact["total"])
+            avg_kda = _safe_div(exact["kda_sum"], exact["total"])
+            strength = "strong" if wr >= 0.55 else "average" if wr >= 0.45 else "weak"
+            return {"status": "ok", "match_type": "exact", "win_rate": round(wr, 4),
+                    "strength": strength, "games": exact["total"],
+                    "avg_duration": round(avg_dur, 1), "avg_kda": round(avg_kda, 2),
+                    "win_condition": self.get_win_condition(champions)["primary"]}
+
+        # Fallback to similar comps
+        similar = self._find_similar_comps(champions)
+        if similar:
+            # Weighted average by overlap
+            total_weight = sum(s["overlap"] * s["total"] for s in similar[:10])
+            if total_weight > 0:
+                weighted_wr = sum(s["win_rate"] * s["overlap"] * s["total"]
+                                  for s in similar[:10]) / total_weight
+            else:
+                weighted_wr = 0.5
+            strength = "strong" if weighted_wr >= 0.55 else "average" if weighted_wr >= 0.45 else "weak"
+            return {"status": "ok", "match_type": "similar", "win_rate": round(weighted_wr, 4),
+                    "strength": strength, "similar_comps": len(similar),
+                    "best_overlap": similar[0]["overlap"] if similar else 0,
+                    "win_condition": self.get_win_condition(champions)["primary"]}
+
+        return {"status": "ok", "match_type": "none", "win_rate": 0.5,
+                "strength": "unknown", "win_condition": self.get_win_condition(champions)["primary"]}
+
+    def compare_comps(self, team_a: List[str], team_b: List[str]) -> Dict[str, Any]:
+        """Compare two team compositions."""
+        self._op_count += 1
+        eval_a = self.evaluate_comp(team_a)
+        eval_b = self.evaluate_comp(team_b)
+        wr_a = eval_a.get("win_rate", 0.5)
+        wr_b = eval_b.get("win_rate", 0.5)
+        diff = wr_a - wr_b
+        if diff > 0.05:
+            advantage = "team_a"
+        elif diff < -0.05:
+            advantage = "team_b"
+        else:
+            advantage = "even"
+        return {"status": "ok", "team_a": eval_a, "team_b": eval_b,
+                "advantage": advantage, "win_rate_diff": round(diff, 4)}
+
+    def get_win_condition(self, champions: List[str]) -> Dict[str, Any]:
+        """Classify team composition win condition by archetype matching."""
+        self._op_count += 1
+        scores: Dict[str, int] = {wc: 0 for wc in _WIN_CONDITIONS}
+        champ_set = set(champions)
+        for wc, archetypes in self._archetype_rules.items():
+            overlap = len(champ_set & set(archetypes))
+            scores[wc] = overlap
+        primary = max(scores, key=lambda k: scores[k])
+        sorted_wc = sorted(scores.items(), key=lambda x: x[1], reverse=True)
+        return {"primary": primary, "scores": dict(sorted_wc),
+                "secondary": sorted_wc[1][0] if len(sorted_wc) > 1 else "unknown"}
+
+    def get_stats(self) -> Dict[str, Any]:
+        total_games = sum(d["total"] for d in self._comp_data.values())
+        return {"comps_tracked": len(self._comp_data), "total_games": total_games,
+                "ingest_count": self._ingest_count, "total_ops": self._op_count}
