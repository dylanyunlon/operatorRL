@@ -0,0 +1,187 @@
+"""
+LiveHistoryDecisionFusionEngine — Advanced fusion of live + historical data for decisions.
+
+Architecture (拿来主义):
+  live_history_fusion_engine.py — existing basic fusion
+  autonomous_decision_orchestrator.py（M705）— decision loop integration
+  realtime_inference_chain_builder.py（M653）— inference chain composition
+
+Location: integrations/lol-history/src/lol_history/live_history_decision_fusion_engine.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Decision-focused fusion: outputs actionable recommendation, not just data merge.
+    - Conflict resolution when historical data contradicts live observations.
+  System:
+    - Two-phase fusion: 1) gather all intelligence, 2) resolve conflicts and produce recommendation.
+    - Each decision includes provenance chain showing which sources influenced it.
+"""
+from __future__ import annotations
+import logging, time
+from typing import Any, Callable, Dict, List, Optional, Tuple
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.live_history_decision_fusion_engine.v1"
+
+def _safe_div(a, b, d=0.0): return a / b if b else d
+
+_CONFLICT_STRATEGIES = ["live_priority", "historical_priority", "weighted_average", "most_confident"]
+
+class LiveHistoryDecisionFusionEngine:
+    """Advanced decision-focused fusion of live and historical intelligence.
+
+    Public API: register_intelligence, set_live_context, produce_recommendation,
+                resolve_conflict, get_provenance, get_stats
+    """
+    def __init__(self, conflict_strategy: str = "live_priority") -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._intelligence_providers: Dict[str, Dict[str, Any]] = {}
+        self._live_context: Dict[str, Any] = {}
+        self._last_recommendation: Dict[str, Any] = {}
+        self._provenance_log: List[Dict[str, Any]] = []
+        self._conflict_strategy = conflict_strategy
+        self._fusion_count = 0
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def register_intelligence(self, name: str, source_type: str,
+                               provider_fn: Callable,
+                               confidence: float = 0.5) -> Dict[str, Any]:
+        """Register an intelligence provider (live or historical)."""
+        self._op_count += 1
+        self._intelligence_providers[name] = {
+            "source_type": source_type, "provider_fn": provider_fn,
+            "confidence": confidence, "call_count": 0, "error_count": 0}
+        return {"status": "ok", "name": name, "type": source_type,
+                "total_providers": len(self._intelligence_providers)}
+
+    def set_live_context(self, context: Dict[str, Any]) -> Dict[str, Any]:
+        self._op_count += 1
+        self._live_context.update(context)
+        self._live_context["_ts"] = time.time()
+        return {"status": "ok", "keys": len(context)}
+
+    def _gather_intelligence(self) -> Tuple[Dict[str, Any], List[Dict[str, Any]]]:
+        """Phase 1: gather all intelligence from providers."""
+        gathered: Dict[str, Any] = {}
+        conflicts: List[Dict[str, Any]] = []
+
+        for name, provider_info in self._intelligence_providers.items():
+            fn = provider_info["provider_fn"]
+            try:
+                result = fn(self._live_context)
+                provider_info["call_count"] += 1
+                gathered[name] = {
+                    "data": result, "source_type": provider_info["source_type"],
+                    "confidence": provider_info["confidence"]}
+            except Exception as e:
+                provider_info["error_count"] += 1
+                gathered[name] = {"data": None, "error": str(e)}
+
+        # Detect conflicts: multiple sources providing same key with different values
+        key_sources: Dict[str, List[Tuple[str, Any, float]]] = {}
+        for name, info in gathered.items():
+            data = info.get("data")
+            if not isinstance(data, dict):
+                continue
+            conf = info.get("confidence", 0.5)
+            for k, v in data.items():
+                if isinstance(v, (int, float, str, bool)):
+                    key_sources.setdefault(k, []).append((name, v, conf))
+
+        for key, sources in key_sources.items():
+            if len(sources) < 2:
+                continue
+            values = [s[1] for s in sources]
+            if isinstance(values[0], (int, float)):
+                spread = max(values) - min(values)
+                avg = sum(values) / len(values)
+                if avg != 0 and spread / abs(avg) > 0.3:
+                    conflicts.append({"key": key, "sources": sources, "spread": spread})
+            elif len(set(str(v) for v in values)) > 1:
+                conflicts.append({"key": key, "sources": sources})
+
+        return gathered, conflicts
+
+    def resolve_conflict(self, conflict: Dict[str, Any]) -> Any:
+        """Resolve a data conflict between sources."""
+        sources = conflict.get("sources", [])
+        if not sources:
+            return None
+
+        if self._conflict_strategy == "live_priority":
+            for name, val, conf in sources:
+                pi = self._intelligence_providers.get(name, {})
+                if pi.get("source_type") == "live":
+                    return val
+            return sources[0][1]
+        elif self._conflict_strategy == "historical_priority":
+            for name, val, conf in sources:
+                pi = self._intelligence_providers.get(name, {})
+                if pi.get("source_type") == "historical":
+                    return val
+            return sources[0][1]
+        elif self._conflict_strategy == "most_confident":
+            best = max(sources, key=lambda s: s[2])
+            return best[1]
+        else:  # weighted_average
+            numeric = [(v, c) for _, v, c in sources if isinstance(v, (int, float))]
+            if numeric:
+                total_w = sum(c for _, c in numeric)
+                if total_w > 0:
+                    return sum(v * c for v, c in numeric) / total_w
+            return sources[0][1]
+
+    def produce_recommendation(self) -> Dict[str, Any]:
+        """Phase 2: produce an actionable recommendation from fused intelligence."""
+        self._op_count += 1
+        self._fusion_count += 1
+
+        gathered, conflicts = self._gather_intelligence()
+
+        # Merge all data, resolving conflicts
+        merged: Dict[str, Any] = {}
+        conflict_resolutions = []
+        for conflict in conflicts:
+            resolved = self.resolve_conflict(conflict)
+            merged[conflict["key"]] = resolved
+            conflict_resolutions.append({
+                "key": conflict["key"], "resolved_to": resolved,
+                "strategy": self._conflict_strategy})
+
+        # Add non-conflicting data
+        for name, info in gathered.items():
+            data = info.get("data")
+            if isinstance(data, dict):
+                for k, v in data.items():
+                    if k not in merged:
+                        merged[k] = v
+
+        provenance = {
+            "sources": {n: {"type": i.get("source_type"), "confidence": i.get("confidence")}
+                        for n, i in gathered.items() if i.get("data") is not None},
+            "conflicts_resolved": len(conflict_resolutions),
+            "conflict_details": conflict_resolutions,
+            "timestamp": time.time()}
+
+        recommendation = {
+            "merged_context": merged, "provenance": provenance,
+            "active_sources": sum(1 for i in gathered.values() if i.get("data") is not None),
+            "total_conflicts": len(conflicts)}
+
+        self._last_recommendation = recommendation
+        self._provenance_log.append(provenance)
+        self._fire("recommendation_produced", {
+            "sources": len(provenance["sources"]), "conflicts": len(conflicts)})
+        return {"status": "ok", "recommendation": recommendation}
+
+    def get_provenance(self, n: int = 10) -> List[Dict[str, Any]]:
+        self._op_count += 1
+        return self._provenance_log[-n:]
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {"providers": len(self._intelligence_providers), "fusion_count": self._fusion_count,
+                "conflict_strategy": self._conflict_strategy,
+                "provenance_entries": len(self._provenance_log), "total_ops": self._op_count}
