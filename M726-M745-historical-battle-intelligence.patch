+"""
+HistoricalItemizationAdvisor — Recommends item builds from historical match data.
+
+Architecture (拿来主义):
+  item_build_path_analyzer.py — existing item path analysis
+  seraphine_lcu_deep_client.py — LCU item data access
+  opgg_build_fetcher.py — external build reference patterns
+
+Location: integrations/lol-history/src/lol_history/historical_itemization_advisor.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Build recommendations factor in opponent champion composition, not just champion played.
+    - Win-rate-weighted scoring surfaces builds that actually win, not just popular builds.
+  System:
+    - Item sequence ordering preserves build path temporal information.
+    - Opponent-composition hashing enables efficient matchup-specific lookup.
+"""
+from __future__ import annotations
+import logging, time
+from collections import Counter
+from typing import Any, Callable, Dict, List, Optional, Tuple
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.historical_itemization_advisor.v1"
+
+def _safe_div(a, b, d=0.0): return a / b if b else d
+
+class HistoricalItemizationAdvisor:
+    """Recommends item builds from historical match performance data.
+
+    Public API: ingest_build_data, recommend_build, get_champion_builds,
+                get_situational_advice, get_stats
+    """
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._builds: Dict[str, List[Dict[str, Any]]] = {}
+        self._ingest_count = 0
+        self._recommend_count = 0
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def _comp_key(self, opponents: List[str]) -> str:
+        return "|".join(sorted(opponents)) if opponents else "any"
+
+    def ingest_build_data(self, champion: str, items: List[str], won: bool,
+                          game_duration_min: float = 0.0,
+                          opponents: List[str] = None,
+                          kda: float = 0.0) -> Dict[str, Any]:
+        """Record a completed build for statistical analysis."""
+        self._op_count += 1
+        self._ingest_count += 1
+        entry = {"items": list(items), "won": won, "duration": game_duration_min,
+                 "opponents": opponents or [], "comp_key": self._comp_key(opponents or []),
+                 "kda": kda, "timestamp": time.time()}
+        self._builds.setdefault(champion, []).append(entry)
+        self._fire("build_ingested", {"champion": champion, "items_count": len(items), "won": won})
+        return {"status": "ok", "champion": champion, "total_builds": len(self._builds[champion])}
+
+    def recommend_build(self, champion: str, opponents: List[str] = None,
+                        game_phase: str = "all",
+                        top_n: int = 3) -> Dict[str, Any]:
+        """Recommend best builds for a champion, optionally filtered by opponent comp."""
+        self._op_count += 1
+        self._recommend_count += 1
+        builds = self._builds.get(champion, [])
+        if not builds:
+            return {"status": "ok", "champion": champion, "recommendations": [], "reason": "no_data"}
+
+        # Filter by opponent comp similarity if provided
+        if opponents:
+            target_set = set(opponents)
+            scored_builds = []
+            for b in builds:
+                overlap = len(set(b.get("opponents", [])) & target_set)
+                relevance = overlap / max(len(target_set), 1)
+                scored_builds.append((b, relevance))
+            # Prefer relevant builds but include all
+            scored_builds.sort(key=lambda x: x[1], reverse=True)
+            builds_ordered = [b for b, _ in scored_builds]
+        else:
+            builds_ordered = builds
+
+        # Aggregate by item sequence signature
+        sig_stats: Dict[str, Dict[str, Any]] = {}
+        for b in builds_ordered:
+            sig = "|".join(b["items"][:6])
+            if sig not in sig_stats:
+                sig_stats[sig] = {"items": b["items"][:6], "wins": 0, "total": 0,
+                                  "kda_sum": 0.0, "duration_sum": 0.0}
+            sig_stats[sig]["total"] += 1
+            if b["won"]:
+                sig_stats[sig]["wins"] += 1
+            sig_stats[sig]["kda_sum"] += b.get("kda", 0)
+            sig_stats[sig]["duration_sum"] += b.get("duration", 0)
+
+        # Score: 60% win rate + 25% avg KDA(normalized) + 15% popularity
+        max_total = max((s["total"] for s in sig_stats.values()), default=1)
+        recommendations = []
+        for sig, stats in sig_stats.items():
+            wr = _safe_div(stats["wins"], stats["total"])
+            avg_kda = _safe_div(stats["kda_sum"], stats["total"])
+            popularity = stats["total"] / max_total
+            score = wr * 0.6 + min(avg_kda / 5.0, 1.0) * 0.25 + popularity * 0.15
+            recommendations.append({
+                "items": stats["items"], "win_rate": round(wr, 4),
+                "avg_kda": round(avg_kda, 2), "games": stats["total"],
+                "score": round(score, 4)})
+
+        recommendations.sort(key=lambda x: x["score"], reverse=True)
+        result = recommendations[:top_n]
+        self._fire("build_recommended", {"champion": champion, "count": len(result)})
+        return {"status": "ok", "champion": champion, "recommendations": result}
+
+    def get_champion_builds(self, champion: str) -> Dict[str, Any]:
+        self._op_count += 1
+        builds = self._builds.get(champion, [])
+        return {"status": "ok", "champion": champion, "total_builds": len(builds)}
+
+    def get_situational_advice(self, champion: str,
+                                opponents: List[str]) -> Dict[str, Any]:
+        """Generate situational build advice based on opponent composition."""
+        self._op_count += 1
+        builds = self._builds.get(champion, [])
+        if not builds or not opponents:
+            return {"status": "ok", "advice": "insufficient_data"}
+        opp_set = set(opponents)
+        relevant = [b for b in builds if set(b.get("opponents", [])) & opp_set]
+        if not relevant:
+            return {"status": "ok", "advice": "no_matchup_data", "fallback": "use_general_build"}
+        wins_relevant = sum(1 for b in relevant if b["won"])
+        wr = _safe_div(wins_relevant, len(relevant))
+        # Find most common items in winning relevant games
+        winning_items: List[str] = []
+        for b in relevant:
+            if b["won"]:
+                winning_items.extend(b["items"][:3])
+        common_core = Counter(winning_items).most_common(3)
+        return {"status": "ok", "advice": "situational",
+                "matchup_win_rate": round(wr, 4), "sample_size": len(relevant),
+                "recommended_core": [item for item, _ in common_core]}
+
+    def get_stats(self) -> Dict[str, Any]:
+        total_builds = sum(len(v) for v in self._builds.values())
+        return {"champions_tracked": len(self._builds), "total_builds": total_builds,
+                "ingest_count": self._ingest_count, "recommend_count": self._recommend_count,
+                "total_ops": self._op_count}
