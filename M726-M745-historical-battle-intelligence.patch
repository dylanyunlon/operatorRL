+"""
+MatchupHistoryPredictor — Predicts lane outcomes from historical champion matchup data.
+
+Architecture (拿来主义):
+  champion_winrate_matrix.py — champion win rate cross-reference
+  pregame_scout.py — per-player champion profiling
+  seraphine_lcu_deep_client.py — LCU match data retrieval
+
+Location: integrations/lol-history/src/lol_history/matchup_history_predictor.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Matchup predictions combine global matchup data with player-specific history.
+    - Confidence scales with sample size via log-curve, preventing overconfidence on 2 games.
+  System:
+    - Bayesian-weighted blend of global and personal matchup data prevents cold-start issues.
+    - Prediction cache keyed by (champion_a, champion_b, puuid) avoids redundant computation.
+"""
+from __future__ import annotations
+import logging, time, math
+from typing import Any, Callable, Dict, List, Optional, Tuple
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.matchup_history_predictor.v1"
+
+def _safe_div(a, b, d=0.0): return a / b if b else d
+def _confidence(n, max_n=30): return min(1.0, math.log1p(n) / math.log1p(max_n)) if n > 0 else 0.0
+def _matchup_key(a: str, b: str) -> str: return f"{a}:vs:{b}"
+
+class MatchupHistoryPredictor:
+    """Predicts lane matchup outcomes using historical data.
+
+    Public API: ingest_matchup_data, predict_matchup, ingest_player_matchup,
+                get_player_matchup_history, get_stats
+    """
+    def __init__(self, personal_weight: float = 0.6) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._global_matchups: Dict[str, Dict[str, Any]] = {}
+        self._player_matchups: Dict[str, Dict[str, Dict[str, Any]]] = {}
+        self._personal_weight = personal_weight
+        self._prediction_count = 0
+        self._cache: Dict[str, Dict[str, Any]] = {}
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def ingest_matchup_data(self, champion_a: str, champion_b: str,
+                            wins_a: int, total: int) -> Dict[str, Any]:
+        """Ingest global matchup win rate data."""
+        self._op_count += 1
+        mk = _matchup_key(champion_a, champion_b)
+        wr = _safe_div(wins_a, total)
+        self._global_matchups[mk] = {
+            "champion_a": champion_a, "champion_b": champion_b,
+            "wins_a": wins_a, "total": total, "win_rate_a": round(wr, 4),
+            "confidence": round(_confidence(total, 100), 4)}
+        self._cache.clear()
+        return {"status": "ok", "matchup": mk, "win_rate_a": round(wr, 4)}
+
+    def ingest_player_matchup(self, puuid: str, champion_played: str,
+                               champion_faced: str, won: bool,
+                               kills: int = 0, deaths: int = 0,
+                               assists: int = 0) -> Dict[str, Any]:
+        """Record a single player's matchup result."""
+        self._op_count += 1
+        mk = _matchup_key(champion_played, champion_faced)
+        player_data = self._player_matchups.setdefault(puuid, {})
+        entry = player_data.get(mk, {"wins": 0, "total": 0, "kills": 0, "deaths": 0, "assists": 0})
+        entry["total"] += 1
+        if won:
+            entry["wins"] += 1
+        entry["kills"] += kills
+        entry["deaths"] += deaths
+        entry["assists"] += assists
+        player_data[mk] = entry
+        self._cache.clear()
+        return {"status": "ok", "puuid": puuid, "matchup": mk, "total": entry["total"]}
+
+    def predict_matchup(self, puuid: str, champion_a: str,
+                        champion_b: str) -> Dict[str, Any]:
+        """Predict matchup outcome blending global and personal data."""
+        self._op_count += 1
+        self._prediction_count += 1
+        cache_key = f"{puuid}:{champion_a}:{champion_b}"
+        if cache_key in self._cache:
+            return self._cache[cache_key]
+
+        mk = _matchup_key(champion_a, champion_b)
+
+        # Global data
+        gd = self._global_matchups.get(mk)
+        global_wr = gd["win_rate_a"] if gd else 0.5
+        global_conf = gd["confidence"] if gd else 0.0
+
+        # Personal data
+        pd = self._player_matchups.get(puuid, {}).get(mk)
+        if pd and pd["total"] > 0:
+            personal_wr = _safe_div(pd["wins"], pd["total"])
+            personal_conf = _confidence(pd["total"])
+            personal_kda = (pd["kills"] + pd["assists"]) / max(pd["deaths"], 1)
+        else:
+            personal_wr = 0.5
+            personal_conf = 0.0
+            personal_kda = 0.0
+
+        # Bayesian blend: weight personal more if enough data
+        if personal_conf > 0.1:
+            pw = self._personal_weight * personal_conf
+            gw = (1.0 - self._personal_weight) * max(global_conf, 0.1)
+            total_w = pw + gw
+            blended_wr = (personal_wr * pw + global_wr * gw) / total_w if total_w > 0 else 0.5
+        else:
+            blended_wr = global_wr
+
+        # Advantage classification
+        if blended_wr >= 0.58:
+            advantage = "strong"
+        elif blended_wr >= 0.52:
+            advantage = "slight"
+        elif blended_wr >= 0.48:
+            advantage = "even"
+        elif blended_wr >= 0.42:
+            advantage = "slight_disadvantage"
+        else:
+            advantage = "strong_disadvantage"
+
+        result = {
+            "status": "ok", "champion_a": champion_a, "champion_b": champion_b,
+            "predicted_win_rate": round(blended_wr, 4),
+            "advantage": advantage,
+            "global_win_rate": round(global_wr, 4), "global_confidence": round(global_conf, 4),
+            "personal_win_rate": round(personal_wr, 4), "personal_confidence": round(personal_conf, 4),
+            "personal_kda": round(personal_kda, 2)}
+        self._cache[cache_key] = result
+        self._fire("matchup_predicted", {"matchup": mk, "advantage": advantage})
+        return result
+
+    def get_player_matchup_history(self, puuid: str) -> Dict[str, Any]:
+        self._op_count += 1
+        data = self._player_matchups.get(puuid, {})
+        return {"status": "ok", "puuid": puuid, "matchups": dict(data), "count": len(data)}
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {"global_matchups": len(self._global_matchups),
+                "player_profiles": len(self._player_matchups),
+                "predictions": self._prediction_count, "total_ops": self._op_count}
