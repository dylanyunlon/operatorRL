+# ===== M726: OpponentLiveHistoryProfiler =====
+class TestOpponentLiveHistoryProfiler:
+    def _make(self):
+        from lol_history.opponent_live_history_profiler import OpponentLiveHistoryProfiler
+        return OpponentLiveHistoryProfiler()
+
+    def test_ingest_empty_history(self):
+        p = self._make()
+        r = p.ingest_match_history("p1", [])
+        assert r["status"] == "ok"
+        assert r["profile"]["threat_level"] == "unknown"
+        assert r["profile"]["confidence"] == 0.0
+
+    def test_ingest_and_profile(self):
+        p = self._make()
+        matches = [{"champion": "Ahri", "win": True, "kills": 10, "deaths": 2, "assists": 5},
+                   {"champion": "Ahri", "win": True, "kills": 8, "deaths": 3, "assists": 7},
+                   {"champion": "Zed", "win": False, "kills": 4, "deaths": 6, "assists": 2}]
+        r = p.ingest_match_history("p1", matches, current_champion="Ahri")
+        assert r["status"] == "ok"
+        assert r["profile"]["games_analyzed"] == 3
+        assert r["profile"]["win_rate"] > 0.5
+        assert "Ahri" in r["profile"]["main_champions"]
+
+    def test_matchup_profile_for_current_champion(self):
+        p = self._make()
+        matches = [{"champion": "Ahri", "win": True, "kills": 10, "deaths": 2, "assists": 5},
+                   {"champion": "Ahri", "win": False, "kills": 3, "deaths": 5, "assists": 2},
+                   {"champion": "Zed", "win": True, "kills": 8, "deaths": 1, "assists": 3}]
+        r = p.ingest_match_history("p1", matches, current_champion="Ahri")
+        mp = r["profile"]["matchup_profile"]
+        assert mp["champion"] == "Ahri"
+        assert mp["games"] == 2
+        assert 0.0 <= mp["win_rate"] <= 1.0
+
+    def test_get_profile_not_found(self):
+        p = self._make()
+        r = p.get_profile("nonexistent")
+        assert r["status"] == "not_found"
+
+    def test_threat_ranking(self):
+        p = self._make()
+        p.ingest_match_history("high", [{"champion": "A", "win": True, "kills": 15, "deaths": 1, "assists": 10}] * 10)
+        p.ingest_match_history("low", [{"champion": "B", "win": False, "kills": 1, "deaths": 10, "assists": 0}] * 10)
+        r = p.get_threat_ranking()
+        assert r["ranking"][0] == "high"
+
+    def test_staleness_detection(self):
+        p = self._make()
+        p._stale_seconds = 0.01
+        p.ingest_match_history("p1", [{"champion": "A", "win": True, "kills": 5, "deaths": 2, "assists": 3}])
+        time.sleep(0.02)
+        r = p.get_profile("p1")
+        assert r["stale"] is True
+
+    def test_live_observation(self):
+        p = self._make()
+        p.ingest_match_history("p1", [{"champion": "A", "win": True, "kills": 5, "deaths": 2, "assists": 3}])
+        r = p.update_live_observation("p1", {"action": "aggressive_trade"})
+        assert r["status"] == "ok"
+        assert r["observations"] == 1
+
+    def test_evolution_callback_fires(self):
+        p = self._make()
+        events = []
+        p.evolution_callback = lambda e: events.append(e)
+        p.ingest_match_history("p1", [{"champion": "A", "win": True, "kills": 5, "deaths": 2, "assists": 3}])
+        assert len(events) == 1
+        assert events[0]["type"] == "profile_updated"
+
+    def test_high_threat_classification(self):
+        p = self._make()
+        matches = [{"champion": "Yasuo", "win": True, "kills": 12, "deaths": 2, "assists": 8}] * 15
+        r = p.ingest_match_history("carry", matches)
+        assert r["profile"]["threat_level"] == "high"
+
+    def test_stats(self):
+        p = self._make()
+        p.ingest_match_history("p1", [{"champion": "A", "win": True, "kills": 5, "deaths": 2, "assists": 3}])
+        s = p.get_stats()
+        assert s["total_profiles"] == 1
+        assert s["ingest_count"] == 1
