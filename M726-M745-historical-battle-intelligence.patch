@@ -0,0 +1,154 @@
+"""
+PlayerPlaystyleClassifier — Classifies players into playstyle archetypes from history.
+
+Architecture (拿来主义):
+  pregame_scout.py — player profile aggregation pattern
+  loss_pattern_classifier.py — classification from match history
+  tactical_intent_reasoner.py（M690）— softmax-based scoring
+
+Location: integrations/lol-history/src/lol_history/player_playstyle_classifier.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Archetypes (aggressor/farmer/roamer/teamfighter/split-pusher) enable matchup counter-play.
+    - Multi-label classification: a player can be 60% aggressor + 30% roamer.
+  System:
+    - Feature vector extraction from match stats maps to archetype scores via weighted sum.
+    - Recency-weighted features prevent ancient playstyle data from dominating.
+"""
+from __future__ import annotations
+import logging, time, math
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.player_playstyle_classifier.v1"
+
+def _safe_div(a, b, d=0.0): return a / b if b else d
+
+def _softmax(scores: Dict[str, float]) -> Dict[str, float]:
+    if not scores:
+        return {}
+    max_s = max(scores.values())
+    exps = {k: math.exp(v - max_s) for k, v in scores.items()}
+    total = sum(exps.values())
+    return {k: round(v / total, 4) if total > 0 else round(1.0 / len(scores), 4)
+            for k, v in exps.items()}
+
+_ARCHETYPES = ["aggressor", "farmer", "roamer", "teamfighter", "split_pusher", "support_oriented"]
+
+# Feature weights per archetype: feature_name -> weight
+_ARCHETYPE_WEIGHTS: Dict[str, Dict[str, float]] = {
+    "aggressor": {"kills_per_min": 3.0, "solo_kills": 2.5, "damage_share": 1.5, "early_kills": 2.0},
+    "farmer": {"cs_per_min": 3.5, "gold_per_min": 2.0, "game_duration": 1.0, "damage_share": -0.5},
+    "roamer": {"roam_kills": 3.0, "kill_participation": 2.0, "wards_per_min": 1.5, "unique_lanes_visited": 2.0},
+    "teamfighter": {"kill_participation": 3.0, "teamfight_damage": 2.5, "assists_per_min": 2.0},
+    "split_pusher": {"tower_damage": 3.0, "cs_per_min": 2.0, "solo_kills": 1.5, "kill_participation": -1.5},
+    "support_oriented": {"assists_per_min": 3.0, "wards_per_min": 2.5, "cc_score": 2.0, "kill_participation": 1.5},
+}
+
+class PlayerPlaystyleClassifier:
+    """Classifies players into playstyle archetypes from match statistics.
+
+    Public API: ingest_player_stats, classify, get_classification,
+                compare_playstyles, get_stats
+    """
+    def __init__(self, recency_decay: float = 0.9) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._player_features: Dict[str, List[Dict[str, float]]] = {}
+        self._classifications: Dict[str, Dict[str, Any]] = {}
+        self._recency_decay = recency_decay
+        self._ingest_count = 0
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def ingest_player_stats(self, puuid: str,
+                             features: Dict[str, float]) -> Dict[str, Any]:
+        """Ingest per-game feature vector for a player."""
+        self._op_count += 1
+        self._ingest_count += 1
+        self._player_features.setdefault(puuid, []).append(features)
+        return {"status": "ok", "puuid": puuid,
+                "total_games": len(self._player_features[puuid])}
+
+    def _weighted_avg_features(self, feature_list: List[Dict[str, float]]) -> Dict[str, float]:
+        """Compute recency-weighted average features."""
+        if not feature_list:
+            return {}
+        n = len(feature_list)
+        weights = [self._recency_decay ** (n - 1 - i) for i in range(n)]
+        total_w = sum(weights)
+        if total_w < 1e-9:
+            return {}
+        all_keys = set()
+        for f in feature_list:
+            all_keys.update(f.keys())
+        result = {}
+        for key in all_keys:
+            weighted_sum = sum(f.get(key, 0.0) * w for f, w in zip(feature_list, weights))
+            result[key] = weighted_sum / total_w
+        return result
+
+    def classify(self, puuid: str) -> Dict[str, Any]:
+        """Classify a player into playstyle archetypes."""
+        self._op_count += 1
+        features_list = self._player_features.get(puuid, [])
+        if not features_list:
+            return {"status": "ok", "puuid": puuid, "classification": {},
+                    "primary": "unknown", "reason": "no_data"}
+
+        avg_features = self._weighted_avg_features(features_list)
+
+        # Score each archetype
+        raw_scores: Dict[str, float] = {}
+        for archetype in _ARCHETYPES:
+            score = 0.0
+            weights = _ARCHETYPE_WEIGHTS.get(archetype, {})
+            for feature, weight in weights.items():
+                score += avg_features.get(feature, 0.0) * weight
+            raw_scores[archetype] = score
+
+        distribution = _softmax(raw_scores)
+        primary = max(distribution, key=lambda k: distribution[k])
+        sorted_archetypes = sorted(distribution.items(), key=lambda x: x[1], reverse=True)
+        secondary = sorted_archetypes[1][0] if len(sorted_archetypes) > 1 else "unknown"
+
+        result = {"puuid": puuid, "primary": primary, "secondary": secondary,
+                  "distribution": distribution, "games_analyzed": len(features_list),
+                  "avg_features": {k: round(v, 4) for k, v in avg_features.items()}}
+        self._classifications[puuid] = result
+        self._fire("classified", {"puuid": puuid, "primary": primary})
+        return {"status": "ok", **result}
+
+    def get_classification(self, puuid: str) -> Dict[str, Any]:
+        self._op_count += 1
+        c = self._classifications.get(puuid)
+        if not c:
+            return {"status": "not_found", "puuid": puuid}
+        return {"status": "ok", **c}
+
+    def compare_playstyles(self, puuid_a: str, puuid_b: str) -> Dict[str, Any]:
+        """Compare playstyle distributions of two players."""
+        self._op_count += 1
+        ca = self._classifications.get(puuid_a)
+        cb = self._classifications.get(puuid_b)
+        if not ca or not cb:
+            return {"status": "error", "reason": "one_or_both_not_classified"}
+        dist_a = ca.get("distribution", {})
+        dist_b = cb.get("distribution", {})
+        # Cosine-like similarity
+        dot = sum(dist_a.get(k, 0) * dist_b.get(k, 0) for k in _ARCHETYPES)
+        mag_a = math.sqrt(sum(v ** 2 for v in dist_a.values())) or 1.0
+        mag_b = math.sqrt(sum(v ** 2 for v in dist_b.values())) or 1.0
+        similarity = round(dot / (mag_a * mag_b), 4)
+        return {"status": "ok", "similarity": similarity,
+                "player_a": {"puuid": puuid_a, "primary": ca["primary"]},
+                "player_b": {"puuid": puuid_b, "primary": cb["primary"]},
+                "divergent_archetypes": [a for a in _ARCHETYPES
+                    if abs(dist_a.get(a, 0) - dist_b.get(a, 0)) > 0.15]}
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {"players_tracked": len(self._player_features),
+                "players_classified": len(self._classifications),
+                "ingest_count": self._ingest_count, "total_ops": self._op_count}
