+def _safe_div(a: float, b: float, default: float = 0.0) -> float:
+    """Division safe against zero denominators."""
+    return a / b if b != 0 else default
+
+
+def _kda(k: int, d: int, a: int) -> float:
+    """KDA ratio with floor-1 deaths."""
+    return (k + a) / max(d, 1)
