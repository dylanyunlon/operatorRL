+            Input parameter for compute_objective_contest_risk.
+        game_state : dict
+            Input parameter for compute_objective_contest_risk.
+
+        Returns
+        -------
+        dict
+        """
+        self._op_count += 1
+        _start = time.time()
+
+        # --- Core logic for compute_objective_contest_risk ---
