+
+# ===================================================================
+# M368: DecisionEngine — 10 tests
+# ===================================================================
+class TestDecisionEngine:
+    """Aggregate state/history/threat → strategy output."""
+
+    def test_decide_returns_dict(self, decision_mod):
+        eng = decision_mod.DecisionEngine()
