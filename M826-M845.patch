+def run_self_test() -> Dict[str, Any]:
+    """Run self-tests for M838 MatchDataEtlPipeline."""
+    results = {"module": MODULE_ID, "tests": [], "passed": 0, "failed": 0}
+
+    def _test(name: str, fn: Callable) -> None:
+        try:
+            fn()
+            results["tests"].append({"name": name, "status": "PASS"})
+            results["passed"] += 1
