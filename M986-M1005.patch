+                "assists": 7 + i % 6,
+                "cs": 150 + i * 8,
+                "goldEarned": 10000 + i * 500,
+                "gameDuration": 1800 + i * 60,
+                "timestamp": int(time.time()) - i * 3600,
+                "queueId": 420,
+                "role": ["TOP", "JUNGLE", "MID", "ADC", "SUPPORT"][i % 5],
+                "lane": ["TOP", "JUNGLE", "MID", "BOTTOM", "BOTTOM"][i % 5],
+                "visionScore": 20 + i % 15,
+                "wardsPlaced": 8 + i % 10,
+                "wardsKilled": 3 + i % 5,
+                "firstBlood": i % 7 == 0,
+                "turretKills": i % 3,
