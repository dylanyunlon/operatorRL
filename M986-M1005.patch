+# ════════════════════════════════════════════════════════════════
+# §2  Data Classes — fiddler_intercept domain model
+# ════════════════════════════════════════════════════════════════
+
+@dataclass
+class PastRequest:
+    """Audit trail for every API call (Seraphine pattern)."""
+    func_name: str
+    params: Dict[str, Any]
+    timestamp: float = field(default_factory=time.time)
