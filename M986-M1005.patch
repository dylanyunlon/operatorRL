+                "baronKills": 1 if i % 8 == 0 else 0,
+                "participants": [
+                    {"puuid": f"mock-{j}", "championId": 100 + j, "teamId": 100 if j < 5 else 200}
+                    for j in range(10)
+                ],
+            })
