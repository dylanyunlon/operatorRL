+    pause_result = manager.process({"should": "fail"})
+    assert "error" in pause_result
+    manager.resume()
+    assert manager.status == DataPipelineStatus.RUNNING
+
+    # Test cleanup
+    manager.cleanup()
+
+    # Stop
