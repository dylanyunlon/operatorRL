+
+    @staticmethod
+    def deserialize_state(data: str) -> Dict[str, Any]:
+        try:
+            return json.loads(data)
+        except json.JSONDecodeError as exc:
+            logger.error("Deserialize error: %s", exc)
+            return {}
+
+    @staticmethod
+    def compute_state_hash(state: Dict[str, Any]) -> str:
