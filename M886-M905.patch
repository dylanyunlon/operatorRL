+                   level: Optional[str] = None,
+                   limit: int = 50) -> List[Dict[str, Any]]:
+        filtered = self._events
+        if event_type:
+            filtered = [e for e in filtered if e["type"] == event_type]
+        if level:
+            filtered = [e for e in filtered if e["level"] == level]
+        return filtered[-limit:]
