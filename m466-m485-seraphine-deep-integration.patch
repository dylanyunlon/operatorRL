+_EVOLUTION_KEY: str = "integrations.lol.rune_page_manager.v1"
+
+
+class RunePageManager:
+    """Build, validate, and manage LoL rune pages."""
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[dict], None]] = None
+
+    def build_rune_page(
+        self, name: str, primary_style: int, sub_style: int, perks: list[int]
+    ) -> dict[str, Any]:
+        """Build a rune page dict.
+
+        Args:
+            name: Page name.
+            primary_style: Primary rune tree ID.
+            sub_style: Secondary rune tree ID.
+            perks: List of 6 perk IDs.
+
+        Returns:
+            Rune page dict for LCU API.
+        """
+        return {
+            "name": name,
+            "primaryStyleId": primary_style,
+            "subStyleId": sub_style,
+            "selectedPerkIds": list(perks),
+            "current": True,
+        }
+
+    def validate_rune_page(
+        self, primary_style: int, sub_style: int, perks: list[int]
+    ) -> bool:
+        """Validate rune page structure.
+
+        Args:
+            primary_style: Primary rune tree ID.
+            sub_style: Secondary rune tree ID.
+            perks: Perk IDs list.
+
+        Returns:
+            True if valid.
+        """
+        if primary_style == sub_style:
+            return False
+        if len(perks) != 6:
+            return False
+        return True
+
+    def build_lcu_payload(
+        self, name: str, primary_style: int, sub_style: int, perks: list[int]
+    ) -> dict[str, Any]:
+        """Build full LCU API payload for rune page creation.
+
+        Returns:
