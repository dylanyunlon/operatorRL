+"""
+Team Color Resolver — Resolve team side (blue/red) and separate teams.
+
+Location: integrations/lol/src/lol_agent/team_color_resolver.py
+
+Reference (拿来主義):
+  - Seraphine/app/lol/tools.py: getTeamColor, separateTeams
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "integrations.lol.team_color_resolver.v1"
+
+
+class TeamColorResolver:
+    """Resolve team color (blue/red) and separate allies/enemies."""
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[dict], None]] = None
+
+    def resolve_color(
+        self, session: dict[str, Any], current_puuid: str
+    ) -> str:
+        """Resolve current player's team color from gameflow session.
+
+        Args:
+            session: Gameflow session dict with gameData.teamOne/teamTwo.
+            current_puuid: Current player's puuid.
+
+        Returns:
+            "blue", "red", or "unknown".
+        """
+        game_data = session.get("gameData", {})
+        team_one = game_data.get("teamOne", [])
+        team_two = game_data.get("teamTwo", [])
+
+        for p in team_one:
+            if p.get("puuid") == current_puuid:
+                return "blue"
+        for p in team_two:
+            if p.get("puuid") == current_puuid:
+                return "red"
+        return "unknown"
+
+    def separate_teams(
+        self, participants: list[dict[str, Any]], current_puuid: str
+    ) -> dict[str, list[dict[str, Any]]]:
+        """Separate participants into allies and enemies.
+
+        Args:
+            participants: List of participant dicts with puuid, teamId.
+            current_puuid: Current player's puuid.
+
+        Returns:
+            Dict with 'allies' and 'enemies' lists.
+        """
+        my_team_id = None
+        for p in participants:
+            if p.get("puuid") == current_puuid:
+                my_team_id = p.get("teamId")
+                break
+
+        if my_team_id is None:
+            return {"allies": [], "enemies": []}
+
+        allies = [p for p in participants if p.get("teamId") == my_team_id]
+        enemies = [p for p in participants if p.get("teamId") != my_team_id]
+        return {"allies": allies, "enemies": enemies}
+
+    def team_id_to_color(self, team_id: int) -> str:
+        """Convert team ID to color string.
+
+        Args:
+            team_id: Team ID (100=blue, 200=red).
+
+        Returns:
+            Color string.
+        """
+        if team_id == 100:
+            return "blue"
+        elif team_id == 200:
+            return "red"
+        return "unknown"
+
+    def is_ally(
+        self, puuid_a: str, puuid_b: str, participants: list[dict[str, Any]]
+    ) -> bool:
+        """Check if two players are on the same team.
+
+        Args:
+            puuid_a: First player puuid.
+            puuid_b: Second player puuid.
+            participants: All participants.
+
+        Returns:
+            True if same team.
+        """
+        team_a = None
+        team_b = None
+        for p in participants:
+            if p.get("puuid") == puuid_a:
+                team_a = p.get("teamId")
+            if p.get("puuid") == puuid_b:
+                team_b = p.get("teamId")
+        if team_a is None or team_b is None:
+            return False
+        return team_a == team_b
+
+    def _fire_evolution(self, data: dict[str, Any]) -> None:
+        if self.evolution_callback is None:
+            return
+        enriched = {"module": "team_color_resolver", "timestamp": time.time(), **data}
+        try:
+            self.evolution_callback(enriched)
+        except Exception as exc:
+            logger.warning("Evolution callback error: %s", exc)
