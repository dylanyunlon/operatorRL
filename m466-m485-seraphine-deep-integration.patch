+    """Manage summoner profile background, status, and displayed rank."""
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[dict], None]] = None
+
+    def build_set_background_payload(self, skin_id: int) -> dict[str, Any]:
+        """Build LCU payload for setting profile background.
+
+        Args:
+            skin_id: Skin ID to use as background.
+
+        Returns:
+            LCU-compatible payload dict.
+        """
+        return {"key": "backgroundSkinId", "value": skin_id}
+
+    def build_set_status_payload(self, message: str) -> dict[str, Any]:
+        """Build payload for setting online status message.
+
+        Args:
+            message: Status message text.
+
+        Returns:
+            LCU-compatible payload dict.
+        """
+        return {"statusMessage": message}
+
+    def build_set_tier_payload(
+        self, queue: str, tier: str, division: str
+    ) -> dict[str, Any]:
+        """Build payload for setting displayed rank tier.
+
+        Args:
+            queue: Queue type (e.g. "RANKED_SOLO_5x5").
+            tier: Tier string (e.g. "DIAMOND").
+            division: Division string (e.g. "II").
+
+        Returns:
+            LCU-compatible payload dict.
+        """
+        return {
+            "lol": {
+                "rankedLeagueQueue": queue,
+                "rankedLeagueTier": tier,
+                "rankedLeagueDivision": division,
+            }
+        }
+
+    def recommend_background(
+        self, mastery: list[dict[str, Any]]
+    ) -> Optional[int]:
+        """Recommend background skin from champion mastery.
+
+        Args:
+            mastery: List of mastery dicts with championId, championLevel, championPoints.
+
+        Returns:
+            Recommended skin ID, or None.
+        """
+        if not mastery:
+            return None
+        # Pick highest mastery champion, default skin = championId * 1000
+        best = max(mastery, key=lambda m: m.get("championPoints", 0))
+        return best.get("championId", 0) * 1000
+
+    def auto_status_message(
+        self, tier: str, division: str, lp: int, streak: str = ""
+    ) -> str:
+        """Generate automatic status message.
+
+        Args:
+            tier: Current tier.
+            division: Current division.
+            lp: League points.
+            streak: Win/loss streak string (e.g. "W3", "L2").
+
+        Returns:
+            Status message string.
+        """
+        tier_display = tier.capitalize() if tier else "Unranked"
+        msg = f"{tier_display} {division} | {lp} LP"
+        if streak:
+            msg += f" | {streak}"
+        return msg
+
+    def lcu_url_for_background(self) -> str:
+        """LCU endpoint URL for setting profile background."""
+        return "/lol-summoner/v1/current-summoner/summoner-profile"
+
+    def lcu_url_for_status(self) -> str:
+        """LCU endpoint URL for setting chat status."""
+        return "/lol-chat/v1/me"
+
+    def validate_skin_id(self, skin_id: int) -> bool:
+        """Validate a skin ID.
+
+        Args:
+            skin_id: Skin ID to validate.
+
+        Returns:
+            True if valid (positive integer).
+        """
+        return isinstance(skin_id, int) and skin_id > 0
+
+    def _fire_evolution(self, data: dict[str, Any]) -> None:
+        if self.evolution_callback is None:
+            return
+        enriched = {"module": "profile_background_manager", "timestamp": time.time(), **data}
+        try:
+            self.evolution_callback(enriched)
+        except Exception as exc:
+            logger.warning("Evolution callback error: %s", exc)
