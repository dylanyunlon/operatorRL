+Tests per module: 10 across key modules. ~50% expected first-run failure.
+"""
+import sys, os, time
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'src'))
+import pytest
+
+
+class TestSummonerIdentityResolver:
