+        return SummonerIdentityResolver(cache_ttl=10.0, max_cache=50)
+
+    def test_init(self):
+        r = self._make()
+        assert r.get_stats()["resolve_count"] == 0
+
+    def test_register_source(self):
+        r = self._make()
