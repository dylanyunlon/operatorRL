@@ -0,0 +1,167 @@
+"""
+CrossGameModelHub — Cross-game model registry with lineage and version tracking.
+
+Architecture (拿来主义):
+  agentos/governance/model_versioner.py — model version management
+  opponent_model_persistence.py（M609）— save/load/list_versions
+
+Location: integrations/lol-history/src/lol_history/cross_game_model_hub.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - register_model() enforces required metadata — prevents orphaned models.
+    - get_lineage() traces model heritage across games.
+  System:
+    - Storage is in-memory dict keyed by (game, model_id, version) tuple.
+    - Lineage is a DAG stored as parent pointers — O(depth) traversal.
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Dict, List, Optional, Tuple
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "integrations.lol_history.cross_game_model_hub.v1"
+
+
+def _safe_div(a: float, b: float, default: float = 0.0) -> float:
+    return a / b if b != 0 else default
+
+
+class ModelRecord:
+    __slots__ = ("game", "model_id", "version", "metrics", "parent_key", "created_at", "meta")
+
+    def __init__(self, game: str, model_id: str, version: str,
+                 metrics: Dict[str, float], parent_key: Optional[str],
+                 meta: Dict[str, Any]) -> None:
+        self.game = game
+        self.model_id = model_id
+        self.version = version
+        self.metrics = metrics
+        self.parent_key = parent_key
+        self.created_at = time.time()
+        self.meta = meta
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            "game": self.game,
+            "model_id": self.model_id,
+            "version": self.version,
+            "metrics": self.metrics,
+            "parent_key": self.parent_key,
+            "created_at": self.created_at,
+            "meta": self.meta,
+        }
+
+    @property
+    def key(self) -> str:
+        return f"{self.game}:{self.model_id}:{self.version}"
+
+
+class CrossGameModelHub:
+    """Cross-game model registry with lineage tracking.
+
+    Public API
+    ----------
+        register_model(game, model_id, version, metrics, parent_key, meta) -> dict
+        get_model(game, model_id, version) -> dict
+        list_models(game) -> list
+        list_versions(game, model_id) -> list
+        get_lineage(key) -> list
+        get_best_model(game, metric) -> dict
+        get_stats() -> dict
+
+    Evolution
+    ---------
+    Set evolution_callback to receive structured events.
+    """
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[Dict[str, Any]], None]] = None
+        self._op_count: int = 0
+        self._models: Dict[str, ModelRecord] = {}
+
+    def _fire(self, event_type: str, data: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({"type": event_type, "key": _EVOLUTION_KEY, **data})
+
+    def register_model(self, game: str, model_id: str, version: str,
+                       metrics: Dict[str, float] = None,
+                       parent_key: Optional[str] = None,
+                       meta: Dict[str, Any] = None) -> Dict[str, Any]:
+        self._op_count += 1
+        if not game or not model_id or not version:
+            return {"status": "error", "reason": "game, model_id, version required"}
+        if metrics is None:
+            metrics = {}
+        if meta is None:
+            meta = {}
+
+        record = ModelRecord(game, model_id, version, metrics, parent_key, meta)
+        self._models[record.key] = record
+        self._fire("model_registered", {"key": record.key, "game": game})
+        return {"status": "ok", "key": record.key, "total_models": len(self._models)}
+
+    def get_model(self, game: str, model_id: str, version: str) -> Dict[str, Any]:
+        self._op_count += 1
+        key = f"{game}:{model_id}:{version}"
+        rec = self._models.get(key)
+        if rec is None:
+            return {"status": "error", "reason": f"model not found: {key}"}
+        return {"status": "ok", "model": rec.to_dict()}
+
+    def list_models(self, game: str = None) -> List[Dict[str, Any]]:
+        self._op_count += 1
+        results = []
+        for rec in self._models.values():
+            if game is None or rec.game == game:
+                results.append(rec.to_dict())
+        return results
+
+    def list_versions(self, game: str, model_id: str) -> List[str]:
+        self._op_count += 1
+        prefix = f"{game}:{model_id}:"
+        return [rec.version for k, rec in self._models.items() if k.startswith(prefix)]
+
+    def get_lineage(self, key: str) -> List[Dict[str, Any]]:
+        """Trace model lineage via parent pointers."""
+        self._op_count += 1
+        chain = []
+        visited = set()
+        current = key
+        while current and current not in visited:
+            visited.add(current)
+            rec = self._models.get(current)
+            if rec is None:
+                break
+            chain.append(rec.to_dict())
+            current = rec.parent_key
+        return chain
+
+    def get_best_model(self, game: str, metric: str = "accuracy") -> Dict[str, Any]:
+        """Find the model with highest value for given metric within a game."""
+        self._op_count += 1
+        best_key = None
+        best_val = float("-inf")
+        for rec in self._models.values():
+            if rec.game == game:
+                val = rec.metrics.get(metric, float("-inf"))
+                if val > best_val:
+                    best_val = val
+                    best_key = rec.key
+        if best_key is None:
+            return {"status": "error", "reason": f"no models for game '{game}'"}
+        return {"status": "ok", "model": self._models[best_key].to_dict(), "metric": metric, "value": best_val}
+
+    def get_stats(self) -> Dict[str, Any]:
+        per_game: Dict[str, int] = {}
+        for rec in self._models.values():
+            per_game[rec.game] = per_game.get(rec.game, 0) + 1
+        return {
+            "total_ops": self._op_count,
+            "total_models": len(self._models),
+            "per_game": per_game,
+        }
