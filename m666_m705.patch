+"""
+GameSpecificDecoderFactory — Factory for creating game-specific protocol decoders with caching.
+
+Architecture (拿来主义):
+  fiddler_lol_decoder.py — decoder structure
+  game_adapter_registry.py（M674）— registration + lookup pattern
+
+Location: extensions/protocol_decoder/src/game_specific_decoder_factory.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - create() returns cached instance if available — no duplicate initialization cost.
+    - Unknown game types return error dict, never raises.
+  System:
+    - Factory map + instance cache are separate — register doesn't create, create doesn't re-register.
+    - Cache can be cleared per-game or globally.
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Dict, Optional, Type
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "extensions.protocol_decoder.game_specific_decoder_factory.v1"
+
+
+def _safe_div(a: float, b: float, default: float = 0.0) -> float:
+    return a / b if b != 0 else default
+
+
+class GameSpecificDecoderFactory:
+    """Factory for game-specific protocol decoders.
+
+    Public API
+    ----------
+        register_decoder_class(game, cls) -> dict
+        create(game, config) -> dict
+        get_or_create(game, config) -> dict
+        clear_cache(game) -> dict
+        list_registered() -> list
+        get_stats() -> dict
+
+    Evolution
+    ---------
+    Set evolution_callback to receive structured events.
+    """
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[Dict[str, Any]], None]] = None
+        self._op_count: int = 0
+        self._factory_map: Dict[str, Callable] = {}
+        self._cache: Dict[str, Any] = {}
+        self._create_count: int = 0
+        self._cache_hits: int = 0
+
+    def _fire(self, event_type: str, data: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({"type": event_type, "key": _EVOLUTION_KEY, **data})
+
+    def register_decoder_class(self, game: str, cls: Callable) -> Dict[str, Any]:
+        """Register a decoder class/factory for a game type."""
+        self._op_count += 1
+        self._factory_map[game] = cls
+        self._fire("decoder_class_registered", {"game": game})
+        return {"status": "ok", "game": game, "total_registered": len(self._factory_map)}
+
+    def create(self, game: str, config: Dict[str, Any] = None) -> Dict[str, Any]:
+        """Create a new decoder instance (ignores cache)."""
+        self._op_count += 1
+        self._create_count += 1
+        if config is None:
+            config = {}
+
+        cls = self._factory_map.get(game)
+        if cls is None:
+            return {"status": "error", "reason": f"no decoder registered for game '{game}'"}
+
+        try:
+            instance = cls()
+            self._fire("decoder_created", {"game": game})
+            return {"status": "ok", "game": game, "decoder": instance}
+        except Exception as exc:
+            return {"status": "error", "reason": f"failed to create decoder: {exc}"}
+
+    def get_or_create(self, game: str, config: Dict[str, Any] = None) -> Dict[str, Any]:
+        """Get cached decoder or create new one."""
+        self._op_count += 1
+        if game in self._cache:
+            self._cache_hits += 1
+            return {"status": "ok", "game": game, "decoder": self._cache[game], "cached": True}
+
+        result = self.create(game, config)
+        if result["status"] == "ok":
+            self._cache[game] = result["decoder"]
+            result["cached"] = False
+        return result
+
+    def clear_cache(self, game: str = None) -> Dict[str, Any]:
+        """Clear decoder cache. If game specified, clear only that game."""
+        self._op_count += 1
+        if game is not None:
+            removed = game in self._cache
+            self._cache.pop(game, None)
+            return {"status": "ok", "game": game, "removed": removed}
+        count = len(self._cache)
+        self._cache.clear()
+        return {"status": "ok", "cleared": count}
+
+    def list_registered(self) -> list:
+        return list(self._factory_map.keys())
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {
+            "total_ops": self._op_count,
+            "registered": list(self._factory_map.keys()),
+            "cached": list(self._cache.keys()),
+            "creates": self._create_count,
+            "cache_hits": self._cache_hits,
+            "cache_hit_rate": round(_safe_div(self._cache_hits, self._cache_hits + self._create_count), 4),
+        }
