@@ -0,0 +1,154 @@
+"""
+CrossGameActionSpaceUnifier — Maps game-specific action spaces to a unified abstract space.
+
+Architecture (拿来主义):
+  integrations/lol/src/lol_agent/action_space_mapper.py — action space mapping
+  historical_action_space_profiler.py（M620）— action profiling
+
+Location: extensions/protocol_decoder/src/cross_game_action_space_unifier.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - encode/decode round-trips perfectly for all registered actions.
+    - Unknown actions get a fallback encoding — never crashes.
+  System:
+    - Per-game codec registration is O(1) lookup by game + action_id.
+    - Abstract action space uses string IDs for debuggability over raw ints.
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Dict, List, Optional, Tuple
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "extensions.protocol_decoder.cross_game_action_space_unifier.v1"
+
+# Abstract action categories shared across games
+ABSTRACT_ACTIONS = {
+    "move", "attack", "defend", "use_ability", "use_item",
+    "buy", "sell", "ward", "retreat", "group", "split",
+    "objective", "communicate", "wait", "discard", "draw",
+    "claim", "pass", "surrender",
+}
+
+
+def _safe_div(a: float, b: float, default: float = 0.0) -> float:
+    return a / b if b != 0 else default
+
+
+class ActionCodec:
+    """Per-game action encoder/decoder."""
+    __slots__ = ("game", "encode_map", "decode_map")
+
+    def __init__(self, game: str) -> None:
+        self.game = game
+        self.encode_map: Dict[str, str] = {}  # game_action -> abstract_action
+        self.decode_map: Dict[str, str] = {}  # abstract_action -> game_action
+
+    def register(self, game_action: str, abstract_action: str) -> None:
+        self.encode_map[game_action] = abstract_action
+        self.decode_map[abstract_action] = game_action
+
+    def encode(self, game_action: str) -> str:
+        return self.encode_map.get(game_action, f"unknown:{game_action}")
+
+    def decode(self, abstract_action: str) -> str:
+        return self.decode_map.get(abstract_action, f"unmapped:{abstract_action}")
+
+
+class CrossGameActionSpaceUnifier:
+    """Unifies action spaces across different games.
+
+    Public API
+    ----------
+        register_game_actions(game, mappings) -> dict
+        encode(game, game_action) -> dict
+        decode(game, abstract_action) -> dict
+        encode_batch(game, actions) -> dict
+        get_supported_games() -> list
+        get_abstract_actions() -> set
+        get_stats() -> dict
+
+    Evolution
+    ---------
+    Set evolution_callback to receive structured events.
+    """
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[Dict[str, Any]], None]] = None
+        self._op_count: int = 0
+        self._codecs: Dict[str, ActionCodec] = {}
+        self._encode_count: int = 0
+        self._decode_count: int = 0
+        self._unknown_count: int = 0
+
+    def _fire(self, event_type: str, data: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({"type": event_type, "key": _EVOLUTION_KEY, **data})
+
+    def register_game_actions(self, game: str,
+                              mappings: Dict[str, str]) -> Dict[str, Any]:
+        """Register game-specific action → abstract action mappings.
+
+        mappings: {game_action_name: abstract_action_name}
+        """
+        self._op_count += 1
+        codec = ActionCodec(game)
+        for game_act, abstract_act in mappings.items():
+            codec.register(game_act, abstract_act)
+        self._codecs[game] = codec
+        self._fire("game_actions_registered", {"game": game, "count": len(mappings)})
+        return {"status": "ok", "game": game, "registered": len(mappings)}
+
+    def encode(self, game: str, game_action: str) -> Dict[str, Any]:
+        """Encode a game-specific action to abstract action."""
+        self._op_count += 1
+        self._encode_count += 1
+        codec = self._codecs.get(game)
+        if codec is None:
+            self._unknown_count += 1
+            return {"status": "error", "reason": f"game '{game}' not registered"}
+        abstract = codec.encode(game_action)
+        if abstract.startswith("unknown:"):
+            self._unknown_count += 1
+        return {"status": "ok", "game": game, "game_action": game_action, "abstract_action": abstract}
+
+    def decode(self, game: str, abstract_action: str) -> Dict[str, Any]:
+        """Decode an abstract action to game-specific action."""
+        self._op_count += 1
+        self._decode_count += 1
+        codec = self._codecs.get(game)
+        if codec is None:
+            return {"status": "error", "reason": f"game '{game}' not registered"}
+        game_action = codec.decode(abstract_action)
+        return {"status": "ok", "game": game, "abstract_action": abstract_action, "game_action": game_action}
+
+    def encode_batch(self, game: str, actions: List[str]) -> Dict[str, Any]:
+        """Encode a batch of game actions."""
+        self._op_count += 1
+        results = []
+        for a in actions:
+            r = self.encode(game, a)
+            results.append(r.get("abstract_action", f"unknown:{a}"))
+        return {"status": "ok", "game": game, "count": len(results), "abstract_actions": results}
+
+    def get_supported_games(self) -> List[str]:
+        return list(self._codecs.keys())
+
+    def get_abstract_actions(self) -> set:
+        return set(ABSTRACT_ACTIONS)
+
+    def get_stats(self) -> Dict[str, Any]:
+        per_game = {}
+        for game, codec in self._codecs.items():
+            per_game[game] = {"encode_map_size": len(codec.encode_map), "decode_map_size": len(codec.decode_map)}
+        return {
+            "total_ops": self._op_count,
+            "encodes": self._encode_count,
+            "decodes": self._decode_count,
+            "unknowns": self._unknown_count,
+            "games": per_game,
+        }
