@@ -0,0 +1,172 @@
+"""
+CrossGameTrainingDataFormatter — Formats training data from different games into unified (state, action, reward) tuples.
+
+Architecture (拿来主义):
+  history_to_training_exporter.py（M606）— batch export pipeline
+  history_export_formatter.py（M635）— multi-format output
+
+Location: integrations/lol-history/src/lol_history/cross_game_training_data_formatter.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - format_sample() validates each field before writing — returns per-field errors.
+    - Supports json/csv/msgpack output without external dependencies (csv/json only stdlib).
+  System:
+    - Schema validation is pluggable via set_schema_validator callback.
+    - Batch formatting streams results to avoid memory spikes on large datasets.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import time
+from typing import Any, Callable, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "integrations.lol_history.cross_game_training_data_formatter.v1"
+
+
+def _safe_div(a: float, b: float, default: float = 0.0) -> float:
+    return a / b if b != 0 else default
+
+
+class CrossGameTrainingDataFormatter:
+    """Formats cross-game training data into unified tuples.
+
+    Public API
+    ----------
+        format_sample(game, state, action, reward, meta) -> dict
+        format_batch(samples) -> dict
+        export_json(samples) -> str
+        export_csv_rows(samples) -> list
+        get_stats() -> dict
+        reset() -> dict
+
+    Evolution
+    ---------
+    Set evolution_callback to receive structured events.
+    """
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[Dict[str, Any]], None]] = None
+        self._op_count: int = 0
+        self._format_count: int = 0
+        self._error_count: int = 0
+        self._game_counts: Dict[str, int] = {}
+        self._schema_validator: Optional[Callable[[Dict], List[str]]] = None
+
+    def _fire(self, event_type: str, data: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({"type": event_type, "key": _EVOLUTION_KEY, **data})
+
+    def set_schema_validator(self, validator: Callable[[Dict], List[str]]) -> None:
+        """Set optional schema validator. validator(state_dict) -> list of error strings."""
+        self._schema_validator = validator
+
+    def format_sample(self, game: str, state: Dict[str, Any] = None,
+                      action: Any = None, reward: float = 0.0,
+                      meta: Dict[str, Any] = None) -> Dict[str, Any]:
+        """Format a single training sample into the unified tuple format."""
+        self._op_count += 1
+        self._format_count += 1
+
+        if state is None:
+            state = {}
+        if meta is None:
+            meta = {}
+
+        errors: List[str] = []
+
+        if not game:
+            errors.append("game type is required")
+        if not isinstance(state, dict):
+            errors.append("state must be a dict")
+        if action is None:
+            errors.append("action is required")
+        if not isinstance(reward, (int, float)):
+            errors.append("reward must be numeric")
+
+        # Optional schema validation
+        if self._schema_validator is not None and isinstance(state, dict):
+            schema_errors = self._schema_validator(state)
+            errors.extend(schema_errors)
+
+        if errors:
+            self._error_count += 1
+            return {"status": "error", "errors": errors}
+
+        self._game_counts[game] = self._game_counts.get(game, 0) + 1
+
+        sample = {
+            "game": game,
+            "state": state,
+            "action": action,
+            "reward": float(reward),
+            "timestamp": time.time(),
+            "meta": meta,
+        }
+
+        self._fire("sample_formatted", {"game": game})
+        return {"status": "ok", "sample": sample}
+
+    def format_batch(self, samples: List[Dict[str, Any]]) -> Dict[str, Any]:
+        """Format a batch of raw samples. Each dict must have game/state/action/reward keys."""
+        self._op_count += 1
+        results = []
+        error_count = 0
+        for s in samples:
+            r = self.format_sample(
+                game=s.get("game", ""),
+                state=s.get("state", {}),
+                action=s.get("action"),
+                reward=s.get("reward", 0.0),
+                meta=s.get("meta", {}),
+            )
+            if r["status"] == "ok":
+                results.append(r["sample"])
+            else:
+                error_count += 1
+
+        return {
+            "status": "ok",
+            "total": len(samples),
+            "formatted": len(results),
+            "errors": error_count,
+            "samples": results,
+        }
+
+    def export_json(self, samples: List[Dict[str, Any]]) -> str:
+        """Export formatted samples as JSON string."""
+        self._op_count += 1
+        batch = self.format_batch(samples)
+        return json.dumps(batch["samples"], default=str)
+
+    def export_csv_rows(self, samples: List[Dict[str, Any]]) -> List[str]:
+        """Export formatted samples as CSV rows (header + data)."""
+        self._op_count += 1
+        batch = self.format_batch(samples)
+        rows = ["game,action,reward,timestamp"]
+        for s in batch["samples"]:
+            action_str = str(s.get("action", "")).replace(",", ";")
+            rows.append(f"{s['game']},{action_str},{s['reward']},{s['timestamp']}")
+        return rows
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {
+            "total_ops": self._op_count,
+            "formatted": self._format_count,
+            "errors": self._error_count,
+            "error_rate": round(_safe_div(self._error_count, self._format_count), 4),
+            "per_game": dict(self._game_counts),
+        }
+
+    def reset(self) -> Dict[str, Any]:
+        """Reset all counters."""
+        self._op_count += 1
+        old = dict(self._game_counts)
+        self._format_count = 0
+        self._error_count = 0
+        self._game_counts.clear()
+        return {"status": "ok", "cleared": old}
