+"""
+DecisionQualityScorer — Scores decision quality based on post-action feedback.
+
+Architecture (拿来主义):
+  realtime_decision_confidence_scorer.py（M659）— confidence scoring
+  coaching_effectiveness_tracker.py（M613）— effectiveness feedback loop
+
+Location: integrations/lol-history/src/lol_history/decision_quality_scorer.py
+"""
+from __future__ import annotations
+import logging, time
+from collections import deque
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.decision_quality_scorer.v1"
+
+def _safe_div(a, b, d=0.0): return a / b if b else d
+
+class DecisionQualityScorer:
+    """Scores decisions post-hoc and tracks quality trends.
+
+    Public API: score, get_trend, detect_bias, get_stats
+    """
+    def __init__(self, window_size: int = 100) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._scores: deque = deque(maxlen=window_size)
+        self._intent_scores: Dict[str, List[float]] = {}
+        self._score_count = 0
+
+    def _fire(self, et, data):
+        if self.evolution_callback: self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def score(self, decision_id: str, intent: str, predicted_value: float,
+              actual_outcome: float) -> Dict[str, Any]:
+        self._op_count += 1
+        self._score_count += 1
+        quality = 1.0 - min(abs(predicted_value - actual_outcome), 1.0)
+        entry = {"decision_id": decision_id, "intent": intent, "predicted": predicted_value,
+                 "actual": actual_outcome, "quality": round(quality, 4), "timestamp": time.time()}
+        self._scores.append(entry)
+        self._intent_scores.setdefault(intent, []).append(quality)
+        self._fire("quality_scored", {"intent": intent, "quality": quality})
+        return {"status": "ok", **entry}
+
+    def get_trend(self, n: int = 20) -> Dict[str, Any]:
+        self._op_count += 1
+        recent = list(self._scores)[-n:]
+        if len(recent) < 2: return {"status": "ok", "trend": "insufficient_data"}
+        scores = [e["quality"] for e in recent]
+        first_half = scores[:len(scores)//2]
+        second_half = scores[len(scores)//2:]
+        avg1 = sum(first_half) / len(first_half)
+        avg2 = sum(second_half) / len(second_half)
+        if avg2 - avg1 > 0.05: trend = "improving"
+        elif avg1 - avg2 > 0.05: trend = "declining"
+        else: trend = "stable"
+        return {"status": "ok", "trend": trend, "recent_avg": round(avg2, 4), "samples": len(recent)}
+
+    def detect_bias(self) -> Dict[str, Any]:
+        self._op_count += 1
+        biases = {}
+        for intent, scores in self._intent_scores.items():
+            if len(scores) < 5: continue
+            avg = sum(scores) / len(scores)
+            if avg < 0.4: biases[intent] = {"avg_quality": round(avg, 3), "bias": "systematically_poor"}
+            elif avg > 0.8: biases[intent] = {"avg_quality": round(avg, 3), "bias": "overconfident_or_good"}
+        return {"status": "ok", "biases": biases}
+
+    def get_stats(self) -> Dict[str, Any]:
+        all_scores = [e["quality"] for e in self._scores]
+        return {"scored": self._score_count,
+                "avg_quality": round(sum(all_scores)/len(all_scores), 4) if all_scores else 0,
+                "intents_tracked": list(self._intent_scores.keys()), "total_ops": self._op_count}
diff --git a/integrations/lol-history/src/lol_history/game_knowledge_transfer_engine.py b/integrations/lol-history/src/lol_history/game_knowledge_transfer_engine.py
new file mode 100644
index 00000000..8c4fd9f6
--- /dev/null
+++ b/integrations/lol-history/src/lol_history/game_knowledge_transfer_engine.py
@@ -0,0 +1,170 @@
+"""
+GameKnowledgeTransferEngine — Transfers strategy knowledge between games.
+
+Architecture (拿来主义):
+  game_event_pattern_library.py（M615）— knowledge store/query pattern
+  transfer_learning_feature_aligner.py（M675）— feature alignment
+
+Location: integrations/lol-history/src/lol_history/game_knowledge_transfer_engine.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - transfer() returns effectiveness estimate before committing — user can reject.
+    - Knowledge items are tagged with abstract concepts (map_control, resource_timing, etc.).
+  System:
+    - Concept-based matching: MOBA map_control → mahjong field_control via tag overlap.
+    - Transfer effectiveness tracked over time for self-improvement.
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "integrations.lol_history.game_knowledge_transfer_engine.v1"
+
+
+def _safe_div(a: float, b: float, default: float = 0.0) -> float:
+    return a / b if b != 0 else default
+
+
+class KnowledgeItem:
+    __slots__ = ("game", "concept", "strategy", "confidence", "tags", "created_at")
+
+    def __init__(self, game: str, concept: str, strategy: str,
+                 confidence: float, tags: List[str]) -> None:
+        self.game = game
+        self.concept = concept
+        self.strategy = strategy
+        self.confidence = confidence
+        self.tags = tags
+        self.created_at = time.time()
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            "game": self.game, "concept": self.concept,
+            "strategy": self.strategy, "confidence": self.confidence,
+            "tags": self.tags, "created_at": self.created_at,
+        }
+
+
+class GameKnowledgeTransferEngine:
+    """Transfers strategy knowledge between games.
+
+    Public API
+    ----------
+        store_knowledge(game, concept, strategy, confidence, tags) -> dict
+        find_transferable(source, target) -> dict
+        transfer(source, target, concept) -> dict
+        evaluate_transfer(transfer_id, outcome_score) -> dict
+        get_knowledge(game) -> list
+        get_stats() -> dict
+
+    Evolution
+    ---------
+    Set evolution_callback to receive structured events.
+    """
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[Dict[str, Any]], None]] = None
+        self._op_count: int = 0
+        self._knowledge: Dict[str, List[KnowledgeItem]] = {}  # game -> items
+        self._transfers: List[Dict[str, Any]] = []
+        self._transfer_outcomes: Dict[int, float] = {}
+
+    def _fire(self, event_type: str, data: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({"type": event_type, "key": _EVOLUTION_KEY, **data})
+
+    def store_knowledge(self, game: str, concept: str, strategy: str,
+                        confidence: float = 0.5, tags: List[str] = None) -> Dict[str, Any]:
+        self._op_count += 1
+        if tags is None:
+            tags = []
+        item = KnowledgeItem(game, concept, strategy, confidence, tags)
+        if game not in self._knowledge:
+            self._knowledge[game] = []
+        self._knowledge[game].append(item)
+        self._fire("knowledge_stored", {"game": game, "concept": concept})
+        return {"status": "ok", "game": game, "concept": concept, "total": len(self._knowledge[game])}
+
+    def find_transferable(self, source: str, target: str) -> Dict[str, Any]:
+        """Find knowledge items from source game transferable to target."""
+        self._op_count += 1
+        src_items = self._knowledge.get(source, [])
+        tgt_items = self._knowledge.get(target, [])
+
+        # Collect target tags for overlap matching
+        tgt_tags = set()
+        for item in tgt_items:
+            tgt_tags.update(item.tags)
+
+        transferable = []
+        for item in src_items:
+            src_tags = set(item.tags)
+            overlap = src_tags & tgt_tags if tgt_tags else src_tags
+            if overlap or not tgt_tags:
+                score = _safe_div(len(overlap), len(src_tags)) if src_tags else 0.3
+                transferable.append({
+                    **item.to_dict(),
+                    "transfer_score": round(score, 4),
+                    "tag_overlap": list(overlap),
+                })
+
+        transferable.sort(key=lambda x: x["transfer_score"], reverse=True)
+        return {"status": "ok", "source": source, "target": target, "items": transferable}
+
+    def transfer(self, source: str, target: str, concept: str) -> Dict[str, Any]:
+        """Execute knowledge transfer from source to target game."""
+        self._op_count += 1
+        src_items = [i for i in self._knowledge.get(source, []) if i.concept == concept]
+        if not src_items:
+            return {"status": "error", "reason": f"concept '{concept}' not found in source '{source}'"}
+
+        best = max(src_items, key=lambda x: x.confidence)
+        transfer_id = len(self._transfers)
+        transfer_record = {
+            "id": transfer_id,
+            "source": source,
+            "target": target,
+            "concept": concept,
+            "strategy": best.strategy,
+            "source_confidence": best.confidence,
+            "transferred_at": time.time(),
+        }
+        self._transfers.append(transfer_record)
+
+        # Store transferred knowledge in target with reduced confidence
+        self.store_knowledge(
+            game=target, concept=f"transferred:{concept}",
+            strategy=best.strategy, confidence=best.confidence * 0.7,
+            tags=best.tags,
+        )
+
+        self._fire("knowledge_transferred", {"source": source, "target": target, "concept": concept})
+        return {"status": "ok", "transfer_id": transfer_id, **transfer_record}
+
+    def evaluate_transfer(self, transfer_id: int, outcome_score: float) -> Dict[str, Any]:
+        """Evaluate a transfer's effectiveness."""
+        self._op_count += 1
+        if transfer_id >= len(self._transfers):
+            return {"status": "error", "reason": "transfer_id not found"}
+        self._transfer_outcomes[transfer_id] = outcome_score
+        return {"status": "ok", "transfer_id": transfer_id, "outcome": outcome_score}
+
+    def get_knowledge(self, game: str) -> List[Dict[str, Any]]:
+        self._op_count += 1
+        return [i.to_dict() for i in self._knowledge.get(game, [])]
+
+    def get_stats(self) -> Dict[str, Any]:
+        outcomes = list(self._transfer_outcomes.values())
+        return {
+            "total_ops": self._op_count,
+            "knowledge_per_game": {g: len(items) for g, items in self._knowledge.items()},
+            "total_transfers": len(self._transfers),
+            "evaluated_transfers": len(self._transfer_outcomes),
+            "avg_outcome": round(sum(outcomes) / len(outcomes), 4) if outcomes else 0.0,
+        }
diff --git a/integrations/lol-history/src/lol_history/game_phase_detector.py b/integrations/lol-history/src/lol_history/game_phase_detector.py
