@@ -0,0 +1,182 @@
+"""
+CrossGamePerformanceComparator — Compares player performance metrics across games.
+
+Architecture (拿来主义):
+  multi_queue_performance_splitter.py（M603）— per-queue split, adapted to per-game
+  role_performance_tracker.py（M589）— grouped statistics
+
+Location: integrations/lol-history/src/lol_history/cross_game_performance_comparator.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - compare() returns structured diff — easy to consume for dashboards.
+    - Identifies strengths/weaknesses shared across games.
+  System:
+    - Statistics stored per (game, metric) tuple — O(1) lookup.
+    - Percentile computation uses sorted insert — no numpy dependency.
+"""
+
+from __future__ import annotations
+
+import logging
+import math
+import time
+from typing import Any, Callable, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "integrations.lol_history.cross_game_performance_comparator.v1"
+
+
+def _safe_div(a: float, b: float, default: float = 0.0) -> float:
+    return a / b if b != 0 else default
+
+
+def _percentile(sorted_data: List[float], p: float) -> float:
+    if not sorted_data:
+        return 0.0
+    k = (len(sorted_data) - 1) * (p / 100.0)
+    f = math.floor(k)
+    c = math.ceil(k)
+    if f == c:
+        return sorted_data[int(k)]
+    return sorted_data[int(f)] * (c - k) + sorted_data[int(c)] * (k - f)
+
+
+class CrossGamePerformanceComparator:
+    """Compares player performance across different games.
+
+    Public API
+    ----------
+        record(game, metrics) -> dict
+        compare(games) -> dict
+        identify_strengths(threshold) -> dict
+        get_game_summary(game) -> dict
+        get_stats() -> dict
+
+    Evolution
+    ---------
+    Set evolution_callback to receive structured events.
+    """
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[Dict[str, Any]], None]] = None
+        self._op_count: int = 0
+        self._data: Dict[str, Dict[str, List[float]]] = {}  # game -> metric -> values
+        self._record_count: int = 0
+
+    def _fire(self, event_type: str, data: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({"type": event_type, "key": _EVOLUTION_KEY, **data})
+
+    def record(self, game: str, metrics: Dict[str, float]) -> Dict[str, Any]:
+        """Record a performance data point for a game."""
+        self._op_count += 1
+        self._record_count += 1
+        if game not in self._data:
+            self._data[game] = {}
+        for k, v in metrics.items():
+            if k not in self._data[game]:
+                self._data[game][k] = []
+            self._data[game][k].append(float(v))
+        self._fire("performance_recorded", {"game": game, "metrics": len(metrics)})
+        return {"status": "ok", "game": game, "metrics_recorded": len(metrics)}
+
+    def compare(self, games: List[str] = None) -> Dict[str, Any]:
+        """Compare performance across specified games (or all)."""
+        self._op_count += 1
+        if games is None:
+            games = list(self._data.keys())
+
+        if len(games) < 2:
+            return {"status": "error", "reason": "need at least 2 games to compare"}
+
+        # Collect all metrics across games
+        all_metrics = set()
+        for g in games:
+            if g in self._data:
+                all_metrics.update(self._data[g].keys())
+
+        comparison = {}
+        for metric in sorted(all_metrics):
+            per_game = {}
+            for g in games:
+                values = self._data.get(g, {}).get(metric, [])
+                if values:
+                    sorted_v = sorted(values)
+                    per_game[g] = {
+                        "mean": round(sum(values) / len(values), 4),
+                        "median": round(_percentile(sorted_v, 50), 4),
+                        "p90": round(_percentile(sorted_v, 90), 4),
+                        "samples": len(values),
+                    }
+            comparison[metric] = per_game
+
+        self._fire("comparison_completed", {"games": games, "metrics": len(all_metrics)})
+        return {"status": "ok", "games": games, "comparison": comparison}
+
+    def identify_strengths(self, threshold: float = 0.7) -> Dict[str, Any]:
+        """Identify cross-game strengths and weaknesses."""
+        self._op_count += 1
+        games = list(self._data.keys())
+        if len(games) < 2:
+            return {"status": "error", "reason": "need 2+ games"}
+
+        # Normalize per-metric per-game to [0,1]
+        all_metrics = set()
+        for g in games:
+            all_metrics.update(self._data[g].keys())
+
+        strengths = []
+        weaknesses = []
+
+        for metric in all_metrics:
+            means = {}
+            for g in games:
+                values = self._data.get(g, {}).get(metric, [])
+                if values:
+                    means[g] = sum(values) / len(values)
+
+            if len(means) < 2:
+                continue
+
+            vals = list(means.values())
+            lo, hi = min(vals), max(vals)
+            rng = hi - lo if hi != lo else 1.0
+
+            for g, m in means.items():
+                normalized = (m - lo) / rng
+                if normalized >= threshold:
+                    strengths.append({"game": g, "metric": metric, "score": round(normalized, 4)})
+                elif normalized <= (1 - threshold):
+                    weaknesses.append({"game": g, "metric": metric, "score": round(normalized, 4)})
+
+        return {
+            "status": "ok",
+            "strengths": strengths,
+            "weaknesses": weaknesses,
+        }
+
+    def get_game_summary(self, game: str) -> Dict[str, Any]:
+        self._op_count += 1
+        data = self._data.get(game, {})
+        if not data:
+            return {"status": "error", "reason": f"no data for game '{game}'"}
+        summary = {}
+        for metric, values in data.items():
+            summary[metric] = {
+                "mean": round(sum(values) / len(values), 4),
+                "count": len(values),
+                "min": round(min(values), 4),
+                "max": round(max(values), 4),
+            }
+        return {"status": "ok", "game": game, "summary": summary}
+
+    def get_stats(self) -> Dict[str, Any]:
+        per_game = {g: sum(len(v) for v in metrics.values()) for g, metrics in self._data.items()}
+        return {
+            "total_ops": self._op_count,
+            "records": self._record_count,
+            "games": list(self._data.keys()),
+            "data_points_per_game": per_game,
+        }
