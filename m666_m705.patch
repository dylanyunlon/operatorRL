@@ -0,0 +1,203 @@
+"""
+MultiGamePipelineOrchestrator — Top-level orchestrator managing all cross-game pipelines.
+
+Architecture (拿来主义):
+  capture_to_decision_orchestrator.py（M665）— register→init→run→shutdown lifecycle
+  history_feedback_loop_orchestrator.py（M625）— full-flow orchestration
+
+Location: integrations/lol-history/src/lol_history/multi_game_pipeline_orchestrator.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Single entry point: start_game() and stop_game() manage everything per game.
+    - get_dashboard() provides unified monitoring view.
+  System:
+    - Per-game isolation: one game's failure is contained.
+    - Shared model/knowledge bus allows cross-game transfer without tight coupling.
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "integrations.lol_history.multi_game_pipeline_orchestrator.v1"
+
+
+def _safe_div(a: float, b: float, default: float = 0.0) -> float:
+    return a / b if b != 0 else default
+
+
+class _GamePipelineEntry:
+    __slots__ = ("game", "adapter", "state", "started_at", "cycle_count", "error_count", "config")
+
+    def __init__(self, game: str, adapter: Any, config: Dict[str, Any]) -> None:
+        self.game = game
+        self.adapter = adapter
+        self.state = "registered"
+        self.started_at: Optional[float] = None
+        self.cycle_count = 0
+        self.error_count = 0
+        self.config = config
+
+    def to_dict(self) -> Dict[str, Any]:
+        uptime = time.time() - self.started_at if self.started_at else 0.0
+        return {
+            "game": self.game, "state": self.state,
+            "uptime_s": round(uptime, 2),
+            "cycles": self.cycle_count, "errors": self.error_count,
+        }
+
+
+class MultiGamePipelineOrchestrator:
+    """Top-level orchestrator for all cross-game agentic pipelines.
+
+    Public API
+    ----------
+        register_game(game, adapter, config) -> dict
+        initialize_game(game) -> dict
+        start_game(game) -> dict
+        run_cycle(game, data) -> dict
+        stop_game(game) -> dict
+        shutdown_all() -> dict
+        get_dashboard() -> dict
+        get_health() -> dict
+        get_stats() -> dict
+
+    Evolution
+    ---------
+    Set evolution_callback to receive structured events.
+    """
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[Dict[str, Any]], None]] = None
+        self._op_count: int = 0
+        self._pipelines: Dict[str, _GamePipelineEntry] = {}
+        self._shared_bus: Dict[str, Any] = {}
+        self._total_cycles: int = 0
+
+    def _fire(self, event_type: str, data: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({"type": event_type, "key": _EVOLUTION_KEY, **data})
+
+    def register_game(self, game: str, adapter: Any = None,
+                      config: Dict[str, Any] = None) -> Dict[str, Any]:
+        self._op_count += 1
+        if config is None:
+            config = {}
+        entry = _GamePipelineEntry(game, adapter, config)
+        self._pipelines[game] = entry
+        self._fire("game_registered", {"game": game})
+        return {"status": "ok", "game": game, "state": "registered", "total": len(self._pipelines)}
+
+    def initialize_game(self, game: str) -> Dict[str, Any]:
+        self._op_count += 1
+        entry = self._pipelines.get(game)
+        if entry is None:
+            return {"status": "error", "reason": f"game '{game}' not registered"}
+        try:
+            if entry.adapter is not None and hasattr(entry.adapter, "connect"):
+                entry.adapter.connect(entry.config)
+            entry.state = "initialized"
+            self._fire("game_initialized", {"game": game})
+            return {"status": "ok", "game": game, "state": "initialized"}
+        except Exception as exc:
+            entry.error_count += 1
+            entry.state = "error"
+            return {"status": "error", "game": game, "reason": str(exc)}
+
+    def start_game(self, game: str) -> Dict[str, Any]:
+        self._op_count += 1
+        entry = self._pipelines.get(game)
+        if entry is None:
+            return {"status": "error", "reason": f"game '{game}' not registered"}
+        if entry.state not in ("initialized", "registered"):
+            return {"status": "error", "reason": f"cannot start from state '{entry.state}'"}
+        entry.state = "running"
+        entry.started_at = time.time()
+        self._fire("game_started", {"game": game})
+        return {"status": "ok", "game": game, "state": "running"}
+
+    def run_cycle(self, game: str, data: Dict[str, Any] = None) -> Dict[str, Any]:
+        self._op_count += 1
+        self._total_cycles += 1
+        entry = self._pipelines.get(game)
+        if entry is None:
+            return {"status": "error", "reason": f"game '{game}' not registered"}
+        if entry.state != "running":
+            return {"status": "error", "reason": f"game not running (state={entry.state})"}
+        if data is None:
+            data = {}
+
+        _start = time.time()
+        try:
+            result = {"cycle": entry.cycle_count, "game": game}
+            # Decode via adapter if available
+            if entry.adapter is not None and hasattr(entry.adapter, "decode"):
+                raw = data.get("raw_packet", b"")
+                if isinstance(raw, str):
+                    raw = raw.encode()
+                decode_result = entry.adapter.decode(raw)
+                result["decoded"] = decode_result
+            entry.cycle_count += 1
+            elapsed = time.time() - _start
+            result["elapsed_ms"] = round(elapsed * 1000, 2)
+            self._fire("cycle_completed", {"game": game, "cycle": entry.cycle_count, "elapsed": elapsed})
+            return {"status": "ok", **result}
+        except Exception as exc:
+            entry.error_count += 1
+            return {"status": "error", "game": game, "reason": str(exc)}
+
+    def stop_game(self, game: str) -> Dict[str, Any]:
+        self._op_count += 1
+        entry = self._pipelines.get(game)
+        if entry is None:
+            return {"status": "error", "reason": f"game '{game}' not registered"}
+        if entry.adapter is not None and hasattr(entry.adapter, "disconnect"):
+            try:
+                entry.adapter.disconnect()
+            except Exception:
+                pass
+        old_state = entry.state
+        entry.state = "stopped"
+        self._fire("game_stopped", {"game": game, "cycles": entry.cycle_count})
+        return {"status": "ok", "game": game, "previous_state": old_state, "cycles": entry.cycle_count}
+
+    def shutdown_all(self) -> Dict[str, Any]:
+        self._op_count += 1
+        results = {}
+        for game in list(self._pipelines.keys()):
+            results[game] = self.stop_game(game)
+        self._fire("all_shutdown", {"games": len(results)})
+        return {"status": "ok", "shutdown": results}
+
+    def get_dashboard(self) -> Dict[str, Any]:
+        return {
+            "status": "ok",
+            "pipelines": {g: e.to_dict() for g, e in self._pipelines.items()},
+            "running": [g for g, e in self._pipelines.items() if e.state == "running"],
+            "total_cycles": self._total_cycles,
+        }
+
+    def get_health(self) -> Dict[str, Any]:
+        total = len(self._pipelines)
+        running = sum(1 for e in self._pipelines.values() if e.state == "running")
+        errored = sum(1 for e in self._pipelines.values() if e.state == "error")
+        return {
+            "healthy": errored == 0,
+            "total": total,
+            "running": running,
+            "errored": errored,
+        }
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {
+            "total_ops": self._op_count,
+            "total_games": len(self._pipelines),
+            "total_cycles": self._total_cycles,
+            "per_game": {g: {"cycles": e.cycle_count, "errors": e.error_count, "state": e.state}
+                         for g, e in self._pipelines.items()},
+        }
