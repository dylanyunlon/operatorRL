+"""
+CrossGameEvolutionTracker — Tracks model evolution across multiple games.
+
+Architecture (拿来主义):
+  agentos/governance/fitness_aggregator.py — get_trend trend analysis
+  coaching_effectiveness_tracker.py（M613）— effectiveness evaluation
+
+Location: integrations/lol-history/src/lol_history/cross_game_evolution_tracker.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - detect_transfer_effects() clearly labels positive vs negative transfer.
+    - Trend analysis uses linear regression (stdlib math) — no numpy needed.
+  System:
+    - Per-game per-metric time series stored as bounded deque.
+    - Cross-game correlation uses Pearson coefficient (stdlib).
+"""
+
+from __future__ import annotations
+
+import logging
+import math
+import time
+from collections import deque
+from typing import Any, Callable, Deque, Dict, List, Optional, Tuple
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "integrations.lol_history.cross_game_evolution_tracker.v1"
+
+_MAX_HISTORY = 500
+
+
+def _safe_div(a: float, b: float, default: float = 0.0) -> float:
+    return a / b if b != 0 else default
+
+
+def _linear_slope(ys: List[float]) -> float:
+    """Compute slope of linear regression (x = 0,1,2,...,n-1)."""
+    n = len(ys)
+    if n < 2:
+        return 0.0
+    x_mean = (n - 1) / 2.0
+    y_mean = sum(ys) / n
+    num = sum((i - x_mean) * (y - y_mean) for i, y in enumerate(ys))
+    den = sum((i - x_mean) ** 2 for i in range(n))
+    return num / den if den != 0 else 0.0
+
+
+def _pearson(xs: List[float], ys: List[float]) -> float:
+    """Pearson correlation coefficient."""
+    n = min(len(xs), len(ys))
+    if n < 3:
+        return 0.0
+    mx = sum(xs[:n]) / n
+    my = sum(ys[:n]) / n
+    num = sum((xs[i] - mx) * (ys[i] - my) for i in range(n))
+    dx = math.sqrt(sum((xs[i] - mx) ** 2 for i in range(n)))
+    dy = math.sqrt(sum((ys[i] - my) ** 2 for i in range(n)))
+    return num / (dx * dy) if dx * dy > 0 else 0.0
+
+
+class CrossGameEvolutionTracker:
+    """Tracks model evolution across games, detecting transfer effects.
+
+    Public API
+    ----------
+        record(game, metrics) -> dict
+        get_trend(game, metric) -> dict
+        detect_transfer_effects(source, target) -> dict
+        get_evolution_summary() -> dict
+        get_stats() -> dict
+
+    Evolution
+    ---------
+    Set evolution_callback to receive structured events.
+    """
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[Dict[str, Any]], None]] = None
+        self._op_count: int = 0
+        self._series: Dict[str, Dict[str, Deque[Tuple[float, float]]]] = {}  # game→metric→[(ts, val)]
+        self._record_count: int = 0
+
+    def _fire(self, event_type: str, data: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({"type": event_type, "key": _EVOLUTION_KEY, **data})
+
+    def record(self, game: str, metrics: Dict[str, float]) -> Dict[str, Any]:
+        self._op_count += 1
+        self._record_count += 1
+        now = time.time()
+        if game not in self._series:
+            self._series[game] = {}
+        for k, v in metrics.items():
+            if k not in self._series[game]:
+                self._series[game][k] = deque(maxlen=_MAX_HISTORY)
+            self._series[game][k].append((now, float(v)))
+        self._fire("evolution_recorded", {"game": game, "metrics": len(metrics)})
+        return {"status": "ok", "game": game, "recorded": len(metrics)}
+
+    def get_trend(self, game: str, metric: str) -> Dict[str, Any]:
+        self._op_count += 1
+        series = self._series.get(game, {}).get(metric)
+        if not series or len(series) < 2:
+            return {"status": "error", "reason": "insufficient data"}
+        values = [v for _, v in series]
+        slope = _linear_slope(values)
+        direction = "improving" if slope > 0.001 else ("declining" if slope < -0.001 else "stable")
+        return {
+            "status": "ok", "game": game, "metric": metric,
+            "slope": round(slope, 6), "direction": direction,
+            "samples": len(values),
+            "latest": round(values[-1], 4),
+            "mean": round(sum(values) / len(values), 4),
+        }
+
+    def detect_transfer_effects(self, source: str, target: str) -> Dict[str, Any]:
+        """Detect positive/negative transfer between source and target games."""
+        self._op_count += 1
+        src_metrics = self._series.get(source, {})
+        tgt_metrics = self._series.get(target, {})
+
+        if not src_metrics or not tgt_metrics:
+            return {"status": "error", "reason": "insufficient data for one or both games"}
+
+        # Find shared metrics
+        shared = set(src_metrics.keys()) & set(tgt_metrics.keys())
+        effects = []
+
+        for metric in shared:
+            src_vals = [v for _, v in src_metrics[metric]]
+            tgt_vals = [v for _, v in tgt_metrics[metric]]
+
+            # Truncate to same length
+            min_len = min(len(src_vals), len(tgt_vals))
+            if min_len < 3:
+                continue
+
+            corr = _pearson(src_vals[-min_len:], tgt_vals[-min_len:])
+            src_trend = _linear_slope(src_vals)
+            tgt_trend = _linear_slope(tgt_vals)
+
+            if corr > 0.3 and tgt_trend > 0.001:
+                effect = "positive_transfer"
+            elif corr > 0.3 and tgt_trend < -0.001:
+                effect = "negative_transfer"
+            elif corr < -0.3:
+                effect = "inverse_correlation"
+            else:
+                effect = "no_significant_transfer"
+
+            effects.append({
+                "metric": metric,
+                "correlation": round(corr, 4),
+                "source_trend": round(src_trend, 6),
+                "target_trend": round(tgt_trend, 6),
+                "effect": effect,
+            })
+
+        positive = sum(1 for e in effects if e["effect"] == "positive_transfer")
+        negative = sum(1 for e in effects if e["effect"] == "negative_transfer")
+
+        self._fire("transfer_detected", {"source": source, "target": target,
+                                          "positive": positive, "negative": negative})
+        return {
+            "status": "ok", "source": source, "target": target,
+            "effects": effects,
+            "positive_transfers": positive,
+            "negative_transfers": negative,
+            "net_effect": "positive" if positive > negative else ("negative" if negative > positive else "neutral"),
+        }
+
+    def get_evolution_summary(self) -> Dict[str, Any]:
+        self._op_count += 1
+        summary = {}
+        for game, metrics in self._series.items():
+            game_summary = {}
+            for metric, series in metrics.items():
+                values = [v for _, v in series]
+                if len(values) >= 2:
+                    slope = _linear_slope(values)
+                    game_summary[metric] = {
+                        "samples": len(values),
+                        "slope": round(slope, 6),
+                        "latest": round(values[-1], 4),
+                    }
+            summary[game] = game_summary
+        return {"status": "ok", "summary": summary}
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {
+            "total_ops": self._op_count,
+            "records": self._record_count,
+            "games": list(self._series.keys()),
+            "metrics_per_game": {g: len(m) for g, m in self._series.items()},
+        }
