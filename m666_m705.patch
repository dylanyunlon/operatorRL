@@ -0,0 +1,170 @@
+"""
+CrossGameRewardNormalizer — Normalizes reward signals from different games to a unified scale.
+
+Architecture (拿来主义):
+  integrations/lol/src/lol_agent/reward_shaper.py — compute_reward multi-dimensional scoring
+  historical_reward_reshaper.py（M617）— adaptive weight adjustment
+
+Location: integrations/lol-history/src/lol_history/cross_game_reward_normalizer.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - normalize() never returns NaN/Inf — clamps to [-1, 1] range by default.
+    - Per-game strategies are configurable; unknown games use linear scaling.
+  System:
+    - Running mean/std tracked per game for z-score normalization.
+    - evolution_callback fires on every normalization for drift monitoring.
+"""
+
+from __future__ import annotations
+
+import logging
+import math
+import time
+from typing import Any, Callable, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "integrations.lol_history.cross_game_reward_normalizer.v1"
+
+
+def _safe_div(a: float, b: float, default: float = 0.0) -> float:
+    return a / b if b != 0 else default
+
+
+class _RunningStats:
+    """Welford online mean/variance."""
+    __slots__ = ("n", "mean", "m2")
+
+    def __init__(self) -> None:
+        self.n = 0
+        self.mean = 0.0
+        self.m2 = 0.0
+
+    def update(self, x: float) -> None:
+        self.n += 1
+        delta = x - self.mean
+        self.mean += delta / self.n
+        delta2 = x - self.mean
+        self.m2 += delta * delta2
+
+    @property
+    def std(self) -> float:
+        if self.n < 2:
+            return 1.0
+        return math.sqrt(self.m2 / (self.n - 1))
+
+
+class CrossGameRewardNormalizer:
+    """Normalizes reward signals across different games.
+
+    Public API
+    ----------
+        register_game(game, strategy, config) -> dict
+        normalize(game, raw_reward) -> dict
+        normalize_batch(game, rewards) -> dict
+        get_stats() -> dict
+        reset_game(game) -> dict
+
+    Evolution
+    ---------
+    Set evolution_callback to receive structured events.
+    """
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[Dict[str, Any]], None]] = None
+        self._op_count: int = 0
+        self._games: Dict[str, Dict[str, Any]] = {}
+        self._stats: Dict[str, _RunningStats] = {}
+        self._history: List[Dict[str, Any]] = []
+
+    def _fire(self, event_type: str, data: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({"type": event_type, "key": _EVOLUTION_KEY, **data})
+
+    def register_game(self, game: str, strategy: str = "zscore",
+                      config: Dict[str, Any] = None) -> Dict[str, Any]:
+        """Register a game with normalization strategy.
+
+        Strategies: 'zscore', 'minmax', 'linear', 'tanh'
+        """
+        self._op_count += 1
+        if config is None:
+            config = {}
+        self._games[game] = {"strategy": strategy, "config": config}
+        if game not in self._stats:
+            self._stats[game] = _RunningStats()
+        self._fire("game_registered", {"game": game, "strategy": strategy})
+        return {"status": "ok", "game": game, "strategy": strategy}
+
+    def normalize(self, game: str, raw_reward: float) -> Dict[str, Any]:
+        """Normalize a single reward value."""
+        self._op_count += 1
+
+        if game not in self._stats:
+            self._stats[game] = _RunningStats()
+
+        stats = self._stats[game]
+        stats.update(raw_reward)
+
+        game_cfg = self._games.get(game, {"strategy": "linear", "config": {}})
+        strategy = game_cfg["strategy"]
+        config = game_cfg["config"]
+
+        if strategy == "zscore":
+            normalized = _safe_div(raw_reward - stats.mean, stats.std)
+        elif strategy == "minmax":
+            lo = config.get("min", -100.0)
+            hi = config.get("max", 100.0)
+            normalized = _safe_div(raw_reward - lo, hi - lo) * 2 - 1
+        elif strategy == "tanh":
+            scale = config.get("scale", 1.0)
+            normalized = math.tanh(raw_reward * scale)
+        else:  # linear
+            scale = config.get("scale", 0.01)
+            normalized = raw_reward * scale
+
+        # Clamp to [-1, 1]
+        clamped = max(-1.0, min(1.0, normalized))
+
+        self._fire("normalize_completed", {"game": game, "raw": raw_reward, "normalized": clamped})
+        return {
+            "status": "ok",
+            "game": game,
+            "raw": raw_reward,
+            "normalized": round(clamped, 6),
+            "strategy": strategy,
+            "sample_count": stats.n,
+        }
+
+    def normalize_batch(self, game: str, rewards: List[float]) -> Dict[str, Any]:
+        """Normalize a batch of rewards."""
+        self._op_count += 1
+        results = []
+        for r in rewards:
+            res = self.normalize(game, r)
+            results.append(res.get("normalized", 0.0))
+        return {
+            "status": "ok",
+            "game": game,
+            "count": len(results),
+            "normalized": results,
+        }
+
+    def get_stats(self) -> Dict[str, Any]:
+        per_game = {}
+        for game, st in self._stats.items():
+            per_game[game] = {
+                "samples": st.n,
+                "mean": round(st.mean, 4),
+                "std": round(st.std, 4),
+                "strategy": self._games.get(game, {}).get("strategy", "linear"),
+            }
+        return {"status": "ok", "total_ops": self._op_count, "games": per_game}
+
+    def reset_game(self, game: str) -> Dict[str, Any]:
+        """Reset stats for a game."""
+        self._op_count += 1
+        old_n = self._stats[game].n if game in self._stats else 0
+        self._stats[game] = _RunningStats()
+        return {"status": "ok", "game": game, "cleared_samples": old_n}
