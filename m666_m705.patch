@@ -0,0 +1,128 @@
+"""
+GameAdapterRegistry — Registry for game-specific protocol adapters with hot-swap support.
+
+Architecture (拿来主义):
+  seraphine_deep_history_pipeline.py（M604）— module registration
+  capture_to_decision_orchestrator.py（M665）— register_stage pluggable pattern
+
+Location: extensions/protocol_decoder/src/game_adapter_registry.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - register/unregister are idempotent — double-register overwrites, double-unregister is noop.
+    - list_adapters() returns metadata, not adapter instances — safe for logging.
+  System:
+    - O(1) lookup by game type via dict.
+    - Hot-swap: register over existing adapter disconnects old one first.
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "extensions.protocol_decoder.game_adapter_registry.v1"
+
+
+def _safe_div(a: float, b: float, default: float = 0.0) -> float:
+    return a / b if b != 0 else default
+
+
+class GameAdapterRegistry:
+    """Registry for cross-game protocol adapters.
+
+    Public API
+    ----------
+        register(game, adapter) -> dict
+        unregister(game) -> dict
+        get(game) -> adapter or None
+        list_adapters() -> list
+        has(game) -> bool
+        get_stats() -> dict
+
+    Evolution
+    ---------
+    Set evolution_callback to receive structured events.
+    """
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[Dict[str, Any]], None]] = None
+        self._op_count: int = 0
+        self._adapters: Dict[str, Any] = {}
+        self._register_times: Dict[str, float] = {}
+        self._lookup_count: int = 0
+        self._miss_count: int = 0
+
+    def _fire(self, event_type: str, data: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({"type": event_type, "key": _EVOLUTION_KEY, **data})
+
+    def register(self, game: str, adapter: Any) -> Dict[str, Any]:
+        """Register a protocol adapter for a game type. Overwrites if exists."""
+        self._op_count += 1
+        replaced = game in self._adapters
+        if replaced:
+            old = self._adapters[game]
+            # Attempt graceful disconnect of old adapter
+            if hasattr(old, "disconnect"):
+                try:
+                    old.disconnect()
+                except Exception:
+                    pass
+
+        self._adapters[game] = adapter
+        self._register_times[game] = time.time()
+        self._fire("adapter_registered", {"game": game, "replaced": replaced})
+        return {"status": "ok", "game": game, "replaced": replaced, "total": len(self._adapters)}
+
+    def unregister(self, game: str) -> Dict[str, Any]:
+        """Unregister a protocol adapter. Noop if not present."""
+        self._op_count += 1
+        if game not in self._adapters:
+            return {"status": "ok", "game": game, "was_registered": False}
+        old = self._adapters.pop(game)
+        self._register_times.pop(game, None)
+        if hasattr(old, "disconnect"):
+            try:
+                old.disconnect()
+            except Exception:
+                pass
+        self._fire("adapter_unregistered", {"game": game})
+        return {"status": "ok", "game": game, "was_registered": True, "remaining": len(self._adapters)}
+
+    def get(self, game: str) -> Any:
+        """Lookup adapter by game type. Returns None if not found."""
+        self._op_count += 1
+        self._lookup_count += 1
+        adapter = self._adapters.get(game)
+        if adapter is None:
+            self._miss_count += 1
+        return adapter
+
+    def has(self, game: str) -> bool:
+        return game in self._adapters
+
+    def list_adapters(self) -> List[Dict[str, Any]]:
+        """List all registered adapters with metadata."""
+        result = []
+        for game, adapter in self._adapters.items():
+            info = {"game": game, "registered_at": self._register_times.get(game)}
+            if hasattr(adapter, "get_state"):
+                info["state"] = adapter.get_state()
+            if hasattr(adapter, "_game_type"):
+                info["adapter_type"] = adapter._game_type()
+            result.append(info)
+        return result
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {
+            "total_ops": self._op_count,
+            "registered_count": len(self._adapters),
+            "lookups": self._lookup_count,
+            "misses": self._miss_count,
+            "hit_rate": round(_safe_div(self._lookup_count - self._miss_count, self._lookup_count), 4),
+            "games": list(self._adapters.keys()),
+        }
diff --git a/extensions/protocol_decoder/src/game_protocol_adapter_base.py b/extensions/protocol_decoder/src/game_protocol_adapter_base.py
new file mode 100644
index 00000000..f7e80bd4
--- /dev/null
+++ b/extensions/protocol_decoder/src/game_protocol_adapter_base.py
@@ -0,0 +1,236 @@
+"""
+GameProtocolAdapterBase — Abstract base class for cross-game protocol adapters.
+
+Architecture (拿来主义):
+  Akagi/mitm/mitm_abc.py — websocket lifecycle abstract methods
+  Akagi/mitm/bridge/bridge_base.py — parse/build interface separation
+  dual_channel_fuser.py — ingest→fuse interface decoupling
+  capture_to_decision_orchestrator.py（M665）— register_stage pluggable module pattern
+
+Location: extensions/protocol_decoder/src/game_protocol_adapter_base.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Every public method returns a dict with 'status' key — never raises on bad input.
+    - connect/disconnect lifecycle prevents double-connect or use-after-disconnect.
+  System:
+    - evolution_callback fires on every lifecycle event for system-level tracking.
+    - _state machine (DISCONNECTED→CONNECTED→DECODING→ERROR) prevents illegal transitions.
+    - Subclasses override _do_connect/_do_decode/_do_normalize/_do_disconnect hooks only.
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from abc import ABC, abstractmethod
+from collections import defaultdict
+from typing import Any, Callable, Dict, List, Optional, Tuple
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "extensions.protocol_decoder.game_protocol_adapter_base.v1"
+
+# Valid state transitions
+_VALID_TRANSITIONS = {
+    "DISCONNECTED": {"CONNECTED"},
+    "CONNECTED": {"DECODING", "DISCONNECTED", "ERROR"},
+    "DECODING": {"CONNECTED", "DISCONNECTED", "ERROR"},
+    "ERROR": {"DISCONNECTED"},
+}
+
+
+def _safe_div(a: float, b: float, default: float = 0.0) -> float:
+    return a / b if b != 0 else default
+
+
+class GameProtocolAdapterBase(ABC):
+    """Abstract base for game-specific protocol adapters.
+
+    Public API
+    ----------
+        connect(config) -> dict
+        decode(raw_packet) -> dict
+        normalize(decoded) -> dict
+        disconnect() -> dict
+        get_adapter_info() -> dict
+        get_state() -> str
+        get_stats() -> dict
+
+    Subclass hooks (override these)
+    --------------------------------
+        _do_connect(config) -> dict
+        _do_decode(raw_packet) -> dict
+        _do_normalize(decoded) -> dict
+        _do_disconnect() -> dict
+        _game_type() -> str
+
+    Evolution
+    ---------
+    Set evolution_callback to receive structured events.
+    """
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[Dict[str, Any]], None]] = None
+        self._state: str = "DISCONNECTED"
+        self._op_count: int = 0
+        self._decode_count: int = 0
+        self._error_count: int = 0
+        self._normalize_count: int = 0
+        self._connect_time: Optional[float] = None
+        self._last_decode_time: Optional[float] = None
+        self._total_decode_ms: float = 0.0
+        self._config: Dict[str, Any] = {}
+        self._history: List[Dict[str, Any]] = []
+
+    def _fire(self, event_type: str, data: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({"type": event_type, "key": _EVOLUTION_KEY, "game": self._game_type(), **data})
+
+    def _transition(self, target: str) -> bool:
+        """Attempt state transition. Returns True if valid."""
+        valid = _VALID_TRANSITIONS.get(self._state, set())
+        if target in valid:
+            old = self._state
+            self._state = target
+            self._fire("state_transition", {"from": old, "to": target})
+            return True
+        return False
+
+    # -----------------------------------------------------------------------
+    # Abstract hooks — subclasses MUST implement
+    # -----------------------------------------------------------------------
+    @abstractmethod
+    def _game_type(self) -> str:
+        """Return game identifier string, e.g. 'lol', 'dota2', 'mahjong'."""
+        ...
+
+    @abstractmethod
+    def _do_connect(self, config: Dict[str, Any]) -> Dict[str, Any]:
+        """Game-specific connection logic. Return result dict."""
+        ...
+
+    @abstractmethod
+    def _do_decode(self, raw_packet: bytes) -> Dict[str, Any]:
+        """Decode raw bytes to game-specific dict. Return decoded dict."""
+        ...
+
+    @abstractmethod
+    def _do_normalize(self, decoded: Dict[str, Any]) -> Dict[str, Any]:
+        """Normalize game-specific dict to universal schema. Return normalized dict."""
+        ...
+
+    @abstractmethod
+    def _do_disconnect(self) -> Dict[str, Any]:
+        """Game-specific disconnect logic. Return result dict."""
+        ...
+
+    # -----------------------------------------------------------------------
+    # Public API
+    # -----------------------------------------------------------------------
+    def connect(self, config: Dict[str, Any] = None) -> Dict[str, Any]:
+        """Connect to game data source."""
+        self._op_count += 1
+        if config is None:
+            config = {}
+        if self._state != "DISCONNECTED":
+            return {"status": "error", "reason": f"cannot connect from state {self._state}"}
+        _start = time.time()
+        try:
+            result = self._do_connect(config)
+            self._config = config
+            self._connect_time = time.time()
+            self._transition("CONNECTED")
+            elapsed = time.time() - _start
+            self._fire("connect_completed", {"elapsed": elapsed, "config_keys": list(config.keys())})
+            return {"status": "ok", "op": "connect", "game": self._game_type(), **result}
+        except Exception as exc:
+            self._error_count += 1
+            self._transition("ERROR")
+            return {"status": "error", "op": "connect", "reason": str(exc)}
+
+    def decode(self, raw_packet: bytes = b"") -> Dict[str, Any]:
+        """Decode a raw protocol packet."""
+        self._op_count += 1
+        if self._state not in ("CONNECTED", "DECODING"):
+            return {"status": "error", "reason": f"cannot decode in state {self._state}"}
+        _start = time.time()
+        try:
+            if self._state == "CONNECTED":
+                self._transition("DECODING")
+            result = self._do_decode(raw_packet)
+            self._decode_count += 1
+            elapsed_ms = (time.time() - _start) * 1000
+            self._total_decode_ms += elapsed_ms
+            self._last_decode_time = time.time()
+            # Return to CONNECTED after decode
+            if self._state == "DECODING":
+                self._transition("CONNECTED")
+            self._fire("decode_completed", {"elapsed_ms": elapsed_ms, "packet_size": len(raw_packet)})
+            return {"status": "ok", "op": "decode", "game": self._game_type(), "decoded": result}
+        except Exception as exc:
+            self._error_count += 1
+            self._transition("ERROR")
+            return {"status": "error", "op": "decode", "reason": str(exc)}
+
+    def normalize(self, decoded: Dict[str, Any] = None) -> Dict[str, Any]:
+        """Normalize decoded data to universal game state schema."""
+        self._op_count += 1
+        if decoded is None:
+            decoded = {}
+        _start = time.time()
+        try:
+            result = self._do_normalize(decoded)
+            self._normalize_count += 1
+            elapsed = time.time() - _start
+            self._fire("normalize_completed", {"elapsed": elapsed})
+            return {"status": "ok", "op": "normalize", "game": self._game_type(), "normalized": result}
+        except Exception as exc:
+            self._error_count += 1
+            return {"status": "error", "op": "normalize", "reason": str(exc)}
+
+    def disconnect(self) -> Dict[str, Any]:
+        """Disconnect from game data source."""
+        self._op_count += 1
+        if self._state == "DISCONNECTED":
+            return {"status": "ok", "op": "disconnect", "reason": "already disconnected"}
+        _start = time.time()
+        try:
+            result = self._do_disconnect()
+            self._transition("DISCONNECTED")
+            elapsed = time.time() - _start
+            self._fire("disconnect_completed", {"elapsed": elapsed})
+            return {"status": "ok", "op": "disconnect", "game": self._game_type(), **result}
+        except Exception as exc:
+            self._error_count += 1
+            # Force disconnect even on error
+            self._state = "DISCONNECTED"
+            return {"status": "error", "op": "disconnect", "reason": str(exc)}
+
+    def get_adapter_info(self) -> Dict[str, Any]:
+        """Return adapter metadata."""
+        return {
+            "game_type": self._game_type(),
+            "state": self._state,
+            "op_count": self._op_count,
+            "decode_count": self._decode_count,
+            "error_count": self._error_count,
+            "normalize_count": self._normalize_count,
+            "connected_since": self._connect_time,
+        }
+
+    def get_state(self) -> str:
+        return self._state
+
+    def get_stats(self) -> Dict[str, Any]:
+        avg_decode_ms = _safe_div(self._total_decode_ms, self._decode_count)
+        return {
+            "game": self._game_type(),
+            "state": self._state,
+            "total_ops": self._op_count,
+            "decodes": self._decode_count,
+            "normalizations": self._normalize_count,
+            "errors": self._error_count,
+            "avg_decode_ms": round(avg_decode_ms, 3),
+            "error_rate": round(_safe_div(self._error_count, self._op_count), 4),
+        }
