new file mode 100644
index 00000000..73a60b83
--- /dev/null
+++ b/extensions/protocol_decoder/src/protocol_adapter_test_harness.py
@@ -0,0 +1,190 @@
+"""
+ProtocolAdapterTestHarness — Standardized compatibility test suite for game adapters.
+
+Architecture (拿来主义):
+  history_regression_test_runner.py（M644）— regression test framework
+  history_data_quality_checker.py（M624）— schema validation
+
+Location: extensions/protocol_decoder/src/protocol_adapter_test_harness.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - run_all() returns detailed per-test results — easy to pinpoint failures.
+    - Generates compatibility report with pass/fail/skip counts.
+  System:
+    - Tests are registered functions — extensible without modifying harness code.
+    - Each test is isolated — one failure doesn't block others.
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+import json
+from typing import Any, Callable, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "extensions.protocol_decoder.protocol_adapter_test_harness.v1"
+
+
+def _safe_div(a: float, b: float, default: float = 0.0) -> float:
+    return a / b if b != 0 else default
+
+
+class ProtocolAdapterTestHarness:
+    """Standardized test harness for protocol adapters.
+
+    Public API
+    ----------
+        register_test(name, test_fn) -> dict
+        run_all(adapter) -> dict
+        run_test(adapter, test_name) -> dict
+        get_builtin_tests() -> list
+        generate_report(results) -> dict
+
+    Evolution
+    ---------
+    Set evolution_callback to receive structured events.
+    """
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[Dict[str, Any]], None]] = None
+        self._op_count: int = 0
+        self._tests: Dict[str, Callable] = {}
+        self._run_count: int = 0
+        self._pass_count: int = 0
+        self._fail_count: int = 0
+
+        # Register built-in tests
+        self._register_builtins()
+
+    def _fire(self, event_type: str, data: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({"type": event_type, "key": _EVOLUTION_KEY, **data})
+
+    def _register_builtins(self) -> None:
+        """Register built-in compatibility tests."""
+        self._tests["test_has_required_methods"] = self._test_has_required_methods
+        self._tests["test_connect_disconnect_lifecycle"] = self._test_connect_disconnect
+        self._tests["test_decode_empty_packet"] = self._test_decode_empty
+        self._tests["test_decode_invalid_json"] = self._test_decode_invalid
+        self._tests["test_normalize_empty"] = self._test_normalize_empty
+        self._tests["test_state_after_connect"] = self._test_state_after_connect
+        self._tests["test_double_connect_rejected"] = self._test_double_connect
+        self._tests["test_decode_before_connect"] = self._test_decode_before_connect
+        self._tests["test_get_stats"] = self._test_get_stats
+        self._tests["test_adapter_info"] = self._test_adapter_info
+
+    def register_test(self, name: str, test_fn: Callable) -> Dict[str, Any]:
+        self._op_count += 1
+        self._tests[name] = test_fn
+        return {"status": "ok", "test": name, "total_tests": len(self._tests)}
+
+    def run_all(self, adapter: Any) -> Dict[str, Any]:
+        """Run all tests against an adapter."""
+        self._op_count += 1
+        results = []
+        for name, fn in self._tests.items():
+            result = self._run_single(adapter, name, fn)
+            results.append(result)
+        return self.generate_report(results)
+
+    def run_test(self, adapter: Any, test_name: str) -> Dict[str, Any]:
+        self._op_count += 1
+        fn = self._tests.get(test_name)
+        if fn is None:
+            return {"status": "error", "reason": f"test not found: {test_name}"}
+        return self._run_single(adapter, test_name, fn)
+
+    def _run_single(self, adapter: Any, name: str, fn: Callable) -> Dict[str, Any]:
+        self._run_count += 1
+        _start = time.time()
+        try:
+            fn(adapter)
+            elapsed = time.time() - _start
+            self._pass_count += 1
+            return {"test": name, "result": "pass", "elapsed_ms": round(elapsed * 1000, 2)}
+        except AssertionError as e:
+            elapsed = time.time() - _start
+            self._fail_count += 1
+            return {"test": name, "result": "fail", "reason": str(e), "elapsed_ms": round(elapsed * 1000, 2)}
+        except Exception as e:
+            elapsed = time.time() - _start
+            self._fail_count += 1
+            return {"test": name, "result": "error", "reason": str(e), "elapsed_ms": round(elapsed * 1000, 2)}
+
+    def generate_report(self, results: List[Dict[str, Any]]) -> Dict[str, Any]:
+        passed = sum(1 for r in results if r["result"] == "pass")
+        failed = sum(1 for r in results if r["result"] in ("fail", "error"))
+        total = len(results)
+        return {
+            "status": "ok",
+            "total": total,
+            "passed": passed,
+            "failed": failed,
+            "pass_rate": round(_safe_div(passed, total), 4),
+            "compatible": failed == 0,
+            "results": results,
+        }
+
+    def get_builtin_tests(self) -> List[str]:
+        return list(self._tests.keys())
+
+    # -----------------------------------------------------------------------
+    # Built-in tests
+    # -----------------------------------------------------------------------
+    def _test_has_required_methods(self, adapter: Any) -> None:
+        for method in ("connect", "decode", "normalize", "disconnect", "get_state", "get_stats"):
+            assert hasattr(adapter, method), f"missing method: {method}"
+
+    def _test_connect_disconnect(self, adapter: Any) -> None:
+        r = adapter.connect({})
+        assert r.get("status") == "ok", f"connect failed: {r}"
+        r = adapter.disconnect()
+        assert r.get("status") == "ok", f"disconnect failed: {r}"
+
+    def _test_decode_empty(self, adapter: Any) -> None:
+        adapter.connect({})
+        r = adapter.decode(b"")
+        assert r.get("status") != "crash", f"empty decode crashed: {r}"
+        adapter.disconnect()
+
+    def _test_decode_invalid(self, adapter: Any) -> None:
+        adapter.connect({})
+        r = adapter.decode(b"not valid json {{{{")
+        assert "error" in str(r) or r.get("status") in ("ok", "error"), f"invalid decode: {r}"
+        adapter.disconnect()
+
+    def _test_normalize_empty(self, adapter: Any) -> None:
+        r = adapter.normalize({})
+        assert r.get("status") in ("ok", "error"), f"normalize empty failed: {r}"
+
+    def _test_state_after_connect(self, adapter: Any) -> None:
+        adapter.connect({})
+        state = adapter.get_state()
+        assert state == "CONNECTED", f"expected CONNECTED, got {state}"
+        adapter.disconnect()
+
+    def _test_double_connect(self, adapter: Any) -> None:
+        adapter.connect({})
+        r = adapter.connect({})
+        assert r.get("status") == "error", "double connect should fail"
+        adapter.disconnect()
+
+    def _test_decode_before_connect(self, adapter: Any) -> None:
+        # Ensure adapter is disconnected first
+        if hasattr(adapter, "get_state") and adapter.get_state() != "DISCONNECTED":
+            adapter.disconnect()
+        r = adapter.decode(b'{"test": true}')
+        assert r.get("status") == "error", "decode before connect should fail"
+
+    def _test_get_stats(self, adapter: Any) -> None:
+        stats = adapter.get_stats()
+        assert isinstance(stats, dict), "get_stats must return dict"
+
+    def _test_adapter_info(self, adapter: Any) -> None:
+        if hasattr(adapter, "get_adapter_info"):
+            info = adapter.get_adapter_info()
+            assert isinstance(info, dict), "get_adapter_info must return dict"
+            assert "game_type" in info, "adapter_info must include game_type"
diff --git a/extensions/protocol_decoder/src/universal_game_state_schema.py b/extensions/protocol_decoder/src/universal_game_state_schema.py
new file mode 100644
index 00000000..95df0cb1
--- /dev/null
+++ b/extensions/protocol_decoder/src/universal_game_state_schema.py
@@ -0,0 +1,199 @@
+"""
+UniversalGameStateSchema — Cross-game unified game state schema definition and validation.
+
+Architecture (拿来主义):
+  protocol_feature_bridge.py（M656）— register_feature pattern
+  historical_feature_vector_builder.py（M602）— FeatureSpec schema-based field definition
+
+Location: extensions/protocol_decoder/src/universal_game_state_schema.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - validate() returns detailed per-field errors — never throws on bad data.
+    - Schema versioning allows gradual migration without breaking consumers.
+  System:
+    - Field registry is O(1) lookup. Type checking uses isinstance, not string comparison.
+    - Game-specific field mappings are registered, not hardcoded.
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Dict, List, Optional, Set, Tuple, Type
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "extensions.protocol_decoder.universal_game_state_schema.v1"
+
+# Core schema fields every game must provide
+_CORE_FIELDS = {
+    "game_type": str,
+    "source_endpoint": str,
+    "timestamp": (int, float),
+    "players": list,
+    "active_player": dict,
+    "game_time": (int, float),
+    "events": list,
+    "map_state": dict,
+    "resources": dict,
+}
+
+
+def _safe_div(a: float, b: float, default: float = 0.0) -> float:
+    return a / b if b != 0 else default
+
+
+class FieldSpec:
+    """Schema field specification."""
+    __slots__ = ("name", "expected_type", "required", "default", "description")
+
+    def __init__(self, name: str, expected_type: Any, required: bool = True,
+                 default: Any = None, description: str = "") -> None:
+        self.name = name
+        self.expected_type = expected_type
+        self.required = required
+        self.default = default
+        self.description = description
+
+
+class UniversalGameStateSchema:
+    """Cross-game unified game state schema.
+
+    Public API
+    ----------
+        register_field(spec) -> dict
+        register_game_mapping(game, field_map) -> dict
+        validate(state) -> dict
+        get_defaults() -> dict
+        get_schema_info() -> dict
+        get_field_names() -> list
+        get_version() -> str
+
+    Evolution
+    ---------
+    Set evolution_callback to receive structured events.
+    """
+
+    SCHEMA_VERSION: str = "1.0.0"
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[Dict[str, Any]], None]] = None
+        self._op_count: int = 0
+        self._fields: Dict[str, FieldSpec] = {}
+        self._game_mappings: Dict[str, Dict[str, str]] = {}
+        self._validation_count: int = 0
+        self._validation_errors: int = 0
+
+        # Register core fields
+        for name, typ in _CORE_FIELDS.items():
+            self._fields[name] = FieldSpec(name, typ, required=True, default=None,
+                                           description=f"Core field: {name}")
+
+    def _fire(self, event_type: str, data: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({"type": event_type, "key": _EVOLUTION_KEY, **data})
+
+    def register_field(self, spec: FieldSpec = None, **kwargs: Any) -> Dict[str, Any]:
+        """Register a new field in the schema."""
+        self._op_count += 1
+        if spec is None:
+            if "name" not in kwargs:
+                return {"status": "error", "reason": "name required"}
+            spec = FieldSpec(
+                name=kwargs["name"],
+                expected_type=kwargs.get("expected_type", str),
+                required=kwargs.get("required", False),
+                default=kwargs.get("default", None),
+                description=kwargs.get("description", ""),
+            )
+        self._fields[spec.name] = spec
+        self._fire("field_registered", {"field": spec.name})
+        return {"status": "ok", "field": spec.name, "total_fields": len(self._fields)}
+
+    def register_game_mapping(self, game: str, field_map: Dict[str, str]) -> Dict[str, Any]:
+        """Register game-specific field name mapping to universal schema.
+
+        field_map: {universal_field_name: game_specific_field_name}
+        """
+        self._op_count += 1
+        self._game_mappings[game] = field_map
+        self._fire("game_mapping_registered", {"game": game, "fields": len(field_map)})
+        return {"status": "ok", "game": game, "mapped_fields": len(field_map)}
+
+    def validate(self, state: Dict[str, Any] = None) -> Dict[str, Any]:
+        """Validate a game state dict against the schema."""
+        self._op_count += 1
+        self._validation_count += 1
+
+        if state is None:
+            state = {}
+
+        errors: List[Dict[str, str]] = []
+        warnings: List[str] = []
+        present: Set[str] = set()
+
+        for name, spec in self._fields.items():
+            if name in state:
+                present.add(name)
+                val = state[name]
+                expected = spec.expected_type
+                if isinstance(expected, tuple):
+                    if not isinstance(val, expected):
+                        errors.append({
+                            "field": name,
+                            "error": f"expected {expected}, got {type(val).__name__}",
+                        })
+                elif not isinstance(val, expected):
+                    errors.append({
+                        "field": name,
+                        "error": f"expected {expected.__name__}, got {type(val).__name__}",
+                    })
+            elif spec.required:
+                errors.append({"field": name, "error": "missing required field"})
+
+        # Check for unknown fields
+        known = set(self._fields.keys())
+        unknown = set(state.keys()) - known
+        if unknown:
+            warnings.append(f"unknown fields: {unknown}")
+
+        coverage = _safe_div(len(present), len(self._fields))
+        valid = len(errors) == 0
+
+        if not valid:
+            self._validation_errors += 1
+
+        result = {
+            "status": "valid" if valid else "invalid",
+            "errors": errors,
+            "warnings": warnings,
+            "coverage": round(coverage, 4),
+            "present_fields": len(present),
+            "total_fields": len(self._fields),
+        }
+        self._fire("validation_completed", {"valid": valid, "error_count": len(errors)})
+        return result
+
+    def get_defaults(self) -> Dict[str, Any]:
+        """Return a dict with all fields set to their defaults."""
+        return {
+            name: spec.default for name, spec in self._fields.items()
+        }
+
+    def get_field_names(self) -> List[str]:
+        return list(self._fields.keys())
+
+    def get_schema_info(self) -> Dict[str, Any]:
+        return {
+            "version": self.SCHEMA_VERSION,
+            "total_fields": len(self._fields),
+            "required_fields": sum(1 for s in self._fields.values() if s.required),
+            "optional_fields": sum(1 for s in self._fields.values() if not s.required),
+            "registered_games": list(self._game_mappings.keys()),
+            "validations": self._validation_count,
+            "validation_errors": self._validation_errors,
+        }
+
+    def get_version(self) -> str:
+        return self.SCHEMA_VERSION
diff --git a/integrations/lol-history/src/lol_history/action_executor_bridge.py b/integrations/lol-history/src/lol_history/action_executor_bridge.py
