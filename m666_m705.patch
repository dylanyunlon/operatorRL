+"""
+TimingWindowScheduler — Schedules time-sensitive action windows.
+
+Architecture (拿来主义):
+  ban_pick_realtime_advisor.py（M637）— realtime scheduling
+  DI-star/distar/agent/default/agent.py — _get_time_factor
+
+Location: integrations/lol-history/src/lol_history/timing_window_scheduler.py
+"""
+from __future__ import annotations
+import logging, time
+from typing import Any, Callable, Dict, List, Optional
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.timing_window_scheduler.v1"
+
+class TimingWindowScheduler:
+    """Schedules time-sensitive windows (dragon spawn, ult CD, wave arrival).
+
+    Public API: register_window, check_windows, get_upcoming, get_utilization, get_stats
+    """
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._windows: List[Dict] = []
+        self._utilized = 0
+        self._missed = 0
+        self._check_count = 0
+
+    def _fire(self, et, data):
+        if self.evolution_callback: self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def register_window(self, name: str, opens_at: float, closes_at: float,
+                        priority: str = "medium", meta: Dict = None) -> Dict[str, Any]:
+        self._op_count += 1
+        window = {"name": name, "opens_at": opens_at, "closes_at": closes_at,
+                  "priority": priority, "meta": meta or {}, "status": "pending"}
+        self._windows.append(window)
+        return {"status": "ok", "window": name, "total_windows": len(self._windows)}
+
+    def check_windows(self, game_time: float) -> Dict[str, Any]:
+        self._op_count += 1
+        self._check_count += 1
+        active = []
+        upcoming = []
+        expired = []
+        for w in self._windows:
+            if w["status"] == "utilized": continue
+            if game_time >= w["closes_at"]:
+                if w["status"] != "expired":
+                    w["status"] = "expired"
+                    self._missed += 1
+                expired.append(w)
+            elif game_time >= w["opens_at"]:
+                w["status"] = "active"
+                active.append(w)
+            else:
+                eta = w["opens_at"] - game_time
+                if eta < 30:
+                    upcoming.append({**w, "eta_s": round(eta, 1)})
+        self._fire("windows_checked", {"active": len(active), "upcoming": len(upcoming)})
+        return {"status": "ok", "active": active, "upcoming": upcoming, "expired_count": len(expired)}
+
+    def mark_utilized(self, name: str) -> Dict[str, Any]:
+        self._op_count += 1
+        for w in self._windows:
+            if w["name"] == name and w["status"] == "active":
+                w["status"] = "utilized"
+                self._utilized += 1
+                return {"status": "ok", "window": name}
+        return {"status": "error", "reason": f"window '{name}' not active"}
+
+    def get_upcoming(self, game_time: float, horizon_s: float = 60) -> List[Dict]:
+        return [w for w in self._windows
+                if w["status"] == "pending" and w["opens_at"] - game_time < horizon_s and w["opens_at"] > game_time]
+
+    def get_utilization(self) -> Dict[str, Any]:
+        total = self._utilized + self._missed
+        return {"utilized": self._utilized, "missed": self._missed,
+                "rate": round(self._utilized / max(total, 1), 3)}
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {"total_windows": len(self._windows), "utilized": self._utilized,
+                "missed": self._missed, "checks": self._check_count, "total_ops": self._op_count}
diff --git a/integrations/lol-history/src/lol_history/transfer_learning_feature_aligner.py b/integrations/lol-history/src/lol_history/transfer_learning_feature_aligner.py
new file mode 100644
index 00000000..15ff8d8c
--- /dev/null
+++ b/integrations/lol-history/src/lol_history/transfer_learning_feature_aligner.py
@@ -0,0 +1,199 @@
+"""
+TransferLearningFeatureAligner — Aligns feature spaces between source and target games.
+
+Architecture (拿来主义):
+  protocol_feature_bridge.py（M656）— feature extraction registration
+  universal_game_state_schema.py（M670）— cross-game schema
+
+Location: integrations/lol-history/src/lol_history/transfer_learning_feature_aligner.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - align() returns similarity scores so users can judge transfer quality.
+    - Features with no alignment get zero weight — never silently corrupts vectors.
+  System:
+    - Cosine similarity for feature matching uses only stdlib math — no numpy needed.
+    - Alignment cache prevents recomputation on repeated source→target pairs.
+"""
+
+from __future__ import annotations
+
+import logging
+import math
+import time
+from typing import Any, Callable, Dict, List, Optional, Tuple
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "integrations.lol_history.transfer_learning_feature_aligner.v1"
+
+
+def _safe_div(a: float, b: float, default: float = 0.0) -> float:
+    return a / b if b != 0 else default
+
+
+def _cosine_sim(a: List[float], b: List[float]) -> float:
+    """Cosine similarity between two vectors (stdlib only)."""
+    if len(a) != len(b) or not a:
+        return 0.0
+    dot = sum(x * y for x, y in zip(a, b))
+    norm_a = math.sqrt(sum(x * x for x in a))
+    norm_b = math.sqrt(sum(x * x for x in b))
+    denom = norm_a * norm_b
+    return dot / denom if denom > 0 else 0.0
+
+
+class TransferLearningFeatureAligner:
+    """Aligns feature spaces for cross-game transfer learning.
+
+    Public API
+    ----------
+        register_features(game, features) -> dict
+        compute_alignment(source, target) -> dict
+        align_vector(source, target, vector) -> dict
+        get_transferable_features(source, target, threshold) -> dict
+        get_stats() -> dict
+
+    Evolution
+    ---------
+    Set evolution_callback to receive structured events.
+    """
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[Dict[str, Any]], None]] = None
+        self._op_count: int = 0
+        self._game_features: Dict[str, Dict[str, Dict[str, Any]]] = {}
+        self._alignment_cache: Dict[str, Dict[str, float]] = {}
+        self._align_count: int = 0
+
+    def _fire(self, event_type: str, data: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({"type": event_type, "key": _EVOLUTION_KEY, **data})
+
+    def register_features(self, game: str,
+                          features: Dict[str, Dict[str, Any]]) -> Dict[str, Any]:
+        """Register feature definitions for a game.
+
+        features: {feature_name: {dim: int, semantic_tag: str, range: [lo, hi]}}
+        """
+        self._op_count += 1
+        self._game_features[game] = features
+        # Invalidate alignment cache involving this game
+        keys_to_drop = [k for k in self._alignment_cache if game in k]
+        for k in keys_to_drop:
+            del self._alignment_cache[k]
+        self._fire("features_registered", {"game": game, "count": len(features)})
+        return {"status": "ok", "game": game, "features": len(features)}
+
+    def compute_alignment(self, source: str, target: str) -> Dict[str, Any]:
+        """Compute feature alignment between source and target games."""
+        self._op_count += 1
+        self._align_count += 1
+        cache_key = f"{source}→{target}"
+
+        if cache_key in self._alignment_cache:
+            return {"status": "ok", "source": source, "target": target,
+                    "alignment": self._alignment_cache[cache_key], "cached": True}
+
+        src_feats = self._game_features.get(source, {})
+        tgt_feats = self._game_features.get(target, {})
+
+        if not src_feats or not tgt_feats:
+            return {"status": "error", "reason": "source or target features not registered"}
+
+        alignment: Dict[str, float] = {}
+
+        for sf_name, sf_spec in src_feats.items():
+            best_score = 0.0
+            best_match = ""
+            src_tag = sf_spec.get("semantic_tag", "")
+
+            for tf_name, tf_spec in tgt_feats.items():
+                tgt_tag = tf_spec.get("semantic_tag", "")
+                # Semantic similarity: exact tag match = 1.0, partial = 0.5
+                if src_tag and tgt_tag:
+                    if src_tag == tgt_tag:
+                        score = 1.0
+                    elif src_tag in tgt_tag or tgt_tag in src_tag:
+                        score = 0.5
+                    else:
+                        score = 0.0
+                else:
+                    # Name-based fuzzy match
+                    common = set(sf_name.lower().split("_")) & set(tf_name.lower().split("_"))
+                    total = set(sf_name.lower().split("_")) | set(tf_name.lower().split("_"))
+                    score = _safe_div(len(common), len(total))
+
+                # Dimension compatibility bonus
+                if sf_spec.get("dim", 1) == tf_spec.get("dim", 1):
+                    score = min(1.0, score + 0.1)
+
+                if score > best_score:
+                    best_score = score
+                    best_match = tf_name
+
+            alignment[sf_name] = round(best_score, 4)
+
+        self._alignment_cache[cache_key] = alignment
+        avg_score = _safe_div(sum(alignment.values()), len(alignment))
+
+        self._fire("alignment_computed", {"source": source, "target": target, "avg": avg_score})
+        return {
+            "status": "ok",
+            "source": source,
+            "target": target,
+            "alignment": alignment,
+            "avg_similarity": round(avg_score, 4),
+            "cached": False,
+        }
+
+    def align_vector(self, source: str, target: str,
+                     vector: Dict[str, float]) -> Dict[str, Any]:
+        """Align a feature vector from source game space to target game space."""
+        self._op_count += 1
+        alignment_result = self.compute_alignment(source, target)
+        if alignment_result["status"] != "ok":
+            return alignment_result
+
+        alignment = alignment_result["alignment"]
+        aligned = {}
+        for feat_name, value in vector.items():
+            weight = alignment.get(feat_name, 0.0)
+            aligned[feat_name] = round(value * weight, 6)
+
+        return {
+            "status": "ok",
+            "source": source,
+            "target": target,
+            "original_dim": len(vector),
+            "aligned_dim": len(aligned),
+            "aligned_vector": aligned,
+        }
+
+    def get_transferable_features(self, source: str, target: str,
+                                  threshold: float = 0.5) -> Dict[str, Any]:
+        """Get features with alignment score above threshold."""
+        self._op_count += 1
+        alignment_result = self.compute_alignment(source, target)
+        if alignment_result["status"] != "ok":
+            return alignment_result
+
+        alignment = alignment_result["alignment"]
+        transferable = {k: v for k, v in alignment.items() if v >= threshold}
+        non_transferable = {k: v for k, v in alignment.items() if v < threshold}
+
+        return {
+            "status": "ok",
+            "transferable": transferable,
+            "non_transferable": non_transferable,
+            "transfer_ratio": round(_safe_div(len(transferable), len(alignment)), 4),
+        }
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {
+            "total_ops": self._op_count,
+            "alignments_computed": self._align_count,
+            "registered_games": list(self._game_features.keys()),
+            "cache_size": len(self._alignment_cache),
+            "features_per_game": {g: len(f) for g, f in self._game_features.items()},
+        }
