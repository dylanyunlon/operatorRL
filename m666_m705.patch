+"""
+LolProtocolAdapter — LoL-specific protocol adapter implementing GameProtocolAdapterBase.
+
+Architecture (拿来主义):
+  fiddler_lol_decoder.py — endpoint dispatch + O(1) dict mapping
+  game_protocol_adapter_base.py（M666）— unified adapter interface
+  live_client_data_poller.py — Riot Live Client Data API patterns
+
+Location: extensions/protocol_decoder/src/lol_protocol_adapter.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Gracefully handles missing/malformed JSON — returns error dict, never crashes.
+    - Unknown endpoints are passthrough decoded — forward compatible with Riot API changes.
+  System:
+    - _ENDPOINT_MAP provides O(1) dispatch — no if/elif chains.
+    - Normalization maps LoL-specific fields to universal schema fields.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import time
+from typing import Any, Callable, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+# Import base class from same package
+try:
+    from .game_protocol_adapter_base import GameProtocolAdapterBase
+except ImportError:
+    from game_protocol_adapter_base import GameProtocolAdapterBase
+
+_EVOLUTION_KEY: str = "extensions.protocol_decoder.lol_protocol_adapter.v1"
+
+# LoL Live Client Data API known endpoints
+_LOL_ENDPOINTS = {
+    "allgamedata", "playerlist", "activeplayer", "eventdata",
+    "gamestats", "playerscores", "playeritems",
+    "activeplayerabilities", "activeplayerrunes",
+}
+
+
+def _safe_div(a: float, b: float, default: float = 0.0) -> float:
+    return a / b if b != 0 else default
+
+
+def _extract_endpoint(url: str) -> str:
+    """Extract endpoint name from URL path. E.g. '/liveclientdata/allgamedata' -> 'allgamedata'."""
+    parts = url.rstrip("/").split("/")
+    return parts[-1].lower() if parts else "unknown"
+
+
+class LolProtocolAdapter(GameProtocolAdapterBase):
+    """LoL protocol adapter — Live Client Data API + Fiddler capture.
+
+    Public API (inherited + extensions)
+    ----------
+        connect(config) -> dict
+        decode(raw_packet) -> dict
+        normalize(decoded) -> dict
+        disconnect() -> dict
+        get_endpoint_stats() -> dict
+
+    Evolution
+    ---------
+    Set evolution_callback to receive structured events.
+    """
+
+    def __init__(self) -> None:
+        super().__init__()
+        self._endpoint_hits: Dict[str, int] = {}
+        self._api_base: str = "https://127.0.0.1:2999/liveclientdata"
+        self._decoder_map: Dict[str, Callable] = {
+            "allgamedata": self._decode_allgamedata,
+            "playerlist": self._decode_playerlist,
+            "activeplayer": self._decode_activeplayer,
+            "eventdata": self._decode_eventdata,
+            "gamestats": self._decode_gamestats,
+        }
+
+    def _game_type(self) -> str:
+        return "lol"
+
+    def _do_connect(self, config: Dict[str, Any]) -> Dict[str, Any]:
+        self._api_base = config.get("api_base", self._api_base)
+        self._endpoint_hits.clear()
+        return {"api_base": self._api_base, "endpoints": list(_LOL_ENDPOINTS)}
+
+    def _do_decode(self, raw_packet: bytes) -> Dict[str, Any]:
+        """Decode raw packet. Expects JSON with 'url' and 'body' keys, or raw JSON body."""
+        if not raw_packet:
+            return {"endpoint": "unknown", "data": {}, "warning": "empty_packet"}
+
+        try:
+            text = raw_packet.decode("utf-8", errors="replace")
+        except Exception:
+            return {"endpoint": "unknown", "data": {}, "error": "decode_failed"}
+
+        try:
+            packet = json.loads(text)
+        except json.JSONDecodeError:
+            return {"endpoint": "unknown", "data": {}, "error": "invalid_json", "raw_preview": text[:200]}
+
+        # Extract endpoint from URL if present
+        url = packet.get("url", packet.get("endpoint", ""))
+        endpoint = _extract_endpoint(url) if url else "unknown"
+        body = packet.get("body", packet.get("data", packet))
+
+        if isinstance(body, str):
+            try:
+                body = json.loads(body)
+            except json.JSONDecodeError:
+                body = {"raw": body}
+
+        # Track endpoint hit
+        self._endpoint_hits[endpoint] = self._endpoint_hits.get(endpoint, 0) + 1
+
+        # Dispatch to endpoint-specific decoder
+        decoder = self._decoder_map.get(endpoint)
+        if decoder is not None:
+            decoded = decoder(body)
+        else:
+            decoded = body  # passthrough for unknown endpoints
+
+        return {"endpoint": endpoint, "data": decoded, "timestamp": time.time()}
+
+    def _do_normalize(self, decoded: Dict[str, Any]) -> Dict[str, Any]:
+        """Normalize LoL-specific decoded data to universal game state schema."""
+        data = decoded.get("data", decoded)
+        endpoint = decoded.get("endpoint", "unknown")
+
+        normalized = {
+            "game_type": "lol",
+            "source_endpoint": endpoint,
+            "timestamp": decoded.get("timestamp", time.time()),
+            "players": [],
+            "active_player": {},
+            "game_time": 0.0,
+            "events": [],
+            "map_state": {},
+            "resources": {},
+        }
+
+        if endpoint == "allgamedata":
+            normalized["game_time"] = data.get("game_time", 0.0)
+            normalized["players"] = data.get("players", [])
+            normalized["active_player"] = data.get("active_player", {})
+            normalized["events"] = data.get("events", [])
+            normalized["map_state"] = {"game_mode": data.get("game_mode", "unknown")}
+        elif endpoint == "playerlist":
+            normalized["players"] = data.get("players", [])
+        elif endpoint == "activeplayer":
+            normalized["active_player"] = data
+        elif endpoint == "eventdata":
+            normalized["events"] = data.get("events", [])
+        elif endpoint == "gamestats":
+            normalized["game_time"] = data.get("game_time", 0.0)
+            normalized["map_state"] = data
+
+        return normalized
+
+    def _do_disconnect(self) -> Dict[str, Any]:
+        stats = dict(self._endpoint_hits)
+        self._endpoint_hits.clear()
+        return {"endpoint_stats": stats}
+
+    # -----------------------------------------------------------------------
+    # Endpoint-specific decoders (mirrors fiddler_lol_decoder.py pattern)
+    # -----------------------------------------------------------------------
+    def _decode_allgamedata(self, body: Dict[str, Any]) -> Dict[str, Any]:
+        game_data = body.get("gameData", {})
+        all_players = body.get("allPlayers", [])
+        active = body.get("activePlayer", {})
+        events = body.get("events", body.get("Events", {}).get("Events", []))
+        game_time = game_data.get("gameTime", 0.0)
+
+        players = []
+        for p in all_players:
+            players.append({
+                "summoner": p.get("summonerName", p.get("riotIdGameName", "")),
+                "champion": p.get("championName", ""),
+                "level": p.get("level", 0),
+                "team": p.get("team", ""),
+                "is_dead": p.get("isDead", False),
+                "scores": p.get("scores", {}),
+            })
+
+        return {
+            "game_time": game_time,
+            "game_mode": game_data.get("gameMode", ""),
+            "map_name": game_data.get("mapName", ""),
+            "players": players,
+            "active_player": {
+                "summoner": active.get("summonerName", ""),
+                "level": active.get("level", 0),
+                "gold": active.get("currentGold", 0.0),
+            },
+            "events": events if isinstance(events, list) else [],
+        }
+
+    def _decode_playerlist(self, body: Any) -> Dict[str, Any]:
+        if isinstance(body, list):
+            players = [{"summoner": p.get("summonerName", ""), "champion": p.get("championName", "")} for p in body]
+        else:
+            players = []
+        return {"players": players}
+
+    def _decode_activeplayer(self, body: Dict[str, Any]) -> Dict[str, Any]:
+        return {
+            "summoner": body.get("summonerName", ""),
+            "level": body.get("level", 0),
+            "gold": body.get("currentGold", 0.0),
+            "abilities": body.get("abilities", {}),
+        }
+
+    def _decode_eventdata(self, body: Any) -> Dict[str, Any]:
+        if isinstance(body, dict):
+            events = body.get("Events", [])
+        elif isinstance(body, list):
+            events = body
+        else:
+            events = []
+        return {"events": events}
+
+    def _decode_gamestats(self, body: Dict[str, Any]) -> Dict[str, Any]:
+        return {
+            "game_time": body.get("gameTime", 0.0),
+            "game_mode": body.get("gameMode", ""),
+            "map_name": body.get("mapName", ""),
+            "map_number": body.get("mapNumber", 0),
+        }
+
+    def get_endpoint_stats(self) -> Dict[str, Any]:
+        """Return per-endpoint hit counts."""
+        total = sum(self._endpoint_hits.values())
+        return {
+            "endpoint_hits": dict(self._endpoint_hits),
+            "total_decodes": total,
+            "known_endpoint_ratio": round(
+                _safe_div(
+                    sum(v for k, v in self._endpoint_hits.items() if k in _LOL_ENDPOINTS),
+                    total,
+                ), 4
+            ),
+        }
