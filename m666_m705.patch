@@ -0,0 +1,165 @@
+"""
+CrossGameTelemetryAggregator — Aggregates telemetry data from multiple game adapters.
+
+Architecture (拿来主义):
+  e2e_inference_telemetry_exporter.py（M664）— telemetry export
+  history_telemetry_dashboard.py（M643）— telemetry aggregation
+
+Location: extensions/protocol_decoder/src/cross_game_telemetry_aggregator.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - get_dashboard() returns unified view across all games — single API for monitoring.
+    - Per-game filtering available via get_game_telemetry().
+  System:
+    - Ring buffer per game prevents unbounded memory growth.
+    - Aggregation uses streaming stats — no full-data retention needed for averages.
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from collections import deque
+from typing import Any, Callable, Dict, Deque, List, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "extensions.protocol_decoder.cross_game_telemetry_aggregator.v1"
+
+_DEFAULT_BUFFER_SIZE = 1000
+
+
+def _safe_div(a: float, b: float, default: float = 0.0) -> float:
+    return a / b if b != 0 else default
+
+
+class CrossGameTelemetryAggregator:
+    """Aggregates telemetry from multiple game adapters.
+
+    Public API
+    ----------
+        ingest(game, metrics) -> dict
+        get_dashboard() -> dict
+        get_game_telemetry(game) -> dict
+        export_json() -> str
+        export_prometheus() -> str
+        reset(game) -> dict
+        get_stats() -> dict
+
+    Evolution
+    ---------
+    Set evolution_callback to receive structured events.
+    """
+
+    def __init__(self, buffer_size: int = _DEFAULT_BUFFER_SIZE) -> None:
+        self.evolution_callback: Optional[Callable[[Dict[str, Any]], None]] = None
+        self._op_count: int = 0
+        self._buffer_size = buffer_size
+        self._buffers: Dict[str, Deque[Dict[str, Any]]] = {}
+        self._totals: Dict[str, Dict[str, float]] = {}
+        self._counts: Dict[str, Dict[str, int]] = {}
+        self._ingest_count: int = 0
+
+    def _fire(self, event_type: str, data: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({"type": event_type, "key": _EVOLUTION_KEY, **data})
+
+    def ingest(self, game: str, metrics: Dict[str, float]) -> Dict[str, Any]:
+        """Ingest a telemetry data point for a game."""
+        self._op_count += 1
+        self._ingest_count += 1
+
+        if game not in self._buffers:
+            self._buffers[game] = deque(maxlen=self._buffer_size)
+            self._totals[game] = {}
+            self._counts[game] = {}
+
+        entry = {"timestamp": time.time(), **metrics}
+        self._buffers[game].append(entry)
+
+        for k, v in metrics.items():
+            self._totals[game][k] = self._totals[game].get(k, 0.0) + v
+            self._counts[game][k] = self._counts[game].get(k, 0) + 1
+
+        self._fire("telemetry_ingested", {"game": game, "metrics": len(metrics)})
+        return {"status": "ok", "game": game, "buffer_size": len(self._buffers[game])}
+
+    def get_dashboard(self) -> Dict[str, Any]:
+        """Get unified telemetry dashboard across all games."""
+        self._op_count += 1
+        dashboard = {}
+        for game in self._buffers:
+            dashboard[game] = self._compute_summary(game)
+        return {"status": "ok", "games": list(self._buffers.keys()), "dashboard": dashboard}
+
+    def get_game_telemetry(self, game: str) -> Dict[str, Any]:
+        self._op_count += 1
+        if game not in self._buffers:
+            return {"status": "error", "reason": f"no telemetry for game '{game}'"}
+        return {"status": "ok", "game": game, "summary": self._compute_summary(game)}
+
+    def _compute_summary(self, game: str) -> Dict[str, Any]:
+        totals = self._totals.get(game, {})
+        counts = self._counts.get(game, {})
+        buf = self._buffers.get(game, deque())
+
+        averages = {}
+        for k in totals:
+            averages[k] = round(_safe_div(totals[k], counts.get(k, 1)), 4)
+
+        # Recent window (last 100 entries)
+        recent = list(buf)[-100:]
+        recent_avgs = {}
+        if recent:
+            for k in totals:
+                vals = [e.get(k, 0) for e in recent if k in e]
+                if vals:
+                    recent_avgs[k] = round(sum(vals) / len(vals), 4)
+
+        return {
+            "total_points": len(buf),
+            "all_time_averages": averages,
+            "recent_averages": recent_avgs,
+            "metrics": list(totals.keys()),
+        }
+
+    def export_json(self) -> str:
+        """Export dashboard as JSON string."""
+        import json
+        self._op_count += 1
+        dashboard = self.get_dashboard()
+        return json.dumps(dashboard, default=str)
+
+    def export_prometheus(self) -> str:
+        """Export metrics in Prometheus exposition format."""
+        self._op_count += 1
+        lines = []
+        for game, totals in self._totals.items():
+            counts = self._counts.get(game, {})
+            for metric, total in totals.items():
+                safe_metric = metric.replace(".", "_").replace("-", "_")
+                avg = _safe_div(total, counts.get(metric, 1))
+                lines.append(f'operatorrl_{safe_metric}{{game="{game}"}} {avg:.4f}')
+        return "\n".join(lines)
+
+    def reset(self, game: str = None) -> Dict[str, Any]:
+        """Reset telemetry. If game specified, reset only that game."""
+        self._op_count += 1
+        if game:
+            self._buffers.pop(game, None)
+            self._totals.pop(game, None)
+            self._counts.pop(game, None)
+            return {"status": "ok", "game": game}
+        self._buffers.clear()
+        self._totals.clear()
+        self._counts.clear()
+        return {"status": "ok", "cleared": "all"}
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {
+            "total_ops": self._op_count,
+            "ingested": self._ingest_count,
+            "games": list(self._buffers.keys()),
+            "buffer_sizes": {g: len(b) for g, b in self._buffers.items()},
+        }
