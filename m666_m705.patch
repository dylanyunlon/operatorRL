+"""
+CrossGameCoachingTemplateEngine — Generates coaching advice via cross-game universal templates.
+
+Architecture (拿来主义):
+  history_driven_coaching_advisor.py（M605）— generate_ingame_advice
+  protocol_anomaly_coaching_translator.py（M654）— rule→advice mapping
+
+Location: integrations/lol-history/src/lol_history/cross_game_coaching_template_engine.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - Templates use placeholder substitution — safe against injection.
+    - Advice is tagged with urgency and category — easy to filter in UI.
+  System:
+    - Templates stored as dict, not files — no I/O dependency.
+    - Game-specific overrides layer on top of universal templates.
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "integrations.lol_history.cross_game_coaching_template_engine.v1"
+
+# Universal coaching concepts shared across all games
+_UNIVERSAL_TEMPLATES = {
+    "positioning": {
+        "category": "positioning",
+        "template": "Consider repositioning: {reason}. Current risk level: {risk}.",
+        "urgency_default": "medium",
+    },
+    "timing": {
+        "category": "timing",
+        "template": "Timing opportunity: {action} in the next {window}s. {context}.",
+        "urgency_default": "high",
+    },
+    "resource_management": {
+        "category": "resource",
+        "template": "Resource check: {resource} is at {level}. Recommendation: {advice}.",
+        "urgency_default": "low",
+    },
+    "objective_control": {
+        "category": "objective",
+        "template": "Objective priority: {objective}. Team status: {team_status}.",
+        "urgency_default": "high",
+    },
+    "risk_assessment": {
+        "category": "risk",
+        "template": "Risk alert: {threat}. Suggested response: {response}.",
+        "urgency_default": "medium",
+    },
+    "team_coordination": {
+        "category": "teamwork",
+        "template": "Coordination needed: {action}. Allies in range: {allies}.",
+        "urgency_default": "medium",
+    },
+}
+
+
+def _safe_div(a: float, b: float, default: float = 0.0) -> float:
+    return a / b if b != 0 else default
+
+
+class CrossGameCoachingTemplateEngine:
+    """Cross-game coaching template engine.
+
+    Public API
+    ----------
+        register_template(name, template_def) -> dict
+        register_game_override(game, name, override) -> dict
+        generate_advice(name, params, game) -> dict
+        generate_batch(requests) -> dict
+        list_templates() -> list
+        get_stats() -> dict
+
+    Evolution
+    ---------
+    Set evolution_callback to receive structured events.
+    """
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable[[Dict[str, Any]], None]] = None
+        self._op_count: int = 0
+        self._templates: Dict[str, Dict[str, Any]] = dict(_UNIVERSAL_TEMPLATES)
+        self._game_overrides: Dict[str, Dict[str, Dict[str, Any]]] = {}
+        self._generate_count: int = 0
+        self._override_hits: int = 0
+
+    def _fire(self, event_type: str, data: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            self.evolution_callback({"type": event_type, "key": _EVOLUTION_KEY, **data})
+
+    def register_template(self, name: str, template_def: Dict[str, Any]) -> Dict[str, Any]:
+        """Register or update a universal coaching template."""
+        self._op_count += 1
+        self._templates[name] = template_def
+        return {"status": "ok", "template": name, "total": len(self._templates)}
+
+    def register_game_override(self, game: str, name: str,
+                               override: Dict[str, Any]) -> Dict[str, Any]:
+        """Register a game-specific template override."""
+        self._op_count += 1
+        if game not in self._game_overrides:
+            self._game_overrides[game] = {}
+        self._game_overrides[game][name] = override
+        return {"status": "ok", "game": game, "template": name}
+
+    def generate_advice(self, name: str, params: Dict[str, Any] = None,
+                        game: str = None) -> Dict[str, Any]:
+        """Generate coaching advice from a template."""
+        self._op_count += 1
+        self._generate_count += 1
+        if params is None:
+            params = {}
+
+        # Check game-specific override first
+        template_def = None
+        if game and game in self._game_overrides:
+            template_def = self._game_overrides[game].get(name)
+            if template_def is not None:
+                self._override_hits += 1
+
+        # Fall back to universal template
+        if template_def is None:
+            template_def = self._templates.get(name)
+
+        if template_def is None:
+            return {"status": "error", "reason": f"template not found: {name}"}
+
+        template_str = template_def.get("template", "")
+        category = template_def.get("category", "general")
+        urgency = params.get("urgency", template_def.get("urgency_default", "medium"))
+
+        # Safe placeholder substitution
+        try:
+            text = template_str.format_map({**{k: "?" for k in _extract_placeholders(template_str)}, **params})
+        except (KeyError, ValueError):
+            text = template_str
+
+        advice = {
+            "template": name,
+            "category": category,
+            "urgency": urgency,
+            "text": text,
+            "game": game or "universal",
+            "timestamp": time.time(),
+        }
+
+        self._fire("advice_generated", {"template": name, "game": game or "universal"})
+        return {"status": "ok", "advice": advice}
+
+    def generate_batch(self, requests: List[Dict[str, Any]]) -> Dict[str, Any]:
+        """Generate multiple advice items."""
+        self._op_count += 1
+        results = []
+        for req in requests:
+            r = self.generate_advice(
+                name=req.get("name", ""),
+                params=req.get("params", {}),
+                game=req.get("game"),
+            )
+            if r["status"] == "ok":
+                results.append(r["advice"])
+        return {"status": "ok", "count": len(results), "advice_list": results}
+
+    def list_templates(self) -> List[str]:
+        return list(self._templates.keys())
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {
+            "total_ops": self._op_count,
+            "templates": len(self._templates),
+            "game_overrides": {g: len(t) for g, t in self._game_overrides.items()},
+            "generated": self._generate_count,
+            "override_hits": self._override_hits,
+            "override_rate": round(_safe_div(self._override_hits, self._generate_count), 4),
+        }
+
+
+def _extract_placeholders(template: str) -> List[str]:
+    """Extract {placeholder} names from template string."""
+    import re
+    return re.findall(r"\{(\w+)\}", template)
