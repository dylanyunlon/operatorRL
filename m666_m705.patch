+"""
+Dota2ProtocolAdapter — Dota2-specific protocol adapter via Game State Integration.
+
+Architecture (拿来主义):
+  dota2bot-OpenHyperAI/ — Dota2 bot framework, GSI state consumption
+  game_protocol_adapter_base.py（M666）— unified adapter interface
+  Akagi/mitm/bridge/bridge_base.py — parse/build pattern
+
+Location: extensions/protocol_decoder/src/dota2_protocol_adapter.py
+
+Design Notes (Knuth-level critique):
+  User:
+    - GSI payloads are JSON POSTs from Dota2 client — no binary protocol needed.
+    - Unknown top-level keys passthrough safely — forward compatible with Valve changes.
+  System:
+    - Normalization maps Dota2-specific fields (hero_id, xpos/ypos) to universal schema.
+    - Timestamp tracking detects stale GSI data (>5s gap = potential disconnect).
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import time
+from typing import Any, Callable, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+try:
+    from .game_protocol_adapter_base import GameProtocolAdapterBase
+except ImportError:
+    from game_protocol_adapter_base import GameProtocolAdapterBase
+
+_EVOLUTION_KEY: str = "extensions.protocol_decoder.dota2_protocol_adapter.v1"
+
+# Dota2 GSI top-level keys
+_GSI_KEYS = {
+    "provider", "map", "player", "hero", "abilities",
+    "items", "draft", "wearables", "minimap", "roshan",
+    "couriers", "buildings", "league", "previously", "added",
+}
+
+
+def _safe_div(a: float, b: float, default: float = 0.0) -> float:
+    return a / b if b != 0 else default
+
+
+class Dota2ProtocolAdapter(GameProtocolAdapterBase):
+    """Dota2 GSI protocol adapter.
+
+    Public API (inherited + extensions)
+    ----------
+        connect(config) -> dict
+        decode(raw_packet) -> dict
+        normalize(decoded) -> dict
+        disconnect() -> dict
+        get_gsi_stats() -> dict
+
+    Evolution
+    ---------
+    Set evolution_callback to receive structured events.
+    """
+
+    def __init__(self) -> None:
+        super().__init__()
+        self._gsi_port: int = 3000
+        self._last_gsi_ts: Optional[float] = None
+        self._key_hits: Dict[str, int] = {}
+        self._stale_count: int = 0
+
+    def _game_type(self) -> str:
+        return "dota2"
+
+    def _do_connect(self, config: Dict[str, Any]) -> Dict[str, Any]:
+        self._gsi_port = config.get("gsi_port", 3000)
+        self._key_hits.clear()
+        self._stale_count = 0
+        self._last_gsi_ts = None
+        return {"gsi_port": self._gsi_port, "gsi_keys": list(_GSI_KEYS)}
+
+    def _do_decode(self, raw_packet: bytes) -> Dict[str, Any]:
+        """Decode GSI JSON payload."""
+        if not raw_packet:
+            return {"keys": [], "data": {}, "warning": "empty_packet"}
+
+        try:
+            text = raw_packet.decode("utf-8", errors="replace")
+        except Exception:
+            return {"keys": [], "data": {}, "error": "decode_failed"}
+
+        try:
+            payload = json.loads(text)
+        except json.JSONDecodeError:
+            return {"keys": [], "data": {}, "error": "invalid_json"}
+
+        if not isinstance(payload, dict):
+            return {"keys": [], "data": {}, "error": "expected_dict"}
+
+        # Track key hits
+        found_keys = list(payload.keys())
+        for k in found_keys:
+            self._key_hits[k] = self._key_hits.get(k, 0) + 1
+
+        # Stale detection
+        now = time.time()
+        if self._last_gsi_ts is not None and (now - self._last_gsi_ts) > 5.0:
+            self._stale_count += 1
+        self._last_gsi_ts = now
+
+        # Extract core state
+        decoded = {
+            "keys": found_keys,
+            "timestamp": now,
+            "map": self._decode_map(payload.get("map", {})),
+            "player": self._decode_player(payload.get("player", {})),
+            "hero": self._decode_hero(payload.get("hero", {})),
+            "abilities": payload.get("abilities", {}),
+            "items": payload.get("items", {}),
+            "draft": payload.get("draft", {}),
+            "minimap": payload.get("minimap", {}),
+            "buildings": payload.get("buildings", {}),
+        }
+        return decoded
+
+    def _do_normalize(self, decoded: Dict[str, Any]) -> Dict[str, Any]:
+        """Normalize Dota2 GSI data to universal game state schema."""
+        hero = decoded.get("hero", {})
+        player = decoded.get("player", {})
+        map_data = decoded.get("map", {})
+
+        normalized = {
+            "game_type": "dota2",
+            "source_endpoint": "gsi",
+            "timestamp": decoded.get("timestamp", time.time()),
+            "players": [],
+            "active_player": {
+                "summoner": player.get("name", ""),
+                "level": hero.get("level", 0),
+                "gold": player.get("gold", 0),
+                "hero": hero.get("name", ""),
+                "health": hero.get("health", 0),
+                "max_health": hero.get("max_health", 0),
+                "mana": hero.get("mana", 0),
+                "position": {"x": hero.get("xpos", 0), "y": hero.get("ypos", 0)},
+            },
+            "game_time": map_data.get("clock_time", 0),
+            "events": [],
+            "map_state": {
+                "game_state": map_data.get("game_state", ""),
+                "day_time": map_data.get("daytime", True),
+                "roshan_state": map_data.get("roshan_state", ""),
+                "dire_score": map_data.get("dire_score", 0),
+                "radiant_score": map_data.get("radiant_score", 0),
+            },
+            "resources": {
+                "gold": player.get("gold", 0),
+                "gold_reliable": player.get("gold_reliable", 0),
+                "gold_unreliable": player.get("gold_unreliable", 0),
+            },
+        }
+        return normalized
+
+    def _do_disconnect(self) -> Dict[str, Any]:
+        stats = dict(self._key_hits)
+        self._key_hits.clear()
+        return {"gsi_key_stats": stats, "stale_events": self._stale_count}
+
+    # -----------------------------------------------------------------------
+    # GSI section decoders
+    # -----------------------------------------------------------------------
+    def _decode_map(self, m: Dict[str, Any]) -> Dict[str, Any]:
+        return {
+            "game_state": m.get("game_state", ""),
+            "clock_time": m.get("clock_time", 0),
+            "daytime": m.get("daytime", True),
+            "radiant_score": m.get("radiant_score", 0),
+            "dire_score": m.get("dire_score", 0),
+            "roshan_state": m.get("roshan_state", ""),
+            "ward_purchase_cooldown": m.get("ward_purchase_cooldown", 0),
+        }
+
+    def _decode_player(self, p: Dict[str, Any]) -> Dict[str, Any]:
+        return {
+            "name": p.get("name", ""),
+            "team_name": p.get("team_name", ""),
+            "gold": p.get("gold", 0),
+            "gold_reliable": p.get("gold_reliable", 0),
+            "gold_unreliable": p.get("gold_unreliable", 0),
+            "kills": p.get("kills", 0),
+            "deaths": p.get("deaths", 0),
+            "assists": p.get("assists", 0),
+            "last_hits": p.get("last_hits", 0),
+            "denies": p.get("denies", 0),
+        }
+
+    def _decode_hero(self, h: Dict[str, Any]) -> Dict[str, Any]:
+        return {
+            "name": h.get("name", ""),
+            "id": h.get("id", 0),
+            "level": h.get("level", 0),
+            "health": h.get("health", 0),
+            "max_health": h.get("max_health", 0),
+            "health_percent": h.get("health_percent", 0),
+            "mana": h.get("mana", 0),
+            "max_mana": h.get("max_mana", 0),
+            "alive": h.get("alive", True),
+            "xpos": h.get("xpos", 0),
+            "ypos": h.get("ypos", 0),
+        }
+
+    def get_gsi_stats(self) -> Dict[str, Any]:
+        total = sum(self._key_hits.values())
+        return {
+            "key_hits": dict(self._key_hits),
+            "total_payloads": self._decode_count,
+            "stale_events": self._stale_count,
+            "known_key_ratio": round(
+                _safe_div(sum(v for k, v in self._key_hits.items() if k in _GSI_KEYS), total), 4
+            ),
+        }
