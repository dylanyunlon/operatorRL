+        "recent_wr": 0.7, "win_streak": 5, "unique_champs": 8,
+    }
+    tags = BehavioralTagger.generate_tags(test_metrics)
+    print(f"Tags: {[f'{t.tag}({t.confidence})' for t in tags]}")
+
