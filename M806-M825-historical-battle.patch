+    data: Any = None
+    timestamp: str = field(default_factory=lambda: datetime.datetime.now().isoformat())
+
+    @property
+    def is_gameflow(self) -> bool:
+        return "gameflow" in self.uri.lower()
+
+    @property
+    def is_champ_select(self) -> bool:
+        return "champ-select" in self.uri.lower()
