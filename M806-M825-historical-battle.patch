+        for name, impact in sorted_factors[:5]:
+            if abs(impact) < 0.01:
+                continue
+            label = self.FEATURE_LABELS.get(name, name)
+            direction = "positively" if impact > 0 else "negatively"
+            explanations.append(f"{label} {direction} affects win probability by {abs(impact):.1%}")
