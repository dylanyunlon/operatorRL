+            elif prob < 0.35:
+                return "Significant mid-game deficit. Seek favorable fights or split pressure."
+            return "Competitive mid-game. Dragon and Baron control will be crucial."
+        else:
+            if prob > 0.7:
+                return "Late game dominance. Close out the game decisively."
