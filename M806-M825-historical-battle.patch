+
+@dataclass
+class CollectionCheckpoint:
+    """Checkpoint for resuming interrupted collections."""
+    target_id: str
+    matches_collected: int = 0
+    last_match_id: str = ""
+    last_timestamp: Optional[datetime.datetime] = None
+    cursor_index: int = 0
