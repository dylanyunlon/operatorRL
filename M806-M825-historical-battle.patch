+class EndpointType(Enum):
+    PLAYER_STATS = "/api/v1/player/{player_id}/stats"
+    MATCH_HISTORY = "/api/v1/player/{player_id}/matches"
+    CHAMPION_STATS = "/api/v1/champions/{champion_id}"
