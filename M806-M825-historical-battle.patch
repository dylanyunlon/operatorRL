+        report = gen.generate_scouting_report({
+            "enemies": [
+                {"name": "Player1", "rank": "Diamond II", "threat": 0.8, "winrate": 0.55},
+                {"name": "Player2", "rank": "Gold I", "threat": 0.4, "winrate": 0.48},
