+
+
+# ===========================================================================
+# Constants & Configuration
+# ===========================================================================
+
+MODULE_ID: Final[str] = "M883"
+MODULE_NAME: Final[str] = "PerformanceHeatmapGenerator"
+DEFAULT_CACHE_SIZE: Final[int] = 5000
+DEFAULT_TIMEOUT_S: Final[float] = 30.0
+MAX_RETRY_COUNT: Final[int] = 3
