+
+
+class DataQuality(enum.Enum):
+    """Quality classification for processed data."""
+    HIGH = "high"
+    MEDIUM = "medium"
+    LOW = "low"
+    UNKNOWN = "unknown"
+    INVALID = "invalid"
+
+
+class HealthLevel(enum.Enum):
+    """System health level."""
+    HEALTHY = "healthy"
+    DEGRADED = "degraded"
+    UNHEALTHY = "unhealthy"
