+)
+
+logger = logging.getLogger("M882.VoiceCoachNarrator")
+
+
+# ===========================================================================
+# Constants & Configuration
+# ===========================================================================
+
+MODULE_ID: Final[str] = "M882"
+MODULE_NAME: Final[str] = "VoiceCoachNarrator"
