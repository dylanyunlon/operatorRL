+    @classmethod
+    def from_file(cls, path: Union[str, pathlib.Path]) -> "ModuleConfig":
+        p = pathlib.Path(path)
+        if p.exists():
+            with open(p, "r", encoding="utf-8") as f:
+                data = json.load(f)
+            return cls(**{k: v for k, v in data.items() if k in cls.__dataclass_fields__})
+        return cls()
