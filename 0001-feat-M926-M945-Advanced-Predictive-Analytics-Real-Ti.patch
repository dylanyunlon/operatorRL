+    LOW = "low"
+    MEDIUM = "medium"
+    HIGH = "high"
+    VERY_HIGH = "very_high"
+
+    @classmethod
+    def from_sample_size(cls, n: int) -> "ConfidenceLevel":
+        if n < 3:
+            return cls.LOW
+        if n < 10:
+            return cls.MEDIUM
+        if n < 30:
+            return cls.HIGH
+        return cls.VERY_HIGH
