+"""Tests for M532 ImitationLearningPipeline — TDD, 10 tests."""
+import pytest, sys, os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "../.."))
+from agentlightning.trainer.imitation_learning_pipeline import ImitationLearningPipeline
+
+class TestImitationLearningPipeline:
+    def test_init(self):
+        ilp = ImitationLearningPipeline()
+        assert ilp.global_step == 0
+        assert ilp.mode == "bc"
+
+    def test_add_expert_trajectory(self):
+        ilp = ImitationLearningPipeline()
+        traj = [{"state": [1,2], "action": 0}, {"state": [3,4], "action": 1}]
+        ilp.add_expert_trajectory(traj)
+        assert ilp.expert_count == 1
+
+    def test_bc_train_step(self):
+        ilp = ImitationLearningPipeline(mode="bc")
+        ilp.add_expert_trajectory([{"state": [1], "action": 0}])
+        metrics = ilp.train_step()
+        assert "loss" in metrics
+        assert ilp.global_step == 1
+
+    def test_dagger_mode(self):
+        ilp = ImitationLearningPipeline(mode="dagger")
+        assert ilp.mode == "dagger"
+
+    def test_dagger_mix_ratio_decay(self):
+        ilp = ImitationLearningPipeline(mode="dagger", initial_mix_ratio=1.0, decay_rate=0.1)
+        ilp.add_expert_trajectory([{"state": [1], "action": 0}])
+        ilp.train_step()
+        ilp.train_step()
+        assert ilp.current_mix_ratio < 1.0
+
+    def test_extract_features(self):
+        ilp = ImitationLearningPipeline()
+        raw = {"state": [1,2,3], "action": 0, "extra": "ignored"}
+        feat = ilp.extract_features(raw)
+        assert "state" in feat and "action" in feat
+
+    def test_empty_train_raises(self):
+        ilp = ImitationLearningPipeline()
+        with pytest.raises(ValueError):
+            ilp.train_step()
+
+    def test_evolution_callback(self):
+        events = []
+        ilp = ImitationLearningPipeline()
+        ilp.evolution_callback = lambda e: events.append(e)
+        ilp.add_expert_trajectory([{"state": [1], "action": 0}])
+        ilp.train_step()
+        assert len(events) >= 1
+
+    def test_save_load_checkpoint(self):
+        ilp = ImitationLearningPipeline()
+        ilp.add_expert_trajectory([{"state": [1], "action": 0}])
+        ilp.train_step()
+        ckpt = ilp.save_checkpoint()
+        ilp2 = ImitationLearningPipeline()
+        ilp2.load_checkpoint(ckpt)
+        assert ilp2.global_step == 1
+
+    def test_get_metrics(self):
+        ilp = ImitationLearningPipeline()
+        ilp.add_expert_trajectory([{"state": [1], "action": 0}])
+        ilp.train_step()
+        m = ilp.get_metrics()
+        assert "global_step" in m
