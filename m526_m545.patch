+"""Tests for M534 MetaLearningOptimizer — TDD, 10 tests."""
+import pytest, sys, os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "../.."))
+from agentlightning.trainer.meta_learning_optimizer import MetaLearningOptimizer
+
+class TestMetaLearningOptimizer:
+    def test_init(self):
+        mlo = MetaLearningOptimizer()
+        assert mlo.mode == "maml"
+
+    def test_reptile_mode(self):
+        mlo = MetaLearningOptimizer(mode="reptile")
+        assert mlo.mode == "reptile"
+
+    def test_register_task(self):
+        mlo = MetaLearningOptimizer()
+        mlo.register_task("lol_laning", data=[{"s": [1], "a": 0, "r": 1.0}])
+        assert "lol_laning" in mlo.tasks
+
+    def test_maml_inner_loop(self):
+        mlo = MetaLearningOptimizer(mode="maml", inner_steps=3, inner_lr=0.01)
+        mlo.set_meta_params({"w": [0.5, 0.5]})
+        mlo.register_task("t1", data=[{"s": [1.0], "a": 0, "r": 1.0}])
+        adapted = mlo.inner_adapt("t1")
+        assert "w" in adapted
+
+    def test_meta_update(self):
+        mlo = MetaLearningOptimizer(mode="maml", meta_lr=0.01)
+        mlo.set_meta_params({"w": [0.5, 0.5]})
+        mlo.register_task("t1", data=[{"s": [1.0], "a": 0, "r": 1.0}])
+        mlo.register_task("t2", data=[{"s": [2.0], "a": 1, "r": 0.5}])
+        metrics = mlo.meta_update(["t1", "t2"])
+        assert "meta_loss" in metrics
+
+    def test_reptile_update(self):
+        mlo = MetaLearningOptimizer(mode="reptile", inner_steps=5, meta_lr=0.1)
+        mlo.set_meta_params({"w": [0.0, 0.0]})
+        mlo.register_task("t1", data=[{"s": [1.0], "a": 0, "r": 1.0}])
+        metrics = mlo.meta_update(["t1"])
+        assert "meta_loss" in metrics
+
+    def test_get_meta_params(self):
+        mlo = MetaLearningOptimizer()
+        mlo.set_meta_params({"w": [1.0, 2.0]})
+        p = mlo.get_meta_params()
+        assert p["w"] == [1.0, 2.0]
+
+    def test_adaptation_distance(self):
+        mlo = MetaLearningOptimizer()
+        mlo.set_meta_params({"w": [0.0]})
+        mlo.register_task("t1", data=[{"s": [1.0], "a": 0, "r": 1.0}])
+        dist = mlo.adaptation_distance("t1")
+        assert isinstance(dist, float)
+
+    def test_evolution_callback(self):
+        events = []
+        mlo = MetaLearningOptimizer()
+        mlo.evolution_callback = lambda e: events.append(e)
+        mlo.set_meta_params({"w": [0.0]})
+        mlo.register_task("t1", data=[{"s": [1.0], "a": 0, "r": 1.0}])
+        mlo.meta_update(["t1"])
+        assert len(events) >= 1
+
+    def test_save_load(self):
+        mlo = MetaLearningOptimizer(mode="reptile")
+        mlo.set_meta_params({"w": [1.0, 2.0]})
+        ckpt = mlo.save_checkpoint()
+        mlo2 = MetaLearningOptimizer()
+        mlo2.load_checkpoint(ckpt)
+        assert mlo2.mode == "reptile"
+        assert mlo2.get_meta_params()["w"] == [1.0, 2.0]
