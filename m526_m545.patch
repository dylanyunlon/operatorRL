+"""Tests for M537 StateEncoderNetwork — TDD, 10 tests."""
+import pytest, sys, os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "../.."))
+from agentlightning.inference.state_encoder_network import StateEncoderNetwork
+
+class TestStateEncoderNetwork:
+    def test_init(self):
+        sen = StateEncoderNetwork(output_dim=64)
+        assert sen.output_dim == 64
+
+    def test_register_numeric_encoder(self):
+        sen = StateEncoderNetwork(output_dim=32)
+        sen.register_feature("hp", ftype="numeric", input_dim=1)
+        assert "hp" in sen.features
+
+    def test_register_categorical_encoder(self):
+        sen = StateEncoderNetwork(output_dim=32)
+        sen.register_feature("champion_id", ftype="categorical", num_categories=160)
+        assert "champion_id" in sen.features
+
+    def test_register_sequence_encoder(self):
+        sen = StateEncoderNetwork(output_dim=32)
+        sen.register_feature("action_history", ftype="sequence", seq_dim=4)
+        assert "action_history" in sen.features
+
+    def test_encode_numeric(self):
+        sen = StateEncoderNetwork(output_dim=16)
+        sen.register_feature("hp", ftype="numeric", input_dim=3)
+        emb = sen.encode({"hp": [100.0, 50.0, 200.0]})
+        assert len(emb) == 16
+
+    def test_encode_mixed(self):
+        sen = StateEncoderNetwork(output_dim=16)
+        sen.register_feature("hp", ftype="numeric", input_dim=2)
+        sen.register_feature("role", ftype="categorical", num_categories=5)
+        emb = sen.encode({"hp": [100.0, 50.0], "role": 2})
+        assert len(emb) == 16
+
+    def test_auto_detect_type(self):
+        sen = StateEncoderNetwork(output_dim=16)
+        ftype = sen.detect_feature_type([1.0, 2.0, 3.0])
+        assert ftype == "numeric"
+        ftype2 = sen.detect_feature_type(5)
+        assert ftype2 == "categorical"
+        ftype3 = sen.detect_feature_type([[1,2],[3,4]])
+        assert ftype3 == "sequence"
+
+    def test_empty_features_raises(self):
+        sen = StateEncoderNetwork(output_dim=16)
+        with pytest.raises(ValueError):
+            sen.encode({})
+
+    def test_evolution_callback(self):
