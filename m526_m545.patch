++Attention Mechanism — Multi-head self-attention with explanation output.
++
++Location: agentlightning/inference/attention_mechanism.py
++
++Reference (拿来主義):
++  - DI-star/ctools/torch_utils/network/ Transformer/Attention modules
++  - integrations/lol/src/lol_agent/state_encoder.py: multi-source fusion
++"""
++
++from __future__ import annotations
++
++import logging
++import math
++import time
++from typing import Any, Callable, Dict, List, Optional, Tuple
++
++logger = logging.getLogger(__name__)
++
++_EVOLUTION_KEY: str = "agentlightning.inference.attention_mechanism.v1"
++
++
++def _softmax_vec(scores: List[float]) -> List[float]:
++    if not scores:
++        return []
++    max_s = max(scores)
++    exps = [math.exp(s - max_s) for s in scores]
++    total = sum(exps) or 1.0
++    return [e / total for e in exps]
++
++
++class AttentionMechanism:
++    """Multi-head self-attention with explanation support.
++
++    Computes scaled dot-product attention and provides
++    attention weight maps for decision explanation.
++
++    Attributes:
++        embed_dim: Embedding dimension.
++        num_heads: Number of attention heads.
++    """
++
++    def __init__(self, embed_dim: int = 64, num_heads: int = 4) -> None:
++        self.embed_dim = embed_dim
++        self.num_heads = num_heads
++        self._last_weights: Optional[List[List[float]]] = None
++        self._last_element_names: Optional[List[str]] = None
++        self.evolution_callback: Optional[Callable[[Dict], None]] = None
++
++    # -------------------------------------------------------------------
++    # Forward — scaled dot-product attention
++    # -------------------------------------------------------------------
++
++    def forward(
++        self,
++        queries: List[List[float]],
++        keys: List[List[float]],
++        values: List[List[float]],
++    ) -> Tuple[List[List[float]], List[List[float]]]:
++        """Compute multi-head attention.
++
++        Args:
++            queries: [num_queries, embed_dim]
++            keys: [num_keys, embed_dim]
++            values: [num_keys, embed_dim]
++
++        Returns:
++            (output, attention_weights) where output is
++            [num_queries, embed_dim] and weights is
++            [num_queries, num_keys].
++
++        Raises:
++            ValueError: If dimensions invalid.
++        """
++        if not queries or not keys or not values:
++            raise ValueError("Empty input to attention")
++
++        q_dim = len(queries[0])
++        if q_dim % self.num_heads != 0:
++            raise ValueError(
++                f"embed_dim {q_dim} not divisible by num_heads {self.num_heads}"
++            )
++
++        head_dim = q_dim // self.num_heads
++        scale = math.sqrt(head_dim) or 1.0
++        num_q = len(queries)
++        num_k = len(keys)
++
++        # Compute attention per head then concatenate
++        all_outputs = [[0.0] * q_dim for _ in range(num_q)]
++        all_weights = [[0.0] * num_k for _ in range(num_q)]
++
++        for h in range(self.num_heads):
++            lo = h * head_dim
++            hi = lo + head_dim
++
++            for qi in range(num_q):
++                scores = []
++                for ki in range(num_k):
++                    dot = sum(
++                        queries[qi][lo + d] * keys[ki][lo + d]
++                        for d in range(head_dim)
++                    )
++                    scores.append(dot / scale)
++
++                weights = _softmax_vec(scores)
++
++                for ki in range(num_k):
++                    all_weights[qi][ki] += weights[ki] / self.num_heads
++                    for d in range(head_dim):
++                        all_outputs[qi][lo + d] += weights[ki] * values[ki][lo + d]
++
++        self._last_weights = all_weights
++        self._fire_evolution({"event": "attention_computed", "num_queries": num_q})
++        return all_outputs, all_weights
++
++    # -------------------------------------------------------------------
++    # Explanation — attention weight interpretation
++    # -------------------------------------------------------------------
++
++    def get_attention_map(self) -> Optional[List[List[float]]]:
++        return self._last_weights
++
++    def explain(
++        self,
++        element_names: Optional[List[str]] = None,
++    ) -> str:
++        """Generate text explanation of attention focus.
++
++        Args:
++            element_names: Names for key positions.
++
++        Returns:
++            Human-readable explanation string.
++        """
++        if self._last_weights is None:
++            return "No attention computed yet"
++
++        if element_names is None:
++            element_names = [f"element_{i}" for i in range(len(self._last_weights[0]))]
++
++        lines = []
++        for qi, weights in enumerate(self._last_weights):
++            ranked = sorted(
++                zip(element_names, weights),
++                key=lambda x: -x[1],
++            )
++            top = ranked[:3]
++            focus = ", ".join(f"{n}({w:.2f})" for n, w in top)
++            lines.append(f"Query {qi}: focus on {focus}")
++
++        return "; ".join(lines)
++
++    # -------------------------------------------------------------------
++    # Checkpoint
++    # -------------------------------------------------------------------
++
++    def save_checkpoint(self) -> Dict[str, Any]:
++        return {"embed_dim": self.embed_dim, "num_heads": self.num_heads}
++
++    def load_checkpoint(self, ckpt: Dict[str, Any]) -> None:
++        self.embed_dim = ckpt.get("embed_dim", self.embed_dim)
++        self.num_heads = ckpt.get("num_heads", self.num_heads)
++
++    # -------------------------------------------------------------------
++    # Evolution callback
++    # -------------------------------------------------------------------
++
++    def _fire_evolution(self, payload: Dict[str, Any]) -> None:
++        if self.evolution_callback is not None:
++            try:
++                self.evolution_callback({
++                    "source": _EVOLUTION_KEY,
++                    "timestamp": time.time(),
++                    **payload,
++                })
++            except Exception as exc:
++                logger.warning("Evolution callback error: %s", exc)
