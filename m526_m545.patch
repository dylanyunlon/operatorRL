+"""Tests for M535 TrainingCheckpointManager — TDD, 10 tests."""
+import pytest, sys, os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "../.."))
+from agentlightning.trainer.training_checkpoint_manager import TrainingCheckpointManager
+
+class TestTrainingCheckpointManager:
+    def test_init(self):
+        tcm = TrainingCheckpointManager()
+        assert tcm.checkpoint_count() == 0
+
+    def test_save_checkpoint(self):
+        tcm = TrainingCheckpointManager()
+        tcm.save("run1", step=100, data={"weights": [1,2,3], "optimizer": {"lr": 0.01}})
+        assert tcm.checkpoint_count() == 1
+
+    def test_load_checkpoint(self):
+        tcm = TrainingCheckpointManager()
+        tcm.save("run1", step=100, data={"weights": [1,2,3]})
+        ckpt = tcm.load("run1", step=100)
+        assert ckpt["weights"] == [1,2,3]
+
+    def test_load_latest(self):
+        tcm = TrainingCheckpointManager()
+        tcm.save("run1", step=100, data={"v": 1})
+        tcm.save("run1", step=200, data={"v": 2})
+        ckpt = tcm.load_latest("run1")
+        assert ckpt["v"] == 2
+
+    def test_auto_save_interval(self):
+        tcm = TrainingCheckpointManager(auto_save_interval=5)
+        for i in range(12):
+            tcm.maybe_save("run1", step=i, data={"w": i})
+        saved = tcm.list_checkpoints("run1")
+        assert len(saved) >= 2  # steps 0,5,10
+
+    def test_ab_compare(self):
+        tcm = TrainingCheckpointManager()
+        tcm.save("run1", step=100, data={"weights": [1]})
+        tcm.save("run1", step=200, data={"weights": [2]})
+        result = tcm.ab_compare("run1", step_a=100, step_b=200,
+                                eval_fn=lambda d: sum(d["weights"]))
+        assert result["winner_step"] == 200
+
+    def test_list_checkpoints(self):
+        tcm = TrainingCheckpointManager()
+        tcm.save("r1", step=10, data={})
+        tcm.save("r1", step=20, data={})
+        lst = tcm.list_checkpoints("r1")
+        assert lst == [10, 20]
+
+    def test_load_missing_raises(self):
+        tcm = TrainingCheckpointManager()
+        with pytest.raises(KeyError):
+            tcm.load("nope", step=1)
+
+    def test_evolution_callback(self):
+        events = []
+        tcm = TrainingCheckpointManager()
+        tcm.evolution_callback = lambda e: events.append(e)
+        tcm.save("r1", step=1, data={"w": 1})
+        assert len(events) >= 1
+
+    def test_delete_checkpoint(self):
+        tcm = TrainingCheckpointManager()
+        tcm.save("r1", step=1, data={})
+        tcm.delete("r1", step=1)
+        assert tcm.checkpoint_count() == 0
