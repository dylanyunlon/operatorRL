++
++class CurriculumLearningEngine:
++    """Curriculum learning with auto-advance and retreat.
++
++    Extends CurriculumManager with retreat mechanism: when
++    performance drops sustained below threshold, agent drops
++    back to previous level to consolidate.
++
++    Attributes:
++        current_level: Current difficulty level index.
++        retreat_window: Number of consecutive low evals to trigger retreat.
++        retreat_threshold: Performance below this triggers retreat counting.
++    """
++
++    def __init__(
++        self,
++        retreat_window: int = 3,
++        retreat_threshold: float = 0.3,
++    ) -> None:
++        self.current_level: int = 0
++        self.retreat_window = retreat_window
++        self.retreat_threshold = retreat_threshold
++        self._levels: List[Dict[str, Any]] = []
++        self._performance_history: List[Dict[str, Any]] = []
++        self._consecutive_low: int = 0
++        self.evolution_callback: Optional[Callable[[Dict], None]] = None
++
++    @property
++    def level_count(self) -> int:
++        return len(self._levels)
++
++    # -------------------------------------------------------------------
++    # Level registration — mirrors curriculum_manager.py
++    # -------------------------------------------------------------------
++
++    def register_level(
++        self,
++        index: int,
++        name: str,
++        threshold: float,
++        **config: Any,
++    ) -> None:
++        """Register a curriculum level.
++
++        Args:
++            index: Level index (0-based).
++            name: Human-readable level name.
++            threshold: Performance threshold to advance past this level.
++        """
++        entry = {"index": index, "name": name, "threshold": threshold}
++        entry.update(config)
++        while len(self._levels) <= index:
++            self._levels.append({})
++        self._levels[index] = entry
++
++    # -------------------------------------------------------------------
++    # Evaluate and advance/retreat
++    # -------------------------------------------------------------------
++
++    def evaluate_and_advance(self, performance: float) -> None:
++        """Evaluate performance and advance or retreat.
++
++        Args:
++            performance: Current performance metric [0, 1].
++        """
++        self._performance_history.append({
++            "performance": performance,
++            "level": self.current_level,
++            "timestamp": time.time(),
++        })
++
++        # Check retreat
++        if performance < self.retreat_threshold:
++            self._consecutive_low += 1
++        else:
++            self._consecutive_low = 0
++
++        if self._consecutive_low >= self.retreat_window and self.current_level > 0:
++            self.current_level -= 1
++            self._consecutive_low = 0
++            self._fire_evolution({
++                "event": "level_retreated",
++                "current_level": self.current_level,
++                "performance": performance,
++            })
++            return
++
++        # Check advance
++        if self.current_level < len(self._levels):
++            threshold = self._levels[self.current_level].get("threshold", 1.0)
++            if performance >= threshold and self.current_level < len(self._levels) - 1:
++                self.current_level += 1
++                self._consecutive_low = 0
++                self._fire_evolution({
++                    "event": "level_advanced",
++                    "current_level": self.current_level,
++                    "performance": performance,
++                })
