@@ -0,0 +1,192 @@
+"""
+Distributed Training Coordinator — Parameter server with fault tolerance.
+
+Location: agentos/governance/distributed_training_coordinator.py
+
+Reference (拿来主義):
+  - DI-star/ctools/worker/: learner/actor/coordinator architecture
+  - agentlightning/execution/client_server.py: client/server IPC pattern
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from collections import defaultdict
+from typing import Any, Callable, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "agentos.governance.distributed_training_coordinator.v1"
+
+
+class DistributedTrainingCoordinator:
+    """Parameter server coordinator for distributed training.
+
+    Aggregates gradients from workers, broadcasts updated params,
+    detects worker failures via heartbeat timeout.
+
+    Attributes:
+        heartbeat_timeout: Seconds before worker considered failed.
+    """
+
+    def __init__(self, heartbeat_timeout: float = 30.0) -> None:
+        self.heartbeat_timeout = heartbeat_timeout
+        self._workers: Dict[str, Dict[str, Any]] = {}
+        self._pending_gradients: List[Dict[str, Any]] = []
+        self._current_params: Dict[str, List[float]] = {}
+        self._tasks: Dict[str, List[str]] = defaultdict(list)  # worker -> tasks
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+
+    @property
+    def worker_count(self) -> int:
+        return len(self._workers)
+
+    @property
+    def pending_gradient_count(self) -> int:
+        return len(self._pending_gradients)
+
+    # -------------------------------------------------------------------
+    # Worker management
+    # -------------------------------------------------------------------
+
+    def register_worker(self, worker_id: str, capacity: float = 1.0) -> None:
+        self._workers[worker_id] = {
+            "capacity": capacity,
+            "last_heartbeat": time.time(),
+            "params": None,
+            "status": "active",
+        }
+        self._fire_evolution({"event": "worker_registered", "worker_id": worker_id})
+
+    def remove_worker(self, worker_id: str) -> None:
+        self._workers.pop(worker_id, None)
+        self._tasks.pop(worker_id, None)
+
+    def heartbeat(self, worker_id: str) -> None:
+        if worker_id in self._workers:
+            self._workers[worker_id]["last_heartbeat"] = time.time()
+
+    # -------------------------------------------------------------------
+    # Gradient aggregation — parameter server pattern
+    # -------------------------------------------------------------------
+
+    def submit_gradients(
+        self,
+        worker_id: str,
+        gradients: Dict[str, List[float]],
+    ) -> None:
+        self._pending_gradients.append({
+            "worker_id": worker_id,
+            "gradients": gradients,
+            "timestamp": time.time(),
+        })
+
+    def aggregate_gradients(self) -> Dict[str, List[float]]:
+        """Average all pending gradients and clear buffer."""
+        if not self._pending_gradients:
+            return {}
+
+        # Collect all layer keys
+        all_keys: set = set()
+        for pg in self._pending_gradients:
+            all_keys.update(pg["gradients"].keys())
+
+        aggregated: Dict[str, List[float]] = {}
+        for key in all_keys:
+            # Gather all gradient vectors for this key
+            vectors = [
+                pg["gradients"][key]
+                for pg in self._pending_gradients
+                if key in pg["gradients"]
+            ]
+            if not vectors:
+                continue
+            dim = max(len(v) for v in vectors)
+            avg = [0.0] * dim
+            for v in vectors:
+                for i in range(min(len(v), dim)):
+                    avg[i] += v[i]
+            avg = [x / len(vectors) for x in avg]
+            aggregated[key] = avg
+
+        self._pending_gradients.clear()
+        return aggregated
+
+    # -------------------------------------------------------------------
+    # Parameter broadcast
+    # -------------------------------------------------------------------
+
+    def broadcast_params(self, params: Dict[str, List[float]]) -> None:
+        self._current_params = {k: list(v) for k, v in params.items()}
+        for wid in self._workers:
+            self._workers[wid]["params"] = {k: list(v) for k, v in params.items()}
+
+    def get_worker_params(self, worker_id: str) -> Optional[Dict[str, List[float]]]:
+        if worker_id in self._workers:
+            return self._workers[worker_id].get("params")
+        return None
+
+    # -------------------------------------------------------------------
+    # Fault detection
+    # -------------------------------------------------------------------
+
+    def detect_failed_workers(
+        self, current_time: Optional[float] = None,
+    ) -> List[str]:
+        now = current_time if current_time is not None else time.time()
+        failed = []
+        for wid, info in self._workers.items():
+            elapsed = now - info["last_heartbeat"]
+            if elapsed > self.heartbeat_timeout:
+                failed.append(wid)
+        return failed
+
+    # -------------------------------------------------------------------
+    # Task assignment
+    # -------------------------------------------------------------------
+
+    def assign_task(self, worker_id: str, task_id: str) -> None:
+        self._tasks[worker_id].append(task_id)
+
+    def reassign_task(
+        self, task_id: str, from_worker: str, to_worker: str,
+    ) -> None:
+        if from_worker in self._tasks:
+            self._tasks[from_worker] = [
+                t for t in self._tasks[from_worker] if t != task_id
+            ]
+        self._tasks[to_worker].append(task_id)
+
+    def get_tasks(self, worker_id: str) -> List[str]:
+        return list(self._tasks.get(worker_id, []))
+
+    # -------------------------------------------------------------------
+    # Cluster status
+    # -------------------------------------------------------------------
+
+    def get_cluster_status(self) -> Dict[str, Any]:
+        return {
+            "total_workers": len(self._workers),
+            "total_capacity": sum(w["capacity"] for w in self._workers.values()),
+            "pending_gradients": len(self._pending_gradients),
+            "workers": {
+                wid: {"capacity": info["capacity"], "status": info["status"]}
+                for wid, info in self._workers.items()
+            },
+        }
+
+    # -------------------------------------------------------------------
+    # Evolution callback
+    # -------------------------------------------------------------------
+
+    def _fire_evolution(self, payload: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            try:
+                self.evolution_callback({
+                    "source": _EVOLUTION_KEY,
+                    "timestamp": time.time(),
+                    **payload,
+                })
+            except Exception as exc:
+                logger.warning("Evolution callback error: %s", exc)
