+"""
+Experience Replay Manager — Prioritized (PER) + Hindsight (HER) replay.
+
+Location: agentlightning/trainer/experience_replay_manager.py
+
+Reference (拿来主义):
+  - agentlightning/store/experience_store.py: add/sample/filter pattern
+  - DI-star/data_helper.py: data cleaning pipeline
+  - PARL: replay memory with priority
+"""
+
+from __future__ import annotations
+
+import logging
+import math
+import random
+import time
+from typing import Any, Callable, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "agentlightning.trainer.experience_replay_manager.v1"
+
+
+class ExperienceReplayManager:
+    """Prioritized Experience Replay with HER support.
+
+    Extends ExperienceStore's add/sample pattern with:
+    - Priority-based sampling (TD-error proportional)
+    - Hindsight Experience Replay for failed episodes
+    - Capacity-based FIFO eviction
+
+    Attributes:
+        capacity: Maximum buffer size.
+        alpha: Priority exponent (0 = uniform, 1 = full priority).
+        evolution_callback: Optional evolution event callback.
+    """
+
+    def __init__(
+        self,
+        capacity: int = 10000,
+        alpha: float = 0.6,
+        beta: float = 0.4,
+    ) -> None:
+        self.capacity = capacity
+        self.alpha = alpha
+        self.beta = beta
+        self._buffer: List[Dict[str, Any]] = []
+        self._priorities: List[float] = []
+        self._max_priority: float = 1.0
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+
+    def __len__(self) -> int:
+        return len(self._buffer)
+
+    # -------------------------------------------------------------------
+    # Add — mirrors ExperienceStore.add with td_error priority
+    # -------------------------------------------------------------------
+
+    def add(
+        self,
+        state: Any,
+        action: Any,
+        reward: float,
+        next_state: Any,
+        done: bool,
+        td_error: float = 1.0,
+        **extra: Any,
+    ) -> None:
+        """Add experience with priority."""
+        entry = {
+            "state": state,
+            "action": action,
+            "reward": reward,
+            "next_state": next_state,
+            "done": done,
+            "td_error": abs(td_error),
+            **extra,
+        }
+        priority = (abs(td_error) + 1e-6) ** self.alpha
+
+        if len(self._buffer) >= self.capacity:
+            self._buffer.pop(0)
+            self._priorities.pop(0)
+
+        self._buffer.append(entry)
+        self._priorities.append(priority)
+        self._max_priority = max(self._max_priority, priority)
+
+        self._fire_evolution({"event": "experience_added", "size": len(self._buffer)})
+
+    # -------------------------------------------------------------------
+    # Prioritized sampling — PER
+    # -------------------------------------------------------------------
+
+    def prioritized_sample(self, batch_size: int) -> List[Dict[str, Any]]:
+        """Sample batch proportional to TD-error priority."""
+        if len(self._buffer) == 0:
+            return []
+        n = min(batch_size, len(self._buffer))
+        total_p = sum(self._priorities)
+        if total_p <= 0:
+            return random.sample(self._buffer, n)
+
+        probs = [p / total_p for p in self._priorities]
+        indices = []
+        for _ in range(n):
+            r = random.random()
+            cumsum = 0.0
+            for i, p in enumerate(probs):
+                cumsum += p
+                if cumsum >= r:
+                    indices.append(i)
+                    break
+            else:
+                indices.append(len(probs) - 1)
+
+        return [self._buffer[i] for i in indices]
+
+    def uniform_sample(self, batch_size: int) -> List[Dict[str, Any]]:
+        """Uniform random sample (fallback)."""
+        n = min(batch_size, len(self._buffer))
+        if n == 0:
+            return []
+        return random.sample(self._buffer, n)
+
+    # -------------------------------------------------------------------
+    # Priority update
+    # -------------------------------------------------------------------
+
+    def update_priority(self, index: int, new_td_error: float) -> None:
+        """Update priority for experience at index."""
+        if 0 <= index < len(self._buffer):
+            self._buffer[index]["td_error"] = abs(new_td_error)
+            self._priorities[index] = (abs(new_td_error) + 1e-6) ** self.alpha
+            self._max_priority = max(self._max_priority, self._priorities[index])
+
+    def get_priority(self, index: int) -> float:
+        """Get priority value at index."""
+        if 0 <= index < len(self._priorities):
+            return self._priorities[index]
+        return 0.0
+
+    # -------------------------------------------------------------------
+    # HER — Hindsight Experience Replay
+    # -------------------------------------------------------------------
+
+    def her_relabel(
+        self,
+        trajectory: List[Dict[str, Any]],
+        achieved_goal: str,
+        success_reward: float = 1.0,
+    ) -> List[Dict[str, Any]]:
+        """Relabel a failed trajectory with achieved goal.
+
+        Following HER paper: replace original goal with what was
+        actually achieved, and assign success reward to terminal step.
+
+        Args:
+            trajectory: List of transition dicts with 'goal' key.
+            achieved_goal: The goal that was actually achieved.
+            success_reward: Reward for achieving the relabeled goal.
+
+        Returns:
+            New trajectory with relabeled goals and rewards.
+        """
+        relabeled = []
+        for i, step in enumerate(trajectory):
+            new_step = dict(step)
+            new_step["goal"] = achieved_goal
+            if i == len(trajectory) - 1:
+                new_step["reward"] = success_reward
+            relabeled.append(new_step)
+        return relabeled
+
+    # -------------------------------------------------------------------
+    # Statistics
+    # -------------------------------------------------------------------
+
+    def get_statistics(self) -> Dict[str, Any]:
+        """Return buffer statistics."""
+        if not self._buffer:
+            return {"size": 0, "mean_td_error": 0.0, "max_td_error": 0.0}
+        td_errors = [e["td_error"] for e in self._buffer]
+        return {
+            "size": len(self._buffer),
+            "mean_td_error": sum(td_errors) / len(td_errors),
+            "max_td_error": max(td_errors),
+            "min_td_error": min(td_errors),
+            "capacity_usage": len(self._buffer) / self.capacity,
+        }
+
+    # -------------------------------------------------------------------
+    # Evolution callback
+    # -------------------------------------------------------------------
+
+    def _fire_evolution(self, payload: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            try:
+                self.evolution_callback({
+                    "source": _EVOLUTION_KEY,
+                    "timestamp": time.time(),
+                    **payload,
+                })
+            except Exception as exc:
+                logger.warning("Evolution callback error: %s", exc)
