+"""Tests for M540 ModelEnsemble — TDD, 10 tests."""
+import pytest, sys, os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "../.."))
+from agentlightning.inference.model_ensemble import ModelEnsemble
+
+class TestModelEnsemble:
+    def test_init(self):
+        me = ModelEnsemble()
+        assert me.model_count == 0
+
+    def test_add_model(self):
+        me = ModelEnsemble()
+        me.add_model("m1", predict_fn=lambda s: [0.1, 0.9])
+        assert me.model_count == 1
+
+    def test_vote_fusion(self):
+        me = ModelEnsemble(fusion="vote")
+        me.add_model("m1", predict_fn=lambda s: [0.1, 0.9])
+        me.add_model("m2", predict_fn=lambda s: [0.2, 0.8])
+        me.add_model("m3", predict_fn=lambda s: [0.8, 0.2])
+        result = me.predict(state=[1,2,3])
+        assert len(result) == 2
+
+    def test_weighted_average_fusion(self):
+        me = ModelEnsemble(fusion="weighted_avg")
+        me.add_model("m1", predict_fn=lambda s: [1.0, 0.0], weight=2.0)
+        me.add_model("m2", predict_fn=lambda s: [0.0, 1.0], weight=1.0)
+        result = me.predict(state=[1])
+        assert result[0] > result[1]
+
+    def test_dynamic_weight_decay(self):
+        me = ModelEnsemble(fusion="weighted_avg")
+        me.add_model("m1", predict_fn=lambda s: [0.9, 0.1], weight=1.0)
+        me.add_model("m2", predict_fn=lambda s: [0.1, 0.9], weight=1.0)
+        me.record_performance("m1", score=0.8)
+        me.record_performance("m2", score=0.2)
+        me.update_weights_from_performance()
+        assert me.get_weight("m1") > me.get_weight("m2")
+
+    def test_remove_model(self):
+        me = ModelEnsemble()
+        me.add_model("m1", predict_fn=lambda s: [0.5, 0.5])
+        me.remove_model("m1")
+        assert me.model_count == 0
+
+    def test_empty_ensemble_raises(self):
+        me = ModelEnsemble()
+        with pytest.raises(ValueError):
+            me.predict(state=[1])
+
+    def test_get_model_contributions(self):
+        me = ModelEnsemble(fusion="weighted_avg")
+        me.add_model("m1", predict_fn=lambda s: [1.0, 0.0], weight=1.0)
+        me.add_model("m2", predict_fn=lambda s: [0.0, 1.0], weight=1.0)
+        me.predict(state=[1])
+        contribs = me.get_contributions()
+        assert "m1" in contribs and "m2" in contribs
+
+    def test_evolution_callback(self):
+        events = []
+        me = ModelEnsemble()
+        me.evolution_callback = lambda e: events.append(e)
+        me.add_model("m1", predict_fn=lambda s: [0.5, 0.5])
+        me.predict(state=[1])
+        assert len(events) >= 1
+
+    def test_list_models(self):
+        me = ModelEnsemble()
+        me.add_model("a", predict_fn=lambda s: [0.5])
+        me.add_model("b", predict_fn=lambda s: [0.5])
+        assert set(me.list_models()) == {"a", "b"}
