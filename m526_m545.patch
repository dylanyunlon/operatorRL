+"""Tests for M529 ValueNetworkTrainer — TDD first, 10 tests."""
+import pytest
+import sys, os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "../.."))
+
+from agentlightning.trainer.value_network_trainer import ValueNetworkTrainer
+
+
+class TestValueNetworkTrainer:
+    def test_init_defaults(self):
+        vnt = ValueNetworkTrainer()
+        assert vnt.lr > 0
+        assert vnt.global_step == 0
+
+    def test_train_step_returns_value_loss(self):
+        vnt = ValueNetworkTrainer(lr=1e-3)
+        batch = {
+            "states": [[1, 2], [3, 4]],
+            "td_targets": [1.0, 0.5],
+        }
+        metrics = vnt.train_step(batch)
+        assert "value_loss" in metrics
+        assert vnt.global_step == 1
+
+    def test_predict_values(self):
+        vnt = ValueNetworkTrainer()
+        states = [[1, 2, 3], [4, 5, 6]]
+        values = vnt.predict(states)
+        assert len(values) == 2
+        assert all(isinstance(v, float) for v in values)
+
+    def test_compute_td_lambda_targets(self):
+        vnt = ValueNetworkTrainer(gamma=0.99, td_lambda=0.95)
+        rewards = [1.0, 1.0, 1.0]
+        values = [0.5, 0.5, 0.5]
+        targets = vnt.compute_td_lambda_targets(rewards, values)
+        assert len(targets) == 3
+        assert all(isinstance(t, float) for t in targets)
+
+    def test_get_prediction_errors(self):
+        vnt = ValueNetworkTrainer()
+        # Train once so weights are initialized
+        vnt.train_step({"states": [[1, 2]], "td_targets": [1.0]})
+        errors = vnt.get_prediction_errors([[1, 2]], [1.0])
+        assert len(errors) == 1
+        assert isinstance(errors[0], float)
+
+    def test_separate_lr_from_policy(self):
+        vnt = ValueNetworkTrainer(lr=5e-4)
+        assert vnt.lr == pytest.approx(5e-4)
+
+    def test_invalid_batch_raises(self):
+        vnt = ValueNetworkTrainer()
+        with pytest.raises(ValueError):
+            vnt.train_step({})
+
+    def test_multiple_steps_decrease_loss(self):
+        vnt = ValueNetworkTrainer(lr=0.1)
+        batch = {"states": [[1.0, 0.0]], "td_targets": [1.0]}
+        loss1 = vnt.train_step(batch)["value_loss"]
+        for _ in range(10):
+            vnt.train_step(batch)
+        loss2 = vnt.train_step(batch)["value_loss"]
+        # After many steps on same data, loss should decrease
+        assert loss2 <= loss1 + 0.1  # allow small tolerance
+
+    def test_evolution_callback(self):
+        events = []
+        vnt = ValueNetworkTrainer()
+        vnt.evolution_callback = lambda e: events.append(e)
+        vnt.train_step({"states": [[1]], "td_targets": [1.0]})
+        assert len(events) >= 1
+
+    def test_save_load_checkpoint(self):
+        vnt = ValueNetworkTrainer(lr=1e-3)
+        vnt.train_step({"states": [[1]], "td_targets": [0.5]})
+        ckpt = vnt.save_checkpoint()
+        vnt2 = ValueNetworkTrainer()
+        vnt2.load_checkpoint(ckpt)
+        assert vnt2.global_step == 1
