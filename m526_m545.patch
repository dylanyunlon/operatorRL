+"""Tests for M545 EvolutionFitnessLandscape — TDD, 10 tests."""
+import pytest, sys, os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "../.."))
+from agentos.governance.evolution_fitness_landscape import EvolutionFitnessLandscape
+
+class TestEvolutionFitnessLandscape:
+    def test_init(self):
+        efl = EvolutionFitnessLandscape()
+        assert efl.dimension_count == 0
+
+    def test_register_dimension(self):
+        efl = EvolutionFitnessLandscape()
+        efl.register_dimension("laning", weight=1.0)
+        efl.register_dimension("teamfight", weight=1.5)
+        assert efl.dimension_count == 2
+
+    def test_report_fitness(self):
+        efl = EvolutionFitnessLandscape()
+        efl.register_dimension("laning", weight=1.0)
+        efl.report("laning", 0.7)
+        efl.report("laning", 0.8)
+        h = efl.get_history("laning")
+        assert len(h) == 2
+
+    def test_build_landscape(self):
+        efl = EvolutionFitnessLandscape()
+        efl.register_dimension("laning", weight=1.0)
+        efl.register_dimension("teamfight", weight=1.0)
+        efl.report("laning", 0.7)
+        efl.report("teamfight", 0.5)
+        landscape = efl.build_landscape()
+        assert "laning" in landscape
+        assert "teamfight" in landscape
+
+    def test_detect_plateau(self):
+        efl = EvolutionFitnessLandscape(plateau_window=5, plateau_threshold=0.02)
+        efl.register_dimension("laning", weight=1.0)
+        for _ in range(10):
+            efl.report("laning", 0.7)
+        plateaus = efl.detect_plateaus()
+        assert "laning" in plateaus
+
+    def test_recommend_direction(self):
+        efl = EvolutionFitnessLandscape()
+        efl.register_dimension("laning", weight=1.0)
+        efl.register_dimension("macro", weight=1.0)
+        efl.register_dimension("teamfight", weight=1.0)
+        for i in range(5):
+            efl.report("laning", 0.5 + i*0.05)
+            efl.report("macro", 0.3)
+            efl.report("teamfight", 0.8)
+        rec = efl.recommend_evolution_direction()
+        assert rec["dimension"] == "macro"  # lowest, most room to improve
+
+    def test_evolution_path_plan(self):
+        efl = EvolutionFitnessLandscape()
+        efl.register_dimension("laning", weight=1.0)
+        efl.register_dimension("vision", weight=1.0)
+        efl.report("laning", 0.6)
+        efl.report("vision", 0.3)
+        plan = efl.plan_evolution_path(target={"laning": 0.9, "vision": 0.8})
+        assert len(plan) >= 1
+
+    def test_global_fitness(self):
+        efl = EvolutionFitnessLandscape()
+        efl.register_dimension("a", weight=1.0)
+        efl.register_dimension("b", weight=1.0)
+        efl.report("a", 0.8)
+        efl.report("b", 0.6)
+        gf = efl.global_fitness()
+        assert 0.6 <= gf <= 0.8
+
+    def test_evolution_callback(self):
+        events = []
+        efl = EvolutionFitnessLandscape()
+        efl.evolution_callback = lambda e: events.append(e)
+        efl.register_dimension("a", weight=1.0)
+        efl.report("a", 0.5)
+        assert len(events) >= 1
+
+    def test_no_history_returns_empty(self):
+        efl = EvolutionFitnessLandscape()
+        assert efl.get_history("nonexist") == []
