++
++class ModelRegistry:
++    """Unified model registry with multi-dimensional query and lineage.
++
++    Supports publishing, querying by game/stage/elo, deployment
++    status tracking, and parent→child lineage.
++
++    Attributes:
++        model_count: Number of registered models.
++    """
++
++    def __init__(self) -> None:
++        # name -> {game, stage, elo, weights, parent, published_at}
++        self._models: Dict[str, Dict[str, Any]] = {}
++        self.evolution_callback: Optional[Callable[[Dict], None]] = None
++
++    @property
++    def model_count(self) -> int:
++        return len(self._models)
++
++    # -------------------------------------------------------------------
++    # Publish
++    # -------------------------------------------------------------------
++
++    def publish(
++        self,
++        name: str,
++        game: str,
++        stage: str,
++        elo: float,
++        weights: Dict[str, Any],
++        parent: Optional[str] = None,
++    ) -> None:
++        """Publish a model to the registry.
++
++        Args:
++            name: Unique model name.
++            game: Game type (lol, dota2, mahjong).
++            stage: Deployment stage (training/staging/production/deprecated).
++            elo: Current Elo rating.
++            weights: Model weights.
++            parent: Parent model name for lineage.
++        """
++        self._models[name] = {
++            "name": name,
++            "game": game,
++            "stage": stage,
++            "elo": elo,
++            "weights": weights,
++            "parent": parent,
++            "published_at": time.time(),
++        }
++        self._fire_evolution({
++            "event": "model_published",
++            "name": name,
++            "game": game,
++            "stage": stage,
++        })
++
++    # -------------------------------------------------------------------
++    # Query
++    # -------------------------------------------------------------------
++
++    def query(
++        self,
++        game: Optional[str] = None,
++        stage: Optional[str] = None,
++        min_elo: Optional[float] = None,
++        max_elo: Optional[float] = None,
++    ) -> List[Dict[str, Any]]:
++        """Multi-dimensional model query."""
++        results = []
++        for info in self._models.values():
++            if game is not None and info["game"] != game:
++                continue
++            if stage is not None and info["stage"] != stage:
++                continue
++            if min_elo is not None and info["elo"] < min_elo:
++                continue
++            if max_elo is not None and info["elo"] > max_elo:
++                continue
++            results.append(dict(info))
++        return results
++
++    # -------------------------------------------------------------------
++    # Load
++    # -------------------------------------------------------------------
++
++    def load(self, name: str) -> Dict[str, Any]:
++        """Load model weights by name.
++
++        Raises:
++            KeyError: If model not found.
++        """
++        if name not in self._models:
++            raise KeyError(f"Model '{name}' not found")
++        return self._models[name]["weights"]
++
++    def get_info(self, name: str) -> Dict[str, Any]:
++        if name not in self._models:
++            raise KeyError(f"Model '{name}' not found")
++        return dict(self._models[name])
++
++    # -------------------------------------------------------------------
++    # Deployment status
++    # -------------------------------------------------------------------
++
++    def set_status(self, name: str, stage: str) -> None:
++        if name not in self._models:
++            raise KeyError(f"Model '{name}' not found")
++        self._models[name]["stage"] = stage
++
++    # -------------------------------------------------------------------
++    # Lineage tracking
++    # -------------------------------------------------------------------
++
++    def get_lineage(self, name: str) -> List[str]:
++        """Trace lineage from root to this model."""
++        chain = []
++        current = name
++        visited = set()
++        while current is not None and current not in visited:
++            visited.add(current)
++            chain.append(current)
++            if current in self._models:
++                current = self._models[current].get("parent")
++            else:
++                break
++        chain.reverse()
++        return chain
++
++    # -------------------------------------------------------------------
++    # Evolution callback
++    # -------------------------------------------------------------------
++
++    def _fire_evolution(self, payload: Dict[str, Any]) -> None:
++        if self.evolution_callback is not None:
++            try:
++                self.evolution_callback({
++                    "source": _EVOLUTION_KEY,
++                    "timestamp": time.time(),
++                    **payload,
++                })
++            except Exception as exc:
++                logger.warning("Evolution callback error: %s", exc)
