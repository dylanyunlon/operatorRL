+"""Tests for M541 TrainingDashboard — TDD, 10 tests."""
+import pytest, sys, os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "../.."))
+from agentos.governance.training_dashboard import TrainingDashboard
+
+class TestTrainingDashboard:
+    def test_init(self):
+        td = TrainingDashboard()
+        assert td.metric_count == 0
+
+    def test_record_metric(self):
+        td = TrainingDashboard()
+        td.record("loss", 0.5, step=1)
+        td.record("loss", 0.3, step=2)
+        assert td.metric_count == 1  # one metric name
+        assert len(td.get_history("loss")) == 2
+
+    def test_record_multiple_metrics(self):
+        td = TrainingDashboard()
+        td.record("loss", 0.5, step=1)
+        td.record("reward", 1.0, step=1)
+        td.record("elo", 1200, step=1)
+        assert td.metric_count == 3
+
+    def test_query_time_window(self):
+        td = TrainingDashboard()
+        for i in range(10):
+            td.record("loss", float(i), step=i, timestamp=float(i))
+        window = td.query("loss", from_time=3.0, to_time=7.0)
+        assert all(3.0 <= w["timestamp"] <= 7.0 for w in window)
+
+    def test_generate_text_report(self):
+        td = TrainingDashboard()
+        td.record("loss", 0.5, step=1)
+        td.record("loss", 0.3, step=2)
+        report = td.generate_report(fmt="text")
+        assert isinstance(report, str)
+        assert "loss" in report
+
+    def test_generate_json_report(self):
+        td = TrainingDashboard()
+        td.record("winrate", 0.55, step=1)
+        report = td.generate_report(fmt="json")
+        assert isinstance(report, dict)
+        assert "winrate" in report
+
+    def test_detect_anomaly(self):
+        td = TrainingDashboard()
+        for i in range(20):
+            td.record("loss", 0.5, step=i)
+        td.record("loss", 100.0, step=20)  # anomaly
+        anomalies = td.detect_anomalies("loss")
+        assert len(anomalies) >= 1
+
+    def test_trend_detection(self):
+        td = TrainingDashboard()
+        for i in range(10):
+            td.record("reward", float(i), step=i)
+        trend = td.get_trend("reward")
+        assert trend == "improving"
+
+    def test_evolution_callback(self):
+        events = []
+        td = TrainingDashboard()
+        td.evolution_callback = lambda e: events.append(e)
+        td.record("loss", 0.5, step=1)
+        assert len(events) >= 1
+
+    def test_missing_metric_returns_empty(self):
+        td = TrainingDashboard()
+        assert td.get_history("nonexist") == []
