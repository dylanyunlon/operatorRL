++
++class StateEncoderNetwork:
++    """Multi-type state encoder with auto feature-type detection.
++
++    Supports numeric (MLP), categorical (embedding), and
++    sequence (RNN-like) sub-encoders, fused to unified output_dim.
++
++    Attributes:
++        output_dim: Dimension of output embedding.
++    """
++
++    def __init__(self, output_dim: int = 64) -> None:
++        self.output_dim = output_dim
++        self.features: Dict[str, Dict[str, Any]] = {}
++        # feature_name -> {ftype, weights, ...}
++        self.evolution_callback: Optional[Callable[[Dict], None]] = None
++
++    # -------------------------------------------------------------------
++    # Feature registration
++    # -------------------------------------------------------------------
++
++    def register_feature(
++        self,
++        name: str,
++        ftype: str = "numeric",
++        input_dim: int = 1,
++        num_categories: int = 10,
++        seq_dim: int = 4,
++    ) -> None:
++        """Register a feature with its encoding type.
++
++        Args:
++            name: Feature name.
++            ftype: 'numeric', 'categorical', or 'sequence'.
++            input_dim: Input dimension for numeric features.
++            num_categories: Number of categories for categorical.
++            seq_dim: Input dimension per step for sequence.
++        """
++        if ftype == "numeric":
++            # Linear projection weights: input_dim -> output_dim
++            weights = [[0.01 * ((i * 7 + j * 13) % 17 - 8) / 8.0
++                        for j in range(self.output_dim)]
++                       for i in range(input_dim)]
++            self.features[name] = {"ftype": ftype, "input_dim": input_dim, "weights": weights}
++
++        elif ftype == "categorical":
++            # Embedding table: num_categories -> output_dim
++            table = [[0.01 * ((i * 11 + j * 3) % 19 - 9) / 9.0
++                      for j in range(self.output_dim)]
++                     for i in range(num_categories)]
++            self.features[name] = {"ftype": ftype, "num_categories": num_categories, "table": table}
++
++        elif ftype == "sequence":
++            # Simple average pooling + linear
++            weights = [[0.01 * ((i * 5 + j * 7) % 13 - 6) / 6.0
++                        for j in range(self.output_dim)]
++                       for i in range(seq_dim)]
++            self.features[name] = {"ftype": ftype, "seq_dim": seq_dim, "weights": weights}
++
++    # -------------------------------------------------------------------
++    # Encoding
++    # -------------------------------------------------------------------
++
++    def encode(self, state: Dict[str, Any]) -> List[float]:
++        """Encode a game state to unified embedding.
++
++        Args:
++            state: Feature name -> value mapping.
++
++        Returns:
++            Embedding vector of length output_dim.
++
++        Raises:
++            ValueError: If no features registered or state empty.
++        """
++        if not self.features:
++            raise ValueError("No features registered")
++        if not state:
++            raise ValueError("Empty state")
++
++        embedding = [0.0] * self.output_dim
++        count = 0
++
++        for name, value in state.items():
++            if name not in self.features:
++                continue
++            feat = self.features[name]
++            ftype = feat["ftype"]
++
++            if ftype == "numeric":
++                sub = self._encode_numeric(value, feat["weights"])
++            elif ftype == "categorical":
++                sub = self._encode_categorical(value, feat["table"])
++            elif ftype == "sequence":
++                sub = self._encode_sequence(value, feat["weights"])
++            else:
++                continue
++
++            for i in range(self.output_dim):
++                embedding[i] += sub[i]
++            count += 1
++
++        # Average fusion
++        if count > 0:
++            embedding = [v / count for v in embedding]
++
++        self._fire_evolution({"event": "state_encoded", "features_used": count})
++        return embedding
++
++    def _encode_numeric(self, values: Any, weights: List[List[float]]) -> List[float]:
++        """MLP-style linear encoding for numeric features."""
++        if not isinstance(values, list):
++            values = [values]
++        result = [0.0] * self.output_dim
++        for i, v in enumerate(values):
++            if i < len(weights):
++                for j in range(self.output_dim):
++                    result[j] += float(v) * weights[i][j]
++        return result
++
++    def _encode_categorical(self, value: int, table: List[List[float]]) -> List[float]:
++        """Embedding lookup for categorical features."""
++        idx = int(value) % len(table)
++        return list(table[idx])
++
++    def _encode_sequence(self, values: Any, weights: List[List[float]]) -> List[float]:
++        """Average-pool + linear for sequence features."""
++        if not isinstance(values, list) or not values:
++            return [0.0] * self.output_dim
++        # Average across sequence steps
++        seq_len = len(values)
++        dim = len(values[0]) if isinstance(values[0], list) else 1
++        avg = [0.0] * dim
++        for step in values:
++            if isinstance(step, list):
++                for k in range(min(dim, len(step))):
++                    avg[k] += step[k]
++            else:
++                avg[0] += float(step)
++        avg = [v / seq_len for v in avg]
++
++        # Linear projection
++        result = [0.0] * self.output_dim
++        for i in range(min(dim, len(weights))):
++            for j in range(self.output_dim):
++                result[j] += avg[i] * weights[i][j]
++        return result
++
++    # -------------------------------------------------------------------
++    # Auto-detect feature type
++    # -------------------------------------------------------------------
++
++    def detect_feature_type(self, value: Any) -> str:
++        if isinstance(value, int):
++            return "categorical"
++        if isinstance(value, list):
++            if value and isinstance(value[0], list):
++                return "sequence"
++            return "numeric"
++        if isinstance(value, float):
++            return "numeric"
++        return "numeric"
++
++    # -------------------------------------------------------------------
++    # Checkpoint
++    # -------------------------------------------------------------------
++
++    def save_checkpoint(self) -> Dict[str, Any]:
++        return {"output_dim": self.output_dim, "features": dict(self.features)}
++
++    def load_checkpoint(self, ckpt: Dict[str, Any]) -> None:
++        self.output_dim = ckpt.get("output_dim", self.output_dim)
++        self.features = dict(ckpt.get("features", {}))
++
