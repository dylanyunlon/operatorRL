+"""
+RL Reward Designer — Dynamic multi-dimensional reward shaping.
+
+Provides unified reward computation across games (LoL/Dota2/Mahjong),
+with dynamic weight adjustment based on agent weakness detection.
+
+Location: agentlightning/trainer/rl_reward_designer.py
+
+Reference (拿来主义):
+  - DI-star/distar/agent/default/rl_learner.py: ReinforcementLoss reward computation
+  - integrations/lol/src/lol_agent/reward_shaper.py: multi-dim reward weighting
+  - PARL: reward normalization patterns
+  - agentlightning/trainer/lol_trainer.py: evolution callback pattern
+"""
+
+from __future__ import annotations
+
+import logging
+import math
+import time
+from collections import defaultdict
+from typing import Any, Callable, Dict, List, Optional, Tuple
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "agentlightning.trainer.rl_reward_designer.v1"
+
+
+# ---------------------------------------------------------------------------
+# Helpers — adapted from DI-star ReinforcementLoss value-clamp pattern
+# ---------------------------------------------------------------------------
+
+def _clamp(value: float, low: float, high: float) -> float:
+    """Clamp *value* to [low, high]."""
+    return max(low, min(high, value))
+
+
+def _normalize(value: float, low: float, high: float) -> float:
+    """Linearly map *value* from [low, high] to [0, 1]."""
+    if high <= low:
+        return 0.0
+    return _clamp((value - low) / (high - low), 0.0, 1.0)
+
+
+def _softmax_weights(scores: Dict[str, float]) -> Dict[str, float]:
+    """Return softmax-normalized weights from raw scores."""
+    if not scores:
+        return {}
+    max_s = max(scores.values())
+    exps = {k: math.exp(v - max_s) for k, v in scores.items()}
+    total = sum(exps.values()) or 1.0
+    return {k: v / total for k, v in exps.items()}
+
+
+# ---------------------------------------------------------------------------
+# Core class
+# ---------------------------------------------------------------------------
+
+class RlRewardDesigner:
+    """Dynamic multi-dimensional reward designer.
+
+    Registers reward dimensions (win, kda, cs, vision, …), computes
+    weighted normalized rewards, and auto-adjusts weights toward the
+    agent's weakest dimensions.
+
+    Follows the interface-separation pattern of DI-star's
+    ReinforcementLoss (loss class independent from learner class).
+
+    Attributes:
+        dimensions: Registered reward dimensions keyed by name.
+        evolution_callback: Optional evolution event callback.
+    """
+
+    # -------------------------------------------------------------------
+    # Construction
+    # -------------------------------------------------------------------
+
+    def __init__(self) -> None:
+        # name -> {weight, bounds, game, ...}
+        self.dimensions: Dict[str, Dict[str, Any]] = {}
+        # game -> [dim_name, ...]
+        self._game_index: Dict[str, List[str]] = defaultdict(list)
+        # history of computed rewards
+        self._reward_history: List[Dict[str, Any]] = []
+        self._weight_history: List[Dict[str, float]] = []
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+
+    # -------------------------------------------------------------------
+    # Registration — mirrors reward_shaper.py multi-dim registration
+    # -------------------------------------------------------------------
+
+    def register_dimension(
+        self,
+        name: str,
+        weight: float = 1.0,
+        bounds: Tuple[float, float] = (0.0, 1.0),
+        game: str = "_global",
+    ) -> None:
+        """Register a reward dimension.
+
+        Args:
+            name: Dimension name (e.g. 'win', 'kda').
+            weight: Initial weight for this dimension.
+            bounds: (min, max) raw value range for normalization.
+            game: Game this dimension belongs to ('_global' = all).
+        """
+        key = f"{game}::{name}" if game != "_global" else name
+        self.dimensions[key] = {
+            "name": name,
+            "weight": weight,
+            "bounds": bounds,
+            "game": game,
+        }
+        self._game_index[game].append(key)
+
+    # -------------------------------------------------------------------
+    # Reward computation
+    # -------------------------------------------------------------------
+
+    def compute_reward(
+        self,
+        raw_values: Dict[str, float],
+        game: str = "_global",
+    ) -> float:
+        """Compute weighted normalized reward.
+
+        Follows DI-star pattern: each dimension normalized independently,
+        then weighted-sum aggregated.
+
+        Args:
+            raw_values: dim_name -> raw value.
+            game: Game context for game-specific dims.
+
+        Returns:
+            Aggregated scalar reward ∈ [0, 1].
+        """
+        total_w = 0.0
+        weighted_sum = 0.0
+
+        for key, dim in self.dimensions.items():
+            dim_name = dim["name"]
+            if dim_name not in raw_values:
+                continue
+            if dim["game"] not in ("_global", game):
+                continue
+
+            low, high = dim["bounds"]
+            normed = _normalize(raw_values[dim_name], low, high)
+            w = dim["weight"]
+            weighted_sum += normed * w
+            total_w += w
+
+        reward = weighted_sum / total_w if total_w > 0 else 0.0
+        reward = _clamp(reward, 0.0, 1.0)
+
+        entry = {"reward": reward, "raw": dict(raw_values), "game": game,
+                 "timestamp": time.time()}
+        self._reward_history.append(entry)
+
+        self._fire_evolution({
+            "event": "reward_computed",
+            "reward": reward,
+            "game": game,
+        })
+
+        return reward
+
+    # -------------------------------------------------------------------
+    # Dynamic weight adjustment — weakness-driven
+    # -------------------------------------------------------------------
+
+    def adjust_weights(
+        self,
+        performance: Dict[str, float],
+        adjustment_rate: float = 0.3,
+    ) -> None:
+        """Adjust dimension weights toward agent weaknesses.
+
+        Dimensions where performance is low get higher weights,
+        following the inverse-performance heuristic from DI-star
+        reward shaping.
+
+        Args:
+            performance: dim_name -> performance score ∈ [0, 1].
+            adjustment_rate: How aggressively to shift weights (0-1).
+        """
+        if not performance:
+            return
+
+        # Compute inverse-performance scores
+        inv_scores: Dict[str, float] = {}
+        for key, dim in self.dimensions.items():
+            dim_name = dim["name"]
+            if dim_name in performance:
+                perf = _clamp(performance[dim_name], 0.01, 1.0)
+                inv_scores[key] = 1.0 / perf
+
+        if not inv_scores:
+            return
+
+        # Softmax to get target weight distribution
+        target_dist = _softmax_weights(inv_scores)
+
+        # Blend current weights toward target
+        total_current = sum(self.dimensions[k]["weight"] for k in inv_scores)
+        if total_current <= 0:
+            total_current = 1.0
+
+        for key in inv_scores:
+            current_w = self.dimensions[key]["weight"]
+            target_w = target_dist[key] * total_current * len(inv_scores)
+            new_w = current_w * (1 - adjustment_rate) + target_w * adjustment_rate
+            self.dimensions[key]["weight"] = max(new_w, 0.01)
+
+        snapshot = self.get_weight_snapshot()
+        self._weight_history.append(snapshot)
+
+        self._fire_evolution({
+            "event": "weights_adjusted",
+            "new_weights": snapshot,
+        })
+
+    # -------------------------------------------------------------------
+    # Multi-game interface
+    # -------------------------------------------------------------------
+
+    def list_games(self) -> List[str]:
+        """Return list of registered game identifiers."""
+        return [g for g in self._game_index if g != "_global"]
+
+    def get_game_dimensions(self, game: str) -> List[str]:
+        """Return dimension keys for a specific game."""
+        return list(self._game_index.get(game, []))
+
+    # -------------------------------------------------------------------
+    # Inspection
+    # -------------------------------------------------------------------
+
+    def get_weight_snapshot(self) -> Dict[str, float]:
+        """Return current weight for each dimension (by dim name)."""
+        result: Dict[str, float] = {}
+        for key, dim in self.dimensions.items():
+            label = dim["name"] if dim["game"] == "_global" else f"{dim['game']}::{dim['name']}"
+            result[label] = dim["weight"]
+        return result
+
+    def global_weight_sum(self) -> float:
+        """Sum of all dimension weights."""
+        return sum(d["weight"] for d in self.dimensions.values())
+
+    def get_reward_history(self, last_n: int = 50) -> List[Dict[str, Any]]:
+        """Return recent reward computation history."""
+        return list(self._reward_history[-last_n:])
+
+    # -------------------------------------------------------------------
+    # Checkpoint — mirrors lol_trainer.py save/load contract
+    # -------------------------------------------------------------------
+
+    def save_checkpoint(self) -> Dict[str, Any]:
+        """Serialize designer state."""
+        return {
+            "dimensions": {k: dict(v) for k, v in self.dimensions.items()},
+            "game_index": {k: list(v) for k, v in self._game_index.items()},
+        }
+
+    def load_checkpoint(self, ckpt: Dict[str, Any]) -> None:
+        """Restore designer state."""
+        self.dimensions = {k: dict(v) for k, v in ckpt.get("dimensions", {}).items()}
+        self._game_index = defaultdict(list)
+        for k, v in ckpt.get("game_index", {}).items():
+            self._game_index[k] = list(v)
+
+    # -------------------------------------------------------------------
+    # Evolution callback — standard pattern from lol_trainer.py
+    # -------------------------------------------------------------------
+
+    def _fire_evolution(self, payload: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            try:
+                self.evolution_callback({
+                    "source": _EVOLUTION_KEY,
+                    "timestamp": time.time(),
+                    **payload,
+                })
+            except Exception as exc:
+                logger.warning("Evolution callback error: %s", exc)
