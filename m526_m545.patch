+"""Tests for M533 SelfPlayArena — TDD, 10 tests."""
+import pytest, sys, os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "../.."))
+from agentlightning.trainer.self_play_arena import SelfPlayArena
+
+class TestSelfPlayArena:
+    def test_init(self):
+        spa = SelfPlayArena()
+        assert spa.pool_size == 0
+
+    def test_add_policy(self):
+        spa = SelfPlayArena()
+        spa.add_policy("v1", elo=1000)
+        spa.add_policy("v2", elo=1000)
+        assert spa.pool_size == 2
+
+    def test_schedule_round_robin(self):
+        spa = SelfPlayArena(mode="round_robin")
+        spa.add_policy("v1", elo=1000)
+        spa.add_policy("v2", elo=1200)
+        matches = spa.schedule_round()
+        assert len(matches) >= 1
+
+    def test_schedule_elimination(self):
+        spa = SelfPlayArena(mode="elimination")
+        for i in range(4):
+            spa.add_policy(f"v{i}", elo=1000+i*100)
+        matches = spa.schedule_round()
+        assert len(matches) == 2
+
+    def test_record_and_update_elo(self):
+        spa = SelfPlayArena()
+        spa.add_policy("v1", elo=1000)
+        spa.add_policy("v2", elo=1000)
+        spa.record_result("v1", "v2", winner="v1")
+        assert spa.get_elo("v1") > 1000
+        assert spa.get_elo("v2") < 1000
+
+    def test_get_trajectories(self):
+        spa = SelfPlayArena()
+        spa.add_policy("v1", elo=1000)
+        spa.add_policy("v2", elo=1000)
+        spa.record_result("v1", "v2", winner="v1", trajectory=[{"s": 1}])
+        trajs = spa.get_trajectories()
+        assert len(trajs) >= 1
+
+    def test_get_rankings(self):
+        spa = SelfPlayArena()
+        spa.add_policy("v1", elo=1200)
+        spa.add_policy("v2", elo=1000)
+        rankings = spa.get_rankings()
+        assert rankings[0][0] == "v1"
+
+    def test_less_than_2_no_schedule(self):
+        spa = SelfPlayArena()
+        spa.add_policy("v1", elo=1000)
+        assert spa.schedule_round() == []
+
+    def test_evolution_callback(self):
+        events = []
+        spa = SelfPlayArena()
+        spa.evolution_callback = lambda e: events.append(e)
+        spa.add_policy("v1", elo=1000)
+        spa.add_policy("v2", elo=1000)
+        spa.record_result("v1", "v2", winner="v1")
+        assert len(events) >= 1
+
+    def test_match_history(self):
+        spa = SelfPlayArena()
+        spa.add_policy("a", elo=1000)
+        spa.add_policy("b", elo=1000)
+        spa.record_result("a", "b", winner="a")
+        assert len(spa.match_history) == 1
