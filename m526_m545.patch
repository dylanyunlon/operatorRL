+"""
+Model Ensemble — Multi-model fusion with dynamic weight adjustment.
+
+Location: agentlightning/inference/model_ensemble.py
+
+Reference (拿来主義):
+  - Akagi/mjai_bot/: unified bot interface (react method)
+  - agentlightning/adapter/base.py: Adapter[T_from,T_to] generic wrapping
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "agentlightning.inference.model_ensemble.v1"
+
+
+class ModelEnsemble:
+    """Multi-model ensemble with voting and weighted average fusion.
+
+    Wraps multiple predict functions behind a unified interface.
+    Adjusts model weights based on historical performance.
+
+    Attributes:
+        fusion: 'vote' or 'weighted_avg'.
+    """
+
+    def __init__(self, fusion: str = "weighted_avg") -> None:
+        self.fusion = fusion
+        self._models: Dict[str, Dict[str, Any]] = {}
+        self._performance: Dict[str, List[float]] = {}
+        self._last_contributions: Dict[str, List[float]] = {}
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+
+    @property
+    def model_count(self) -> int:
+        return len(self._models)
+
+    # -------------------------------------------------------------------
+    # Model management
+    # -------------------------------------------------------------------
+
+    def add_model(
+        self,
+        model_id: str,
+        predict_fn: Callable[[Any], List[float]],
+        weight: float = 1.0,
+    ) -> None:
+        self._models[model_id] = {
+            "predict_fn": predict_fn,
+            "weight": weight,
+        }
+        self._performance[model_id] = []
+
+    def remove_model(self, model_id: str) -> None:
+        self._models.pop(model_id, None)
+        self._performance.pop(model_id, None)
+
+    def list_models(self) -> List[str]:
+        return list(self._models.keys())
+
+    def get_weight(self, model_id: str) -> float:
+        return self._models.get(model_id, {}).get("weight", 0.0)
+
+    # -------------------------------------------------------------------
+    # Prediction
+    # -------------------------------------------------------------------
+
+    def predict(self, state: Any) -> List[float]:
+        """Fused prediction from all models.
+
+        Args:
+            state: Input state for prediction.
+
+        Returns:
+            Fused output vector.
+
+        Raises:
+            ValueError: If no models registered.
+        """
+        if not self._models:
+            raise ValueError("No models in ensemble")
+
+        outputs: Dict[str, List[float]] = {}
+        for mid, info in self._models.items():
+            try:
+                outputs[mid] = info["predict_fn"](state)
+            except Exception as exc:
+                logger.warning("Model '%s' prediction error: %s", mid, exc)
+
+        if not outputs:
+            raise ValueError("All models failed")
+
+        if self.fusion == "vote":
+            result = self._vote_fusion(outputs)
+        else:
+            result = self._weighted_avg_fusion(outputs)
+
+        self._last_contributions = {
+            mid: out for mid, out in outputs.items()
+        }
+        self._fire_evolution({"event": "ensemble_predict", "models_used": len(outputs)})
+        return result
+
+    def _vote_fusion(self, outputs: Dict[str, List[float]]) -> List[float]:
+        """Majority vote on argmax action, return averaged logits."""
+        if not outputs:
+            return []
+        dim = len(next(iter(outputs.values())))
+        avg = [0.0] * dim
+        for out in outputs.values():
+            for i in range(min(dim, len(out))):
+                avg[i] += out[i]
+        return [v / len(outputs) for v in avg]
+
+    def _weighted_avg_fusion(self, outputs: Dict[str, List[float]]) -> List[float]:
+        """Weighted average of model outputs."""
+        if not outputs:
+            return []
+        dim = len(next(iter(outputs.values())))
+        result = [0.0] * dim
+        total_w = 0.0
+        for mid, out in outputs.items():
+            w = self._models[mid]["weight"]
+            total_w += w
+            for i in range(min(dim, len(out))):
+                result[i] += out[i] * w
+        if total_w > 0:
+            result = [v / total_w for v in result]
+        return result
+
+    # -------------------------------------------------------------------
+    # Dynamic weight adjustment
+    # -------------------------------------------------------------------
+
+    def record_performance(self, model_id: str, score: float) -> None:
+        if model_id in self._performance:
+            self._performance[model_id].append(score)
+
+    def update_weights_from_performance(self) -> None:
+        """Adjust weights based on recent performance scores."""
+        for mid in self._models:
+            scores = self._performance.get(mid, [])
+            if scores:
+                avg = sum(scores[-10:]) / len(scores[-10:])
+                self._models[mid]["weight"] = max(avg, 0.01)
+
+    def get_contributions(self) -> Dict[str, List[float]]:
+        return dict(self._last_contributions)
+
+    # -------------------------------------------------------------------
+    # Evolution callback
+    # -------------------------------------------------------------------
+
+    def _fire_evolution(self, payload: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            try:
+                self.evolution_callback({
+                    "source": _EVOLUTION_KEY,
+                    "timestamp": time.time(),
+                    **payload,
+                })
+            except Exception as exc:
+                logger.warning("Evolution callback error: %s", exc)
