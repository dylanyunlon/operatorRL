+"""
+Hyperparameter Tuner — Grid, random, and Bayesian search with early stopping.
+
+Location: agentos/governance/hyperparameter_tuner.py
+
+Reference (拿来主義):
+  - DI-star/rl_learner.py: cfg-based hyperparameter config
+  - agentlightning/trainer/lol_trainer.py: lr/gamma/clip encapsulation
+"""
+
+from __future__ import annotations
+
+import itertools
+import logging
+import random
+import time
+from typing import Any, Callable, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "agentos.governance.hyperparameter_tuner.v1"
+
+
+class HyperparameterTuner:
+    """Systematic hyperparameter search with early stopping.
+
+    Supports grid search, random search, and Bayesian optimization.
+
+    Attributes:
+        strategy: 'grid', 'random', or 'bayesian'.
+        max_trials: Max number of trials for random/bayesian.
+        early_stop_patience: Trials without improvement before stopping.
+    """
+
+    def __init__(
+        self,
+        strategy: str = "grid",
+        max_trials: int = 20,
+        early_stop_patience: int = 5,
+    ) -> None:
+        self.strategy = strategy
+        self.max_trials = max_trials
+        self.early_stop_patience = early_stop_patience
+        self.search_space: Dict[str, Dict[str, Any]] = {}
+        self.trial_history: List[Dict[str, Any]] = []
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+
+    # -------------------------------------------------------------------
+    # Search space definition
+    # -------------------------------------------------------------------
+
+    def define_param(
+        self,
+        name: str,
+        values: Optional[List[Any]] = None,
+        low: Optional[float] = None,
+        high: Optional[float] = None,
+    ) -> None:
+        """Define a hyperparameter search space."""
+        self.search_space[name] = {
+            "values": values,
+            "low": low,
+            "high": high,
+        }
+
+    # -------------------------------------------------------------------
+    # Config generation
+    # -------------------------------------------------------------------
+
+    def generate_configs(self) -> List[Dict[str, Any]]:
+        """Generate all config combinations based on strategy."""
+        if self.strategy == "grid":
+            return self._grid_configs()
+        elif self.strategy == "random":
+            return self._random_configs()
+        elif self.strategy == "bayesian":
+            return [self.suggest_next() for _ in range(self.max_trials)]
+        return []
+
+    def _grid_configs(self) -> List[Dict[str, Any]]:
+        names = list(self.search_space.keys())
+        value_lists = []
+        for name in names:
+            sp = self.search_space[name]
+            if sp["values"] is not None:
+                value_lists.append(sp["values"])
+            elif sp["low"] is not None and sp["high"] is not None:
+                # Sample 5 evenly spaced values
+                lo, hi = sp["low"], sp["high"]
+                value_lists.append([lo + (hi - lo) * i / 4 for i in range(5)])
+            else:
+                value_lists.append([None])
+
+        configs = []
+        for combo in itertools.product(*value_lists):
+            configs.append(dict(zip(names, combo)))
+        return configs
+
+    def _random_configs(self) -> List[Dict[str, Any]]:
+        configs = []
+        for _ in range(self.max_trials):
+            config = {}
+            for name, sp in self.search_space.items():
+                if sp["values"] is not None:
+                    config[name] = random.choice(sp["values"])
+                elif sp["low"] is not None and sp["high"] is not None:
+                    config[name] = random.uniform(sp["low"], sp["high"])
+            configs.append(config)
+        return configs
+
+    def suggest_next(self) -> Dict[str, Any]:
+        """Bayesian-style suggestion: exploit best + explore."""
+        config = {}
+        best = self.get_best_config()
+        for name, sp in self.search_space.items():
+            if sp["low"] is not None and sp["high"] is not None:
+                lo, hi = sp["low"], sp["high"]
+                if best and name in best.get("config", {}):
+                    center = best["config"][name]
+                    spread = (hi - lo) * 0.2
+                    val = center + random.gauss(0, spread)
+                    val = max(lo, min(hi, val))
+                else:
+                    val = random.uniform(lo, hi)
+                config[name] = val
+            elif sp["values"] is not None:
+                config[name] = random.choice(sp["values"])
+        return config
+
+    # -------------------------------------------------------------------
+    # Trial management
+    # -------------------------------------------------------------------
+
+    def record_trial(
+        self,
+        config: Dict[str, Any],
+        score: float,
+        steps: int = 0,
+    ) -> None:
+        self.trial_history.append({
+            "config": dict(config),
+            "score": score,
+            "steps": steps,
+            "timestamp": time.time(),
+        })
+        self._fire_evolution({
+            "event": "trial_recorded",
+            "score": score,
+            "trial_num": len(self.trial_history),
+        })
+
+    def get_best_config(self) -> Optional[Dict[str, Any]]:
+        if not self.trial_history:
+            return None
+        return max(self.trial_history, key=lambda t: t["score"])
+
+    def apply_best(self) -> Dict[str, Any]:
+        """Return the best config for application."""
+        best = self.get_best_config()
+        if best is None:
+            return {}
+        return dict(best["config"])
+
+    # -------------------------------------------------------------------
+    # Early stopping
+    # -------------------------------------------------------------------
+
+    def should_early_stop(self, config: Dict[str, Any]) -> bool:
+        """Check if trials with similar config should stop."""
+        recent = self.trial_history[-self.early_stop_patience:]
+        if len(recent) < self.early_stop_patience:
+            return False
+        scores = [t["score"] for t in recent]
+        if max(scores) - min(scores) < 0.01:
+            return True
+        return False
+
+    # -------------------------------------------------------------------
+    # Evolution callback
+    # -------------------------------------------------------------------
+
+    def _fire_evolution(self, payload: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            try:
+                self.evolution_callback({
+                    "source": _EVOLUTION_KEY,
+                    "timestamp": time.time(),
+                    **payload,
+                })
+            except Exception as exc:
+                logger.warning("Evolution callback error: %s", exc)
