+"""Tests for M527 ExperienceReplayManager — TDD first, 10 tests."""
+import pytest
+import sys, os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "../.."))
+
+from agentlightning.trainer.experience_replay_manager import ExperienceReplayManager
+
+
+class TestExperienceReplayManager:
+    def test_init_empty(self):
+        erm = ExperienceReplayManager(capacity=1000)
+        assert len(erm) == 0
+
+    def test_add_and_len(self):
+        erm = ExperienceReplayManager(capacity=100)
+        for i in range(10):
+            erm.add(state=i, action=i, reward=float(i), next_state=i+1, done=False, td_error=1.0)
+        assert len(erm) == 10
+
+    def test_prioritized_sample_higher_td_error(self):
+        erm = ExperienceReplayManager(capacity=100, alpha=1.0)
+        erm.add(state=0, action=0, reward=0.0, next_state=1, done=False, td_error=0.01)
+        for i in range(1, 50):
+            erm.add(state=i, action=i, reward=float(i), next_state=i+1, done=False, td_error=10.0)
+        samples = erm.prioritized_sample(batch_size=20)
+        assert len(samples) == 20
+        # Most samples should have high td_error
+        high_td = sum(1 for s in samples if s["td_error"] > 5.0)
+        assert high_td > 10
+
+    def test_uniform_sample_fallback(self):
+        erm = ExperienceReplayManager(capacity=100)
+        for i in range(20):
+            erm.add(state=i, action=i, reward=1.0, next_state=i+1, done=False, td_error=1.0)
+        samples = erm.uniform_sample(batch_size=5)
+        assert len(samples) == 5
+
+    def test_her_relabel(self):
+        erm = ExperienceReplayManager(capacity=100)
+        trajectory = [
+            {"state": 0, "action": 0, "reward": 0.0, "next_state": 1, "done": False, "goal": "win"},
+            {"state": 1, "action": 1, "reward": 0.0, "next_state": 2, "done": True, "goal": "win"},
+        ]
+        relabeled = erm.her_relabel(trajectory, achieved_goal="survive")
+        assert len(relabeled) == 2
+        assert all(r["goal"] == "survive" for r in relabeled)
+        assert relabeled[-1]["reward"] != 0.0  # relabeled reward
+
+    def test_update_priorities(self):
+        erm = ExperienceReplayManager(capacity=100)
+        erm.add(state=0, action=0, reward=1.0, next_state=1, done=False, td_error=1.0)
+        erm.add(state=1, action=1, reward=2.0, next_state=2, done=False, td_error=2.0)
+        erm.update_priority(index=0, new_td_error=100.0)
+        assert erm.get_priority(0) > erm.get_priority(1)
+
+    def test_capacity_eviction(self):
+        erm = ExperienceReplayManager(capacity=5)
+        for i in range(10):
+            erm.add(state=i, action=i, reward=float(i), next_state=i+1, done=False, td_error=1.0)
+        assert len(erm) == 5
+
+    def test_sample_empty_returns_empty(self):
+        erm = ExperienceReplayManager(capacity=100)
+        assert erm.prioritized_sample(batch_size=5) == []
+
+    def test_get_statistics(self):
+        erm = ExperienceReplayManager(capacity=100)
+        for i in range(10):
+            erm.add(state=i, action=i, reward=float(i), next_state=i+1, done=False, td_error=float(i+1))
+        stats = erm.get_statistics()
+        assert "size" in stats
+        assert "mean_td_error" in stats
+        assert "max_td_error" in stats
+
+    def test_evolution_callback(self):
+        events = []
+        erm = ExperienceReplayManager(capacity=100)
+        erm.evolution_callback = lambda e: events.append(e)
+        erm.add(state=0, action=0, reward=1.0, next_state=1, done=False, td_error=1.0)
+        assert len(events) >= 1
