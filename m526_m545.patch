++"""
++Self-Play Arena — Multi-policy tournament with Elo and trajectory collection.
++
++Location: agentlightning/trainer/self_play_arena.py
++
++Reference (拿来主義):
++  - agentlightning/algorithm/self_play_scheduler.py: Elo, schedule_match, record_result
++  - agentlightning/trainer/lol_trainer.py: evolution callback pattern
++"""
++
++from __future__ import annotations
++
++import logging
++import time
++from typing import Any, Callable, Dict, List, Optional, Tuple
++
++logger = logging.getLogger(__name__)
++
++_EVOLUTION_KEY: str = "agentlightning.trainer.self_play_arena.v1"
++_K_FACTOR: float = 32.0
++
++
++class SelfPlayArena:
++    """Self-play arena with round-robin and elimination tournaments.
++
++    Extends SelfPlayScheduler with full tournament modes
++    and trajectory collection for training feedback loop.
++
++    Attributes:
++        mode: 'round_robin' or 'elimination'.
++    """
++
++    def __init__(self, mode: str = "round_robin") -> None:
++        self.mode = mode
++        self._policies: Dict[str, float] = {}  # id -> elo
++        self.match_history: List[Dict[str, Any]] = []
++        self._trajectories: List[Dict[str, Any]] = []
++        self.evolution_callback: Optional[Callable[[Dict], None]] = None
++
++    @property
++    def pool_size(self) -> int:
++        return len(self._policies)
++
++    # -------------------------------------------------------------------
++    # Policy management — mirrors self_play_scheduler.add_agent
++    # -------------------------------------------------------------------
++
++    def add_policy(self, policy_id: str, elo: float = 1000.0) -> None:
++        self._policies[policy_id] = elo
++
++    def get_elo(self, policy_id: str) -> float:
++        return self._policies.get(policy_id, 0.0)
++
++    def get_rankings(self) -> List[Tuple[str, float]]:
++        return sorted(self._policies.items(), key=lambda x: -x[1])
++
++    # -------------------------------------------------------------------
++    # Scheduling
++    # -------------------------------------------------------------------
++
++    def schedule_round(self) -> List[Dict[str, str]]:
++        """Schedule matches based on tournament mode."""
++        ids = list(self._policies.keys())
++        if len(ids) < 2:
++            return []
++
++        if self.mode == "round_robin":
++            matches = []
++            for i in range(len(ids)):
++                for j in range(i + 1, len(ids)):
++                    matches.append({"player_a": ids[i], "player_b": ids[j]})
++            return matches
++
++        elif self.mode == "elimination":
++            sorted_ids = [pid for pid, _ in self.get_rankings()]
++            matches = []
++            for i in range(0, len(sorted_ids) - 1, 2):
++                matches.append({"player_a": sorted_ids[i], "player_b": sorted_ids[i + 1]})
++            return matches
++
++        return []
++
++    # -------------------------------------------------------------------
++    # Record result and update Elo
++    # -------------------------------------------------------------------
++
++    def record_result(
++        self,
++        player_a: str,
++        player_b: str,
++        winner: str,
++        trajectory: Optional[List[Dict[str, Any]]] = None,
++    ) -> None:
++        """Record match result, update Elo, store trajectory."""
++        elo_a = self._policies.get(player_a, 1000)
++        elo_b = self._policies.get(player_b, 1000)
++
++        # Expected scores
++        ea = 1.0 / (1.0 + 10 ** ((elo_b - elo_a) / 400.0))
++        eb = 1.0 - ea
++
++        # Actual scores
++        sa = 1.0 if winner == player_a else 0.0
++        sb = 1.0 - sa
++
++        self._policies[player_a] = elo_a + _K_FACTOR * (sa - ea)
++        self._policies[player_b] = elo_b + _K_FACTOR * (sb - eb)
++
++        record = {
++            "player_a": player_a,
++            "player_b": player_b,
++            "winner": winner,
++            "elo_a_after": self._policies[player_a],
++            "elo_b_after": self._policies[player_b],
++            "timestamp": time.time(),
++        }
++        self.match_history.append(record)
++
++        if trajectory:
++            self._trajectories.append({
++                "match": record,
++                "trajectory": trajectory,
++            })
