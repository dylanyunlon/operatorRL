+"""Tests for M530 MultiAgentCoordinator — TDD first, 10 tests."""
+import pytest
+import sys, os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "../.."))
+
+from agentlightning.trainer.multi_agent_coordinator import MultiAgentCoordinator
+
+
+class TestMultiAgentCoordinator:
+    def test_init(self):
+        mac = MultiAgentCoordinator()
+        assert mac.agent_count == 0
+
+    def test_register_agent_with_role(self):
+        mac = MultiAgentCoordinator()
+        mac.register_agent("agent_1", role="TOP")
+        mac.register_agent("agent_2", role="JG")
+        assert mac.agent_count == 2
+        assert mac.get_role("agent_1") == "TOP"
+
+    def test_all_lol_roles(self):
+        mac = MultiAgentCoordinator()
+        for role in ["TOP", "JG", "MID", "ADC", "SUP"]:
+            mac.register_agent(f"agent_{role}", role=role)
+        assert mac.agent_count == 5
+        roles = mac.list_roles()
+        assert set(roles) == {"TOP", "JG", "MID", "ADC", "SUP"}
+
+    def test_broadcast_message(self):
+        mac = MultiAgentCoordinator()
+        mac.register_agent("a1", role="TOP")
+        mac.register_agent("a2", role="MID")
+        received = mac.broadcast({"type": "group", "target": "baron"})
+        assert len(received) == 2
+
+    def test_joint_action_selection(self):
+        mac = MultiAgentCoordinator()
+        mac.register_agent("a1", role="TOP")
+        mac.register_agent("a2", role="JG")
+        proposals = {"a1": {"action": "push", "confidence": 0.8},
+                     "a2": {"action": "gank", "confidence": 0.9}}
+        joint = mac.select_joint_action(proposals)
+        assert "a1" in joint
+        assert "a2" in joint
+
+    def test_differentiated_reward(self):
+        mac = MultiAgentCoordinator()
+        mac.register_agent("a1", role="ADC")
+        mac.register_agent("a2", role="SUP")
+        team_reward = 1.0
+        rewards = mac.distribute_reward(team_reward, contributions={"a1": 0.7, "a2": 0.3})
+        assert rewards["a1"] > rewards["a2"]
+        assert abs(sum(rewards.values()) - team_reward) < 0.01
+
+    def test_communication_channel(self):
+        mac = MultiAgentCoordinator()
+        mac.register_agent("a1", role="MID")
+        mac.register_agent("a2", role="JG")
+        mac.send_message("a1", "a2", {"type": "ping", "location": "river"})
+        msgs = mac.get_messages("a2")
+        assert len(msgs) == 1
+        assert msgs[0]["from"] == "a1"
+
+    def test_remove_agent(self):
+        mac = MultiAgentCoordinator()
+        mac.register_agent("a1", role="TOP")
+        mac.remove_agent("a1")
+        assert mac.agent_count == 0
+
+    def test_evolution_callback(self):
+        events = []
+        mac = MultiAgentCoordinator()
+        mac.evolution_callback = lambda e: events.append(e)
+        mac.register_agent("a1", role="TOP")
+        assert len(events) >= 1
+
+    def test_get_team_state(self):
+        mac = MultiAgentCoordinator()
+        mac.register_agent("a1", role="TOP")
+        mac.register_agent("a2", role="JG")
+        state = mac.get_team_state()
+        assert "agents" in state
+        assert len(state["agents"]) == 2
