+"""
+Training Checkpoint Manager — Auto-save with A/B testing support.
+
+Location: agentlightning/trainer/training_checkpoint_manager.py
+
+Reference (拿来主義):
+  - agentos/governance/model_versioner.py: save/load/rollback/diff
+  - agentlightning/trainer/lol_trainer.py: checkpoint contract
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "agentlightning.trainer.training_checkpoint_manager.v1"
+
+
+class TrainingCheckpointManager:
+    """Training checkpoint manager with auto-save and A/B testing.
+
+    Extends ModelVersioner's save/load pattern with:
+    - Step-interval auto-save
+    - A/B comparison between checkpoint versions
+
+    Attributes:
+        auto_save_interval: Steps between auto-saves (0 = disabled).
+    """
+
+    def __init__(self, auto_save_interval: int = 0) -> None:
+        self.auto_save_interval = auto_save_interval
+        # run_id -> [{step, data, saved_at}, ...]
+        self._store: Dict[str, List[Dict[str, Any]]] = {}
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+
+    def checkpoint_count(self) -> int:
+        return sum(len(v) for v in self._store.values())
+
+    # -------------------------------------------------------------------
+    # Save / Load — mirrors model_versioner.py
+    # -------------------------------------------------------------------
+
+    def save(self, run_id: str, step: int, data: Dict[str, Any]) -> None:
+        """Save a checkpoint."""
+        if run_id not in self._store:
+            self._store[run_id] = []
+        self._store[run_id].append({
+            "step": step,
+            "data": data,
+            "saved_at": time.time(),
+        })
+        self._fire_evolution({
+            "event": "checkpoint_saved",
+            "run_id": run_id,
+            "step": step,
+        })
+
+    def load(self, run_id: str, step: int) -> Dict[str, Any]:
+        """Load checkpoint by run and step.
+
+        Raises:
+            KeyError: If not found.
+        """
+        if run_id not in self._store:
+            raise KeyError(f"Run '{run_id}' not found")
+        for entry in self._store[run_id]:
+            if entry["step"] == step:
+                return entry["data"]
+        raise KeyError(f"Step {step} not found for run '{run_id}'")
+
+    def load_latest(self, run_id: str) -> Dict[str, Any]:
+        if run_id not in self._store or not self._store[run_id]:
+            raise KeyError(f"Run '{run_id}' not found or empty")
+        return self._store[run_id][-1]["data"]
+
+    def list_checkpoints(self, run_id: str) -> List[int]:
+        return [e["step"] for e in self._store.get(run_id, [])]
+
+    def delete(self, run_id: str, step: int) -> None:
+        if run_id in self._store:
+            self._store[run_id] = [
+                e for e in self._store[run_id] if e["step"] != step
+            ]
+
+    # -------------------------------------------------------------------
+    # Auto-save
+    # -------------------------------------------------------------------
+
+    def maybe_save(self, run_id: str, step: int, data: Dict[str, Any]) -> bool:
+        """Save if step is on auto-save interval boundary."""
+        if self.auto_save_interval <= 0:
+            return False
+        if step % self.auto_save_interval == 0:
+            self.save(run_id, step, data)
+            return True
+        return False
+
+    # -------------------------------------------------------------------
+    # A/B testing
+    # -------------------------------------------------------------------
+
+    def ab_compare(
+        self,
+        run_id: str,
+        step_a: int,
+        step_b: int,
+        eval_fn: Callable[[Dict[str, Any]], float],
+    ) -> Dict[str, Any]:
+        """Compare two checkpoints using eval function.
+
+        Args:
+            run_id: Run identifier.
+            step_a: First checkpoint step.
+            step_b: Second checkpoint step.
+            eval_fn: Function that scores checkpoint data.
+
+        Returns:
+            Dict with scores and winner.
+        """
+        data_a = self.load(run_id, step_a)
+        data_b = self.load(run_id, step_b)
+        score_a = eval_fn(data_a)
+        score_b = eval_fn(data_b)
+        winner = step_a if score_a >= score_b else step_b
+        return {
+            "step_a": step_a,
+            "score_a": score_a,
+            "step_b": step_b,
+            "score_b": score_b,
+            "winner_step": winner,
+        }
+
+    # -------------------------------------------------------------------
+    # Evolution callback
+    # -------------------------------------------------------------------
+
+    def _fire_evolution(self, payload: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            try:
+                self.evolution_callback({
+                    "source": _EVOLUTION_KEY,
+                    "timestamp": time.time(),
+                    **payload,
+                })
+            except Exception as exc:
+                logger.warning("Evolution callback error: %s", exc)
