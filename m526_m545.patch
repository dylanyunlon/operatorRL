+"""Tests for M528 PolicyGradientTrainer — TDD first, 10 tests."""
+import pytest
+import sys, os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "../.."))
+
+from agentlightning.trainer.policy_gradient_trainer import PolicyGradientTrainer
+
+
+class TestPolicyGradientTrainer:
+    def test_init_defaults(self):
+        pgt = PolicyGradientTrainer()
+        assert pgt.mode == "ppo"
+        assert pgt.global_step == 0
+
+    def test_init_reinforce_mode(self):
+        pgt = PolicyGradientTrainer(mode="reinforce")
+        assert pgt.mode == "reinforce"
+
+    def test_train_step_returns_metrics(self):
+        pgt = PolicyGradientTrainer()
+        batch = {
+            "states": [[1, 2], [3, 4]],
+            "actions": [0, 1],
+            "rewards": [1.0, 0.5],
+            "log_probs": [-0.5, -1.0],
+            "values": [0.8, 0.6],
+            "dones": [False, True],
+        }
+        metrics = pgt.train_step(batch)
+        assert "loss" in metrics
+        assert "step" in metrics
+        assert pgt.global_step == 1
+
+    def test_compute_gae(self):
+        pgt = PolicyGradientTrainer(gamma=0.99, gae_lambda=0.95)
+        rewards = [1.0, 1.0, 1.0]
+        values = [0.5, 0.5, 0.5, 0.0]
+        advantages = pgt.compute_gae(rewards, values)
+        assert len(advantages) == 3
+        assert all(isinstance(a, float) for a in advantages)
+
+    def test_ppo_clip_loss(self):
+        pgt = PolicyGradientTrainer(mode="ppo", clip_eps=0.2)
+        loss = pgt._compute_ppo_loss(
+            ratios=[1.1, 0.9, 1.3],
+            advantages=[0.5, -0.2, 0.8],
+        )
+        assert isinstance(loss, float)
+
+    def test_reinforce_loss(self):
+        pgt = PolicyGradientTrainer(mode="reinforce")
+        loss = pgt._compute_reinforce_loss(
+            log_probs=[-0.5, -1.0, -0.3],
+            returns=[1.0, 0.5, 2.0],
+        )
+        assert isinstance(loss, float)
+
+    def test_mode_switch(self):
+        pgt = PolicyGradientTrainer(mode="ppo")
+        pgt.set_mode("reinforce")
+        assert pgt.mode == "reinforce"
+
+    def test_invalid_batch_raises(self):
+        pgt = PolicyGradientTrainer()
+        with pytest.raises(ValueError):
+            pgt.train_step({})
+
+    def test_evolution_callback_on_train(self):
+        events = []
+        pgt = PolicyGradientTrainer()
+        pgt.evolution_callback = lambda e: events.append(e)
+        batch = {"states": [[1]], "actions": [0], "rewards": [1.0],
+                 "log_probs": [-0.5], "values": [0.5], "dones": [False]}
+        pgt.train_step(batch)
+        assert len(events) >= 1
+
+    def test_save_load_checkpoint(self):
+        pgt = PolicyGradientTrainer(mode="ppo", lr=1e-3)
+        batch = {"states": [[1]], "actions": [0], "rewards": [1.0],
+                 "log_probs": [-0.5], "values": [0.5], "dones": [False]}
+        pgt.train_step(batch)
+        ckpt = pgt.save_checkpoint()
+        pgt2 = PolicyGradientTrainer()
+        pgt2.load_checkpoint(ckpt)
+        assert pgt2.global_step == 1
+        assert pgt2.mode == "ppo"
