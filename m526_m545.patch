++"""
++Meta-Learning Optimizer — MAML and Reptile for rapid task adaptation.
++
++Location: agentlightning/trainer/meta_learning_optimizer.py
++
++Reference (拿来主義):
++  - DI-star/rl_learner.py: _setup_optimizer, Adam, MultiStepLR
++  - agentlightning/trainer/lol_trainer.py: optimizer config encapsulation
++"""
++
++from __future__ import annotations
++
++import logging
++import math
++import time
++from typing import Any, Callable, Dict, List, Optional
++
++logger = logging.getLogger(__name__)
++
++_EVOLUTION_KEY: str = "agentlightning.trainer.meta_learning_optimizer.v1"
++
++
++class MetaLearningOptimizer:
++    """Meta-learning optimizer supporting MAML and Reptile.
++
++    Maintains meta-parameters that can rapidly adapt to new
++    tasks/games with few gradient steps.
++
++    Attributes:
++        mode: 'maml' or 'reptile'.
++        inner_steps: Number of inner-loop adaptation steps.
++        inner_lr: Inner-loop learning rate.
++        meta_lr: Outer-loop (meta) learning rate.
++    """
++
++    def __init__(
++        self,
++        mode: str = "maml",
++        inner_steps: int = 5,
++        inner_lr: float = 0.01,
++        meta_lr: float = 0.001,
++    ) -> None:
++        self.mode = mode
++        self.inner_steps = inner_steps
++        self.inner_lr = inner_lr
++        self.meta_lr = meta_lr
++        self._meta_params: Dict[str, List[float]] = {}
++        self.tasks: Dict[str, List[Dict[str, Any]]] = {}
++        self.evolution_callback: Optional[Callable[[Dict], None]] = None
++
++    # -------------------------------------------------------------------
++    # Meta params
++    # -------------------------------------------------------------------
++
++    def set_meta_params(self, params: Dict[str, List[float]]) -> None:
++        self._meta_params = {k: list(v) for k, v in params.items()}
++
++    def get_meta_params(self) -> Dict[str, List[float]]:
++        return {k: list(v) for k, v in self._meta_params.items()}
++
++    # -------------------------------------------------------------------
++    # Task registration
++    # -------------------------------------------------------------------
++
++    def register_task(self, task_name: str, data: List[Dict[str, Any]]) -> None:
++        self.tasks[task_name] = data
++
++    # -------------------------------------------------------------------
++    # Inner adaptation — task-specific fine-tuning
++    # -------------------------------------------------------------------
++
++    def inner_adapt(self, task_name: str) -> Dict[str, List[float]]:
++        """Run inner-loop adaptation on a task.
++
++        Returns adapted parameters (not modifying meta params).
++        """
++        if task_name not in self.tasks:
++            return dict(self._meta_params)
++
++        data = self.tasks[task_name]
++        adapted = {k: list(v) for k, v in self._meta_params.items()}
++
++        for step in range(self.inner_steps):
++            for sample in data:
++                state = sample.get("s", sample.get("state", [0.0]))
++                reward = sample.get("r", sample.get("reward", 0.0))
++                if not isinstance(state, list):
++                    state = [state]
++                for key in adapted:
++                    for i in range(len(adapted[key])):
++                        si = state[i % len(state)] if state else 0.0
++                        grad = -reward * si * 0.1
++                        adapted[key][i] -= self.inner_lr * grad
++
++        return adapted
++
++    # -------------------------------------------------------------------
++    # Meta update — outer loop
++    # -------------------------------------------------------------------
++
++    def meta_update(self, task_names: List[str]) -> Dict[str, Any]:
++        """Execute one meta-learning update across tasks."""
++        if not task_names or not self._meta_params:
++            return {"meta_loss": 0.0}
++
++        if self.mode == "maml":
++            return self._maml_update(task_names)
++        elif self.mode == "reptile":
++            return self._reptile_update(task_names)
++        return {"meta_loss": 0.0}
++
++    def _maml_update(self, task_names: List[str]) -> Dict[str, Any]:
++        """MAML: meta-gradient from adapted params."""
++        meta_grads: Dict[str, List[float]] = {
++            k: [0.0] * len(v) for k, v in self._meta_params.items()
++        }
++        total_loss = 0.0
++
++        for task in task_names:
++            adapted = self.inner_adapt(task)
++            for key in self._meta_params:
++                for i in range(len(self._meta_params[key])):
++                    diff = adapted[key][i] - self._meta_params[key][i]
++                    meta_grads[key][i] += diff
++                    total_loss += diff ** 2
++
++        n = max(len(task_names), 1)
++        for key in self._meta_params:
++            for i in range(len(self._meta_params[key])):
++                self._meta_params[key][i] += self.meta_lr * meta_grads[key][i] / n
++
++        metrics = {"meta_loss": total_loss / n, "tasks": len(task_names)}
++        self._fire_evolution({"event": "meta_update", **metrics})
++        return metrics
++
++    def _reptile_update(self, task_names: List[str]) -> Dict[str, Any]:
++        """Reptile: move meta-params toward adapted params."""
++        total_loss = 0.0
++
++        for task in task_names:
++            adapted = self.inner_adapt(task)
++            for key in self._meta_params:
++                for i in range(len(self._meta_params[key])):
++                    diff = adapted[key][i] - self._meta_params[key][i]
++                    self._meta_params[key][i] += self.meta_lr * diff
++                    total_loss += diff ** 2
++
++        n = max(len(task_names), 1)
++        metrics = {"meta_loss": total_loss / n, "tasks": len(task_names)}
++        self._fire_evolution({"event": "meta_update", **metrics})
++        return metrics
++
++    # -------------------------------------------------------------------
++    # Adaptation distance
++    # -------------------------------------------------------------------
++
++    def adaptation_distance(self, task_name: str) -> float:
++        """L2 distance from meta-params to task-adapted params."""
++        adapted = self.inner_adapt(task_name)
++        dist = 0.0
++        for key in self._meta_params:
++            for i in range(len(self._meta_params[key])):
++                dist += (adapted[key][i] - self._meta_params[key][i]) ** 2
++        return math.sqrt(dist)
++
++    # -------------------------------------------------------------------
++    # Checkpoint
++    # -------------------------------------------------------------------
++
++    def save_checkpoint(self) -> Dict[str, Any]:
++        return {
++            "mode": self.mode,
++            "inner_steps": self.inner_steps,
++            "inner_lr": self.inner_lr,
++            "meta_lr": self.meta_lr,
++            "meta_params": {k: list(v) for k, v in self._meta_params.items()},
++        }
++
++    def load_checkpoint(self, ckpt: Dict[str, Any]) -> None:
++        self.mode = ckpt.get("mode", self.mode)
++        self.inner_steps = ckpt.get("inner_steps", self.inner_steps)
++        self.inner_lr = ckpt.get("inner_lr", self.inner_lr)
++        self.meta_lr = ckpt.get("meta_lr", self.meta_lr)
++        self._meta_params = {k: list(v) for k, v in ckpt.get("meta_params", {}).items()}
++
++    # -------------------------------------------------------------------
++    # Evolution callback
++    # -------------------------------------------------------------------
++
++    def _fire_evolution(self, payload: Dict[str, Any]) -> None:
++        if self.evolution_callback is not None:
++            try:
++                self.evolution_callback({
++                    "source": _EVOLUTION_KEY,
++                    "timestamp": time.time(),
++                    **payload,
++                })
++            except Exception as exc:
++                logger.warning("Evolution callback error: %s", exc)
