+        sen = StateEncoderNetwork(output_dim=16)
+        sen.evolution_callback = lambda e: events.append(e)
+        sen.register_feature("hp", ftype="numeric", input_dim=1)
+        sen.encode({"hp": [1.0]})
+        assert len(events) >= 1
+
+    def test_save_load(self):
+        sen = StateEncoderNetwork(output_dim=16)
+        sen.register_feature("x", ftype="numeric", input_dim=2)
+        ckpt = sen.save_checkpoint()
