+"""
+Training Dashboard — Unified training metrics aggregation and reporting.
+
+Location: agentos/governance/training_dashboard.py
+
+Reference (拿来主義):
+  - agentos/governance/evolution_metrics_exporter.py: metric export
+  - agentos/governance/fitness_aggregator.py: report→aggregate→trend
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import math
+import time
+from collections import defaultdict
+from typing import Any, Callable, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "agentos.governance.training_dashboard.v1"
+
+
+class TrainingDashboard:
+    """Unified training metrics dashboard.
+
+    Aggregates metrics from all trainers and evolution components.
+    Supports time-window queries, trend detection, and anomaly detection.
+
+    Attributes:
+        metric_count: Number of distinct metric names tracked.
+    """
+
+    def __init__(self) -> None:
+        # metric_name -> [{value, step, timestamp}, ...]
+        self._metrics: Dict[str, List[Dict[str, Any]]] = defaultdict(list)
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+
+    @property
+    def metric_count(self) -> int:
+        return len(self._metrics)
+
+    # -------------------------------------------------------------------
+    # Record — mirrors fitness_aggregator.report
+    # -------------------------------------------------------------------
+
+    def record(
+        self,
+        name: str,
+        value: float,
+        step: int = 0,
+        timestamp: Optional[float] = None,
+    ) -> None:
+        """Record a metric value."""
+        ts = timestamp if timestamp is not None else time.time()
+        self._metrics[name].append({
+            "value": value,
+            "step": step,
+            "timestamp": ts,
+        })
+        self._fire_evolution({
+            "event": "metric_recorded",
+            "name": name,
+            "value": value,
+            "step": step,
+        })
+
+    # -------------------------------------------------------------------
+    # Query
+    # -------------------------------------------------------------------
+
+    def get_history(self, name: str) -> List[Dict[str, Any]]:
+        return list(self._metrics.get(name, []))
+
+    def query(
+        self,
+        name: str,
+        from_time: Optional[float] = None,
+        to_time: Optional[float] = None,
+    ) -> List[Dict[str, Any]]:
+        """Query metrics within time window."""
+        history = self._metrics.get(name, [])
+        result = []
+        for entry in history:
+            ts = entry["timestamp"]
+            if from_time is not None and ts < from_time:
+                continue
+            if to_time is not None and ts > to_time:
+                continue
+            result.append(entry)
+        return result
+
+    # -------------------------------------------------------------------
+    # Trend detection — mirrors fitness_aggregator.get_trend
+    # -------------------------------------------------------------------
+
+    def get_trend(self, name: str) -> str:
+        """Detect trend in metric: improving/declining/stable."""
+        history = self._metrics.get(name, [])
+        if len(history) < 3:
+            return "insufficient_data"
+        recent = [h["value"] for h in history[-5:]]
+        if all(recent[i] <= recent[i + 1] for i in range(len(recent) - 1)):
+            return "improving"
+        if all(recent[i] >= recent[i + 1] for i in range(len(recent) - 1)):
+            return "declining"
+        return "stable"
+
+    # -------------------------------------------------------------------
+    # Anomaly detection — z-score based
+    # -------------------------------------------------------------------
+
+    def detect_anomalies(
+        self,
+        name: str,
+        z_threshold: float = 3.0,
+    ) -> List[Dict[str, Any]]:
+        """Detect anomalous metric values via z-score."""
+        history = self._metrics.get(name, [])
+        if len(history) < 5:
+            return []
+        values = [h["value"] for h in history]
+        mean = sum(values) / len(values)
+        var = sum((v - mean) ** 2 for v in values) / len(values)
+        std = math.sqrt(var) if var > 0 else 1.0
+
+        anomalies = []
+        for entry in history:
+            z = abs(entry["value"] - mean) / std
+            if z > z_threshold:
+                anomalies.append({**entry, "z_score": z})
+        return anomalies
+
+    # -------------------------------------------------------------------
+    # Reports
+    # -------------------------------------------------------------------
+
+    def generate_report(self, fmt: str = "text") -> Any:
+        """Generate training report.
+
+        Args:
+            fmt: 'text' or 'json'.
+
+        Returns:
+            Report string or dict.
+        """
+        data: Dict[str, Any] = {}
+        for name, history in self._metrics.items():
+            if not history:
+                continue
+            values = [h["value"] for h in history]
+            data[name] = {
+                "count": len(values),
+                "latest": values[-1],
+                "mean": sum(values) / len(values),
+                "min": min(values),
+                "max": max(values),
+                "trend": self.get_trend(name),
+            }
+
+        if fmt == "json":
+            return data
+
+        lines = ["=== Training Dashboard Report ==="]
+        for name, info in data.items():
+            lines.append(
+                f"{name}: latest={info['latest']:.4f} mean={info['mean']:.4f} "
+                f"trend={info['trend']} ({info['count']} records)"
+            )
+        return "\n".join(lines)
+
+    # -------------------------------------------------------------------
+    # Evolution callback
+    # -------------------------------------------------------------------
+
+    def _fire_evolution(self, payload: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            try:
+                self.evolution_callback({
+                    "source": _EVOLUTION_KEY,
+                    "timestamp": time.time(),
+                    **payload,
+                })
+            except Exception as exc:
+                logger.warning("Evolution callback error: %s", exc)
