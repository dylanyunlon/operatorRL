+"""Tests for M543 DistributedTrainingCoordinator — TDD, 10 tests."""
+import pytest, sys, os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "../.."))
+from agentos.governance.distributed_training_coordinator import DistributedTrainingCoordinator
+
+class TestDistributedTrainingCoordinator:
+    def test_init(self):
+        dtc = DistributedTrainingCoordinator()
+        assert dtc.worker_count == 0
+
+    def test_register_worker(self):
+        dtc = DistributedTrainingCoordinator()
+        dtc.register_worker("w1", capacity=1.0)
+        dtc.register_worker("w2", capacity=1.0)
+        assert dtc.worker_count == 2
+
+    def test_submit_gradients(self):
+        dtc = DistributedTrainingCoordinator()
+        dtc.register_worker("w1", capacity=1.0)
+        dtc.submit_gradients("w1", gradients={"layer1": [0.1, 0.2]})
+        assert dtc.pending_gradient_count == 1
+
+    def test_aggregate_gradients(self):
+        dtc = DistributedTrainingCoordinator()
+        dtc.register_worker("w1", capacity=1.0)
+        dtc.register_worker("w2", capacity=1.0)
+        dtc.submit_gradients("w1", gradients={"l1": [1.0, 2.0]})
+        dtc.submit_gradients("w2", gradients={"l1": [3.0, 4.0]})
+        agg = dtc.aggregate_gradients()
+        assert "l1" in agg
+        assert agg["l1"][0] == pytest.approx(2.0)  # mean
+        assert agg["l1"][1] == pytest.approx(3.0)
+
+    def test_broadcast_params(self):
+        dtc = DistributedTrainingCoordinator()
+        dtc.register_worker("w1", capacity=1.0)
+        dtc.register_worker("w2", capacity=1.0)
+        dtc.broadcast_params({"l1": [1.0, 1.0]})
+        p1 = dtc.get_worker_params("w1")
+        p2 = dtc.get_worker_params("w2")
+        assert p1 == p2
+
+    def test_detect_failure(self):
+        dtc = DistributedTrainingCoordinator(heartbeat_timeout=1.0)
+        dtc.register_worker("w1", capacity=1.0)
+        dtc.register_worker("w2", capacity=1.0)
+        # w1 heartbeats at time 100
+        dtc._workers["w1"]["last_heartbeat"] = 100.0
+        dtc._workers["w2"]["last_heartbeat"] = 100.0
+        dtc.heartbeat("w1")  # refreshes w1 to now
+        # w2 never heartbeats again — detect at a time far in the future
+        import time as _t
+        future = _t.time() + 10.0
+        dtc._workers["w2"]["last_heartbeat"] = future - 5.0  # 5s ago
+        dtc._workers["w1"]["last_heartbeat"] = future         # just now
+        failed = dtc.detect_failed_workers(current_time=future)
+        assert "w2" in failed
+
+    def test_reassign_task(self):
+        dtc = DistributedTrainingCoordinator()
+        dtc.register_worker("w1", capacity=1.0)
+        dtc.register_worker("w2", capacity=1.0)
+        dtc.assign_task("w1", task_id="t1")
+        dtc.reassign_task("t1", from_worker="w1", to_worker="w2")
+        assert "t1" in dtc.get_tasks("w2")
+
+    def test_remove_worker(self):
+        dtc = DistributedTrainingCoordinator()
+        dtc.register_worker("w1", capacity=1.0)
+        dtc.remove_worker("w1")
+        assert dtc.worker_count == 0
+
+    def test_evolution_callback(self):
+        events = []
+        dtc = DistributedTrainingCoordinator()
+        dtc.evolution_callback = lambda e: events.append(e)
+        dtc.register_worker("w1", capacity=1.0)
+        assert len(events) >= 1
+
+    def test_get_cluster_status(self):
+        dtc = DistributedTrainingCoordinator()
+        dtc.register_worker("w1", capacity=1.0)
+        dtc.register_worker("w2", capacity=2.0)
+        status = dtc.get_cluster_status()
+        assert status["total_workers"] == 2
+        assert status["total_capacity"] == pytest.approx(3.0)
