+"""Tests for M542 HyperparameterTuner — TDD, 10 tests."""
+import pytest, sys, os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "../.."))
+from agentos.governance.hyperparameter_tuner import HyperparameterTuner
+
+class TestHyperparameterTuner:
+    def test_init(self):
+        ht = HyperparameterTuner()
+        assert ht.strategy == "grid"
+
+    def test_define_search_space(self):
+        ht = HyperparameterTuner()
+        ht.define_param("lr", values=[1e-4, 1e-3, 1e-2])
+        ht.define_param("gamma", values=[0.95, 0.99])
+        assert len(ht.search_space) == 2
+
+    def test_grid_search_generates_all(self):
+        ht = HyperparameterTuner(strategy="grid")
+        ht.define_param("lr", values=[1e-3, 1e-2])
+        ht.define_param("gamma", values=[0.95, 0.99])
+        configs = ht.generate_configs()
+        assert len(configs) == 4
+
+    def test_random_search(self):
+        ht = HyperparameterTuner(strategy="random", max_trials=5)
+        ht.define_param("lr", values=[1e-4, 1e-3, 1e-2])
+        ht.define_param("gamma", values=[0.9, 0.95, 0.99])
+        configs = ht.generate_configs()
+        assert len(configs) == 5
+
+    def test_bayesian_search(self):
+        ht = HyperparameterTuner(strategy="bayesian", max_trials=3)
+        ht.define_param("lr", low=1e-4, high=1e-2)
+        ht.define_param("gamma", low=0.9, high=0.99)
+        c1 = ht.suggest_next()
+        assert "lr" in c1 and "gamma" in c1
+
+    def test_record_trial(self):
+        ht = HyperparameterTuner(strategy="grid")
+        ht.define_param("lr", values=[1e-3])
+        ht.record_trial(config={"lr": 1e-3}, score=0.85, steps=100)
+        assert len(ht.trial_history) == 1
+
+    def test_early_stop(self):
+        ht = HyperparameterTuner(early_stop_patience=3)
+        ht.define_param("lr", values=[1e-3])
+        for i in range(5):
+            ht.record_trial(config={"lr": 1e-3}, score=0.5, steps=i*10)
+        assert ht.should_early_stop({"lr": 1e-3}) is True
+
+    def test_get_best(self):
+        ht = HyperparameterTuner()
+        ht.record_trial(config={"lr": 1e-3}, score=0.7, steps=100)
+        ht.record_trial(config={"lr": 1e-2}, score=0.9, steps=100)
+        best = ht.get_best_config()
+        assert best["config"]["lr"] == 1e-2
+
+    def test_evolution_callback(self):
+        events = []
+        ht = HyperparameterTuner()
+        ht.evolution_callback = lambda e: events.append(e)
+        ht.record_trial(config={"lr": 1e-3}, score=0.5, steps=10)
+        assert len(events) >= 1
+
+    def test_apply_best(self):
+        ht = HyperparameterTuner()
+        ht.record_trial(config={"lr": 1e-2, "gamma": 0.99}, score=0.95, steps=100)
+        applied = ht.apply_best()
+        assert applied["lr"] == 1e-2
