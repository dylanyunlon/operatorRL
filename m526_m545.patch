++            return []
++        n = min(batch_size, len(self._buffer))
++        total_p = sum(self._priorities)
++        if total_p <= 0:
++            return random.sample(self._buffer, n)
++
++        probs = [p / total_p for p in self._priorities]
++        indices = []
++        for _ in range(n):
++            r = random.random()
++            cumsum = 0.0
++            for i, p in enumerate(probs):
++                cumsum += p
++                if cumsum >= r:
++                    indices.append(i)
++                    break
++            else:
