+"""
+Multi-Agent Coordinator — Team-based multi-agent strategy coordination.
+
+Location: agentlightning/trainer/multi_agent_coordinator.py
+
+Reference (拿来主義):
+  - agentlightning/algorithm/self_play_scheduler.py: agent pool management
+  - agentos/governance/evolution_orchestrator.py: multi-game orchestration
+  - DI-star: multi-agent coordination patterns
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from collections import defaultdict
+from typing import Any, Callable, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "agentlightning.trainer.multi_agent_coordinator.v1"
+
+
+class MultiAgentCoordinator:
+    """Multi-agent coordinator for team-based games.
+
+    Manages agent registration with roles, communication channels,
+    joint action selection, and differentiated reward distribution.
+
+    Attributes:
+        evolution_callback: Optional evolution event callback.
+    """
+
+    def __init__(self) -> None:
+        self._agents: Dict[str, Dict[str, Any]] = {}
+        self._messages: Dict[str, List[Dict[str, Any]]] = defaultdict(list)
+        self._comm_log: List[Dict[str, Any]] = []
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+
+    @property
+    def agent_count(self) -> int:
+        return len(self._agents)
+
+    # -------------------------------------------------------------------
+    # Registration — mirrors self_play_scheduler.add_agent
+    # -------------------------------------------------------------------
+
+    def register_agent(
+        self,
+        agent_id: str,
+        role: str = "UNKNOWN",
+        **config: Any,
+    ) -> None:
+        """Register an agent with a team role.
+
+        Args:
+            agent_id: Unique agent identifier.
+            role: Team role (TOP/JG/MID/ADC/SUP for LoL).
+        """
+        self._agents[agent_id] = {
+            "role": role,
+            "config": config,
+            "registered_at": time.time(),
+        }
+        self._messages[agent_id] = []
+        self._fire_evolution({
+            "event": "agent_registered",
+            "agent_id": agent_id,
+            "role": role,
+        })
+
+    def remove_agent(self, agent_id: str) -> None:
+        self._agents.pop(agent_id, None)
+        self._messages.pop(agent_id, None)
+
+    def get_role(self, agent_id: str) -> str:
+        return self._agents.get(agent_id, {}).get("role", "UNKNOWN")
+
+    def list_roles(self) -> List[str]:
+        return [a["role"] for a in self._agents.values()]
+
+    # -------------------------------------------------------------------
+    # Communication — shared channel
+    # -------------------------------------------------------------------
+
+    def broadcast(self, message: Dict[str, Any]) -> List[str]:
+        """Broadcast message to all agents. Returns list of recipients."""
+        recipients = []
+        for agent_id in self._agents:
+            self._messages[agent_id].append({
+                "from": "_broadcast",
+                "payload": message,
+                "timestamp": time.time(),
+            })
+            recipients.append(agent_id)
+        return recipients
+
+    def send_message(
+        self,
+        from_agent: str,
+        to_agent: str,
+        message: Dict[str, Any],
+    ) -> None:
+        """Send direct message between agents."""
+        self._messages[to_agent].append({
+            "from": from_agent,
+            "payload": message,
+            "timestamp": time.time(),
+        })
+        self._comm_log.append({
+            "from": from_agent,
+            "to": to_agent,
+            "message": message,
+        })
+
+    def get_messages(self, agent_id: str) -> List[Dict[str, Any]]:
+        """Get and clear pending messages for agent."""
+        msgs = list(self._messages.get(agent_id, []))
+        self._messages[agent_id] = []
+        return msgs
+
+    # -------------------------------------------------------------------
+    # Joint action selection
+    # -------------------------------------------------------------------
+
+    def select_joint_action(
+        self,
+        proposals: Dict[str, Dict[str, Any]],
+    ) -> Dict[str, str]:
+        """Select joint action from individual proposals.
+
+        Each agent proposes {action, confidence}. Currently uses
+        independent selection (production: correlated equilibrium).
+
+        Args:
+            proposals: agent_id -> {action, confidence}.
+
+        Returns:
+            agent_id -> selected action.
+        """
+        result = {}
+        for agent_id, proposal in proposals.items():
+            result[agent_id] = proposal.get("action", "wait")
+        return result
+
+    # -------------------------------------------------------------------
+    # Differentiated reward distribution
+    # -------------------------------------------------------------------
+
+    def distribute_reward(
+        self,
+        team_reward: float,
+        contributions: Optional[Dict[str, float]] = None,
+    ) -> Dict[str, float]:
+        """Distribute team reward based on role contributions.
+
+        Args:
+            team_reward: Total team reward.
+            contributions: agent_id -> contribution weight.
+
+        Returns:
+            agent_id -> individual reward.
+        """
+        if contributions is None:
+            n = max(len(self._agents), 1)
+            return {aid: team_reward / n for aid in self._agents}
+
+        total_c = sum(contributions.values()) or 1.0
+        return {
+            aid: team_reward * (contributions.get(aid, 0.0) / total_c)
+            for aid in self._agents
+        }
+
+    # -------------------------------------------------------------------
+    # Team state
+    # -------------------------------------------------------------------
+
+    def get_team_state(self) -> Dict[str, Any]:
+        return {
+            "agents": [
+                {"id": aid, "role": info["role"]}
+                for aid, info in self._agents.items()
+            ],
+            "agent_count": len(self._agents),
+        }
+
+    # -------------------------------------------------------------------
+    # Evolution callback
+    # -------------------------------------------------------------------
+
+    def _fire_evolution(self, payload: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            try:
+                self.evolution_callback({
+                    "source": _EVOLUTION_KEY,
+                    "timestamp": time.time(),
+                    **payload,
+                })
+            except Exception as exc:
+                logger.warning("Evolution callback error: %s", exc)
