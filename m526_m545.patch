++
++class ValueNetworkTrainer:
++    """Independent value network trainer with TD(λ).
++
++    Separated from policy trainer (M528) to allow different
++    learning rates, following DI-star's value_loss_coef pattern.
++
++    Attributes:
++        lr: Learning rate for value network.
++        gamma: Discount factor.
++        td_lambda: Lambda for TD(λ) targets.
++        global_step: Total training steps.
++    """
++
++    def __init__(
++        self,
++        lr: float = 1e-3,
++        gamma: float = 0.99,
++        td_lambda: float = 0.95,
++        hidden_dim: int = 64,
++    ) -> None:
++        self.lr = lr
++        self.gamma = gamma
++        self.td_lambda = td_lambda
++        self.hidden_dim = hidden_dim
++        self.global_step: int = 0
++        self._total_loss: float = 0.0
++        # Simple linear value network weights (production: neural network)
++        self._weights: List[float] = []
++        self._bias: float = 0.0
++        self._initialized: bool = False
++        self.evolution_callback: Optional[Callable[[Dict], None]] = None
++
++    # -------------------------------------------------------------------
++    # Lazy init weights based on first input dimension
++    # -------------------------------------------------------------------
++
++    def _ensure_init(self, dim: int) -> None:
++        if not self._initialized or len(self._weights) != dim:
++            self._weights = [0.01] * dim
++            self._bias = 0.0
++            self._initialized = True
++
++    # -------------------------------------------------------------------
++    # Predict — value function forward pass
++    # -------------------------------------------------------------------
++
++    def predict(self, states: List[List[float]]) -> List[float]:
++        """Predict value for a batch of states.
++
++        Args:
++            states: List of state vectors.
++
++        Returns:
++            List of value predictions.
++        """
++        if not states:
++            return []
++        dim = len(states[0])
++        self._ensure_init(dim)
++        values = []
++        for s in states:
++            v = sum(w * x for w, x in zip(self._weights, s)) + self._bias
++            values.append(v)
++        return values
++
++    # -------------------------------------------------------------------
++    # Train step — MSE loss between predictions and TD targets
++    # -------------------------------------------------------------------
++
++    def train_step(self, batch: Dict[str, Any]) -> Dict[str, Any]:
++        """Execute one value network training step.
++
++        Args:
++            batch: Dict with 'states' and 'td_targets'.
++
++        Returns:
++            Metrics dict with value_loss, step.
++
++        Raises:
++            ValueError: If batch missing required keys.
++        """
++        if not batch or "states" not in batch or "td_targets" not in batch:
++            raise ValueError("Batch must contain 'states' and 'td_targets'")
++
++        states = batch["states"]
++        targets = batch["td_targets"]
++
++        if not states:
++            return {"value_loss": 0.0, "step": self.global_step}
++
++        dim = len(states[0])
++        self._ensure_init(dim)
++
++        # Forward
++        predictions = self.predict(states)
++
++        # MSE loss
++        loss = sum((p - t) ** 2 for p, t in zip(predictions, targets)) / len(states)
++
++        # SGD update (production: Adam optimizer)
++        for i in range(len(states)):
++            error = predictions[i] - targets[i]
++            for j in range(dim):
++                grad = 2.0 * error * states[i][j] / len(states)
++                self._weights[j] -= self.lr * grad
++            self._bias -= self.lr * 2.0 * error / len(states)
++
++        self.global_step += 1
++        self._total_loss += loss
++
++        metrics = {
++            "value_loss": loss,
++            "step": self.global_step,
++            "batch_size": len(states),
++        }
++        self._fire_evolution({"event": "train_step", **metrics})
++        return metrics
++
++    # -------------------------------------------------------------------
++    # TD(λ) target computation
++    # -------------------------------------------------------------------
++
++    def compute_td_lambda_targets(
++        self,
++        rewards: List[float],
++        values: List[float],
++    ) -> List[float]:
++        """Compute TD(λ) targets.
++
++        Args:
++            rewards: Step rewards.
++            values: Current value estimates.
++
++        Returns:
++            List of TD(λ) target values.
++        """
++        n = len(rewards)
++        targets = [0.0] * n
++        last_target = 0.0
++
++        for t in reversed(range(n)):
++            next_val = values[t + 1] if t + 1 < len(values) else 0.0
++            td_target = rewards[t] + self.gamma * next_val
++            last_target = td_target * (1 - self.td_lambda) + \
++                          (rewards[t] + self.gamma * last_target) * self.td_lambda
++            targets[t] = last_target
++
++        return targets
++
++    # -------------------------------------------------------------------
++    # Prediction errors — for PER priority (M527)
++    # -------------------------------------------------------------------
++
++    def get_prediction_errors(
++        self,
++        states: List[List[float]],
++        targets: List[float],
++    ) -> List[float]:
++        """Compute prediction errors for PER priority update."""
++        predictions = self.predict(states)
++        return [abs(p - t) for p, t in zip(predictions, targets)]
++
++    # -------------------------------------------------------------------
++    # Checkpoint
++    # -------------------------------------------------------------------
++
++    def save_checkpoint(self) -> Dict[str, Any]:
++        return {
++            "global_step": self.global_step,
++            "lr": self.lr,
++            "gamma": self.gamma,
++            "td_lambda": self.td_lambda,
++            "weights": list(self._weights),
++            "bias": self._bias,
++            "total_loss": self._total_loss,
++        }
++
++    def load_checkpoint(self, ckpt: Dict[str, Any]) -> None:
++        self.global_step = ckpt.get("global_step", 0)
++        self.lr = ckpt.get("lr", self.lr)
++        self.gamma = ckpt.get("gamma", self.gamma)
++        self.td_lambda = ckpt.get("td_lambda", self.td_lambda)
++        self._weights = list(ckpt.get("weights", []))
++        self._bias = ckpt.get("bias", 0.0)
++        self._total_loss = ckpt.get("total_loss", 0.0)
++        self._initialized = bool(self._weights)
++
++    # -------------------------------------------------------------------
++    # Evolution callback
++    # -------------------------------------------------------------------
++
++    def _fire_evolution(self, payload: Dict[str, Any]) -> None:
++        if self.evolution_callback is not None:
++            try:
++                self.evolution_callback({
++                    "source": _EVOLUTION_KEY,
++                    "timestamp": time.time(),
++                    **payload,
++                })
++            except Exception as exc:
++                logger.warning("Evolution callback error: %s", exc)
