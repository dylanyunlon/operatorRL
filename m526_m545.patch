@@ -0,0 +1,231 @@
+"""
+Policy Gradient Trainer — PPO and REINFORCE with GAE advantage estimation.
+
+Location: agentlightning/trainer/policy_gradient_trainer.py
+
+Reference (拿来主义):
+  - agentlightning/algorithm/multi_game_ppo.py: clipped surrogate loss, GAE
+  - agentlightning/trainer/lol_trainer.py: train_step → metrics pattern
+  - DI-star/rl_learner.py: PPO training loop
+  - PARL/algorithms/torch/ppo.py: advantage computation
+"""
+
+from __future__ import annotations
+
+import logging
+import math
+import time
+from typing import Any, Callable, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+_EVOLUTION_KEY: str = "agentlightning.trainer.policy_gradient_trainer.v1"
+
+
+class PolicyGradientTrainer:
+    """Policy gradient trainer supporting PPO and REINFORCE.
+
+    Follows lol_trainer.py's train_step→metrics contract.
+    Algorithm logic (advantage, clipped loss) separated from
+    training loop (step counting, checkpointing).
+
+    Attributes:
+        mode: 'ppo' or 'reinforce'.
+        lr: Learning rate.
+        global_step: Total training steps executed.
+    """
+
+    def __init__(
+        self,
+        mode: str = "ppo",
+        lr: float = 3e-4,
+        gamma: float = 0.99,
+        gae_lambda: float = 0.95,
+        clip_eps: float = 0.2,
+        entropy_coef: float = 0.01,
+    ) -> None:
+        self.mode = mode
+        self.lr = lr
+        self.gamma = gamma
+        self.gae_lambda = gae_lambda
+        self.clip_eps = clip_eps
+        self.entropy_coef = entropy_coef
+        self.global_step: int = 0
+        self._total_loss: float = 0.0
+        self._metrics_buffer: List[Dict[str, Any]] = []
+        self.evolution_callback: Optional[Callable[[Dict], None]] = None
+
+    # -------------------------------------------------------------------
+    # Core train step — mirrors lol_trainer.py contract
+    # -------------------------------------------------------------------
+
+    def train_step(self, batch: Dict[str, Any]) -> Dict[str, Any]:
+        """Execute one policy gradient training step.
+
+        Args:
+            batch: Dict with states, actions, rewards, log_probs, values, dones.
+
+        Returns:
+            Metrics dict with loss, step, avg_reward, etc.
+
+        Raises:
+            ValueError: If batch is empty or missing required keys.
+        """
+        if not batch or "rewards" not in batch:
+            raise ValueError("Batch must contain 'rewards' key at minimum")
+
+        rewards = batch["rewards"]
+        log_probs = batch.get("log_probs", [-1.0] * len(rewards))
+        values = batch.get("values", [0.0] * len(rewards))
+        dones = batch.get("dones", [False] * len(rewards))
+
+        # Compute advantages via GAE
+        advantages = self.compute_gae(rewards, values + [0.0], dones)
+
+        # Compute returns for value baseline
+        returns = [adv + val for adv, val in zip(advantages, values)]
+
+        if self.mode == "ppo":
+            # Stub ratio = 1.0 (production: exp(new_log_prob - old_log_prob))
+            ratios = [1.0 + 0.01 * lp for lp in log_probs]
+            loss = self._compute_ppo_loss(ratios, advantages)
+        elif self.mode == "reinforce":
+            loss = self._compute_reinforce_loss(log_probs, returns)
+        else:
+            loss = sum(abs(r) for r in rewards) / max(len(rewards), 1)
+
+        self.global_step += 1
+        self._total_loss += loss
+
+        metrics = {
+            "loss": loss,
+            "step": self.global_step,
+            "mode": self.mode,
+            "batch_size": len(rewards),
+            "avg_reward": sum(rewards) / max(len(rewards), 1),
+            "avg_advantage": sum(advantages) / max(len(advantages), 1),
+        }
+        self._metrics_buffer.append(metrics)
+        self._fire_evolution({"event": "train_step", **metrics})
+        return metrics
+
+    # -------------------------------------------------------------------
+    # GAE — adapted from multi_game_ppo.py compute_advantages
+    # -------------------------------------------------------------------
+
+    def compute_gae(
+        self,
+        rewards: List[float],
+        values: List[float],
+        dones: Optional[List[bool]] = None,
+    ) -> List[float]:
+        """Compute Generalized Advantage Estimation.
+
+        Args:
+            rewards: Step rewards.
+            values: Value estimates (len = len(rewards) + 1 ideally).
+            dones: Episode termination flags.
+
+        Returns:
+            List of advantage floats.
+        """
+        n = len(rewards)
+        if dones is None:
+            dones = [False] * n
+        advantages = [0.0] * n
+        last_gae = 0.0
+
+        for t in reversed(range(n)):
+            next_val = values[t + 1] if t + 1 < len(values) else 0.0
+            mask = 0.0 if (t < len(dones) and dones[t]) else 1.0
+            delta = rewards[t] + self.gamma * next_val * mask - values[t]
+            last_gae = delta + self.gamma * self.gae_lambda * mask * last_gae
+            advantages[t] = last_gae
+
+        return advantages
+
+    # -------------------------------------------------------------------
+    # Loss computations — separated from train loop per DI-star pattern
+    # -------------------------------------------------------------------
+
+    def _compute_ppo_loss(
+        self,
+        ratios: List[float],
+        advantages: List[float],
+    ) -> float:
+        """Clipped PPO surrogate loss."""
+        if not ratios:
+            return 0.0
+        total = 0.0
+        for ratio, adv in zip(ratios, advantages):
+            clipped = max(min(ratio, 1.0 + self.clip_eps), 1.0 - self.clip_eps)
+            surrogate = min(ratio * adv, clipped * adv)
+            total += -surrogate
+        return total / len(ratios)
+
+    def _compute_reinforce_loss(
+        self,
+        log_probs: List[float],
+        returns: List[float],
+    ) -> float:
+        """REINFORCE policy gradient loss."""
+        if not log_probs:
+            return 0.0
+        total = 0.0
+        for lp, ret in zip(log_probs, returns):
+            total += -lp * ret
+        return total / len(log_probs)
+
+    # -------------------------------------------------------------------
+    # Mode switching
+    # -------------------------------------------------------------------
+
+    def set_mode(self, mode: str) -> None:
+        """Switch between 'ppo' and 'reinforce'."""
+        self.mode = mode
+
+    # -------------------------------------------------------------------
+    # Checkpoint — mirrors lol_trainer.py
+    # -------------------------------------------------------------------
+
+    def save_checkpoint(self) -> Dict[str, Any]:
+        return {
+            "global_step": self.global_step,
+            "mode": self.mode,
+            "lr": self.lr,
+            "gamma": self.gamma,
+            "gae_lambda": self.gae_lambda,
+            "clip_eps": self.clip_eps,
+            "total_loss": self._total_loss,
+        }
+
+    def load_checkpoint(self, ckpt: Dict[str, Any]) -> None:
+        self.global_step = ckpt.get("global_step", 0)
+        self.mode = ckpt.get("mode", self.mode)
+        self.lr = ckpt.get("lr", self.lr)
+        self.gamma = ckpt.get("gamma", self.gamma)
+        self.gae_lambda = ckpt.get("gae_lambda", self.gae_lambda)
+        self.clip_eps = ckpt.get("clip_eps", self.clip_eps)
+        self._total_loss = ckpt.get("total_loss", 0.0)
+
+    def get_metrics(self) -> Dict[str, Any]:
+        return {
+            "global_step": self.global_step,
+            "mode": self.mode,
+            "avg_loss": self._total_loss / max(self.global_step, 1),
+        }
+
+    # -------------------------------------------------------------------
+    # Evolution callback
+    # -------------------------------------------------------------------
+
+    def _fire_evolution(self, payload: Dict[str, Any]) -> None:
+        if self.evolution_callback is not None:
+            try:
+                self.evolution_callback({
+                    "source": _EVOLUTION_KEY,
+                    "timestamp": time.time(),
+                    **payload,
+                })
+            except Exception as exc:
+                logger.warning("Evolution callback error: %s", exc)
