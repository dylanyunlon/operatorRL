++"""
++Action Sampler — Multi-strategy action sampling from policy logits.
++
++Location: agentlightning/inference/action_sampler.py
++
++Reference (拿来主義):
++  - dota2bot-OpenHyperAI/BotLib/hero_*.lua: Consider*Action utility scoring
++  - integrations/lol/src/lol_agent/decision_engine.py: decide→strategy pattern
++"""
++
++from __future__ import annotations
++
++import logging
++import math
++import random
++import time
++from typing import Any, Callable, Dict, List, Optional
++
++logger = logging.getLogger(__name__)
++
++_EVOLUTION_KEY: str = "agentlightning.inference.action_sampler.v1"
++
++
++def _softmax(logits: List[float], temperature: float = 1.0) -> List[float]:
++    """Compute softmax probabilities with temperature."""
++    if temperature <= 0:
++        temperature = 1e-8
++    scaled = [x / temperature for x in logits]
++    max_s = max(scaled)
++    exps = [math.exp(s - max_s) for s in scaled]
++    total = sum(exps) or 1.0
++    return [e / total for e in exps]
++
++
++class ActionSampler:
++    """Multi-strategy action sampler.
++
++    Supports greedy, temperature, top-k, and beam search.
++    Training uses high temperature for exploration,
++    inference uses low temperature for exploitation.
++
++    Attributes:
++        mode: Sampling mode.
++        temperature: Temperature for softmax.
++        top_k: K for top-k filtering.
++        beam_width: Width for beam search.
++    """
++
++    def __init__(
++        self,
++        mode: str = "greedy",
++        temperature: float = 1.0,
++        top_k: int = 5,
++        beam_width: int = 3,
++    ) -> None:
++        self.mode = mode
++        self.temperature = temperature
++        self.top_k = top_k
++        self.beam_width = beam_width
++        self.evolution_callback: Optional[Callable[[Dict], None]] = None
++
++    # -------------------------------------------------------------------
++    # Core sampling
++    # -------------------------------------------------------------------
++
++    def sample(self, logits: List[float]) -> int:
++        """Sample an action from logits.
++
++        Args:
++            logits: Raw logit scores per action.
++
++        Returns:
++            Selected action index.
++
++        Raises:
++            ValueError: If logits is empty.
++        """
++        if not logits:
++            raise ValueError("Cannot sample from empty logits")
++
++        if self.mode == "greedy":
++            action = self._greedy(logits)
++        elif self.mode == "temperature":
++            action = self._temperature_sample(logits)
++        elif self.mode == "topk":
++            action = self._topk_sample(logits)
++        else:
++            action = self._greedy(logits)
++
++        self._fire_evolution({
++            "event": "action_sampled",
++            "mode": self.mode,
++            "action": action,
++        })
++        return action
++
++    def _greedy(self, logits: List[float]) -> int:
++        return max(range(len(logits)), key=lambda i: logits[i])
++
++    def _temperature_sample(self, logits: List[float]) -> int:
++        probs = _softmax(logits, self.temperature)
++        r = random.random()
++        cumsum = 0.0
++        for i, p in enumerate(probs):
++            cumsum += p
++            if cumsum >= r:
++                return i
++        return len(probs) - 1
++
++    def _topk_sample(self, logits: List[float]) -> int:
++        indexed = sorted(enumerate(logits), key=lambda x: -x[1])
++        top = indexed[:self.top_k]
++        top_logits = [x[1] for x in top]
++        top_indices = [x[0] for x in top]
++        probs = _softmax(top_logits, self.temperature)
++        r = random.random()
++        cumsum = 0.0
++        for i, p in enumerate(probs):
++            cumsum += p
++            if cumsum >= r:
++                return top_indices[i]
++        return top_indices[-1]
++
++    # -------------------------------------------------------------------
++    # Beam search
++    # -------------------------------------------------------------------
++
++    def beam_search(self, logits_seq: List[List[float]]) -> List[int]:
++        """Beam search over a sequence of logit distributions.
++
++        Args:
++            logits_seq: List of logit vectors, one per time step.
++
++        Returns:
++            Best action sequence.
++        """
++        if not logits_seq:
++            return []
++
++        # beams: [(score, action_seq)]
++        beams = [(0.0, [])]
++
++        for logits in logits_seq:
++            candidates = []
++            probs = _softmax(logits, self.temperature)
++            for score, seq in beams:
++                for i, p in enumerate(probs):
++                    new_score = score + math.log(p + 1e-10)
++                    candidates.append((new_score, seq + [i]))
++            candidates.sort(key=lambda x: -x[0])
++            beams = candidates[:self.beam_width]
++
++        return beams[0][1] if beams else []
++
++    # -------------------------------------------------------------------
++    # Mode switching
++    # -------------------------------------------------------------------
++
++    def set_mode(self, mode: str, **kwargs: Any) -> None:
++        self.mode = mode
++        if "temperature" in kwargs:
++            self.temperature = kwargs["temperature"]
++        if "top_k" in kwargs:
++            self.top_k = kwargs["top_k"]
++
++    # -------------------------------------------------------------------
++    # Utilities
++    # -------------------------------------------------------------------
++
++    def get_probabilities(
++        self, logits: List[float], temperature: float = 1.0
++    ) -> List[float]:
++        return _softmax(logits, temperature)
++
++    # -------------------------------------------------------------------
++    # Evolution callback
++    # -------------------------------------------------------------------
++
++    def _fire_evolution(self, payload: Dict[str, Any]) -> None:
++        if self.evolution_callback is not None:
++            try:
++                self.evolution_callback({
++                    "source": _EVOLUTION_KEY,
++                    "timestamp": time.time(),
++                    **payload,
++                })
++            except Exception as exc:
++                logger.warning("Evolution callback error: %s", exc)
