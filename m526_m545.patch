+"""Tests for M544 ModelRegistry — TDD, 10 tests."""
+import pytest, sys, os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "../.."))
+from agentos.governance.model_registry import ModelRegistry
+
+class TestModelRegistry:
+    def test_init(self):
+        mr = ModelRegistry()
+        assert mr.model_count == 0
+
+    def test_publish_model(self):
+        mr = ModelRegistry()
+        mr.publish("lol_agent_v1", game="lol", stage="training", elo=1200,
+                    weights={"w": [1,2]}, parent=None)
+        assert mr.model_count == 1
+
+    def test_query_by_game(self):
+        mr = ModelRegistry()
+        mr.publish("lol_v1", game="lol", stage="training", elo=1200, weights={})
+        mr.publish("dota_v1", game="dota2", stage="training", elo=1000, weights={})
+        results = mr.query(game="lol")
+        assert len(results) == 1
+        assert results[0]["name"] == "lol_v1"
+
+    def test_query_by_stage(self):
+        mr = ModelRegistry()
+        mr.publish("m1", game="lol", stage="staging", elo=1200, weights={})
+        mr.publish("m2", game="lol", stage="production", elo=1300, weights={})
+        results = mr.query(stage="production")
+        assert len(results) == 1
+
+    def test_query_by_elo_range(self):
+        mr = ModelRegistry()
+        mr.publish("m1", game="lol", stage="production", elo=1000, weights={})
+        mr.publish("m2", game="lol", stage="production", elo=1500, weights={})
+        results = mr.query(min_elo=1200)
+        assert len(results) == 1
+        assert results[0]["elo"] == 1500
+
+    def test_load_model(self):
+        mr = ModelRegistry()
+        mr.publish("m1", game="lol", stage="production", elo=1200, weights={"w": [1]})
+        w = mr.load("m1")
+        assert w == {"w": [1]}
+
+    def test_set_deployment_status(self):
+        mr = ModelRegistry()
+        mr.publish("m1", game="lol", stage="staging", elo=1200, weights={})
+        mr.set_status("m1", "production")
+        info = mr.get_info("m1")
+        assert info["stage"] == "production"
+
+    def test_lineage_tracking(self):
+        mr = ModelRegistry()
+        mr.publish("m1", game="lol", stage="training", elo=1000, weights={}, parent=None)
+        mr.publish("m2", game="lol", stage="training", elo=1200, weights={}, parent="m1")
+        lineage = mr.get_lineage("m2")
+        assert lineage == ["m1", "m2"]
+
+    def test_evolution_callback(self):
+        events = []
+        mr = ModelRegistry()
+        mr.evolution_callback = lambda e: events.append(e)
+        mr.publish("m1", game="lol", stage="training", elo=1000, weights={})
+        assert len(events) >= 1
+
+    def test_deprecate_model(self):
+        mr = ModelRegistry()
+        mr.publish("m1", game="lol", stage="production", elo=1200, weights={})
+        mr.set_status("m1", "deprecated")
+        info = mr.get_info("m1")
+        assert info["stage"] == "deprecated"
