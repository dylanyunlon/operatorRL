@@ -0,0 +1,53 @@
+"""
+conftest.py — Bypass agentlightning/__init__.py heavy imports.
+Directly load individual module files via importlib.util.
+"""
+import importlib.util
+import sys
+import os
+
+_PROJECT_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "../.."))
+
+def _load_module(dotted_name: str):
+    """Load a module by dotted name without triggering package __init__.py."""
+    if dotted_name in sys.modules:
+        return sys.modules[dotted_name]
+    parts = dotted_name.split(".")
+    filepath = os.path.join(_PROJECT_ROOT, *parts) + ".py"
+    if not os.path.isfile(filepath):
+        raise ImportError(f"Cannot find {filepath}")
+    spec = importlib.util.spec_from_file_location(dotted_name, filepath)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[dotted_name] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+# Pre-load all M526-M545 modules so normal imports work in test files
+_MODULES = [
+    "agentlightning.trainer.rl_reward_designer",
+    "agentlightning.trainer.experience_replay_manager",
+    "agentlightning.trainer.policy_gradient_trainer",
+    "agentlightning.trainer.value_network_trainer",
+    "agentlightning.trainer.multi_agent_coordinator",
+    "agentlightning.trainer.curriculum_learning_engine",
+    "agentlightning.trainer.imitation_learning_pipeline",
+    "agentlightning.trainer.self_play_arena",
+    "agentlightning.trainer.meta_learning_optimizer",
+    "agentlightning.trainer.training_checkpoint_manager",
+    "agentlightning.inference.action_sampler",
+    "agentlightning.inference.state_encoder_network",
+    "agentlightning.inference.attention_mechanism",
+    "agentlightning.inference.decision_tree_fallback",
+    "agentlightning.inference.model_ensemble",
+    "agentos.governance.training_dashboard",
+    "agentos.governance.hyperparameter_tuner",
+    "agentos.governance.distributed_training_coordinator",
+    "agentos.governance.model_registry",
+    "agentos.governance.evolution_fitness_landscape",
+]
+
+for _m in _MODULES:
+    try:
+        _load_module(_m)
+    except Exception as e:
+        print(f"WARNING: Could not pre-load {_m}: {e}")
