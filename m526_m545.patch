+"""Tests for M536 ActionSampler — TDD, 10 tests."""
+import pytest, sys, os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "../.."))
+from agentlightning.inference.action_sampler import ActionSampler
+
+class TestActionSampler:
+    def test_init(self):
+        a = ActionSampler()
+        assert a.mode == "greedy"
+
+    def test_greedy_sample(self):
+        a = ActionSampler(mode="greedy")
+        logits = [0.1, 0.3, 0.9, 0.2]
+        action = a.sample(logits)
+        assert action == 2
+
+    def test_temperature_sample(self):
+        a = ActionSampler(mode="temperature", temperature=1.0)
+        logits = [0.1, 0.3, 0.9, 0.2]
+        action = a.sample(logits)
+        assert 0 <= action < 4
+
+    def test_topk_sample(self):
+        a = ActionSampler(mode="topk", top_k=2)
+        logits = [0.1, 0.3, 0.9, 0.2]
+        action = a.sample(logits)
+        assert action in [1, 2]  # top-2
+
+    def test_beam_search(self):
+        a = ActionSampler(mode="beam", beam_width=3)
+        logits_seq = [[0.1, 0.9, 0.3], [0.8, 0.1, 0.4], [0.2, 0.7, 0.5]]
+        actions = a.beam_search(logits_seq)
+        assert len(actions) == 3
+
+    def test_low_temperature_is_greedy(self):
+        a = ActionSampler(mode="temperature", temperature=0.01)
+        logits = [0.1, 0.3, 0.9, 0.2]
+        results = [a.sample(logits) for _ in range(20)]
+        assert all(r == 2 for r in results)
+
+    def test_set_mode(self):
+        a = ActionSampler(mode="greedy")
+        a.set_mode("temperature", temperature=0.5)
+        assert a.mode == "temperature"
+
+    def test_empty_logits_raises(self):
+        a = ActionSampler()
+        with pytest.raises(ValueError):
+            a.sample([])
+
+    def test_get_probabilities(self):
+        a = ActionSampler()
+        logits = [1.0, 2.0, 3.0]
+        probs = a.get_probabilities(logits, temperature=1.0)
+        assert len(probs) == 3
+        assert abs(sum(probs) - 1.0) < 1e-6
+
+    def test_evolution_callback(self):
+        events = []
+        a = ActionSampler()
+        a.evolution_callback = lambda e: events.append(e)
+        a.sample([0.1, 0.9])
+        assert len(events) >= 1
