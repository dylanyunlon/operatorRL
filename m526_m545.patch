+"""Tests for M526 RlRewardDesigner — TDD first, 10 tests."""
+import pytest
+import sys, os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "../.."))
+
+from agentlightning.trainer.rl_reward_designer import RlRewardDesigner
+
+
+class TestRlRewardDesigner:
+    def test_init_default_dimensions(self):
+        rd = RlRewardDesigner()
+        assert rd.dimensions == {}
+        assert rd.global_weight_sum() == 0.0
+
+    def test_register_dimension(self):
+        rd = RlRewardDesigner()
+        rd.register_dimension("win", weight=2.0, bounds=(-1.0, 1.0))
+        rd.register_dimension("kda", weight=1.0, bounds=(0.0, 10.0))
+        assert "win" in rd.dimensions
+        assert "kda" in rd.dimensions
+        assert len(rd.dimensions) == 2
+
+    def test_compute_reward_single_dimension(self):
+        rd = RlRewardDesigner()
+        rd.register_dimension("win", weight=1.0, bounds=(0.0, 1.0))
+        raw = {"win": 1.0}
+        reward = rd.compute_reward(raw)
+        assert isinstance(reward, float)
+        assert reward > 0.0
+
+    def test_compute_reward_multi_dimension_weighted(self):
+        rd = RlRewardDesigner()
+        rd.register_dimension("win", weight=3.0, bounds=(0.0, 1.0))
+        rd.register_dimension("cs", weight=1.0, bounds=(0.0, 300.0))
+        raw = {"win": 1.0, "cs": 150.0}
+        reward = rd.compute_reward(raw)
+        assert isinstance(reward, float)
+
+    def test_adjust_weights_shifts_toward_weakness(self):
+        rd = RlRewardDesigner()
+        rd.register_dimension("win", weight=1.0, bounds=(0.0, 1.0))
+        rd.register_dimension("cs", weight=1.0, bounds=(0.0, 300.0))
+        performance = {"win": 0.8, "cs": 0.2}  # cs is weak
+        rd.adjust_weights(performance)
+        assert rd.dimensions["cs"]["weight"] > rd.dimensions["win"]["weight"]
+
+    def test_unified_interface_multi_game(self):
+        rd = RlRewardDesigner()
+        rd.register_dimension("win", weight=1.0, bounds=(0.0, 1.0), game="lol")
+        rd.register_dimension("win", weight=1.0, bounds=(0.0, 1.0), game="dota2")
+        rd.register_dimension("win", weight=1.0, bounds=(0.0, 1.0), game="mahjong")
+        games = rd.list_games()
+        assert "lol" in games
+        assert "dota2" in games
+        assert "mahjong" in games
+
+    def test_compute_reward_clamps_out_of_bounds(self):
+        rd = RlRewardDesigner()
+        rd.register_dimension("score", weight=1.0, bounds=(0.0, 100.0))
+        raw = {"score": 200.0}
+        reward = rd.compute_reward(raw)
+        assert reward <= 1.0  # normalized and clamped
+
+    def test_get_weight_snapshot(self):
+        rd = RlRewardDesigner()
+        rd.register_dimension("a", weight=2.0, bounds=(0.0, 1.0))
+        rd.register_dimension("b", weight=3.0, bounds=(0.0, 1.0))
+        snap = rd.get_weight_snapshot()
+        assert snap["a"] == pytest.approx(2.0)
+        assert snap["b"] == pytest.approx(3.0)
+
+    def test_evolution_callback_fires(self):
+        events = []
+        rd = RlRewardDesigner()
+        rd.evolution_callback = lambda e: events.append(e)
+        rd.register_dimension("x", weight=1.0, bounds=(0.0, 1.0))
+        rd.compute_reward({"x": 0.5})
+        assert len(events) >= 1
+
+    def test_save_load_checkpoint(self):
+        rd = RlRewardDesigner()
+        rd.register_dimension("a", weight=2.5, bounds=(-1.0, 1.0))
+        ckpt = rd.save_checkpoint()
+        rd2 = RlRewardDesigner()
+        rd2.load_checkpoint(ckpt)
+        assert rd2.dimensions["a"]["weight"] == pytest.approx(2.5)
