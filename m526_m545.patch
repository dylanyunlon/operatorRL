++
++Reference (拿来主義):
++  - dota2bot-OpenHyperAI/BotLib/hero_axe.lua: condition-based priority rules
++  - integrations/lol/src/lol_agent/decision_engine.py: rule decisions
++"""
++
++from __future__ import annotations
++
++import logging
++import time
++from typing import Any, Callable, Dict, List, Optional
++
++logger = logging.getLogger(__name__)
++
++_EVOLUTION_KEY: str = "agentlightning.inference.decision_tree_fallback.v1"
++
++
++class DecisionTreeFallback:
++    """Rule-based decision fallback engine.
++
++    Activates when neural network confidence drops below threshold.
++    Logs every fallback for training blind-spot detection.
++
++    Attributes:
++        confidence_threshold: Below this, fallback activates.
++        rules: Registered decision rules sorted by priority.
++    """
++
++    def __init__(self, confidence_threshold: float = 0.5) -> None:
++        self.confidence_threshold = confidence_threshold
++        self.rules: List[Dict[str, Any]] = []
++        self._fallback_log: List[Dict[str, Any]] = []
++        self.evolution_callback: Optional[Callable[[Dict], None]] = None
++
++    # -------------------------------------------------------------------
++    # Rule management
++    # -------------------------------------------------------------------
++
++    def add_rule(
++        self,
++        name: str,
++        condition: Callable[[Dict[str, Any]], bool],
++        action: str,
++        priority: int = 0,
++    ) -> None:
++        """Add a decision rule.
++
++        Args:
++            name: Rule identifier.
++            condition: Function that takes state dict and returns bool.
++            action: Action string to return if condition matches.
++            priority: Higher priority rules checked first.
++        """
++        self.rules.append({
++            "name": name,
++            "condition": condition,
++            "action": action,
++            "priority": priority,
++        })
++        self.rules.sort(key=lambda r: -r["priority"])
++
++    def remove_rule(self, name: str) -> None:
++        self.rules = [r for r in self.rules if r["name"] != name]
++
++    # -------------------------------------------------------------------
++    # Fallback evaluation
++    # -------------------------------------------------------------------
++
++    def maybe_fallback(
++        self,
++        state: Dict[str, Any],
++        nn_confidence: float,
++    ) -> Dict[str, Any]:
++        """Check if fallback should trigger and return action.
++
++        Args:
++            state: Current game state.
++            nn_confidence: Neural network output confidence.
++
++        Returns:
++            Dict with 'triggered' bool and optional 'action'.
++        """
++        if nn_confidence >= self.confidence_threshold:
++            return {"triggered": False, "action": None, "rule": None}
++
++        # Find first matching rule (sorted by priority)
++        for rule in self.rules:
++            try:
++                if rule["condition"](state):
++                    log_entry = {
++                        "state": dict(state),
++                        "nn_confidence": nn_confidence,
++                        "rule": rule["name"],
++                        "action": rule["action"],
++                        "timestamp": time.time(),
++                    }
++                    self._fallback_log.append(log_entry)
++
++                    self._fire_evolution({
++                        "event": "fallback_triggered",
++                        "rule": rule["name"],
++                        "confidence": nn_confidence,
++                    })
++
++                    return {
++                        "triggered": True,
++                        "action": rule["action"],
++                        "rule": rule["name"],
++                    }
++            except Exception as exc:
++                logger.warning("Rule '%s' condition error: %s", rule["name"], exc)
++
++        return {"triggered": False, "action": None, "rule": None}
