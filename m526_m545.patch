+"""Tests for M531 CurriculumLearningEngine — TDD first, 10 tests."""
+import pytest
+import sys, os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "../.."))
+
+from agentlightning.trainer.curriculum_learning_engine import CurriculumLearningEngine
+
+
+class TestCurriculumLearningEngine:
+    def test_init(self):
+        cle = CurriculumLearningEngine()
+        assert cle.current_level == 0
+
+    def test_register_levels(self):
+        cle = CurriculumLearningEngine()
+        cle.register_level(0, "bot", threshold=0.6, opponent="ai_easy")
+        cle.register_level(1, "bronze", threshold=0.7, opponent="ai_medium")
+        cle.register_level(2, "silver", threshold=0.8, opponent="ai_hard")
+        assert cle.level_count == 3
+
+    def test_advance_on_threshold(self):
+        cle = CurriculumLearningEngine()
+        cle.register_level(0, "bot", threshold=0.5)
+        cle.register_level(1, "bronze", threshold=0.7)
+        cle.evaluate_and_advance(performance=0.6)
+        assert cle.current_level == 1
+
+    def test_no_advance_below_threshold(self):
+        cle = CurriculumLearningEngine()
+        cle.register_level(0, "bot", threshold=0.5)
+        cle.register_level(1, "bronze", threshold=0.7)
+        cle.evaluate_and_advance(performance=0.3)
+        assert cle.current_level == 0
+
+    def test_retreat_on_sustained_decline(self):
+        cle = CurriculumLearningEngine(retreat_window=3, retreat_threshold=0.3)
+        cle.register_level(0, "bot", threshold=0.5)
+        cle.register_level(1, "bronze", threshold=0.7)
+        cle.evaluate_and_advance(performance=0.6)  # advance to 1
+        assert cle.current_level == 1
+        # Sustained decline
+        cle.evaluate_and_advance(performance=0.2)
+        cle.evaluate_and_advance(performance=0.2)
+        cle.evaluate_and_advance(performance=0.2)
+        assert cle.current_level == 0  # retreated
+
+    def test_cannot_retreat_below_zero(self):
+        cle = CurriculumLearningEngine(retreat_window=2, retreat_threshold=0.1)
+        cle.register_level(0, "bot", threshold=0.5)
+        cle.evaluate_and_advance(performance=0.05)
+        cle.evaluate_and_advance(performance=0.05)
+        assert cle.current_level == 0
+
+    def test_get_current_config(self):
+        cle = CurriculumLearningEngine()
+        cle.register_level(0, "bot", threshold=0.5, opponent="ai_easy")
+        config = cle.get_current_config()
+        assert config["name"] == "bot"
+        assert config["opponent"] == "ai_easy"
+
+    def test_generate_progress_report(self):
+        cle = CurriculumLearningEngine()
+        cle.register_level(0, "bot", threshold=0.5)
+        cle.register_level(1, "bronze", threshold=0.7)
+        cle.evaluate_and_advance(performance=0.6)
+        report = cle.generate_progress_report()
+        assert "current_level" in report
+        assert "history" in report
+
+    def test_evolution_callback(self):
+        events = []
+        cle = CurriculumLearningEngine()
+        cle.evolution_callback = lambda e: events.append(e)
+        cle.register_level(0, "bot", threshold=0.5)
+        cle.register_level(1, "bronze", threshold=0.8)
+        cle.evaluate_and_advance(performance=0.6)
+        assert len(events) >= 1
+
+    def test_max_level_stays(self):
+        cle = CurriculumLearningEngine()
+        cle.register_level(0, "bot", threshold=0.3)
+        cle.register_level(1, "top", threshold=0.9)
+        cle.evaluate_and_advance(performance=0.5)  # to level 1
+        cle.evaluate_and_advance(performance=0.95)  # already at max
+        assert cle.current_level == 1
