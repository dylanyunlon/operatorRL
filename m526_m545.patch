@@ -0,0 +1,74 @@
+"""Tests for M539 DecisionTreeFallback — TDD, 10 tests."""
+import pytest, sys, os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "../.."))
+from agentlightning.inference.decision_tree_fallback import DecisionTreeFallback
+
+class TestDecisionTreeFallback:
+    def test_init(self):
+        dtf = DecisionTreeFallback(confidence_threshold=0.5)
+        assert dtf.confidence_threshold == 0.5
+
+    def test_add_rule(self):
+        dtf = DecisionTreeFallback()
+        dtf.add_rule("low_hp_retreat", condition=lambda s: s.get("hp_pct", 1.0) < 0.2,
+                      action="retreat", priority=10)
+        assert len(dtf.rules) == 1
+
+    def test_fallback_triggers_low_confidence(self):
+        dtf = DecisionTreeFallback(confidence_threshold=0.6)
+        dtf.add_rule("default_farm", condition=lambda s: True, action="farm", priority=0)
+        result = dtf.maybe_fallback(state={"hp_pct": 0.5}, nn_confidence=0.3)
+        assert result["triggered"] is True
+        assert result["action"] == "farm"
+
+    def test_no_fallback_high_confidence(self):
+        dtf = DecisionTreeFallback(confidence_threshold=0.6)
+        dtf.add_rule("retreat", condition=lambda s: s.get("hp_pct", 1.0) < 0.2,
+                      action="retreat", priority=10)
+        result = dtf.maybe_fallback(state={"hp_pct": 0.5}, nn_confidence=0.9)
+        assert result["triggered"] is False
+
+    def test_priority_ordering(self):
+        dtf = DecisionTreeFallback(confidence_threshold=0.6)
+        dtf.add_rule("farm", condition=lambda s: True, action="farm", priority=0)
+        dtf.add_rule("retreat", condition=lambda s: s.get("hp_pct", 1.0) < 0.3,
+                      action="retreat", priority=10)
+        result = dtf.maybe_fallback(state={"hp_pct": 0.1}, nn_confidence=0.3)
+        assert result["action"] == "retreat"
+
+    def test_log_fallback_context(self):
+        dtf = DecisionTreeFallback(confidence_threshold=0.5)
+        dtf.add_rule("farm", condition=lambda s: True, action="farm", priority=0)
+        dtf.maybe_fallback(state={"hp_pct": 0.5}, nn_confidence=0.3)
+        log = dtf.get_fallback_log()
+        assert len(log) == 1
+        assert "state" in log[0]
+
+    def test_no_matching_rule(self):
+        dtf = DecisionTreeFallback(confidence_threshold=0.5)
+        dtf.add_rule("retreat", condition=lambda s: s.get("hp_pct", 1.0) < 0.1,
+                      action="retreat", priority=10)
+        result = dtf.maybe_fallback(state={"hp_pct": 0.9}, nn_confidence=0.3)
+        assert result["triggered"] is False  # no rule matched
+
+    def test_get_blind_spots(self):
+        dtf = DecisionTreeFallback(confidence_threshold=0.5)
+        dtf.add_rule("farm", condition=lambda s: True, action="farm", priority=0)
+        for i in range(5):
+            dtf.maybe_fallback(state={"phase": "early", "idx": i}, nn_confidence=0.2)
+        spots = dtf.get_blind_spots()
+        assert len(spots) >= 1
+
+    def test_evolution_callback(self):
+        events = []
+        dtf = DecisionTreeFallback(confidence_threshold=0.5)
+        dtf.evolution_callback = lambda e: events.append(e)
+        dtf.add_rule("farm", condition=lambda s: True, action="farm", priority=0)
+        dtf.maybe_fallback(state={}, nn_confidence=0.3)
+        assert len(events) >= 1
+
+    def test_remove_rule(self):
+        dtf = DecisionTreeFallback()
+        dtf.add_rule("farm", condition=lambda s: True, action="farm", priority=0)
+        dtf.remove_rule("farm")
+        assert len(dtf.rules) == 0
