++"""
++Evolution Fitness Landscape — Multi-dimensional fitness landscape analysis.
++
++Location: agentos/governance/evolution_fitness_landscape.py
++
++Reference (拿来主義):
++  - agentos/governance/fitness_aggregator.py: report→aggregate→get_trend
++"""
++
++from __future__ import annotations
++
++import logging
++import math
++import time
++from collections import defaultdict
++from typing import Any, Callable, Dict, List, Optional
++
++logger = logging.getLogger(__name__)
++
++_EVOLUTION_KEY: str = "agentos.governance.evolution_fitness_landscape.v1"
++
++
++class EvolutionFitnessLandscape:
++    """Multi-dimensional fitness landscape for evolution guidance.
++
++    Builds a landscape from per-dimension fitness reports,
++    detects plateaus, recommends evolution directions, and
++    plans improvement paths.
++
++    Attributes:
++        dimension_count: Number of registered fitness dimensions.
++    """
++
++    def __init__(
++        self,
++        plateau_window: int = 5,
++        plateau_threshold: float = 0.02,
++    ) -> None:
++        self.plateau_window = plateau_window
++        self.plateau_threshold = plateau_threshold
++        self._dimensions: Dict[str, float] = {}  # name -> weight
++        self._history: Dict[str, List[float]] = defaultdict(list)
++        self.evolution_callback: Optional[Callable[[Dict], None]] = None
++
++    @property
++    def dimension_count(self) -> int:
++        return len(self._dimensions)
++
++    # -------------------------------------------------------------------
++    # Dimension registration
++    # -------------------------------------------------------------------
++
++    def register_dimension(self, name: str, weight: float = 1.0) -> None:
++        self._dimensions[name] = weight
++
++    # -------------------------------------------------------------------
++    # Fitness reporting — mirrors fitness_aggregator.report
++    # -------------------------------------------------------------------
++
++    def report(self, dimension: str, fitness: float) -> None:
++        """Report fitness value for a dimension."""
++        clamped = max(0.0, min(1.0, fitness))
++        self._history[dimension].append(clamped)
++        self._fire_evolution({
++            "event": "fitness_reported",
++            "dimension": dimension,
++            "fitness": clamped,
++        })
++
++    def get_history(self, dimension: str) -> List[float]:
++        return list(self._history.get(dimension, []))
++
++    # -------------------------------------------------------------------
++    # Landscape construction
++    # -------------------------------------------------------------------
++
++    def build_landscape(self) -> Dict[str, Dict[str, Any]]:
++        """Build current fitness landscape snapshot."""
++        landscape = {}
++        for dim in self._dimensions:
++            h = self._history.get(dim, [])
++            latest = h[-1] if h else 0.0
++            landscape[dim] = {
++                "latest": latest,
++                "weight": self._dimensions[dim],
++                "history_len": len(h),
++            }
++        return landscape
++
++    # -------------------------------------------------------------------
++    # Global fitness — weighted average
++    # -------------------------------------------------------------------
++
++    def global_fitness(self) -> float:
++        total_w = 0.0
++        weighted_sum = 0.0
++        for dim, weight in self._dimensions.items():
++            h = self._history.get(dim, [])
++            if h:
++                weighted_sum += h[-1] * weight
++                total_w += weight
++        return weighted_sum / total_w if total_w > 0 else 0.0
++
++    # -------------------------------------------------------------------
++    # Plateau detection
++    # -------------------------------------------------------------------
++
++    def detect_plateaus(self) -> List[str]:
++        """Find dimensions stuck at a plateau."""
++        plateaus = []
++        for dim in self._dimensions:
++            h = self._history.get(dim, [])
++            if len(h) < self.plateau_window:
++                continue
++            window = h[-self.plateau_window:]
++            spread = max(window) - min(window)
++            if spread < self.plateau_threshold:
++                plateaus.append(dim)
++        return plateaus
++
++    # -------------------------------------------------------------------
++    # Evolution direction recommendation
++    # -------------------------------------------------------------------
++
++    def recommend_evolution_direction(self) -> Dict[str, Any]:
++        """Recommend the dimension with most room for improvement.
++
++        Returns dimension with lowest recent fitness (steepest gradient).
++        """
++        if not self._dimensions:
++            return {"dimension": None, "reason": "no dimensions"}
++
++        worst_dim = None
++        worst_fitness = 2.0  # higher than max 1.0
++
++        for dim in self._dimensions:
++            h = self._history.get(dim, [])
++            latest = h[-1] if h else 0.0
++            if latest < worst_fitness:
++                worst_fitness = latest
++                worst_dim = dim
++
++        return {
++            "dimension": worst_dim,
++            "current_fitness": worst_fitness,
++            "reason": "lowest fitness — most room for improvement",
++        }
