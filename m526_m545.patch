++"""
++Imitation Learning Pipeline — Behavioral Cloning + DAgger.
++
++Location: agentlightning/trainer/imitation_learning_pipeline.py
++
++Reference (拿来主義):
++  - DI-star/agent/default/replay_decoder.py: replay decode→features→training
++  - agentlightning/adapter/distar_adapter.py: obs/action format conversion
++  - agentlightning/trainer/lol_trainer.py: train_step contract
++"""
++
++from __future__ import annotations
++
++import logging
++import math
++import random
++import time
++from typing import Any, Callable, Dict, List, Optional
++
++logger = logging.getLogger(__name__)
++
++_EVOLUTION_KEY: str = "agentlightning.trainer.imitation_learning_pipeline.v1"
++
++
++class ImitationLearningPipeline:
++    """Imitation learning with BC and DAgger modes.
++
++    BC: Pure behavioral cloning from expert trajectories.
++    DAgger: Online imitation mixing expert and agent actions
++    with decaying expert ratio.
++
++    Attributes:
++        mode: 'bc' or 'dagger'.
++        global_step: Total training steps.
++    """
++
++    def __init__(
++        self,
++        mode: str = "bc",
++        lr: float = 1e-3,
++        initial_mix_ratio: float = 1.0,
++        decay_rate: float = 0.05,
++    ) -> None:
++        self.mode = mode
++        self.lr = lr
++        self.initial_mix_ratio = initial_mix_ratio
++        self.current_mix_ratio = initial_mix_ratio
++        self.decay_rate = decay_rate
++        self.global_step: int = 0
++        self._total_loss: float = 0.0
++        self._expert_trajectories: List[List[Dict[str, Any]]] = []
++        self._weights: List[float] = []
++        self._initialized: bool = False
++        self.evolution_callback: Optional[Callable[[Dict], None]] = None
++
++    @property
++    def expert_count(self) -> int:
++        return len(self._expert_trajectories)
++
++    # -------------------------------------------------------------------
++    # Expert data management
++    # -------------------------------------------------------------------
++
++    def add_expert_trajectory(self, trajectory: List[Dict[str, Any]]) -> None:
++        """Add an expert demonstration trajectory."""
++        self._expert_trajectories.append(trajectory)
++
++    def extract_features(self, raw: Dict[str, Any]) -> Dict[str, Any]:
++        """Extract state/action features from raw data."""
++        return {
++            "state": raw.get("state", []),
++            "action": raw.get("action", 0),
++        }
++
++    # -------------------------------------------------------------------
++    # Train step
++    # -------------------------------------------------------------------
++
++    def train_step(self) -> Dict[str, Any]:
++        """Execute one imitation learning training step.
++
++        Returns:
++            Metrics dict with loss, step.
++
++        Raises:
++            ValueError: If no expert trajectories available.
++        """
++        if not self._expert_trajectories:
++            raise ValueError("No expert trajectories available for training")
++
++        # Flatten expert data
++        all_pairs = []
++        for traj in self._expert_trajectories:
++            for step in traj:
++                feat = self.extract_features(step)
++                all_pairs.append(feat)
++
++        if not all_pairs:
++            return {"loss": 0.0, "step": self.global_step}
++
++        # Sample mini-batch
++        batch = random.sample(all_pairs, min(32, len(all_pairs)))
++
++        # Compute BC loss (cross-entropy proxy: MSE on action)
++        loss = 0.0
++        for pair in batch:
++            state = pair["state"]
++            action = pair["action"]
++            if not self._initialized and state:
++                dim = len(state) if isinstance(state, list) else 1
++                self._weights = [0.01] * dim
++                self._initialized = True
++            # Prediction stub
++            if self._initialized and isinstance(state, list):
++                pred = sum(w * x for w, x in zip(self._weights, state))
++            else:
++                pred = 0.0
++            loss += (pred - float(action)) ** 2
++
++        loss /= max(len(batch), 1)
++
++        # SGD update
++        if self._initialized:
++            for pair in batch:
++                state = pair["state"]
++                action = pair["action"]
++                if isinstance(state, list):
++                    pred = sum(w * x for w, x in zip(self._weights, state))
++                    error = pred - float(action)
++                    for j in range(len(self._weights)):
++                        if j < len(state):
++                            self._weights[j] -= self.lr * 2 * error * state[j] / len(batch)
++
++        # DAgger mix ratio decay
++        if self.mode == "dagger":
++            self.current_mix_ratio = max(
++                0.0,
++                self.current_mix_ratio - self.decay_rate,
++            )
++
++        self.global_step += 1
++        self._total_loss += loss
++
++        metrics = {
++            "loss": loss,
++            "step": self.global_step,
++            "mode": self.mode,
++            "mix_ratio": self.current_mix_ratio,
++        }
++        self._fire_evolution({"event": "train_step", **metrics})
++        return metrics
++
++    # -------------------------------------------------------------------
++    # Checkpoint
++    # -------------------------------------------------------------------
++
++    def save_checkpoint(self) -> Dict[str, Any]:
++        return {
++            "global_step": self.global_step,
++            "mode": self.mode,
++            "lr": self.lr,
++            "mix_ratio": self.current_mix_ratio,
++            "weights": list(self._weights),
++            "total_loss": self._total_loss,
++        }
++
++    def load_checkpoint(self, ckpt: Dict[str, Any]) -> None:
++        self.global_step = ckpt.get("global_step", 0)
++        self.mode = ckpt.get("mode", self.mode)
++        self.lr = ckpt.get("lr", self.lr)
++        self.current_mix_ratio = ckpt.get("mix_ratio", self.current_mix_ratio)
++        self._weights = list(ckpt.get("weights", []))
++        self._total_loss = ckpt.get("total_loss", 0.0)
++        self._initialized = bool(self._weights)
++
++    def get_metrics(self) -> Dict[str, Any]:
++        return {
++            "global_step": self.global_step,
++            "mode": self.mode,
++            "avg_loss": self._total_loss / max(self.global_step, 1),
++        }
++
++    # -------------------------------------------------------------------
++    # Evolution callback
++    # -------------------------------------------------------------------
++
++    def _fire_evolution(self, payload: Dict[str, Any]) -> None:
++        if self.evolution_callback is not None:
++            try:
++                self.evolution_callback({
++                    "source": _EVOLUTION_KEY,
++                    "timestamp": time.time(),
++                    **payload,
++                })
++            except Exception as exc:
++                logger.warning("Evolution callback error: %s", exc)
