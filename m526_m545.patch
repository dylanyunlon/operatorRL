++            current = h[-1] if h else 0.0
++            gap = target_val - current
++            if gap > 0:
++                gaps.append({
++                    "dimension": dim,
++                    "current": current,
++                    "target": target_val,
++                    "gap": gap,
++                })
++
++        # Sort by gap descending — work on biggest gaps first
++        gaps.sort(key=lambda g: -g["gap"])
++        return gaps
