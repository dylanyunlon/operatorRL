+logger = logging.getLogger(f"operatorRL.{MODULE_ID}.{MODULE_NAME}")
+
+
+# ============================================================================
+# Enumerations
+# ============================================================================
+class LoggingOrchestratorState(enum.Enum):
+    """Lifecycle states for LoggingOrchestrator."""
+    UNINITIALIZED = "uninitialized"
+    INITIALIZING = "initializing"
+    READY = "ready"
+    RUNNING = "running"
+    PAUSED = "paused"
