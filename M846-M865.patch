+    def reset(self) -> bool:
+        """Reset module to initial state."""
+        with self._lock:
+            self._cache.clear()
+            self._events.clear()
+            self._last_error = None
+            self._state = RuneItemBuildOptimizerState.READY
+            self._emit_event("info", "reset", f"{MODULE_ID} reset")
+            return True
