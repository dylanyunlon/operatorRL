+    ERROR = "error"
+    CRITICAL = "critical"
+
+
+# ============================================================================
+# Data Classes
+# ============================================================================
+@dataclasses.dataclass
+class PlanUpdateProjectIntegratorConfig:
+    """Configuration for PlanUpdateProjectIntegrator."""
+    enabled: bool = True
+    log_level: str = "INFO"
+    max_retries: int = MAX_RETRIES
+    timeout: float = DEFAULT_TIMEOUT
+    cache_ttl: int = 300  # seconds
+    data_dir: str = str(DATA_DIR)
+    cache_dir: str = str(CACHE_DIR)
+    rate_limit_per_second: int = RATE_LIMIT_PER_SECOND
+    rate_limit_per_2min: int = RATE_LIMIT_PER_2MIN
+    fiddler_host: str = "localhost"
+    fiddler_port: int = 8868
