+def generate_readme(module: dict) -> str:
+    """Generate README.md for a module."""
+    deps_str = ", ".join(module["deps"]) if module["deps"] else "None"
+    interfaces = "\n".join(f"- `{i}`" for i in module["interfaces"])
+    return (
