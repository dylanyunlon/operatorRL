+
+# ============================================================================
+# Enumerations
+# ============================================================================
+class PlanUpdateProjectIntegratorState(enum.Enum):
+    """Lifecycle states for PlanUpdateProjectIntegrator."""
+    UNINITIALIZED = "uninitialized"
