+        mc.increment("test_counter")
+        mc.observe("test_hist", 1.5)
+        data = mc.get_all()
+        assert data["counters"]["test_counter"] == 1
+    _test("metrics", test_metrics)
+
+    # Test 6: Event emission
+    def test_events():
+        obj = RankedProgressionTracker()
