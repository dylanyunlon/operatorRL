+"""
+OpponentPlaystyleFingerprinter — Builds unique playstyle fingerprints from Seraphine historical data.
+
+Architecture (拿来主义):
+  opponent_adaptation_tracker.py（M723） — primary reference for opponent modeling
+  seraphine_deep_history_pipeline.py — secondary reference for history data extraction
+
+Location: integrations/lol-history/src/lol_history/opponent_playstyle_fingerprinter.py
+
+查看 **integrations/lol-history/src/lol_history/opponent_adaptation_tracker.py（M723）** 上现有
+**对手追踪方式** 的实现方式，理解其模式，特别是行为聚合与滑动窗口。可以从
+**`seraphine_deep_history_pipeline.py`** 的历史数据批处理这个好例子开始。然后，遵循该模式
+实现一个新的 **OpponentPlaystyleFingerprinter**，让 **对战分析** 可以 **从历史比赛数据中
+提取对手独特的操作指纹（激进度、视野控制偏好、团战参与率、补刀效率曲线）**，并能
+**生成对手画像向量用于实时匹配预测**。从头开始构建，除了代码库中已有的库之外，不要使用其他库。
+"""
+from __future__ import annotations
+import logging, time, math
+from collections import deque
+from typing import Any, Callable, Dict, List, Optional, Tuple
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.opponent_playstyle_fingerprinter.v1"
+def _safe_div(a, b, d=0.0): return a / b if b else d
+def _clamp(v, lo=0.0, hi=1.0): return max(lo, min(hi, v))
+
+class OpponentPlaystyleFingerprinter:
+    """Builds unique playstyle fingerprints from Seraphine historical match data.
+
+    Extracts per-opponent feature vectors: aggression_score, vision_control,
+    teamfight_participation, cs_efficiency, objective_priority, roam_frequency.
+
+    Public API: register, initialize, process, fingerprint, compare, get_report, shutdown, get_stats
+    """
+    DIMENSIONS = ("aggression", "vision_control", "teamfight_participation",
+                  "cs_efficiency", "objective_priority", "roam_frequency",
+                  "early_game_pressure", "late_game_scaling")
+
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._modules: Dict[str, Any] = {}
+        self._history: deque = deque(maxlen=500)
+        self._process_count = 0
+        self._state = "uninitialized"
+        self._errors: Dict[str, int] = {}
+        self._fingerprints: Dict[str, Dict[str, float]] = {}
+        self._match_counts: Dict[str, int] = {}
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def register(self, name: str, module: Any) -> Dict[str, Any]:
+        self._op_count += 1
+        self._modules[name] = module
+        self._errors[name] = 0
+        return {"status": "ok", "module": name, "total": len(self._modules)}
+
+    def initialize(self) -> Dict[str, Any]:
+        self._op_count += 1
+        self._state = "initialized"
+        self._fire("initialized", {"modules": list(self._modules.keys())})
+        return {"status": "ok", "state": self._state, "modules": len(self._modules)}
+
+    def _extract_dimensions(self, match_data: Dict[str, Any]) -> Dict[str, float]:
+        """Extract normalized 0-1 dimension values from a single match record."""
+        kills = match_data.get("kills", 0)
+        deaths = match_data.get("deaths", 0)
+        assists = match_data.get("assists", 0)
+        wards_placed = match_data.get("wards_placed", 0)
+        wards_killed = match_data.get("wards_killed", 0)
+        cs = match_data.get("cs", 0)
+        game_duration_min = max(match_data.get("game_duration_min", 20), 1)
+        teamfight_kills = match_data.get("teamfight_kills", 0)
+        total_team_kills = max(match_data.get("total_team_kills", 1), 1)
+        objectives = match_data.get("objectives_taken", 0)
+        roams = match_data.get("roam_count", 0)
+        early_kills = match_data.get("early_kills_pre15", 0)
+        late_damage_share = match_data.get("late_damage_share", 0.0)
+
+        aggression = _clamp(_safe_div(kills + assists, game_duration_min) / 1.5)
+        vision = _clamp(_safe_div(wards_placed + wards_killed, game_duration_min) / 2.0)
+        teamfight = _clamp(_safe_div(teamfight_kills + assists, total_team_kills))
+        cs_eff = _clamp(_safe_div(cs, game_duration_min) / 10.0)
+        obj_priority = _clamp(_safe_div(objectives, game_duration_min) * 5.0)
+        roam_freq = _clamp(_safe_div(roams, game_duration_min) / 0.5)
+        early_pressure = _clamp(early_kills / 5.0)
+        late_scaling = _clamp(late_damage_share)
+
+        return {
+            "aggression": round(aggression, 4),
+            "vision_control": round(vision, 4),
+            "teamfight_participation": round(teamfight, 4),
+            "cs_efficiency": round(cs_eff, 4),
+            "objective_priority": round(obj_priority, 4),
+            "roam_frequency": round(roam_freq, 4),
+            "early_game_pressure": round(early_pressure, 4),
+            "late_game_scaling": round(late_scaling, 4),
+        }
+
+    def fingerprint(self, opponent_id: str, match_history: List[Dict[str, Any]]) -> Dict[str, Any]:
+        """Build or update a fingerprint for a given opponent from match history."""
+        self._op_count += 1
+        if not match_history:
+            return {"status": "error", "reason": "empty_history"}
+
+        dim_accum = {d: 0.0 for d in self.DIMENSIONS}
+        valid = 0
+        for match in match_history:
+            try:
+                dims = self._extract_dimensions(match)
+                for d in self.DIMENSIONS:
+                    dim_accum[d] += dims[d]
+                valid += 1
+            except Exception as e:
+                logger.warning("fingerprint extraction error: %s", e)
+
+        if valid == 0:
+            return {"status": "error", "reason": "no_valid_matches"}
+
+        fp = {d: round(dim_accum[d] / valid, 4) for d in self.DIMENSIONS}
+        self._fingerprints[opponent_id] = fp
+        self._match_counts[opponent_id] = valid
+        self._fire("fingerprinted", {"opponent": opponent_id, "matches": valid})
+        return {"status": "ok", "opponent_id": opponent_id, "fingerprint": fp, "match_count": valid}
+
+    def compare(self, fp_a: Dict[str, float], fp_b: Dict[str, float]) -> Dict[str, Any]:
+        """Compute cosine similarity between two fingerprint vectors."""
+        self._op_count += 1
+        dot = sum(fp_a.get(d, 0) * fp_b.get(d, 0) for d in self.DIMENSIONS)
+        mag_a = math.sqrt(sum(fp_a.get(d, 0) ** 2 for d in self.DIMENSIONS))
+        mag_b = math.sqrt(sum(fp_b.get(d, 0) ** 2 for d in self.DIMENSIONS))
+        similarity = _safe_div(dot, mag_a * mag_b)
+        return {"status": "ok", "similarity": round(similarity, 4),
+                "distance": round(1.0 - similarity, 4)}
+
+    def process(self, data: Dict[str, Any] = None) -> Dict[str, Any]:
+        self._op_count += 1
+        self._process_count += 1
+        data = data or {}
+        results = {}
+        errors = []
+        # Process any queued opponent data
+        opponents = data.get("opponents", {})
+        for opp_id, matches in opponents.items():
+            try:
+                r = self.fingerprint(opp_id, matches)
+                results[opp_id] = r
+            except Exception as e:
+                self._errors[opp_id] = self._errors.get(opp_id, 0) + 1
+                errors.append(f"{opp_id}: {e}")
+                results[opp_id] = {"status": "error", "error": str(e)}
+        # Also process registered modules
+        for name, module in self._modules.items():
+            try:
+                if hasattr(module, "get_stats"):
+                    results[name] = {"status": "ok", "stats": module.get_stats()}
+                else:
+                    results[name] = {"status": "ok"}
+            except Exception as e:
+                self._errors[name] = self._errors.get(name, 0) + 1
+                errors.append(f"{name}: {e}")
+        entry = {"cycle": self._process_count, "results": results, "errors": errors,
+                 "timestamp": time.time()}
+        self._history.append(entry)
+        self._fire("processed", {"cycle": self._process_count, "errors": len(errors)})
+        return {"status": "ok", "cycle": self._process_count, "results": results, "errors": errors}
+
+    def get_report(self) -> Dict[str, Any]:
+        self._op_count += 1
+        return {"status": "ok", "state": self._state, "modules": len(self._modules),
+                "process_count": self._process_count,
+                "fingerprints_count": len(self._fingerprints),
+                "module_errors": dict(self._errors),
+                "recent_history": list(self._history)[-5:]}
+
+    def shutdown(self) -> Dict[str, Any]:
+        self._op_count += 1
+        self._state = "shutdown"
+        self._fire("shutdown", {"cycles": self._process_count})
+        return {"status": "ok", "state": "shutdown", "total_cycles": self._process_count}
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {"state": self._state, "modules": len(self._modules),
+                "process_count": self._process_count, "total_ops": self._op_count,
+                "fingerprints": len(self._fingerprints),
+                "errors": dict(self._errors)}
