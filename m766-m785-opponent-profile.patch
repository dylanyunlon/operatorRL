+        cond_counts: Dict[str, int] = {}
+        for r in records:
+            for c in r.get("loss_factors", []):
+                cond_counts[c] = cond_counts.get(c, 0) + 1
+        total = len(records)
+        conditions = {c: {"count": n, "frequency": round(n / total, 4)}
+                      for c, n in sorted(cond_counts.items(), key=lambda x: -x[1])}
+        self._condition_cache[opponent_id] = conditions
+        return {"status": "ok", "opponent_id": opponent_id, "conditions": conditions, "total": total}
