+# ─────────────────────────── M767: OpponentLaneMatchupPredictor ───────────────────────────
+from lol_history.opponent_lane_matchup_predictor import OpponentLaneMatchupPredictor
+
+class TestOpponentLaneMatchupPredictor:
+    def _make(self):
+        return OpponentLaneMatchupPredictor()
+
+    def test_init(self):
+        m = self._make()
+        assert m._state == "uninitialized"
+
+    def test_predict_no_data(self):
+        m = self._make()
+        r = m.predict_matchup("Ahri", "Zed")
+        assert r["status"] == "ok"
+        assert r["confidence"] == 0.0
+        assert r["prediction"] == 0.5
+
+    def test_add_historical_lane(self):
+        m = self._make()
+        r = m.add_historical_lane("Ahri", "Zed", {"win": True, "cs_diff": 15})
+        assert r["status"] == "ok"
+        assert r["total"] == 1
+
+    def test_predict_after_data(self):
+        m = self._make()
+        for _ in range(8):
+            m.add_historical_lane("Ahri", "Zed", {"win": True})
+        for _ in range(2):
+            m.add_historical_lane("Ahri", "Zed", {"win": False})
+        r = m.predict_matchup("Ahri", "Zed")
+        assert r["prediction"] == pytest.approx(0.8, abs=0.01)
+
+    def test_confidence_scales_with_samples(self):
+        m = self._make()
+        m.add_historical_lane("A", "B", {"win": True})
+        r1 = m.predict_matchup("A", "B")
+        for _ in range(19):
+            m.add_historical_lane("A", "B", {"win": True})
+        r2 = m.predict_matchup("A", "B")
+        assert r2["confidence"] >= r1["confidence"]
+
+    def test_matchup_report(self):
+        m = self._make()
+        m.add_historical_lane("A", "B", {"win": True})
+        m.predict_matchup("A", "B")
+        r = m.get_matchup_report()
+        assert r["total_matchups"] >= 1
+
+    def test_register_and_process(self):
+        m = self._make()
+        m.register("sub", type("S", (), {"get_stats": lambda s: {"ok": True}})())
+        r = m.process()
+        assert r["status"] == "ok"
+
+    def test_shutdown(self):
+        m = self._make()
+        r = m.shutdown()
+        assert r["state"] == "shutdown"
+
+    def test_get_stats(self):
+        m = self._make()
+        s = m.get_stats()
+        assert "state" in s
+        assert "process_count" in s
+
+    def test_multiple_matchups_independent(self):
+        m = self._make()
+        m.add_historical_lane("X", "Y", {"win": True})
+        m.add_historical_lane("A", "B", {"win": False})
+        r1 = m.predict_matchup("X", "Y")
+        r2 = m.predict_matchup("A", "B")
+        assert r1["prediction"] > r2["prediction"]
+
