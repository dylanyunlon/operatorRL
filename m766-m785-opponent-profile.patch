+"""
+OpponentComebackPatternProfiler — 对手翻盘模式画像器。
+
+Architecture (拿来主义):
+  comeback_pattern_detector.py — primary reference
+  intel_prediction_evaluator.py（M726） — secondary reference
+
+Location: integrations/lol-history/src/lol_history/opponent_comeback_pattern_profiler.py
+
+查看 **integrations/lol-history/src/lol_history/comeback_pattern_detector.py** 上现有
+**翻盘检测** 的实现方式，理解其模式。可以从
+**`intel_prediction_evaluator.py（M726）`** 的赛后评估模式这个好例子开始。然后，遵循该模式
+实现一个新的 **OpponentComebackPatternProfiler**，让 **翻盘预测** 可以 **从对手历史逆风翻盘数据分析翻盘条件（经济差阈值、关键事件触发器）**，并能
+**输出翻盘概率和需要警惕的翻盘信号**。从头开始构建，除了代码库中已有的库之外，不要使用其他库。
+"""
+from __future__ import annotations
+import logging, time, math
+from collections import deque
+from typing import Any, Callable, Dict, List, Optional, Tuple
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.opponent_comeback_pattern_profiler.v1"
+def _safe_div(a, b, d=0.0): return a / b if b else d
+def _clamp(v, lo=0.0, hi=1.0): return max(lo, min(hi, v))
+
+class OpponentComebackPatternProfiler:
+    """Profiles opponent comeback patterns from historical deficit-to-win games.
+
+    Public API: register, initialize, process, get_report, shutdown, get_stats
+    """
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._modules: Dict[str, Any] = {}
+        self._history: deque = deque(maxlen=500)
+        self._process_count = 0
+        self._state = "uninitialized"
+        self._errors: Dict[str, int] = {}
+        self._game_records: Dict[str, List[Dict]] = {}
+        self._comeback_cache: Dict[str, Dict] = {}
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def register(self, name: str, module: Any) -> Dict[str, Any]:
+        self._op_count += 1
+        self._modules[name] = module
+        self._errors[name] = 0
+        return {"status": "ok", "module": name, "total": len(self._modules)}
+
+    def initialize(self) -> Dict[str, Any]:
+        self._op_count += 1
+        self._state = "initialized"
+        self._fire("initialized", {"modules": list(self._modules.keys())})
+        return {"status": "ok", "state": self._state, "modules": len(self._modules)}
+
+    def profile_comeback(self, opponent_id: str) -> Dict[str, Any]:
+        self._op_count += 1
+        records = self._game_records.get(opponent_id, [])
+        if not records:
+            return {"status": "ok", "opponent_id": opponent_id, "comeback_rate": 0.0, "confidence": 0.0}
+        total = len(records)
+        deficit_games = [r for r in records if r.get("was_behind", False)]
+        comebacks = [r for r in deficit_games if r.get("win", False)]
+        comeback_rate = _safe_div(len(comebacks), len(deficit_games)) if deficit_games else 0.0
+        triggers: Dict[str, int] = {}
+        for c in comebacks:
+            for t in c.get("comeback_triggers", []):
+                triggers[t] = triggers.get(t, 0) + 1
+        conf = min(len(deficit_games) / 10.0, 1.0)
+        result = {"comeback_rate": round(comeback_rate, 4), "deficit_games": len(deficit_games),
+                  "comebacks": len(comebacks), "triggers": triggers, "confidence": round(conf, 4)}
+        self._comeback_cache[opponent_id] = result
+        return {"status": "ok", "opponent_id": opponent_id, **result}
+
+    def add_game_record(self, opponent_id: str, record: Dict[str, Any]) -> Dict[str, Any]:
+        self._op_count += 1
