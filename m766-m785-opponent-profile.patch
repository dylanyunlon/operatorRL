+"""
+OpponentEarlyAggressionProfiler — 对手前期侵略性画像器。
+
+Architecture (拿来主义):
+  opponent_playstyle_fingerprinter.py（M766） — primary reference
+  opponent_tilt_detector.py（M770） — secondary reference
+
+Location: integrations/lol-history/src/lol_history/opponent_early_aggression_profiler.py
+
+查看 **integrations/lol-history/src/lol_history/opponent_playstyle_fingerprinter.py（M766）** 上现有
+**指纹向量提取** 的实现方式，理解其模式。可以从
+**`opponent_tilt_detector.py（M770）`** 的连续匹配分析这个好例子开始。然后，遵循该模式
+实现一个新的 **OpponentEarlyAggressionProfiler**，让 **前期策略** 可以 **从前15分钟的击杀/死亡/补刀/视野数据评估对手前期侵略性等级**，并能
+**输出侵略性评级和对应的前期策略（激进/保守/标准）**。从头开始构建，除了代码库中已有的库之外，不要使用其他库。
+"""
+from __future__ import annotations
+import logging, time, math
+from collections import deque
+from typing import Any, Callable, Dict, List, Optional, Tuple
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.opponent_early_aggression_profiler.v1"
+def _safe_div(a, b, d=0.0): return a / b if b else d
+def _clamp(v, lo=0.0, hi=1.0): return max(lo, min(hi, v))
+
+class OpponentEarlyAggressionProfiler:
+    """Profiles opponent early-game aggression patterns from historical pre-15min data.
+
+    Public API: register, initialize, process, get_report, shutdown, get_stats
+    """
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._modules: Dict[str, Any] = {}
+        self._history: deque = deque(maxlen=500)
+        self._process_count = 0
+        self._state = "uninitialized"
+        self._errors: Dict[str, int] = {}
+        self._early_data: Dict[str, List[Dict]] = {}
+        self._profile_cache: Dict[str, Dict] = {}
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def register(self, name: str, module: Any) -> Dict[str, Any]:
+        self._op_count += 1
+        self._modules[name] = module
+        self._errors[name] = 0
+        return {"status": "ok", "module": name, "total": len(self._modules)}
+
+    def initialize(self) -> Dict[str, Any]:
+        self._op_count += 1
+        self._state = "initialized"
+        self._fire("initialized", {"modules": list(self._modules.keys())})
+        return {"status": "ok", "state": self._state, "modules": len(self._modules)}
+
+    def profile_aggression(self, opponent_id: str) -> Dict[str, Any]:
+        self._op_count += 1
+        data_list = self._early_data.get(opponent_id, [])
+        if not data_list:
+            return {"status": "ok", "opponent_id": opponent_id, "aggression_level": "unknown", "score": 0.0, "confidence": 0.0}
+        scores = []
+        for d in data_list:
+            early_kills = d.get("kills_pre15", 0)
+            early_deaths = d.get("deaths_pre15", 0)
+            cs_at15 = d.get("cs_at15", 0)
+            wards_pre15 = d.get("wards_pre15", 0)
+            score = _clamp(early_kills * 0.3 + (1.0 - _clamp(early_deaths / 5.0)) * 0.2 +
+                          _clamp(cs_at15 / 120.0) * 0.2 + _clamp(wards_pre15 / 10.0) * 0.3)
+            scores.append(score)
+        avg = sum(scores) / len(scores)
+        level = "aggressive" if avg > 0.6 else ("passive" if avg < 0.3 else "standard")
+        conf = min(len(scores) / 10.0, 1.0)
+        result = {"aggression_level": level, "score": round(avg, 4), "confidence": round(conf, 4)}
+        self._profile_cache[opponent_id] = result
+        return {"status": "ok", "opponent_id": opponent_id, **result}
+
+    def add_early_data(self, opponent_id: str, data: Dict[str, Any]) -> Dict[str, Any]:
+        self._op_count += 1
+        if opponent_id not in self._early_data:
+            self._early_data[opponent_id] = []
+        self._early_data[opponent_id].append(data)
+        return {"status": "ok", "opponent_id": opponent_id, "total": len(self._early_data[opponent_id])}
+
+    def get_strategy_advice(self, opponent_id: str) -> Dict[str, Any]:
+        self._op_count += 1
+        profile = self._profile_cache.get(opponent_id, {})
+        level = profile.get("aggression_level", "unknown")
+        advice_map = {"aggressive": "play_safe_early_scale", "passive": "push_advantage_early",
+                      "standard": "match_pace", "unknown": "default_standard"}
+        return {"status": "ok", "opponent_id": opponent_id, "advice": advice_map.get(level, "default_standard"), "profile": profile}
+
+    def process(self, data: Dict[str, Any] = None) -> Dict[str, Any]:
+        self._op_count += 1
+        self._process_count += 1
+        data = data or {}
+        results = {}
+        errors = []
+        for name, module in self._modules.items():
+            try:
+                if hasattr(module, "get_stats"):
+                    results[name] = {"status": "ok", "stats": module.get_stats()}
+                else:
+                    results[name] = {"status": "ok"}
+            except Exception as e:
+                self._errors[name] = self._errors.get(name, 0) + 1
+                errors.append(f"{name}: {e}")
+                results[name] = {"status": "error", "error": str(e)}
+        entry = {"cycle": self._process_count, "results": results, "errors": errors,
+                 "timestamp": time.time()}
+        self._history.append(entry)
+        self._fire("processed", {"cycle": self._process_count, "errors": len(errors)})
+        return {"status": "ok", "cycle": self._process_count, "results": results, "errors": errors}
+
