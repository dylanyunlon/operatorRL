+"""
+TDD Tests for M766-M785: Opponent Profile Combat Decision Engine.
+
+200 tests total (10 per module). Designed so ~50% fail on first run to validate
+genuine test-driven development. Tests cover:
+- Basic instantiation and state
+- Core business logic with realistic inputs
+- Edge cases (empty data, single item, large volumes)
+- Evolution callback firing
+- Error handling and graceful degradation
+- Cross-module integration contracts
+
+NO MOCKS - tests use real module instances per TDD discipline.
+"""
+import sys, os, math, time, pytest
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "integrations", "lol-history", "src"))
+
+# ─────────────────────────── M766: OpponentPlaystyleFingerprinter ───────────────────────────
+from lol_history.opponent_playstyle_fingerprinter import OpponentPlaystyleFingerprinter
+
+class TestOpponentPlaystyleFingerprinter:
+    def _make(self):
+        return OpponentPlaystyleFingerprinter()
+
+    def _sample_match(self, kills=5, deaths=3, assists=7, cs=180, duration=25):
+        return {"kills": kills, "deaths": deaths, "assists": assists, "cs": cs,
+                "game_duration_min": duration, "wards_placed": 12, "wards_killed": 4,
+                "teamfight_kills": 3, "total_team_kills": 20, "objectives_taken": 2,
+                "roam_count": 5, "early_kills_pre15": 2, "late_damage_share": 0.25}
+
+    def test_init_state(self):
+        fp = self._make()
+        assert fp._state == "uninitialized"
+        assert fp._process_count == 0
+        assert len(fp._fingerprints) == 0
+
+    def test_register_module(self):
+        fp = self._make()
+        r = fp.register("test_mod", object())
+        assert r["status"] == "ok"
+        assert r["total"] == 1
+
+    def test_initialize(self):
+        fp = self._make()
+        r = fp.initialize()
+        assert r["state"] == "initialized"
+
+    def test_fingerprint_single_match(self):
+        fp = self._make()
+        r = fp.fingerprint("opp1", [self._sample_match()])
+        assert r["status"] == "ok"
+        assert r["match_count"] == 1
+        assert "aggression" in r["fingerprint"]
+        assert 0 <= r["fingerprint"]["aggression"] <= 1
+
+    def test_fingerprint_all_dimensions_present(self):
+        fp = self._make()
+        r = fp.fingerprint("opp1", [self._sample_match()])
+        for dim in OpponentPlaystyleFingerprinter.DIMENSIONS:
+            assert dim in r["fingerprint"], f"Missing dimension: {dim}"
+
+    def test_fingerprint_empty_history(self):
+        fp = self._make()
+        r = fp.fingerprint("opp1", [])
+        assert r["status"] == "error"
+
+    def test_fingerprint_multiple_matches_averaging(self):
+        fp = self._make()
+        matches = [self._sample_match(kills=10), self._sample_match(kills=0)]
+        r = fp.fingerprint("opp1", matches)
+        assert r["match_count"] == 2
+        # Aggression of 10-kill game should be higher than 0-kill game, average in between
+        fp2 = self._make()
+        r_high = fp2.fingerprint("h", [self._sample_match(kills=10)])
+        r_low = fp2.fingerprint("l", [self._sample_match(kills=0)])
+        assert r_low["fingerprint"]["aggression"] <= r["fingerprint"]["aggression"] <= r_high["fingerprint"]["aggression"]
+
+    def test_compare_identical_fingerprints(self):
+        fp = self._make()
+        r = fp.fingerprint("opp1", [self._sample_match()])
+        sim = fp.compare(r["fingerprint"], r["fingerprint"])
+        assert sim["similarity"] == pytest.approx(1.0, abs=0.01)
+
+    def test_compare_different_fingerprints(self):
+        fp = self._make()
+        fp_a = fp.fingerprint("a", [self._sample_match(kills=10, cs=300)])["fingerprint"]
+        fp_b = fp.fingerprint("b", [self._sample_match(kills=0, cs=50)])["fingerprint"]
+        sim = fp.compare(fp_a, fp_b)
+        assert sim["similarity"] < 1.0
+
+    def test_evolution_callback_fires(self):
+        fp = self._make()
+        events = []
+        fp.evolution_callback = lambda e: events.append(e)
+        fp.fingerprint("opp1", [self._sample_match()])
+        assert any(e["type"] == "fingerprinted" for e in events)
+
