+        self._history: deque = deque(maxlen=500)
+        self._process_count = 0
+        self._state = "uninitialized"
+        self._errors: Dict[str, int] = {}
+        self._analyzers: Dict[str, Any] = {}
+        self._profile_cache: Dict[str, Dict] = {}
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def register(self, name: str, module: Any) -> Dict[str, Any]:
+        self._op_count += 1
+        self._modules[name] = module
+        self._errors[name] = 0
+        return {"status": "ok", "module": name, "total": len(self._modules)}
+
+    def initialize(self) -> Dict[str, Any]:
+        self._op_count += 1
+        self._state = "initialized"
+        self._fire("initialized", {"modules": list(self._modules.keys())})
+        return {"status": "ok", "state": self._state, "modules": len(self._modules)}
+
+    def merge_profile(self, opponent_id: str) -> Dict[str, Any]:
+        self._op_count += 1
+        profile = {}
+        errors = []
+        for name, analyzer in self._analyzers.items():
+            try:
+                if hasattr(analyzer, "get_stats"):
+                    profile[name] = analyzer.get_stats()
+                else:
+                    profile[name] = {"status": "ok"}
+            except Exception as e:
+                errors.append(f"{name}: {e}")
+                profile[name] = {"status": "error", "error": str(e)}
+        completeness = _safe_div(sum(1 for v in profile.values() if v.get("status") != "error"), len(profile))
+        result = {"profile": profile, "completeness": round(completeness, 4),
+                  "analyzers_total": len(self._analyzers), "errors": errors}
+        self._profile_cache[opponent_id] = result
+        self._fire("merged", {"opponent": opponent_id, "completeness": completeness})
+        return {"status": "ok", "opponent_id": opponent_id, **result}
+
+    def register_analyzer(self, name: str, analyzer: Any) -> Dict[str, Any]:
+        self._op_count += 1
+        self._analyzers[name] = analyzer
+        return {"status": "ok", "analyzer": name, "total": len(self._analyzers)}
+
+    def get_unified_profile(self, opponent_id: str) -> Dict[str, Any]:
+        self._op_count += 1
+        cached = self._profile_cache.get(opponent_id, {})
+        return {"status": "ok", "opponent_id": opponent_id, "cached_profile": cached}
+
+    def process(self, data: Dict[str, Any] = None) -> Dict[str, Any]:
+        self._op_count += 1
+        self._process_count += 1
+        data = data or {}
