+"""
+OpponentDeathHeatmapBuilder — 对手死亡热力图构建器。
+
+Architecture (拿来主义):
+  opponent_ward_pattern_analyzer.py（M768） — primary reference
+  intel_feature_vector_builder.py（M727） — secondary reference
+
+Location: integrations/lol-history/src/lol_history/opponent_death_heatmap_builder.py
+
+查看 **integrations/lol-history/src/lol_history/opponent_ward_pattern_analyzer.py（M768）** 上现有
+**空间模式分析** 的实现方式，理解其模式。可以从
+**`intel_feature_vector_builder.py（M727）`** 的特征向量这个好例子开始。然后，遵循该模式
+实现一个新的 **OpponentDeathHeatmapBuilder**，让 **地图控制** 可以 **从历史死亡位置数据构建对手死亡热力图（分区域、分时间段）**，并能
+**输出高死亡概率区域和最佳击杀时机建议**。从头开始构建，除了代码库中已有的库之外，不要使用其他库。
+"""
+from __future__ import annotations
+import logging, time, math
+from collections import deque
+from typing import Any, Callable, Dict, List, Optional, Tuple
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.opponent_death_heatmap_builder.v1"
+def _safe_div(a, b, d=0.0): return a / b if b else d
+def _clamp(v, lo=0.0, hi=1.0): return max(lo, min(hi, v))
+
+class OpponentDeathHeatmapBuilder:
+    """Builds spatial death heatmaps from opponent historical death positions.
+
+    Public API: register, initialize, process, get_report, shutdown, get_stats
+    """
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._modules: Dict[str, Any] = {}
+        self._history: deque = deque(maxlen=500)
+        self._process_count = 0
+        self._state = "uninitialized"
+        self._errors: Dict[str, int] = {}
+        self._death_events: Dict[str, List[Dict]] = {}
+        self._heatmap_cache: Dict[str, Dict] = {}
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def register(self, name: str, module: Any) -> Dict[str, Any]:
+        self._op_count += 1
+        self._modules[name] = module
+        self._errors[name] = 0
+        return {"status": "ok", "module": name, "total": len(self._modules)}
+
+    def initialize(self) -> Dict[str, Any]:
+        self._op_count += 1
+        self._state = "initialized"
+        self._fire("initialized", {"modules": list(self._modules.keys())})
+        return {"status": "ok", "state": self._state, "modules": len(self._modules)}
+
+    def build_heatmap(self, opponent_id: str) -> Dict[str, Any]:
+        self._op_count += 1
+        deaths = self._death_events.get(opponent_id, [])
+        if not deaths:
+            return {"status": "ok", "opponent_id": opponent_id, "zones": {}, "total": 0}
+        zone_counts: Dict[str, int] = {}
+        time_buckets: Dict[str, Dict[str, int]] = {}
+        for d in deaths:
+            zone = d.get("zone", "unknown")
+            phase = d.get("game_phase", "mid")
+            zone_counts[zone] = zone_counts.get(zone, 0) + 1
+            if zone not in time_buckets:
+                time_buckets[zone] = {}
+            time_buckets[zone][phase] = time_buckets[zone].get(phase, 0) + 1
+        total = len(deaths)
+        zones = {z: {"count": c, "frequency": round(c / total, 4), "phases": time_buckets.get(z, {})}
+                 for z, c in sorted(zone_counts.items(), key=lambda x: -x[1])}
+        self._heatmap_cache[opponent_id] = zones
+        return {"status": "ok", "opponent_id": opponent_id, "zones": zones, "total": total}
+
+    def add_death_event(self, opponent_id: str, event: Dict[str, Any]) -> Dict[str, Any]:
+        self._op_count += 1
+        if opponent_id not in self._death_events:
+            self._death_events[opponent_id] = []
+        self._death_events[opponent_id].append(event)
+        return {"status": "ok", "opponent_id": opponent_id, "total": len(self._death_events[opponent_id])}
+
+    def get_gank_advice(self, opponent_id: str, game_phase: str = "early", top_n: int = 3) -> Dict[str, Any]:
+        self._op_count += 1
+        zones = self._heatmap_cache.get(opponent_id, {})
+        advice = []
+        for z, info in zones.items():
+            phase_count = info.get("phases", {}).get(game_phase, 0)
+            if phase_count > 0:
+                advice.append({"zone": z, "deaths_in_phase": phase_count, "frequency": info["frequency"]})
+        advice.sort(key=lambda x: -x["deaths_in_phase"])
+        return {"status": "ok", "opponent_id": opponent_id, "phase": game_phase, "advice": advice[:top_n]}
+
+    def process(self, data: Dict[str, Any] = None) -> Dict[str, Any]:
+        self._op_count += 1
+        self._process_count += 1
+        data = data or {}
+        results = {}
+        errors = []
+        for name, module in self._modules.items():
+            try:
+                if hasattr(module, "get_stats"):
+                    results[name] = {"status": "ok", "stats": module.get_stats()}
+                else:
+                    results[name] = {"status": "ok"}
+            except Exception as e:
+                self._errors[name] = self._errors.get(name, 0) + 1
+                errors.append(f"{name}: {e}")
+                results[name] = {"status": "error", "error": str(e)}
+        entry = {"cycle": self._process_count, "results": results, "errors": errors,
+                 "timestamp": time.time()}
+        self._history.append(entry)
+        self._fire("processed", {"cycle": self._process_count, "errors": len(errors)})
+        return {"status": "ok", "cycle": self._process_count, "results": results, "errors": errors}
+
+    def get_report(self) -> Dict[str, Any]:
+        self._op_count += 1
+        return {"status": "ok", "state": self._state, "modules": len(self._modules),
+                "process_count": self._process_count,
+                "module_errors": dict(self._errors),
+                "recent_history": list(self._history)[-5:]}
+
+    def shutdown(self) -> Dict[str, Any]:
+        self._op_count += 1
+        self._state = "shutdown"
+        self._fire("shutdown", {"cycles": self._process_count})
+        return {"status": "ok", "state": "shutdown", "total_cycles": self._process_count}
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {"state": self._state, "modules": len(self._modules),
+                "process_count": self._process_count, "total_ops": self._op_count,
+                "errors": dict(self._errors)}
