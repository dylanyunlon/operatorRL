+"""
+OpponentSummonerSpellTracker — 对手召唤师技能偏好追踪器。
+
+Architecture (拿来主义):
+  seraphine_bridge.py — primary reference
+  champion_meta.py — secondary reference
+
+Location: integrations/lol-history/src/lol_history/opponent_summoner_spell_tracker.py
+
+查看 **integrations/lol-history/src/lol_history/seraphine_bridge.py** 上现有
+**LCU数据获取** 的实现方式，理解其模式。可以从
+**`champion_meta.py`** 的英雄元数据这个好例子开始。然后，遵循该模式
+实现一个新的 **OpponentSummonerSpellTracker**，让 **技能追踪** 可以 **从历史数据追踪对手对每英雄的召唤师技能选择偏好（闪现+引燃 vs 闪现+传送等）**，并能
+**输出预测的召唤师技能和对应的对线策略调整**。从头开始构建，除了代码库中已有的库之外，不要使用其他库。
+"""
+from __future__ import annotations
+import logging, time, math
+from collections import deque
+from typing import Any, Callable, Dict, List, Optional, Tuple
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.opponent_summoner_spell_tracker.v1"
+def _safe_div(a, b, d=0.0): return a / b if b else d
+def _clamp(v, lo=0.0, hi=1.0): return max(lo, min(hi, v))
+
+class OpponentSummonerSpellTracker:
+    """Tracks opponent summoner spell preferences and usage patterns from match history.
+
+    Public API: register, initialize, process, get_report, shutdown, get_stats
+    """
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._modules: Dict[str, Any] = {}
+        self._history: deque = deque(maxlen=500)
+        self._process_count = 0
+        self._state = "uninitialized"
+        self._errors: Dict[str, int] = {}
+        self._spell_records: Dict[str, List[Dict]] = {}
+        self._spell_cache: Dict[str, Dict] = {}
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def register(self, name: str, module: Any) -> Dict[str, Any]:
+        self._op_count += 1
+        self._modules[name] = module
+        self._errors[name] = 0
+        return {"status": "ok", "module": name, "total": len(self._modules)}
+
+    def initialize(self) -> Dict[str, Any]:
+        self._op_count += 1
+        self._state = "initialized"
+        self._fire("initialized", {"modules": list(self._modules.keys())})
+        return {"status": "ok", "state": self._state, "modules": len(self._modules)}
+
+    def track_spells(self, opponent_id: str) -> Dict[str, Any]:
+        self._op_count += 1
+        records = self._spell_records.get(opponent_id, [])
+        if not records:
+            return {"status": "ok", "opponent_id": opponent_id, "patterns": {}, "total": 0}
+        combo_counts: Dict[str, int] = {}
+        for r in records:
+            combo = f"{r.get('spell1','?')}+{r.get('spell2','?')}"
+            combo_counts[combo] = combo_counts.get(combo, 0) + 1
+        total = len(records)
+        patterns = {c: {"count": n, "frequency": round(n / total, 4)}
+                    for c, n in sorted(combo_counts.items(), key=lambda x: -x[1])}
+        self._spell_cache[opponent_id] = patterns
+        return {"status": "ok", "opponent_id": opponent_id, "patterns": patterns, "total": total}
+
+    def add_spell_record(self, opponent_id: str, record: Dict[str, Any]) -> Dict[str, Any]:
+        self._op_count += 1
+        if opponent_id not in self._spell_records:
+            self._spell_records[opponent_id] = []
+        self._spell_records[opponent_id].append(record)
+        return {"status": "ok", "opponent_id": opponent_id, "total": len(self._spell_records[opponent_id])}
+
+    def predict_spells(self, opponent_id: str, champion: str = "") -> Dict[str, Any]:
+        self._op_count += 1
+        patterns = self._spell_cache.get(opponent_id, {})
+        if not patterns:
+            return {"status": "ok", "prediction": "unknown", "confidence": 0.0}
+        best_combo = max(patterns.keys(), key=lambda k: patterns[k]["count"])
+        conf = patterns[best_combo]["frequency"]
+        return {"status": "ok", "prediction": best_combo, "confidence": round(conf, 4)}
+
+    def process(self, data: Dict[str, Any] = None) -> Dict[str, Any]:
+        self._op_count += 1
+        self._process_count += 1
+        data = data or {}
+        results = {}
+        errors = []
+        for name, module in self._modules.items():
+            try:
+                if hasattr(module, "get_stats"):
+                    results[name] = {"status": "ok", "stats": module.get_stats()}
+                else:
+                    results[name] = {"status": "ok"}
+            except Exception as e:
+                self._errors[name] = self._errors.get(name, 0) + 1
+                errors.append(f"{name}: {e}")
+                results[name] = {"status": "error", "error": str(e)}
+        entry = {"cycle": self._process_count, "results": results, "errors": errors,
+                 "timestamp": time.time()}
+        self._history.append(entry)
+        self._fire("processed", {"cycle": self._process_count, "errors": len(errors)})
+        return {"status": "ok", "cycle": self._process_count, "results": results, "errors": errors}
+
+    def get_report(self) -> Dict[str, Any]:
+        self._op_count += 1
+        return {"status": "ok", "state": self._state, "modules": len(self._modules),
+                "process_count": self._process_count,
+                "module_errors": dict(self._errors),
+                "recent_history": list(self._history)[-5:]}
+
+    def shutdown(self) -> Dict[str, Any]:
+        self._op_count += 1
+        self._state = "shutdown"
+        self._fire("shutdown", {"cycles": self._process_count})
+        return {"status": "ok", "state": "shutdown", "total_cycles": self._process_count}
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {"state": self._state, "modules": len(self._modules),
+                "process_count": self._process_count, "total_ops": self._op_count,
+                "errors": dict(self._errors)}
