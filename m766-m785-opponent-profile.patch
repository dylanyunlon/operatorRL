+"""
+OpponentTiltStateAnalyzer — 对手心态倾斜状态分析器。
+
+Architecture (拿来主义):
+  intel_accuracy_tracker.py（M731） — primary reference
+  opponent_adaptation_tracker.py（M723） — secondary reference
+
+Location: integrations/lol-history/src/lol_history/opponent_tilt_state_analyzer.py
+
+查看 **integrations/lol-history/src/lol_history/intel_accuracy_tracker.py（M731）** 上现有
+**趋势检测与滑动窗口** 的实现方式，理解其模式。可以从
+**`opponent_adaptation_tracker.py（M723）`** 的对手行为追踪这个好例子开始。然后，遵循该模式
+实现一个新的 **OpponentTiltStateAnalyzer**，让 **心理分析** 可以 **从连败/连胜趋势、KDA下降、
+投降率等检测对手心态状态（稳定/倾斜/超神）**，并能 **输出倾斜概率和可利用的心理弱点建议**。
+从头开始构建，除了代码库中已有的库之外，不要使用其他库。
+
+Note: 本模块是 opponent_tilt_detector.py 的增强版本，提供更细粒度的倾斜状态分析。
+原有 opponent_tilt_detector.py 保持不变以确保向后兼容。
+"""
+from __future__ import annotations
+import logging, time, math
+from collections import deque
+from typing import Any, Callable, Dict, List, Optional, Tuple
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.opponent_tilt_state_analyzer.v1"
+def _safe_div(a, b, d=0.0): return a / b if b else d
+def _clamp(v, lo=0.0, hi=1.0): return max(lo, min(hi, v))
+
+class OpponentTiltStateAnalyzer:
+    """Analyzes opponent tilt state from match history with granular state detection.
+
+    Unlike OpponentTiltDetector which provides a binary tilt/stable signal,
+    this analyzer provides continuous state tracking with confidence scoring.
+
+    Public API: register, initialize, detect_tilt, add_match_result, get_tilt_history,
+                process, get_report, shutdown, get_stats
+    """
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._modules: Dict[str, Any] = {}
+        self._history: deque = deque(maxlen=500)
+        self._process_count = 0
+        self._state = "uninitialized"
+        self._errors: Dict[str, int] = {}
+        self._match_results: Dict[str, List[Dict]] = {}
+        self._tilt_cache: Dict[str, Dict] = {}
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def register(self, name: str, module: Any) -> Dict[str, Any]:
+        self._op_count += 1
+        self._modules[name] = module
+        self._errors[name] = 0
+        return {"status": "ok", "module": name, "total": len(self._modules)}
+
+    def initialize(self) -> Dict[str, Any]:
+        self._op_count += 1
+        self._state = "initialized"
+        self._fire("initialized", {"modules": list(self._modules.keys())})
+        return {"status": "ok", "state": self._state, "modules": len(self._modules)}
+
+    def detect_tilt(self, opponent_id: str) -> Dict[str, Any]:
+        """Detect tilt state with continuous scoring."""
+        self._op_count += 1
+        results = self._match_results.get(opponent_id, [])
+        if len(results) < 3:
+            return {"status": "ok", "opponent_id": opponent_id, "tilt_score": 0.0,
+                    "state": "unknown", "confidence": 0.0}
+        recent = results[-5:] if len(results) >= 5 else results
+        losses = sum(1 for r in recent if not r.get("win", True))
+        kda_trend = [r.get("kda", 3.0) for r in recent]
+        kda_declining = len(kda_trend) > 1 and kda_trend[-1] < kda_trend[0] * 0.7
+        surrender_rate = _safe_div(
+            sum(1 for r in recent if r.get("surrender", False)), len(recent))
+        tilt_score = _clamp(
+            losses / len(recent) * 0.5 +
+            (0.2 if kda_declining else 0) +
+            surrender_rate * 0.3)
+        state = "tilted" if tilt_score > 0.6 else (
+            "unstable" if tilt_score > 0.3 else "stable")
+        conf = min(len(results) / 10.0, 1.0)
+        entry = {"tilt_score": round(tilt_score, 4), "state": state,
+                 "confidence": round(conf, 4)}
+        self._tilt_cache[opponent_id] = entry
+        return {"status": "ok", "opponent_id": opponent_id, **entry}
+
+    def add_match_result(self, opponent_id: str, result: Dict[str, Any]) -> Dict[str, Any]:
+        """Add a match result for tilt tracking."""
+        self._op_count += 1
+        if opponent_id not in self._match_results:
+            self._match_results[opponent_id] = []
+        self._match_results[opponent_id].append(result)
+        return {"status": "ok", "opponent_id": opponent_id,
+                "total": len(self._match_results[opponent_id])}
+
+    def get_tilt_history(self, opponent_id: str) -> Dict[str, Any]:
+        """Get cached tilt analysis for an opponent."""
+        self._op_count += 1
+        return {"status": "ok", "opponent_id": opponent_id,
+                "cached": self._tilt_cache.get(opponent_id, {}),
+                "matches": len(self._match_results.get(opponent_id, []))}
+
+    def process(self, data: Dict[str, Any] = None) -> Dict[str, Any]:
+        self._op_count += 1
+        self._process_count += 1
+        data = data or {}
+        results = {}
+        errors = []
+        for name, module in self._modules.items():
+            try:
+                if hasattr(module, "get_stats"):
+                    results[name] = {"status": "ok", "stats": module.get_stats()}
+                else:
+                    results[name] = {"status": "ok"}
+            except Exception as e:
+                self._errors[name] = self._errors.get(name, 0) + 1
+                errors.append(f"{name}: {e}")
+                results[name] = {"status": "error", "error": str(e)}
+        entry = {"cycle": self._process_count, "results": results, "errors": errors,
+                 "timestamp": time.time()}
+        self._history.append(entry)
+        self._fire("processed", {"cycle": self._process_count, "errors": len(errors)})
+        return {"status": "ok", "cycle": self._process_count, "results": results, "errors": errors}
+
+    def get_report(self) -> Dict[str, Any]:
+        self._op_count += 1
+        return {"status": "ok", "state": self._state, "modules": len(self._modules),
+                "process_count": self._process_count,
+                "module_errors": dict(self._errors),
+                "recent_history": list(self._history)[-5:]}
+
+    def shutdown(self) -> Dict[str, Any]:
+        self._op_count += 1
+        self._state = "shutdown"
+        self._fire("shutdown", {"cycles": self._process_count})
+        return {"status": "ok", "state": "shutdown", "total_cycles": self._process_count}
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {"state": self._state, "modules": len(self._modules),
+                "process_count": self._process_count, "total_ops": self._op_count,
+                "errors": dict(self._errors)}
