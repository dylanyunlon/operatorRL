+"""
+OpponentPowerSpikeTimer — 对手强势期时间预测器。
+
+Architecture (拿来主义):
+  historical_power_spike_advisor.py（M720） — primary reference
+  seraphine_deep_history_pipeline.py — secondary reference
+
+Location: integrations/lol-history/src/lol_history/opponent_power_spike_timer.py
+
+查看 **integrations/lol-history/src/lol_history/historical_power_spike_advisor.py（M720）** 上现有
+**强势期分析** 的实现方式，理解其模式。可以从
+**`seraphine_deep_history_pipeline.py`** 的历史数据管线这个好例子开始。然后，遵循该模式
+实现一个新的 **OpponentPowerSpikeTimer**，让 **对战时间轴** 可以 **从历史数据预测对手英雄的关键装备完成时间和等级强势期**，并能
+**输出时间窗口建议（何时进攻/何时防守）**。从头开始构建，除了代码库中已有的库之外，不要使用其他库。
+"""
+from __future__ import annotations
+import logging, time, math
+from collections import deque
+from typing import Any, Callable, Dict, List, Optional, Tuple
+logger = logging.getLogger(__name__)
+_EVOLUTION_KEY = "integrations.lol_history.opponent_power_spike_timer.v1"
+def _safe_div(a, b, d=0.0): return a / b if b else d
+def _clamp(v, lo=0.0, hi=1.0): return max(lo, min(hi, v))
+
+class OpponentPowerSpikeTimer:
+    """Predicts opponent champion power spike timings from historical item/level data.
+
+    Public API: register, initialize, process, get_report, shutdown, get_stats
+    """
+    def __init__(self) -> None:
+        self.evolution_callback: Optional[Callable] = None
+        self._op_count = 0
+        self._modules: Dict[str, Any] = {}
+        self._history: deque = deque(maxlen=500)
+        self._process_count = 0
+        self._state = "uninitialized"
+        self._errors: Dict[str, int] = {}
+        self._item_timings: Dict[str, List[Dict]] = {}
+        self._spike_cache: Dict[str, List[Dict]] = {}
+
+    def _fire(self, et, data):
+        if self.evolution_callback:
+            self.evolution_callback({"type": et, "key": _EVOLUTION_KEY, **data})
+
+    def register(self, name: str, module: Any) -> Dict[str, Any]:
+        self._op_count += 1
+        self._modules[name] = module
+        self._errors[name] = 0
+        return {"status": "ok", "module": name, "total": len(self._modules)}
+
+    def initialize(self) -> Dict[str, Any]:
+        self._op_count += 1
+        self._state = "initialized"
+        self._fire("initialized", {"modules": list(self._modules.keys())})
+        return {"status": "ok", "state": self._state, "modules": len(self._modules)}
+
+    def predict_spikes(self, champion: str, opponent_id: str = "") -> Dict[str, Any]:
+        self._op_count += 1
+        key = f"{opponent_id}_{champion}" if opponent_id else champion
+        timings = self._item_timings.get(key, self._item_timings.get(champion, []))
+        if not timings:
+            return {"status": "ok", "champion": champion, "spikes": [], "confidence": 0.0}
+        spike_map: Dict[str, List[float]] = {}
+        for t in timings:
+            item = t.get("item", "unknown")
+            minute = t.get("minute", 0)
+            if item not in spike_map:
+                spike_map[item] = []
+            spike_map[item].append(minute)
+        spikes = []
+        for item, mins in spike_map.items():
+            avg = sum(mins) / len(mins)
+            spikes.append({"item": item, "avg_minute": round(avg, 1), "samples": len(mins)})
+        spikes.sort(key=lambda x: x["avg_minute"])
+        conf = min(len(timings) / 15.0, 1.0)
+        self._spike_cache[key] = spikes
+        return {"status": "ok", "champion": champion, "spikes": spikes, "confidence": round(conf, 4)}
+
+    def add_item_timing(self, champion: str, timing: Dict[str, Any], opponent_id: str = "") -> Dict[str, Any]:
+        self._op_count += 1
+        key = f"{opponent_id}_{champion}" if opponent_id else champion
+        if key not in self._item_timings:
+            self._item_timings[key] = []
+        self._item_timings[key].append(timing)
+        return {"status": "ok", "key": key, "total": len(self._item_timings[key])}
+
+    def get_spike_timeline(self, champion: str) -> Dict[str, Any]:
+        self._op_count += 1
+        return {"status": "ok", "champion": champion, "cached": self._spike_cache.get(champion, [])}
+
+    def process(self, data: Dict[str, Any] = None) -> Dict[str, Any]:
+        self._op_count += 1
+        self._process_count += 1
+        data = data or {}
+        results = {}
+        errors = []
+        for name, module in self._modules.items():
+            try:
+                if hasattr(module, "get_stats"):
+                    results[name] = {"status": "ok", "stats": module.get_stats()}
+                else:
+                    results[name] = {"status": "ok"}
+            except Exception as e:
+                self._errors[name] = self._errors.get(name, 0) + 1
+                errors.append(f"{name}: {e}")
+                results[name] = {"status": "error", "error": str(e)}
+        entry = {"cycle": self._process_count, "results": results, "errors": errors,
+                 "timestamp": time.time()}
+        self._history.append(entry)
+        self._fire("processed", {"cycle": self._process_count, "errors": len(errors)})
+        return {"status": "ok", "cycle": self._process_count, "results": results, "errors": errors}
+
+    def get_report(self) -> Dict[str, Any]:
+        self._op_count += 1
+        return {"status": "ok", "state": self._state, "modules": len(self._modules),
+                "process_count": self._process_count,
+                "module_errors": dict(self._errors),
+                "recent_history": list(self._history)[-5:]}
+
+    def shutdown(self) -> Dict[str, Any]:
+        self._op_count += 1
+        self._state = "shutdown"
+        self._fire("shutdown", {"cycles": self._process_count})
+        return {"status": "ok", "state": "shutdown", "total_cycles": self._process_count}
+
+    def get_stats(self) -> Dict[str, Any]:
+        return {"state": self._state, "modules": len(self._modules),
+                "process_count": self._process_count, "total_ops": self._op_count,
+                "errors": dict(self._errors)}
